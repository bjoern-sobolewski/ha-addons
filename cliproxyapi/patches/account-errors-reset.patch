@@ -0,0 +1,64 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+func TestSharedResetFailureProvenanceAndSafeDiagnostics(t *testing.T) {
+	for _, test := range []struct {
+		name           string
+		status         int
+		body           string
+		transportError bool
+		code           string
+	}{
+		{"authentication", 401, "synthetic-secret-token", false, "auth_error"},
+		{"rate limit", 429, "synthetic-secret-token", false, "rate_limited"},
+		{"provider unavailable", 503, "synthetic-secret-token", false, "unknown"},
+		{"transport", 0, "", true, "unknown"},
+		{"malformed result", 200, "synthetic-secret-token", false, "unknown"},
+		{"provider business result", 200, `{"code":"not_limited"}`, false, "not_limited"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			h, _ := resetFixture(t, "codex")
+			h.resetHTTPClient = resetDoer(func(request *http.Request) (*http.Response, error) {
+				if request.Method == "GET" {
+					return resetReply(resetCredits), nil
+				}
+				if test.transportError {
+					return nil, errors.New("synthetic-secret-token")
+				}
+				response := resetReply(test.body)
+				response.StatusCode = test.status
+				return response, nil
+			})
+			response := resetRequest(h, resetID, "codex", "")
+			var result quotaResetResult
+			if response.Code != 200 || json.Unmarshal(response.Body.Bytes(), &result) != nil || result.Code != test.code || result.ErrorSource != "provider" {
+				t.Fatalf("wrong failure provenance: %d %s", response.Code, response.Body.String())
+			}
+			if strings.Contains(response.Body.String(), "synthetic-secret-token") {
+				t.Fatal("raw error leaked")
+			}
+		})
+	}
+}
+
+func TestSharedResetOptionsIdentifyProviderFailure(t *testing.T) {
+	h, account := resetFixture(t, "codex")
+	h.resetHTTPClient = resetDoer(func(*http.Request) (*http.Response, error) {
+		response := resetReply("synthetic-secret-token")
+		response.StatusCode = 403
+		return response, nil
+	})
+	_, err := h.quotaResetOptions(context.Background(), account)
+	var failure *quotaResetCallError
+	if !errors.As(err, &failure) || failure.source != "provider" || failure.status != 403 || strings.Contains(failure.Error(), "synthetic-secret-token") {
+		t.Fatalf("provider options failure was lost: %v", err)
+	}
+}
