+func resetCallFailure(status int, err error) *quotaResetCallError {
+	var failure *quotaResetCallError
+	if errors.As(err, &failure) {
+		return failure
+	}
+	if err != nil {
+		return &quotaResetCallError{source: "provider", reason: "The provider response could not be read. The result is unconfirmed."}
+	}
+	if status < 200 || status >= 300 {
+		return &quotaResetCallError{source: "provider", status: status, reason: "The provider rejected the reset request."}
+	}
+	return nil
+}
+func failedReset(code string, failure *quotaResetCallError) quotaResetResult {
+	return quotaResetResult{Code: code, ErrorSource: failure.source, ErrorStatus: failure.status, ErrorReason: failure.reason}
+}
