diff --git a/internal/client/codex/live/desktop_sideband.go b/internal/client/codex/live/desktop_sideband.go
new file mode 100644
--- /dev/null
+++ b/internal/client/codex/live/desktop_sideband.go
@@ -0,0 +1,196 @@
+package live
+
+import (
+	"context"
+	"net/http"
+	"regexp"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+const (
+	desktopJoinTimeout     = 30 * time.Second
+	desktopAccountAttempts = 8
+	knownCallLifetime      = 2 * time.Hour
+	knownCallLimit         = 4096
+)
+
+var desktopCallIDPattern = regexp.MustCompile(`^rtc_[A-Za-z0-9_-]{24,124}$`)
+
+// Keep tombstones beyond the upstream call lifetime so completed proxy calls
+// cannot be adopted by another principal. Saturation fails closed rather than
+// evicting an ownership record that is still relevant.
+func (s *sessionStore) rememberCallLocked(callID string) {
+	now := time.Now()
+	for knownID, expires := range s.knownCalls {
+		if !expires.After(now) {
+			delete(s.knownCalls, knownID)
+		}
+	}
+	if s.knownCalls == nil {
+		s.knownCalls = make(map[string]time.Time)
+	}
+	if _, exists := s.knownCalls[callID]; !exists && len(s.knownCalls) >= knownCallLimit {
+		s.adoptionBlockedUntil = now.Add(knownCallLifetime)
+		return
+	}
+	s.knownCalls[callID] = now.Add(knownCallLifetime)
+}
+
+func (s *sessionStore) reserveDesktopCall(callID string, session liveSession) (liveSession, bool) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	now := time.Now()
+	if s.sessions[callID] != nil || s.knownCalls[callID].After(now) || s.adoptionBlockedUntil.After(now) {
+		return liveSession{}, false
+	}
+	s.next++
+	session.callID, session.token = callID, s.next
+	entry := &storedSession{session: session, claimed: true}
+	entry.timer = time.AfterFunc(s.expiryDuration(), func() { s.expire(callID, session.token) })
+	s.sessions[callID] = entry
+	return session, true
+}
+
+func (s *sessionStore) confirmDesktopCall(session liveSession, authID string) bool {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	entry := s.sessions[session.callID]
+	if entry == nil || entry.session.token != session.token {
+		return false
+	}
+	entry.session.authID = authID
+	s.rememberCallLocked(session.callID)
+	return true
+}
+
+// Desktop creates its WebRTC media call with its local ChatGPT login, then
+// attaches app-server control through the configured provider. Such calls have
+// no proxy creation record. Only full API principals may attach, and only an
+// upstream 101 proves that one of our eligible OAuth accounts owns the call.
+func (h *Handler) handleDesktopSideband(c *gin.Context, callID string) {
+	principal, provider := requestOwner(c)
+	_, scopedSecret := c.Get(ClientSecretPrincipalContextKey)
+	if scopedSecret || principal == "" || provider == "" || h.authManager.HomeEnabled() {
+		writeLiveError(c, http.StatusNotFound, "Codex live session not found")
+		return
+	}
+	releaseSlot, admitted := h.acquireLiveSlot(c)
+	if !admitted {
+		return
+	}
+	ctx := context.WithValue(c.Request.Context(), "gin", c)
+	ctx = coreexecutor.WithDownstreamWebsocket(ctx)
+	ctx, cancel := context.WithCancel(ctx)
+	resources := &liveSessionResources{}
+	resources.add(func() error { cancel(); releaseSlot(); return nil })
+	defer resources.close()
+	stopShutdown := context.AfterFunc(h.voiceContext, resources.close)
+	defer stopShutdown()
+	stopRequest := context.AfterFunc(ctx, resources.close)
+	defer stopRequest()
+	session, reserved := h.sessions.reserveDesktopCall(callID, liveSession{
+		model: "gpt-live-1.1-codex", ownerPrincipal: principal, ownerProvider: provider, resources: resources,
+	})
+	if !reserved {
+		writeLiveError(c, http.StatusNotFound, "Codex live session not found")
+		return
+	}
+	defer h.sessions.complete(session, "desktop_sideband_closed")
+	setupCtx, cancelSetup := context.WithTimeout(ctx, desktopJoinTimeout)
+	defer cancelSetup()
+	upstream, selected, status := h.dialDesktopSideband(setupCtx, c, callID)
+	if upstream == nil {
+		writeLiveError(c, status, "Unable to attach Codex desktop voice call; the same ChatGPT account must be connected to the proxy")
+		return
+	}
+	logging.SetGinCPATraceID(c, selected.EnsureIndex())
+	resources.add(websocketCloseFunc("upstream", upstream))
+	if !h.sessions.confirmDesktopCall(session, selected.ID) {
+		writeLiveError(c, http.StatusGone, "Codex live session expired")
+		return
+	}
+	upgradeHeaders := make(http.Header)
+	if protocol := upstream.Subprotocol(); protocol != "" {
+		upgradeHeaders.Set("Sec-WebSocket-Protocol", protocol)
+	}
+	downstream, err := sidebandUpgrader.Upgrade(c.Writer, c.Request, upgradeHeaders)
+	if err != nil {
+		return
+	}
+	resources.add(websocketCloseFunc("downstream", downstream))
+	// The media connection stays between desktop and OpenAI. This socket carries
+	// only native control/delegation events; no audio conversion is necessary.
+	_ = relayWebsockets(downstream, upstream)
+}
+
+func (h *Handler) dialDesktopSideband(ctx context.Context, c *gin.Context, callID string) (*websocket.Conn, *auth.Auth, int) {
+	opts := coreexecutor.Options{Headers: liveSelectionHeaders(c), Metadata: map[string]any{coreexecutor.ExecutionSessionMetadataKey: callID}}
+	_, first, err := h.selectOAuth(ctx, "gpt-live-1.1-codex", opts)
+	if err != nil || first == nil {
+		return nil, nil, http.StatusServiceUnavailable
+	}
+	candidates := []*auth.Auth{first}
+	for _, candidate := range h.authManager.List() {
+		if candidate.ID != first.ID && candidate.Provider == "codex" && candidate.AuthKind() == auth.AuthKindOAuth {
+			candidates = append(candidates, candidate)
+		}
+	}
+	upstreamURL := buildSidebandURL(h.sidebandAPIBaseURL, sidebandFrameless, callID)
+	attempts := 0
+	for _, candidate := range candidates {
+		if ctx.Err() != nil {
+			return nil, nil, http.StatusGatewayTimeout
+		}
+		// Re-select pinned candidates through the manager; listing credentials
+		// alone must never bypass disabled, quota, or credential-policy checks.
+		opts.Metadata[coreexecutor.PinnedAuthMetadataKey] = candidate.ID
+		_, selected, selectErr := h.selectOAuth(ctx, "gpt-live-1.1-codex", opts)
+		if selectErr != nil || selected == nil || selected.ID != candidate.ID {
+			continue
+		}
+		attempts++
+		req, requestErr := http.NewRequestWithContext(ctx, http.MethodGet, websocketHTTPURL(upstreamURL), nil)
+		if requestErr != nil {
+			return nil, nil, http.StatusBadGateway
+		}
+		req.Header = protocolHeaders(c.Request.Header)
+		if req.Header.Get("OpenAI-Alpha") == "" {
+			req.Header.Set("OpenAI-Alpha", "quicksilver=v2")
+		}
+		setAccountHeader(req.Header, selected)
+		if err := h.authManager.PrepareHttpRequest(ctx, selected, req); err != nil {
+			return nil, nil, http.StatusBadGateway
+		}
+		dialer := newProxyAwareSidebandDialer(h.currentConfig(), selected)
+		dialer.Subprotocols = websocket.Subprotocols(c.Request)
+		connection, response, dialErr := dialer.DialContext(ctx, upstreamURL, req.Header)
+		status := http.StatusBadGateway
+		if response != nil {
+			status = response.StatusCode
+			if response.Body != nil {
+				_ = response.Body.Close()
+			}
+		}
+		if dialErr == nil {
+			return connection, selected, http.StatusSwitchingProtocols
+		}
+		if connection != nil {
+			_ = connection.Close()
+		}
+		// A missing call can mean a different account owns it. Never retry
+		// authentication, policy, quota, or network errors under other accounts.
+		if status != http.StatusNotFound || attempts >= desktopAccountAttempts {
+			if status != http.StatusNotFound {
+				status = http.StatusBadGateway
+			}
+			return nil, nil, status
+		}
+	}
+	return nil, nil, http.StatusNotFound
+}
