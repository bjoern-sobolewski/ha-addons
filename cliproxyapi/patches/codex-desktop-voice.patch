+package live
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+const desktopTestCallID = "rtc_desktop_external_call_123456789"
+
+func TestDesktopSidebandJoinsExternalCallAndClosesResources(t *testing.T) {
+	var handshakes atomic.Int32
+	upstream := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		handshakes.Add(1)
+		if request.URL.Path != "/v1/live/"+desktopTestCallID || request.Header.Get("Authorization") != "Bearer test-only-token" || request.Header.Get("OpenAI-Alpha") != "quicksilver=v2" {
+			t.Error("desktop sideband used incorrect upstream route or credentials")
+		}
+		connection, err := sidebandUpgrader.Upgrade(writer, request, nil)
+		if err != nil {
+			return
+		}
+		defer connection.Close()
+		for {
+			kind, payload, err := connection.ReadMessage()
+			if err != nil {
+				return
+			}
+			if err := connection.WriteMessage(kind, payload); err != nil {
+				return
+			}
+		}
+	}))
+	defer upstream.Close()
+	handler := audioTestHandler(t, &captureExecutor{})
+	handler.sidebandAPIBaseURL = "ws" + strings.TrimPrefix(upstream.URL, "http") + "/v1"
+	router := gin.New()
+	router.GET("/v1/live/:call_id", func(c *gin.Context) {
+		c.Set("userApiKey", c.GetHeader("X-Test-Principal"))
+		c.Set("accessProvider", "fixture")
+		handler.HandleSideband(c)
+	})
+	proxy := httptest.NewServer(router)
+	defer proxy.Close()
+	url := "ws" + strings.TrimPrefix(proxy.URL, "http") + "/v1/live/" + desktopTestCallID
+	connection, response, err := websocket.DefaultDialer.Dial(url, http.Header{"X-Test-Principal": []string{"client-a"}, "OpenAI-Alpha": []string{"quicksilver=v2"}})
+	if response != nil && response.Body != nil {
+		response.Body.Close()
+	}
+	if err != nil {
+		t.Fatalf("join desktop-created call: %v", err)
+	}
+	defer connection.Close()
+	_ = connection.SetReadDeadline(time.Now().Add(2 * time.Second))
+	event := `{"type":"delegation.context.append","content":[{"type":"input_text","text":"Synthetic result"}]}`
+	if err := connection.WriteMessage(websocket.TextMessage, []byte(event)); err != nil {
+		t.Fatal(err)
+	}
+	_, payload, err := connection.ReadMessage()
+	if err != nil || string(payload) != event {
+		t.Fatalf("control relay = %q, %v", payload, err)
+	}
+	handler.Close()
+	if _, _, err := connection.ReadMessage(); err == nil {
+		t.Fatal("shutdown left desktop sideband connected")
+	}
+	if handshakes.Load() != 1 {
+		t.Fatalf("upstream handshakes=%d", handshakes.Load())
+	}
+	if len(handler.liveSlots) != 0 {
+		t.Fatal("desktop sideband leaked admission slot")
+	}
+}
+
+func TestDesktopSidebandAccountDiscovery(t *testing.T) {
+	for _, test := range []struct {
+		name         string
+		firstStatus  int
+		disabled     bool
+		wantStatus   int
+		wantAttempts int
+	}{
+		{"another account owns call", 404, false, 101, 2},
+		{"authentication errors stop discovery", 401, false, 502, 1},
+		{"quota errors stop discovery", 429, false, 502, 1},
+		{"disabled account is never dialed", 404, true, 404, 1},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			handler := audioTestHandler(t, &captureExecutor{})
+			registerCredential(t, handler.authManager, &auth.Auth{ID: "second-oauth", Provider: "codex", Status: auth.StatusActive, Disabled: test.disabled, Metadata: map[string]any{"access_token": "second-test-token", "account_id": "second-test-account"}})
+			var attempts atomic.Int32
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				attempts.Add(1)
+				if r.Header.Get("Authorization") == "Bearer test-only-token" {
+					w.WriteHeader(test.firstStatus)
+					_, _ = w.Write([]byte("private provider error"))
+					return
+				}
+				if r.Header.Get("Authorization") != "Bearer second-test-token" {
+					t.Error("unexpected credential")
+				}
+				connection, err := sidebandUpgrader.Upgrade(w, r, nil)
+				if err == nil {
+					defer connection.Close()
+					_, _, _ = connection.ReadMessage()
+				}
+			}))
+			defer upstream.Close()
+			handler.sidebandAPIBaseURL = "ws" + strings.TrimPrefix(upstream.URL, "http") + "/v1"
+			router := desktopTestRouter(handler, "client-a", false)
+			proxy := httptest.NewServer(router)
+			defer proxy.Close()
+			connection, response, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(proxy.URL, "http")+"/v1/live/"+desktopTestCallID, nil)
+			if connection != nil {
+				connection.Close()
+			}
+			if response == nil {
+				t.Fatalf("no HTTP response: %v", err)
+			}
+			defer response.Body.Close()
+			if response.StatusCode != test.wantStatus || int(attempts.Load()) != test.wantAttempts {
+				t.Fatalf("status=%d attempts=%d, want %d/%d", response.StatusCode, attempts.Load(), test.wantStatus, test.wantAttempts)
+			}
+			handler.Close()
+			if len(handler.liveSlots) != 0 {
+				t.Fatal("failed or closed join leaked admission slot")
+			}
+		})
+	}
+}
+
+func desktopTestRouter(handler *Handler, principal string, scoped bool) *gin.Engine {
+	router := gin.New()
+	router.GET("/v1/live/:call_id", func(c *gin.Context) {
+		c.Set("userApiKey", principal)
+		c.Set("accessProvider", "fixture")
+		if scoped {
+			c.Set(ClientSecretPrincipalContextKey, "scoped-secret")
+		}
+		handler.HandleSideband(c)
+	})
+	return router
+}
+
+func TestDesktopSidebandRejectsUnscopedAndConcurrentJoins(t *testing.T) {
+	for _, test := range []struct {
+		name      string
+		principal string
+		scoped    bool
+		reserve   bool
+		callID    string
+	}{
+		{"anonymous", "", false, false, desktopTestCallID},
+		{"client secret", "client-a", true, false, desktopTestCallID},
+		{"concurrent call", "client-b", false, true, desktopTestCallID},
+		{"short unknown call", "client-a", false, false, "rtc_short"},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			handler := audioTestHandler(t, &captureExecutor{})
+			if test.reserve {
+				handler.sessions.reserveDesktopCall(test.callID, liveSession{ownerPrincipal: "client-a", ownerProvider: "fixture", resources: &liveSessionResources{}})
+			}
+			router := desktopTestRouter(handler, test.principal, test.scoped)
+			r := httptest.NewRequest("GET", "/v1/live/"+test.callID, nil)
+			r.Header.Set("Connection", "Upgrade")
+			r.Header.Set("Upgrade", "websocket")
+			w := httptest.NewRecorder()
+			router.ServeHTTP(w, r)
+			if w.Code != 404 && !(test.reserve && w.Code == 409) {
+				t.Fatalf("unexpected status %d", w.Code)
+			}
+			if len(handler.liveSlots) != 0 {
+				t.Fatal("rejected request acquired live slot")
+			}
+		})
+	}
+}
+
+func TestDesktopSidebandExpiresDuringHandshake(t *testing.T) {
+	handler := audioTestHandler(t, &captureExecutor{})
+	handler.sessions.lifetime = 20 * time.Millisecond
+	entered := make(chan struct{})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { close(entered); <-r.Context().Done() }))
+	defer upstream.Close()
+	handler.sidebandAPIBaseURL = "ws" + strings.TrimPrefix(upstream.URL, "http") + "/v1"
+	proxy := httptest.NewServer(desktopTestRouter(handler, "client-a", false))
+	defer proxy.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	connection, response, err := websocket.DefaultDialer.DialContext(ctx, "ws"+strings.TrimPrefix(proxy.URL, "http")+"/v1/live/"+desktopTestCallID, nil)
+	if connection != nil {
+		connection.Close()
+		t.Fatal("expired join upgraded")
+	}
+	if err == nil {
+		t.Fatal("expired join succeeded")
+	}
+	if response != nil {
+		response.Body.Close()
+	}
+	select {
+	case <-entered:
+	default:
+		t.Fatal("handshake was not attempted")
+	}
+	if _, ok := handler.sessions.peek(desktopTestCallID); ok {
+		t.Fatal("expired reservation retained")
+	}
+	if len(handler.liveSlots) != 0 {
+		t.Fatal("expired join leaked admission slot")
+	}
+}
+
+func TestDesktopSidebandHistorySaturationFailsClosed(t *testing.T) {
+	store := newSessionStore()
+	defer store.closeAll("test")
+	store.mu.Lock()
+	store.knownCalls = make(map[string]time.Time)
+	for index := 0; index < knownCallLimit; index++ {
+		store.knownCalls[time.Unix(int64(index), 0).String()] = time.Now().Add(time.Hour)
+	}
+	store.rememberCallLocked("overflow")
+	store.mu.Unlock()
+	if _, ok := store.reserveDesktopCall(desktopTestCallID, liveSession{}); ok {
+		t.Fatal("history saturation allowed adoption")
+	}
+}
+
+func TestDesktopSidebandCannotAdoptFinishedProxyCall(t *testing.T) {
+	var handshakes atomic.Int32
+	upstream := httptest.NewServer(http.HandlerFunc(func(writer http.ResponseWriter, request *http.Request) {
+		handshakes.Add(1)
+		writer.WriteHeader(http.StatusNotFound)
+	}))
+	defer upstream.Close()
+	handler := audioTestHandler(t, &captureExecutor{})
+	handler.sidebandAPIBaseURL = "ws" + strings.TrimPrefix(upstream.URL, "http") + "/v1"
+	session := handler.sessions.put(desktopTestCallID, liveSession{authID: "audio-oauth", model: defaultLiveModel, ownerPrincipal: "client-a", ownerProvider: "fixture"})
+	handler.sessions.complete(session, "test_finished")
+	router := gin.New()
+	router.GET("/v1/live/:call_id", func(c *gin.Context) {
+		c.Set("userApiKey", "client-b")
+		c.Set("accessProvider", "fixture")
+		handler.HandleSideband(c)
+	})
+	request := httptest.NewRequest(http.MethodGet, "/v1/live/"+desktopTestCallID, nil)
+	request.Header.Set("Connection", "Upgrade")
+	request.Header.Set("Upgrade", "websocket")
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, request)
+	if response.Code != http.StatusNotFound || handshakes.Load() != 0 {
+		t.Fatalf("finished owned call was adopted: status=%d handshakes=%d", response.Code, handshakes.Load())
+	}
+}
