diff --git a/internal/api/handlers/management/auth_files_reconnect.go b/internal/api/handlers/management/auth_files_reconnect.go
new file mode 100644
index 00000000..3c8fef03
--- /dev/null
+++ b/internal/api/handlers/management/auth_files_reconnect.go
@@ -0,0 +1,206 @@
+package management
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/misc"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+var errCodexReconnectChanged = errors.New("the credential changed or was removed during sign-in; start reconnect again")
+var errCodexReconnectAccount = errors.New("sign in to the same Codex account; the existing credential has not been changed")
+
+type codexReconnectTarget struct {
+	id, name, index, path, accountID string
+	registrationEpoch                uint64
+}
+
+// ReconnectCodexAuthFile starts a fresh OAuth flow bound to an existing file.
+// A separate endpoint makes older backends fail safely instead of ignoring the target.
+func (h *Handler) ReconnectCodexAuthFile(c *gin.Context) {
+	if h == nil || h.cfg == nil || h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "core auth manager unavailable"})
+		return
+	}
+	name, index := strings.TrimSpace(c.Query("name")), strings.TrimSpace(c.Query("auth_index"))
+	if name == "" || index == "" || filepath.Base(name) != name || strings.ContainsAny(name, "/\\") {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "an existing credential name and auth_index are required"})
+		return
+	}
+	auth, ok := h.lookupAuthFile(name, index)
+	if !ok || auth == nil {
+		c.JSON(http.StatusNotFound, gin.H{"error": "auth file not found"})
+		return
+	}
+	if auth.Provider != "codex" || auth.AuthKind() != coreauth.AuthKindOAuth || coreauth.IsPluginVirtualAuth(auth) {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "reconnect supports Codex OAuth files only"})
+		return
+	}
+	path, errPath := filepath.Abs(filepath.Join(h.cfg.AuthDir, name))
+	if errPath != nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid credential path"})
+		return
+	}
+	if source := auth.Attributes[coreauth.AttributePath]; source != "" {
+		absoluteSource, errSource := filepath.Abs(source)
+		if errSource != nil || filepath.Clean(absoluteSource) != path {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "reconnect requires a file in the configured auth directory"})
+			return
+		}
+	}
+	metadata, _, errRead := readCodexReconnectFile(path)
+	if errRead != nil {
+		c.JSON(http.StatusConflict, gin.H{"error": "the existing Codex credential cannot be verified"})
+		return
+	}
+	accountID := codexReconnectAccountID(metadata)
+	if accountID == "" {
+		c.JSON(http.StatusConflict, gin.H{"error": "the existing Codex account identity cannot be verified"})
+		return
+	}
+	target := &codexReconnectTarget{auth.ID, name, index, path, accountID, auth.RegistrationEpoch}
+	h.requestCodexToken(c, target)
+}
+
+func codexReconnectAccountID(metadata map[string]any) string {
+	accountID, _ := metadata["account_id"].(string)
+	accountID = strings.TrimSpace(accountID)
+	if token, _ := metadata["id_token"].(string); token != "" {
+		if claims, errParse := codex.ParseJWTToken(token); errParse == nil && claims != nil {
+			claimID := strings.TrimSpace(claims.GetAccountID())
+			if claimID != "" {
+				if accountID != "" && accountID != claimID {
+					return ""
+				}
+				accountID = claimID
+			}
+		}
+	}
+	return accountID
+}
+
+func readCodexReconnectFile(path string) (map[string]any, []byte, error) {
+	info, errStat := os.Lstat(path)
+	if errStat != nil || !info.Mode().IsRegular() {
+		return nil, nil, errCodexReconnectChanged
+	}
+	raw, errRead := os.ReadFile(path)
+	if errRead != nil {
+		return nil, nil, errCodexReconnectChanged
+	}
+	var metadata map[string]any
+	if json.Unmarshal(raw, &metadata) != nil || metadata["type"] != "codex" {
+		return nil, nil, errCodexReconnectChanged
+	}
+	return metadata, raw, nil
+}
+
+func (h *Handler) saveCodexReconnect(ctx context.Context, state string, target *codexReconnectTarget, record *coreauth.Auth) (string, error) {
+	h.authStatusMu.Lock()
+	defer h.authStatusMu.Unlock()
+	if errGuard := guardOAuthSessionPendingForSave(state, "codex"); errGuard != nil {
+		return "", errGuard
+	}
+	current, ok := h.lookupAuthFile(target.name, target.index)
+	if !ok || current.ID != target.id || current.RegistrationEpoch != target.registrationEpoch || current.Provider != "codex" {
+		return "", errCodexReconnectChanged
+	}
+	metadata, raw, errRead := readCodexReconnectFile(target.path)
+	if errRead != nil {
+		return "", errRead
+	}
+	if codexReconnectAccountID(metadata) != target.accountID {
+		return "", errCodexReconnectChanged
+	}
+	storage, okStorage := record.Storage.(*codex.CodexTokenStorage)
+	if !okStorage || strings.TrimSpace(storage.AccountID) != target.accountID {
+		return "", errCodexReconnectAccount
+	}
+	if codexReconnectAccountID(map[string]any{"account_id": storage.AccountID, "id_token": storage.IDToken}) != target.accountID {
+		return "", errCodexReconnectAccount
+	}
+	// Keep the path-derived index, even when email or subscription plan changes.
+	record.ID, record.FileName, record.Index = target.id, target.name, target.index
+	record.CreatedAt = current.CreatedAt
+	if record.Attributes == nil {
+		record.Attributes = make(map[string]string)
+	}
+	record.Attributes[coreauth.AttributePath] = target.path
+	coreauth.MergeExistingAuthMetadata(record, metadata)
+	record.Storage = &atomicCodexReconnectStorage{storage, target.path, sha256.Sum256(raw), state}
+	return h.saveTokenRecord(ctx, record)
+}
+
+// Write to a private temporary file first: a failed write must not truncate the old tokens.
+type atomicCodexReconnectStorage struct {
+	*codex.CodexTokenStorage
+	path     string
+	expected [32]byte
+	state    string
+}
+
+func (s *atomicCodexReconnectStorage) SaveTokenToFile(path string) error {
+	absolute, errPath := filepath.Abs(path)
+	if errPath != nil || absolute != s.path {
+		return errCodexReconnectChanged
+	}
+	s.Type = "codex"
+	data, errMerge := misc.MergeMetadata(s.CodexTokenStorage, s.Metadata)
+	if errMerge != nil {
+		return fmt.Errorf("prepare reconnect credentials: %w", errMerge)
+	}
+	file, errCreate := os.CreateTemp(filepath.Dir(path), ".codex-reconnect-*")
+	if errCreate != nil {
+		return fmt.Errorf("create reconnect temporary file: %w", errCreate)
+	}
+	temporary := file.Name()
+	defer func() { _ = file.Close(); _ = os.Remove(temporary) }()
+	if errEncode := json.NewEncoder(file).Encode(data); errEncode != nil {
+		return fmt.Errorf("write reconnect credentials: %w", errEncode)
+	}
+	if errSync := file.Sync(); errSync != nil {
+		return fmt.Errorf("sync reconnect credentials: %w", errSync)
+	}
+	if errClose := file.Close(); errClose != nil {
+		return fmt.Errorf("close reconnect credentials: %w", errClose)
+	}
+	_, raw, errRead := readCodexReconnectFile(path)
+	if errRead != nil || sha256.Sum256(raw) != s.expected {
+		return errCodexReconnectChanged
+	}
+	return persistCodexReconnectSession(s.state, func() error {
+		if errRename := os.Rename(temporary, path); errRename != nil {
+			return fmt.Errorf("replace reconnect credentials: %w", errRename)
+		}
+		return nil
+	})
+}
+
+// Serialize cancellation with the final replacement. Once persisted, cancellation
+// must not claim success while the runtime synchronization hook is still running.
+func persistCodexReconnectSession(state string, persist func() error) error {
+	oauthSessions.mu.Lock()
+	defer oauthSessions.mu.Unlock()
+	oauthSessions.purgeExpiredLocked(time.Now())
+	session, ok := oauthSessions.sessions[state]
+	if !ok || session.Provider != "codex" || session.Completed || session.Persisted || session.Status != "" {
+		return errOAuthSessionNotPending
+	}
+	if errPersist := persist(); errPersist != nil {
+		return errPersist
+	}
+	session.Persisted = true
+	oauthSessions.sessions[state] = session
+	return nil
+}
