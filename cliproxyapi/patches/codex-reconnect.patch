+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/auth/codex"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	sdkAuth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func reconnectFixture(t *testing.T) (*Handler, *codexReconnectTarget, *coreauth.Auth, []byte, string) {
+	t.Helper()
+	dir := t.TempDir()
+	name := "codex-original-pro.json"
+	path := filepath.Join(dir, name)
+	raw := []byte(`{"type":"codex","account_id":"account-original","access_token":"old-test-token","refresh_token":"old-test-refresh","disabled":true,"websockets":true,"prefix":"team","note":"keep this","priority":2,"weight":3}`)
+	if errWrite := os.WriteFile(path, raw, 0o600); errWrite != nil {
+		t.Fatal(errWrite)
+	}
+	var metadata map[string]any
+	if errDecode := json.Unmarshal(raw, &metadata); errDecode != nil {
+		t.Fatal(errDecode)
+	}
+	manager := coreauth.NewManager(nil, nil, nil)
+	existing := &coreauth.Auth{ID: name, FileName: name, Provider: "codex", Metadata: metadata,
+		Attributes: map[string]string{coreauth.AttributePath: path}, Disabled: true, Success: 120, Failed: 3, CreatedAt: time.Unix(100, 0).UTC()}
+	registered, errRegister := manager.Register(context.Background(), existing)
+	if errRegister != nil {
+		t.Fatal(errRegister)
+	}
+	h := NewHandler(&config.Config{AuthDir: dir}, "", manager)
+	h.tokenStore = sdkAuth.NewFileTokenStore()
+	target := &codexReconnectTarget{registered.ID, name, registered.EnsureIndex(), path, "account-original", registered.RegistrationEpoch}
+	record := &coreauth.Auth{ID: "different-plan.json", FileName: "different-plan.json", Provider: "codex",
+		Storage:  &codex.CodexTokenStorage{AccountID: "account-original", AccessToken: "new-test-token", RefreshToken: "new-test-refresh", Email: "new-label@example.test", PlanType: "plus"},
+		Metadata: map[string]any{"account_id": "account-original", "plan_type": "plus"}}
+	state := "test-reconnect-state"
+	RegisterOAuthSession(state, "codex")
+	t.Cleanup(func() { CompleteOAuthSession(state) })
+	return h, target, record, raw, state
+}
+
+func TestCodexReconnectPreservesTrackingIdentityAndSettings(t *testing.T) {
+	h, target, record, _, state := reconnectFixture(t)
+	hookCalled := false
+	h.SetPostAuthPersistHook(func(_ context.Context, saved *coreauth.Auth) error {
+		hookCalled = true
+		if saved.EnsureIndex() != target.index {
+			t.Errorf("tracking identity changed")
+		}
+		if !saved.Disabled {
+			t.Errorf("disabled status changed")
+		}
+		if !saved.CreatedAt.Equal(time.Unix(100, 0)) {
+			t.Errorf("creation time changed")
+		}
+		_, errUpdate := h.authManager.Update(context.Background(), saved)
+		return errUpdate
+	})
+	path, errSave := h.saveCodexReconnect(context.Background(), state, target, record)
+	if errSave != nil {
+		t.Fatal(errSave)
+	}
+	if path != target.path || record.ID != target.id || !hookCalled {
+		t.Fatal("existing record was not updated in place")
+	}
+	metadata, _, errRead := readCodexReconnectFile(path)
+	if errRead != nil {
+		t.Fatal(errRead)
+	}
+	for key, want := range map[string]any{"access_token": "new-test-token", "refresh_token": "new-test-refresh", "account_id": "account-original", "plan_type": "plus", "prefix": "team", "note": "keep this", "websockets": true, "disabled": true, "priority": float64(2), "weight": float64(3)} {
+		if !reflect.DeepEqual(metadata[key], want) {
+			t.Errorf("%s was not preserved/updated correctly", key)
+		}
+	}
+	entries, errList := os.ReadDir(filepath.Dir(path))
+	if errList != nil || len(entries) != 1 {
+		t.Fatal("reconnect created an extra file or left temporary credentials")
+	}
+	if CancelOAuthSession(state) {
+		t.Fatal("cancel reported success after credentials were persisted")
+	}
+	updated, ok := h.authManager.GetByID(target.id)
+	if !ok || updated.Success != 120 || updated.Failed != 3 {
+		t.Fatal("runtime counters were reset")
+	}
+}
+
+func TestCodexReconnectRejectsUnsafeReplacement(t *testing.T) {
+	for _, scenario := range []string{"wrong-account", "missing-account", "cancelled", "removed", "metadata-change", "save-failure", "changed-during-save"} {
+		t.Run(scenario, func(t *testing.T) {
+			h, target, record, raw, state := reconnectFixture(t)
+			want := raw
+			switch scenario {
+			case "wrong-account":
+				record.Storage.(*codex.CodexTokenStorage).AccountID = "another-account"
+			case "missing-account":
+				record.Storage.(*codex.CodexTokenStorage).AccountID = ""
+			case "cancelled":
+				CancelOAuthSession(state)
+			case "removed":
+				if errRemove := os.Remove(target.path); errRemove != nil {
+					t.Fatal(errRemove)
+				}
+			case "metadata-change":
+				want = []byte(`{"type":"codex","account_id":"another-account"}`)
+				if errWrite := os.WriteFile(target.path, want, 0o600); errWrite != nil {
+					t.Fatal(errWrite)
+				}
+			case "save-failure":
+				h.SetPostAuthHook(func(context.Context, *coreauth.Auth) error { return errors.New("test failure before persistence") })
+			case "changed-during-save":
+				want = []byte(`{"type":"codex","account_id":"account-original","access_token":"concurrent-token"}`)
+				h.SetPostAuthHook(func(context.Context, *coreauth.Auth) error { return os.WriteFile(target.path, want, 0o600) })
+			}
+			if _, errSave := h.saveCodexReconnect(context.Background(), state, target, record); errSave == nil {
+				t.Fatal("unsafe reconnect succeeded")
+			}
+			got, errRead := os.ReadFile(target.path)
+			if scenario == "removed" {
+				if !os.IsNotExist(errRead) {
+					t.Fatal("deleted credential was recreated")
+				}
+				return
+			}
+			if errRead != nil || string(got) != string(want) {
+				t.Fatal("failed reconnect changed existing credentials")
+			}
+		})
+	}
+}
+
+func TestCodexReconnectRequiresExistingMatchingTarget(t *testing.T) {
+	h, target, _, _, _ := reconnectFixture(t)
+	router := gin.New()
+	router.GET("/reconnect", h.ReconnectCodexAuthFile)
+	for _, query := range []string{"", "?name=" + target.name, "?name=" + target.name + "&auth_index=wrong", "?name=../outside.json&auth_index=" + target.index} {
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/reconnect"+query, nil))
+		if w.Code == http.StatusOK {
+			t.Fatal("invalid reconnect target started an OAuth flow")
+		}
+	}
+}
+
+type reconnectTestOAuth struct{ fakeCodexOAuthService }
+
+func (f *reconnectTestOAuth) ExchangeCodeForTokens(ctx context.Context, code string, pkce *codex.PKCECodes) (*codex.CodexAuthBundle, error) {
+	bundle, errExchange := f.fakeCodexOAuthService.ExchangeCodeForTokens(ctx, code, pkce)
+	if errExchange != nil {
+		return nil, errExchange
+	}
+	bundle.TokenData.AccountID = "account-original"
+	bundle.TokenData.PlanType = "plus"
+	return bundle, nil
+}
+
+func TestCodexReconnectOAuthFlowUpdatesExistingFile(t *testing.T) {
+	h, target, _, _, _ := reconnectFixture(t)
+	previousFactory := newCodexOAuthService
+	newCodexOAuthService = func(*config.Config) codexOAuthService { return &reconnectTestOAuth{} }
+	t.Cleanup(func() { newCodexOAuthService = previousFactory })
+	persisted := make(chan *coreauth.Auth, 1)
+	h.SetPostAuthPersistHook(func(_ context.Context, auth *coreauth.Auth) error { persisted <- auth.Clone(); return nil })
+	router := gin.New()
+	router.GET("/reconnect", h.ReconnectCodexAuthFile)
+	query := url.Values{"name": {target.name}, "auth_index": {target.index}}
+	w := httptest.NewRecorder()
+	router.ServeHTTP(w, httptest.NewRequest(http.MethodGet, "/reconnect?"+query.Encode(), nil))
+	if w.Code != http.StatusOK {
+		t.Fatalf("start reconnect: status %d", w.Code)
+	}
+	var response struct {
+		State string `json:"state"`
+		URL   string `json:"url"`
+	}
+	if errDecode := json.Unmarshal(w.Body.Bytes(), &response); errDecode != nil || response.State == "" || response.URL == "" {
+		t.Fatal("missing OAuth session")
+	}
+	t.Cleanup(func() { CompleteOAuthSession(response.State) })
+	if _, errCallback := WriteOAuthCallbackFileForPendingSession(h.cfg.AuthDir, "codex", response.State, "reconnected", ""); errCallback != nil {
+		t.Fatal(errCallback)
+	}
+	select {
+	case saved := <-persisted:
+		if saved.EnsureIndex() != target.index || saved.FileName != target.name {
+			t.Fatal("OAuth flow changed tracking identity")
+		}
+		metadata, _, errRead := readCodexReconnectFile(target.path)
+		if errRead != nil || metadata["access_token"] != "access-reconnected" || metadata["plan_type"] != "plus" {
+			t.Fatal("fresh OAuth tokens were not saved in place")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("reconnect OAuth flow did not persist")
+	}
+}
+
+func TestCodexReconnectCancellationAtCommit(t *testing.T) {
+	state := "test-reconnect-cancel-commit"
+	RegisterOAuthSession(state, "codex")
+	defer CompleteOAuthSession(state)
+	if !CancelOAuthSession(state) {
+		t.Fatal("cancel failed")
+	}
+	called := false
+	if errPersist := persistCodexReconnectSession(state, func() error { called = true; return nil }); !errors.Is(errPersist, errOAuthSessionNotPending) || called {
+		t.Fatal("cancelled session committed")
+	}
+}
