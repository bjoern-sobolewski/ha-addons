@@ -0,0 +1,58 @@
+package helps
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	log "github.com/sirupsen/logrus"
+	logtest "github.com/sirupsen/logrus/hooks/test"
+)
+
+func TestCodexControlDiagnosticsAtFinalPayload(t *testing.T) {
+	previousHooks := log.StandardLogger().ReplaceHooks(make(log.LevelHooks))
+	hook := new(logtest.Hook)
+	log.AddHook(hook)
+	t.Cleanup(func() { log.StandardLogger().ReplaceHooks(previousHooks) })
+	request := []byte(`{"model":"secret-model","prompt_cache_options":{"ttl":"secret-value"},"max_completion_tokens":32,"context_management":[],"input":[{"type":"configuration_update","reasoning":{"effort":"secret-effort"}},{"role":"user","content":[{"text":"secret-prompt","prompt_cache_breakpoint":{"mode":"explicit"}}]},{"type":"function_call_output","output":[{"text":"secret-result","prompt_cache_breakpoint":{}}]}]}`)
+	finalize := NewPayloadFinalizer(nil, "codex", "secret-model", "codex", "", []byte(`{}`), cliproxyexecutor.Request{Payload: request}, cliproxyexecutor.Options{})
+	finalize([]byte(`{"max_output_tokens":32,"context_management":[]}`))
+	entries := hook.AllEntries()
+	if len(entries) != 1 {
+		t.Fatalf("diagnostic entries = %d, want one", len(entries))
+	}
+	encoded, err := json.Marshal(entries[0].Data)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(encoded) != `{"action":"omitted","controls":["configuration_update","prompt_cache_breakpoint","prompt_cache_options"],"reason":"compatibility_or_payload_rule"}` {
+		t.Fatalf("unexpected diagnostic fields: %s", encoded)
+	}
+	if strings.Contains(string(encoded)+entries[0].Message, "secret") {
+		t.Fatal("diagnostic leaked request contents")
+	}
+	formatted, err := (&logging.LogFormatter{}).Format(entries[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(formatted), "configuration_update,prompt_cache_breakpoint,prompt_cache_options") || strings.Contains(string(formatted), "secret") {
+		t.Fatalf("formatted diagnostic missing safe field names or leaked contents: %s", formatted)
+	}
+	hook.Reset()
+	// Operator rules are the final barrier: a restored control is not omitted.
+	cfg := &config.Config{Payload: config.PayloadConfig{Override: []config.PayloadRule{{Models: []config.PayloadModelRule{{Name: "*", Protocol: "codex"}}, Params: map[string]any{"prompt_cache_options.ttl": "30m"}}}}}
+	finalize = NewPayloadFinalizer(cfg, "codex", "test", "codex", "", nil, cliproxyexecutor.Request{Payload: []byte(`{"prompt_cache_options":{"ttl":"30m"}}`)}, cliproxyexecutor.Options{})
+	finalize([]byte(`{}`))
+	if len(hook.AllEntries()) != 0 {
+		t.Fatal("restored control reported as omitted")
+	}
+	// Other providers must not receive Codex compatibility diagnostics.
+	finalize = NewPayloadFinalizer(nil, "openai", "test", "openai", "", nil, cliproxyexecutor.Request{Payload: request}, cliproxyexecutor.Options{})
+	finalize([]byte(`{}`))
+	if len(hook.AllEntries()) != 0 {
+		t.Fatal("diagnostic emitted for another protocol")
+	}
+}
