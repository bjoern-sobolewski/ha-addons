@@ -0,0 +1,54 @@
+package responses
+
+import (
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexResponsesPreservesGenerationControls(t *testing.T) {
+	for _, test := range []struct {
+		name, fields, want string
+	}{
+		{"canonical", `"max_output_tokens":64`, `64`},
+		{"legacy", `"max_completion_tokens":32`, `32`},
+		{"canonical wins", `"max_output_tokens":64,"max_completion_tokens":32`, `64`},
+		{"null canonical", `"max_output_tokens":null,"max_completion_tokens":32`, `32`},
+		{"small ceiling is not raised", `"max_output_tokens":1`, `1`},
+		{"invalid canonical is not replaced", `"max_output_tokens":"invalid","max_completion_tokens":32`, `"invalid"`},
+		{"invalid legacy is not ignored", `"max_completion_tokens":-1`, `-1`},
+		{"fraction is not truncated", `"max_completion_tokens":16.5`, `16.5`},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			for _, stream := range []bool{false, true} {
+				body := []byte(`{"input":[],"context_management":[{"type":"compaction","compact_threshold":16384}],` + test.fields + `}`)
+				got, err := ConvertOpenAIResponsesRequestToCodex("gpt-6.1-sol", body, stream)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if value := gjson.GetBytes(got, "max_output_tokens").Raw; value != test.want {
+					t.Errorf("cap = %s, want %s", value, test.want)
+				}
+				if gjson.GetBytes(got, "max_completion_tokens").Exists() {
+					t.Error("legacy field must be consumed")
+				}
+				if value := gjson.GetBytes(got, "context_management").Raw; value != gjson.GetBytes(body, "context_management").Raw {
+					t.Error("automatic compaction configuration changed")
+				}
+			}
+		})
+	}
+}
+
+func TestCodexResponsesPreservesContinuationItemsAndToolControls(t *testing.T) {
+	body := []byte(`{"input":[{"type":"additional_tools","role":"developer","tools":[{"type":"function","name":"lookup","defer_loading":true}]},{"type":"configuration_update","reasoning":{"effort":"low"}},{"type":"reasoning","id":"rs_test","encrypted_content":"opaque","summary":[]},{"type":"message","role":"assistant","phase":"analysis","content":[{"type":"output_text","text":"working"}]},{"type":"compaction","encrypted_content":"opaque-compaction"},{"type":"compaction_trigger"},{"type":"function_call","call_id":"call_test","name":"lookup","arguments":"{}"},{"type":"function_call_output","call_id":"call_test","output":"synthetic"}],"tools":[{"type":"function","name":"lookup","defer_loading":true}],"tool_choice":{"type":"allowed_tools","mode":"auto","tools":[{"type":"function","name":"lookup"}]},"prompt_cache_key":"synthetic-session","context_management":[{"type":"compaction","compact_threshold":16384}]}`)
+	got, err := ConvertOpenAIResponsesRequestToCodex("gpt-6.1-sol", body, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"input", "tools", "tool_choice", "prompt_cache_key", "context_management"} {
+		if gjson.GetBytes(got, path).Raw != gjson.GetBytes(body, path).Raw {
+			t.Errorf("%s changed during translation", path)
+		}
+	}
+}
