diff --git a/internal/runtime/executor/helps/codex_controls.go b/internal/runtime/executor/helps/codex_controls.go
new file mode 100644
index 00000000..54e2575a
--- /dev/null
+++ b/internal/runtime/executor/helps/codex_controls.go
@@ -0,0 +1,67 @@
+package helps
+
+import (
+	"sort"
+	"strings"
+
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+// Capture only allowlisted field presence, never request contents. Diagnostics
+// run after operator payload rules, which may intentionally remove controls.
+func codexRequestControlCounts(body []byte) map[string]int {
+	counts := make(map[string]int)
+	for _, field := range []string{"prompt_cache_options", "prompt_cache_retention", "context_management", "max_output_tokens", "max_completion_tokens", "temperature", "top_p", "truncation"} {
+		if gjson.GetBytes(body, field).Exists() {
+			counts[field] = 1
+		}
+	}
+	gjson.GetBytes(body, "input").ForEach(func(_, item gjson.Result) bool {
+		if item.Get("type").String() == "configuration_update" {
+			counts["configuration_update"]++
+		}
+		if item.Get("prompt_cache_breakpoint").Exists() {
+			counts["prompt_cache_breakpoint"]++
+		}
+		for _, path := range []string{"content", "output"} {
+			parts := item.Get(path)
+			if !parts.IsArray() {
+				continue
+			}
+			parts.ForEach(func(_, part gjson.Result) bool {
+				if part.Get("prompt_cache_breakpoint").Exists() {
+					counts["prompt_cache_breakpoint"]++
+				}
+				return true
+			})
+		}
+		return true
+	})
+	return counts
+}
+
+func warnOmittedCodexControls(requested map[string]int, body []byte) {
+	if len(requested) == 0 {
+		return
+	}
+	forwarded := codexRequestControlCounts(body)
+	var omitted []string
+	for field, count := range requested {
+		if field == "max_completion_tokens" && forwarded["max_output_tokens"] > 0 {
+			continue // A canonical ceiling consumes the legacy alias.
+		}
+		if forwarded[field] < count {
+			omitted = append(omitted, field)
+		}
+	}
+	if len(omitted) == 0 {
+		return
+	}
+	sort.Strings(omitted)
+	log.WithFields(log.Fields{
+		"controls": omitted,
+		"action":   "omitted",
+		"reason":   "compatibility_or_payload_rule",
+	}).Warnf("codex request controls omitted: %s", strings.Join(omitted, ","))
+}
