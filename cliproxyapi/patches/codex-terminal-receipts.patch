diff --git a/sdk/cliproxy/executor/responses_failure_receipt.go b/sdk/cliproxy/executor/responses_failure_receipt.go
new file mode 100644
index 00000000..4783c06b
--- /dev/null
+++ b/sdk/cliproxy/executor/responses_failure_receipt.go
@@ -0,0 +1,13 @@
+package executor
+
+import "errors"
+
+// ResponsesFailureReceipt retrieves content-free accounting evidence from a failed generation.
+// It remains separate from Error() so normal error logging cannot include the receipt.
+func ResponsesFailureReceipt(err error) []byte {
+	var receipt interface{ ResponsesFailureReceipt() []byte }
+	if errors.As(err, &receipt) {
+		return receipt.ResponsesFailureReceipt()
+	}
+	return nil
+}
