--- /dev/null
+++ b/internal/runtime/executor/codex_duplex_failure_usage_test.go
@@ -0,0 +1,65 @@
+package executor
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	translator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexDuplexQueuedFailureUsageBelongsToQueuedSettings(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			t.Error(err)
+			return
+		}
+		defer conn.Close()
+		conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+		if _, _, err = conn.ReadMessage(); err != nil {
+			t.Error(err)
+			return
+		}
+		conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"running","output":[]}}`))
+		if _, _, err = conn.ReadMessage(); err != nil {
+			t.Error(err)
+			return
+		}
+		conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.failed","response":{"id":"queued","status":"failed","usage":{"input_tokens":40,"output_tokens":16},"error":{"type":"authentication_error","message":"synthetic"}}}`))
+		_, _, _ = conn.ReadMessage()
+	}))
+	defer server.Close()
+	alias := t.Name()
+	capture := &codexResponseModelUsageCapture{alias: alias, records: make(chan coreusage.Record, 4)}
+	coreusage.RegisterNamedPlugin(alias, capture)
+	t.Cleanup(func() { coreusage.RegisterNamedPlugin(alias, codexResponseModelNoopUsagePlugin{}) })
+	ctx, cancel := context.WithTimeout(coreusage.WithRequestedModelAlias(context.Background(), alias), 5*time.Second)
+	defer cancel()
+	input := make(chan core.WebsocketInput, 1)
+	ctx = core.WithWebsocketInput(core.WithDownstreamWebsocket(ctx), input)
+	executor := NewCodexWebsocketsExecutor(&config.Config{Codex: config.CodexConfig{ResponseSteering: true}})
+	executor.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+	auth := codexOAuthTestAuth(server.URL)
+	auth.Attributes["websockets"] = "true"
+	stream, err := executor.ExecuteStream(ctx, auth, core.Request{Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","reasoning":{"effort":"low"},"input":[]}`)}, core.Options{SourceFormat: translator.FormatCodex, Metadata: map[string]any{core.ExecutionSessionMetadataKey: alias}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for chunk := range stream.Chunks {
+		if gjson.GetBytes(chunk.Payload, "type").String() == "response.created" {
+			input <- core.WebsocketInput{Payload: []byte(`{"type":"response.create","model":"gpt-5.5","reasoning":{"effort":"high"},"input":[]}`)}
+		}
+	}
+	record := capture.await(t)
+	if !record.Failed || record.Detail.InputTokens != 40 || record.Detail.OutputTokens != 16 || record.ReasoningEffort != "high" {
+		t.Fatalf("failure attributed to wrong turn: %+v", record)
+	}
+}
