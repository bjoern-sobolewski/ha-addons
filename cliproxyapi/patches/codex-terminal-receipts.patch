--- /dev/null
+++ b/sdk/api/handlers/openai/openai_responses_failure_receipt.go
@@ -0,0 +1,60 @@
+package openai
+
+import (
+	"net/http"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/api/handlers"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// responsesFailureBody exposes only the executor's accounting receipt and a fixed public error.
+// The original error stays attached for health classification, but never enters this envelope.
+func responsesFailureBody(errMsg *interfaces.ErrorMessage) []byte {
+	if errMsg == nil {
+		return nil
+	}
+	receipt := coreexecutor.ResponsesFailureReceipt(errMsg.Error)
+	if len(receipt) == 0 {
+		return nil
+	}
+	body := handlers.BuildErrorResponseBody(errMsg.StatusCode, "Upstream response failed")
+	body, _ = sjson.SetBytes(body, "error.code", "upstream_response_failed")
+	body, _ = sjson.SetBytes(body, "error.retryable", false)
+	body, _ = sjson.SetRawBytes(body, "response", receipt)
+	return body
+}
+
+func responsesFailureEvent(errMsg *interfaces.ErrorMessage, sequence int) []byte {
+	body := responsesFailureBody(errMsg)
+	if len(body) == 0 {
+		return nil
+	}
+	response := []byte(gjson.GetBytes(body, "response").Raw)
+	response, _ = sjson.SetRawBytes(response, "error", []byte(gjson.GetBytes(body, "error").Raw))
+	event := []byte(`{"type":"response.failed"}`)
+	event, _ = sjson.SetRawBytes(event, "response", response)
+	event, _ = sjson.SetBytes(event, "sequence_number", sequence)
+	return event
+}
+
+func responsesFailureHTTPMessage(errMsg *interfaces.ErrorMessage) *interfaces.ErrorMessage {
+	body := responsesFailureBody(errMsg)
+	if len(body) == 0 {
+		return errMsg
+	}
+	safe := *errMsg
+	safe.DirectResponse = true
+	safe.Body = body
+	safe.Headers = http.Header{"Content-Type": {"application/json"}}
+	return &safe
+}
+
+func closeResponsesUpstreamErrorWithoutReceipt(writer *responsesWebsocketWriter, errMsg *interfaces.ErrorMessage) (bool, error) {
+	if len(responsesFailureBody(errMsg)) > 0 {
+		return false, nil
+	}
+	return writer.closeForUpstreamError(errMsg.Error)
+}
