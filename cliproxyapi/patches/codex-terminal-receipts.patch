+
+type syntheticReceiptError struct{}
+
+func (syntheticReceiptError) Error() string { return "PRIVATE_SENTINEL" }
+func (syntheticReceiptError) ResponsesFailureReceipt() []byte {
+	return []byte(`{"id":"r1","status":"failed","usage":{"input_tokens":40,"output_tokens":16}}`)
+}
+
+func TestResponsesFailureReceiptSurvivesSanitization(t *testing.T) {
+	message := &interfaces.ErrorMessage{StatusCode: 502, Error: fmt.Errorf("wrapped: %w", syntheticReceiptError{})}
+	for _, message := range []*interfaces.ErrorMessage{message, sanitizeResponsesStreamErrorMessage(message)} {
+		body := responsesFailureHTTPMessage(message).Body
+		event := responsesFailureEvent(message, 7)
+		for _, payload := range [][]byte{body, event} {
+			if strings.Contains(string(payload), "PRIVATE_SENTINEL") {
+				t.Fatal("private error leaked")
+			}
+			if gjson.GetBytes(payload, "response.usage.input_tokens").Int() != 40 || gjson.GetBytes(payload, "response.usage.output_tokens").Int() != 16 {
+				t.Fatalf("receipt lost: %s", payload)
+			}
+		}
+		if gjson.GetBytes(event, "type").String() != "response.failed" {
+			t.Fatal("failure misclassified")
+		}
+	}
+	sanitized := sanitizeResponsesStreamErrorMessage(message)
+	if strings.Contains(sanitized.Error.Error(), "input_tokens") || strings.Contains(sanitized.Error.Error(), "r1") {
+		t.Fatal("receipt entered loggable Error() text")
+	}
+}
+
+func TestResponsesFailureReceiptDoesNotRequestPinnedReplay(t *testing.T) {
+	for _, status := range []int{401, 429} {
+		message := &interfaces.ErrorMessage{StatusCode: status, Error: fmt.Errorf("wrapped: %w", syntheticReceiptError{})}
+		if shouldReplayResponsesWebsocketPinnedAuthFailure(message) {
+			t.Fatal("definitive failed generation requested pinned replay")
+		}
+		if !shouldReplayResponsesWebsocketPinnedAuthFailure(&interfaces.ErrorMessage{StatusCode: status}) {
+			t.Fatal("admission recovery changed")
+		}
+	}
+}
+
+func TestResponsesCancelledSSEEndsWithoutEOFError(t *testing.T) {
+	framer := &responsesSSEFramer{}
+	var output bytes.Buffer
+	framer.WriteChunk(&output, []byte("data: {\"type\":\"response.cancelled\",\"response\":{\"id\":\"r1\",\"status\":\"cancelled\",\"output\":[],\"usage\":{\"input_tokens\":40}}}\n\n"))
+	framer.Flush(&output)
+	if framer.terminalEvent != "response.cancelled" || framer.terminalError != nil {
+		t.Fatalf("cancellation not terminal: %+v", framer)
+	}
+}
