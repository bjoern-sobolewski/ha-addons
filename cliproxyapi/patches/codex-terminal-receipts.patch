@@ -0,0 +1,101 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	coreusage "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	translator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexFailedTerminalRetainsAccounting(t *testing.T) {
+	for _, transport := range []string{"http-json", "http-sse", "ws-json", "ws-sse", "duplex"} {
+		t.Run(transport, func(t *testing.T) {
+			payload := `{"type":"response.failed","response":{"id":"r1","status":"failed","error":{"code":"server_error","message":"synthetic failure"},"usage":{"input_tokens":40,"output_tokens":16,"input_tokens_details":{"cached_tokens":8}}}}`
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if websocket.IsWebSocketUpgrade(r) {
+					conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					defer conn.Close()
+					if _, _, err = conn.ReadMessage(); err != nil {
+						t.Error(err)
+						return
+					}
+					if transport == "ws-sse" {
+						conn.WriteMessage(websocket.TextMessage, []byte(`{"type":"response.created","response":{"id":"r1","output":[]}}`))
+					}
+					if err = conn.WriteMessage(websocket.TextMessage, []byte(payload)); err != nil {
+						t.Error(err)
+					}
+					_, _, _ = conn.ReadMessage()
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				fmt.Fprintf(w, "data: %s\n\n", payload)
+			}))
+			defer server.Close()
+			alias := t.Name()
+			capture := &codexResponseModelUsageCapture{alias: alias, records: make(chan coreusage.Record, 4)}
+			coreusage.RegisterNamedPlugin(alias, capture)
+			t.Cleanup(func() { coreusage.RegisterNamedPlugin(alias, codexResponseModelNoopUsagePlugin{}) })
+			ctx, cancel := context.WithCancel(coreusage.WithRequestedModelAlias(context.Background(), alias))
+			defer cancel()
+			cfg := &config.Config{}
+			if transport == "duplex" {
+				cfg.Codex.ResponseSteering = true
+				ctx = core.WithWebsocketInput(core.WithDownstreamWebsocket(ctx), make(chan core.WebsocketInput))
+			}
+			auth := codexOAuthTestAuth(server.URL)
+			wsExecutor := NewCodexWebsocketsExecutor(cfg)
+			wsExecutor.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+			auth.Attributes["websockets"] = "true"
+			req := core.Request{Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","input":"synthetic"}`)}
+			opts := core.Options{SourceFormat: translator.FormatOpenAIResponse, Metadata: map[string]any{core.ExecutionSessionMetadataKey: alias}}
+			var terminalErr error
+			switch transport {
+			case "http-json":
+				_, terminalErr = NewCodexExecutor(cfg).Execute(ctx, auth, req, opts)
+			case "ws-json":
+				_, terminalErr = wsExecutor.Execute(ctx, auth, req, opts)
+			default:
+				var stream *core.StreamResult
+				if transport == "http-sse" {
+					stream, terminalErr = NewCodexExecutor(cfg).ExecuteStream(ctx, auth, req, opts)
+				} else {
+					stream, terminalErr = wsExecutor.ExecuteStream(ctx, auth, req, opts)
+				}
+				if terminalErr == nil {
+					for chunk := range stream.Chunks {
+						if chunk.Err != nil {
+							terminalErr = chunk.Err
+						}
+					}
+				}
+			}
+			if transport == "ws-sse" {
+				select {
+				case <-wsExecutor.UpstreamDisconnectChan(alias):
+					t.Fatal("out-of-band close raced with the failure receipt")
+				default:
+				}
+			}
+			if terminalErr == nil || gjson.GetBytes(core.ResponsesFailureReceipt(terminalErr), "usage.output_tokens").Int() != 16 {
+				t.Fatalf("receipt lost: %v", terminalErr)
+			}
+			record := capture.await(t)
+			if !record.Failed || record.Detail.InputTokens != 40 || record.Detail.OutputTokens != 16 || record.Detail.CachedTokens != 8 {
+				t.Fatalf("failure accounting lost: %+v", record)
+			}
+		})
+	}
+}
