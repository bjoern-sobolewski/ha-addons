diff --git a/sdk/cliproxy/auth/conductor_receipt_stop_test.go b/sdk/cliproxy/auth/conductor_receipt_stop_test.go
new file mode 100644
index 00000000..accb695d
--- /dev/null
+++ b/sdk/cliproxy/auth/conductor_receipt_stop_test.go
@@ -0,0 +1,86 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	"testing"
+	"time"
+
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+type receiptStopFailure struct{ status int }
+
+func (e receiptStopFailure) Error() string       { return "failed generation" }
+func (e receiptStopFailure) StatusCode() int     { return e.status }
+func (e receiptStopFailure) IsRequestStop() bool { return true }
+func (e receiptStopFailure) ResponsesFailureReceipt() []byte {
+	return []byte(`{"id":"r1","status":"failed","usage":{"input_tokens":40,"output_tokens":16}}`)
+}
+
+type receiptStopExecutor struct {
+	*unauthorizedRefreshExecutor
+	status    int
+	bootstrap bool
+}
+
+func (e *receiptStopExecutor) Execute(ctx context.Context, auth *Auth, req core.Request, opts core.Options) (core.Response, error) {
+	e.unauthorizedRefreshExecutor.Execute(ctx, auth, req, opts)
+	return core.Response{}, receiptStopFailure{status: e.status}
+}
+func (e *receiptStopExecutor) ExecuteStream(ctx context.Context, auth *Auth, req core.Request, opts core.Options) (*core.StreamResult, error) {
+	e.unauthorizedRefreshExecutor.ExecuteStream(ctx, auth, req, opts)
+	err := receiptStopFailure{status: e.status}
+	if !e.bootstrap {
+		return nil, err
+	}
+	chunks := make(chan core.StreamChunk, 1)
+	chunks <- core.StreamChunk{Err: err}
+	close(chunks)
+	return &core.StreamResult{Chunks: chunks}, nil
+}
+
+func TestManagerReceiptStopsRefreshAndRedispatch(t *testing.T) {
+	for _, status := range []int{401, 429, 502} {
+		for _, mode := range []string{"json", "stream", "bootstrap"} {
+			t.Run(fmt.Sprintf("%d/%s", status, mode), func(t *testing.T) {
+				manager, original, primary, backup, model := newUnauthorizedRefreshFixture(t, false)
+				manager.SetRetryConfig(3, time.Second, 0)
+				manager.RegisterExecutor(&receiptStopExecutor{unauthorizedRefreshExecutor: original, status: status, bootstrap: mode == "bootstrap"})
+				ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+				defer cancel()
+				var err error
+				if mode == "json" {
+					_, err = manager.Execute(ctx, []string{"codex"}, core.Request{Model: model}, core.Options{})
+				} else {
+					_, err = manager.ExecuteStream(ctx, []string{"codex"}, core.Request{Model: model}, core.Options{})
+				}
+				if err == nil || len(core.ResponsesFailureReceipt(err)) == 0 {
+					t.Fatalf("failure receipt lost: %v", err)
+				}
+				if original.RefreshCalls() != 0 {
+					t.Fatal("receipt triggered refresh/redispatch")
+				}
+				calls := original.ExecuteCalls()
+				if mode != "json" {
+					calls = original.StreamCalls()
+				}
+				if len(calls) != 1 || calls[0] != primary.ID {
+					t.Fatalf("generation repeated: %v", calls)
+				}
+				failed, _ := manager.GetByID(primary.ID)
+				failure := failed.LastError
+				if state := failed.ModelStates[model]; state != nil && state.LastError != nil {
+					failure = state.LastError
+				}
+				if failure == nil || failure.HTTPStatus != status {
+					t.Fatalf("health classification lost: %+v", failed.ModelStates)
+				}
+				healthy, _ := manager.GetByID(backup.ID)
+				if healthy.LastError != nil || healthy.Unavailable {
+					t.Fatal("unrelated credential changed")
+				}
+			})
+		}
+	}
+}
