diff --git a/internal/runtime/executor/helps/codex_failure_receipt.go b/internal/runtime/executor/helps/codex_failure_receipt.go
new file mode 100644
index 00000000..11e96468
--- /dev/null
+++ b/internal/runtime/executor/helps/codex_failure_receipt.go
@@ -0,0 +1,65 @@
+package helps
+
+import (
+	"context"
+	"strings"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+// CodexFailureReceipt retains accounting evidence without copying request content or upstream errors.
+// Admission rejections without a response identity and usage keep their existing failover semantics.
+func CodexFailureReceipt(payload []byte) []byte {
+	if gjson.GetBytes(payload, "type").String() != "response.failed" ||
+		gjson.GetBytes(payload, "response.id").Type != gjson.String ||
+		strings.TrimSpace(gjson.GetBytes(payload, "response.id").String()) == "" ||
+		!gjson.GetBytes(payload, "response.usage").IsObject() {
+		return nil
+	}
+	receipt := []byte(`{"status":"failed","usage":{}}`)
+	receipt, _ = sjson.SetBytes(receipt, "id", gjson.GetBytes(payload, "response.id").String())
+	for _, path := range []string{
+		"input_tokens", "output_tokens", "total_tokens",
+		"input_tokens_details.cached_tokens", "input_tokens_details.cache_write_tokens",
+		"input_tokens_details.cache_write_tokens_details.ttl_30m_tokens",
+		"input_tokens_details.cache_write_tokens_details.ttl_12h_tokens",
+		"output_tokens_details.reasoning_tokens",
+	} {
+		value := gjson.GetBytes(payload, "response.usage."+path)
+		if value.Type == gjson.Number && value.Num >= 0 || value.Type == gjson.Null && value.Raw == "null" {
+			receipt, _ = sjson.SetRawBytes(receipt, "usage."+path, []byte(value.Raw))
+		}
+	}
+	for _, path := range []string{"input_tokens_details", "output_tokens_details", "input_tokens_details.cache_write_tokens_details"} {
+		value := gjson.GetBytes(payload, "response.usage."+path)
+		if value.Raw == "null" || value.IsObject() && len(value.Map()) == 0 {
+			receipt, _ = sjson.SetRawBytes(receipt, "usage."+path, []byte(value.Raw))
+		}
+	}
+	return receipt
+}
+
+// PublishCodexFailureUsage must run before a deferred or explicit empty failure publication.
+func PublishCodexFailureUsage(ctx context.Context, reporter *UsageReporter, payload []byte, err error) {
+	if detail, ok := ParseCodexUsage(payload); ok {
+		reporter.PublishFailureWithDetail(ctx, detail, err)
+	} else {
+		reporter.PublishFailure(ctx, err)
+	}
+}
+
+// CodexFailureEvent sanitizes a recoverable duplex receipt before downstream delivery.
+func CodexFailureEvent(payload []byte) []byte {
+	receipt := CodexFailureReceipt(payload)
+	if len(receipt) == 0 {
+		return payload
+	}
+	receipt, _ = sjson.SetRawBytes(receipt, "error", []byte(`{"message":"Upstream response failed","type":"server_error","code":"upstream_response_failed","retryable":false}`))
+	event := []byte(`{"type":"response.failed"}`)
+	event, _ = sjson.SetRawBytes(event, "response", receipt)
+	if sequence := gjson.GetBytes(payload, "sequence_number"); sequence.Type == gjson.Number {
+		event, _ = sjson.SetRawBytes(event, "sequence_number", []byte(sequence.Raw))
+	}
+	return event
+}
diff --git a/internal/runtime/executor/helps/codex_failure_receipt_test.go b/internal/runtime/executor/helps/codex_failure_receipt_test.go
new file mode 100644
index 00000000..3813c677
--- /dev/null
+++ b/internal/runtime/executor/helps/codex_failure_receipt_test.go
@@ -0,0 +1,54 @@
+package helps
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/tidwall/gjson"
+)
+
+func TestCodexCappedEmptyReceiptIsNotSilentAbort(t *testing.T) {
+	cap := []byte(`{"type":"response.incomplete","response":{"output":[],"incomplete_details":{"reason":"max_output_tokens"},"usage":{"output_tokens":0}}}`)
+	if IsCodexTerminalEmptyIncomplete(cap, 0, false) {
+		t.Fatal("explicit cap lost")
+	}
+	abort := []byte(`{"type":"response.incomplete","response":{"output":[],"usage":{"output_tokens":0}}}`)
+	if !IsCodexTerminalEmptyIncomplete(abort, 0, false) {
+		t.Fatal("silent abort safeguard lost")
+	}
+}
+
+func TestCodexFailureReceiptUsageAndPrivacy(t *testing.T) {
+	for _, usage := range []string{
+		`{"input_tokens":40,"output_tokens":16}`,
+		`{"input_tokens_details":null,"output_tokens_details":null}`,
+		`{"input_tokens_details":{},"output_tokens_details":{}}`,
+		`{"input_tokens_details":{"cache_write_tokens_details":null}}`,
+		`{"input_tokens_details":{"cache_write_tokens_details":{}}}`,
+		`{"input_tokens_details":{"cached_tokens":null},"output_tokens_details":{"reasoning_tokens":null}}`,
+		`{"input_tokens_details":{"cached_tokens":0},"output_tokens_details":{"reasoning_tokens":0}}`,
+		`{"input_tokens_details":{"cached_tokens":8,"cache_write_tokens":4,"cache_write_tokens_details":{"ttl_30m_tokens":4}},"output_tokens_details":{"reasoning_tokens":8}}`,
+	} {
+		payload := []byte(`{"type":"response.failed","response":{"id":"r1","error":{"message":"PRIVATE_SENTINEL"},"instructions":"PRIVATE_SENTINEL","output":[{"text":"PRIVATE_SENTINEL"}],"usage":` + usage + `}}`)
+		receipt := CodexFailureReceipt(payload)
+		if gjson.GetBytes(receipt, "usage").Raw != usage {
+			t.Fatalf("usage changed: %s", receipt)
+		}
+		if strings.Contains(string(receipt), "PRIVATE_SENTINEL") {
+			t.Fatal("content copied to receipt")
+		}
+		if strings.Contains(string(CodexFailureEvent(payload)), "PRIVATE_SENTINEL") {
+			t.Fatal("content copied to event")
+		}
+	}
+	if len(CodexFailureReceipt([]byte(`{"type":"response.failed","response":{"id":"r1","usage":null}}`))) != 0 {
+		t.Fatal("admission failure changed")
+	}
+	if len(CodexFailureReceipt([]byte(`{"type":"response.failed","response":{"id":{"private":"PRIVATE_SENTINEL"},"usage":{}}}`))) != 0 {
+		t.Fatal("malformed response identity copied")
+	}
+	malformed := []byte(`{"type":"response.failed","response":{"id":"r1","usage":{"input_tokens":"PRIVATE_SENTINEL","private":"PRIVATE_SENTINEL","output_tokens":16,"input_tokens_details":{"cached_tokens":-1,"private":"PRIVATE_SENTINEL"}}}}`)
+	if strings.Contains(string(CodexFailureReceipt(malformed)), "PRIVATE_SENTINEL") {
+		t.Fatal("untrusted usage copied")
+	}
+}
