@@ -0,0 +1,250 @@
+package live
+
+import (
+	"bytes"
+	"context"
+	"encoding/binary"
+	"io"
+	"mime/multipart"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func audioTestHandler(t *testing.T, executor *captureExecutor) *Handler {
+	t.Helper()
+	manager := auth.NewManager(nil, &apiKeyFirstSelector{}, nil)
+	manager.RegisterExecutor(executor)
+	registerCredential(t, manager, &auth.Auth{ID: "audio-key", Provider: "codex", Status: auth.StatusActive, Attributes: map[string]string{auth.AttributeAPIKey: "never-use"}})
+	registerCredential(t, manager, &auth.Auth{ID: "audio-oauth", Provider: "codex", Status: auth.StatusActive, Metadata: map[string]any{"access_token": "test-only-token", "account_id": "account-test"}})
+	handler := NewHandler(manager, nil)
+	t.Cleanup(handler.Close)
+	return handler
+}
+
+func recordingWAV(seconds int) []byte {
+	samples := seconds * 24000 * 2
+	result := make([]byte, 44+samples)
+	copy(result, "RIFF")
+	binary.LittleEndian.PutUint32(result[4:], uint32(len(result)-8))
+	copy(result[8:], "WAVEfmt ")
+	binary.LittleEndian.PutUint32(result[16:], 16)
+	binary.LittleEndian.PutUint16(result[20:], 1)
+	binary.LittleEndian.PutUint16(result[22:], 1)
+	binary.LittleEndian.PutUint32(result[24:], 24000)
+	binary.LittleEndian.PutUint32(result[28:], 48000)
+	binary.LittleEndian.PutUint16(result[32:], 2)
+	binary.LittleEndian.PutUint16(result[34:], 16)
+	copy(result[36:], "data")
+	binary.LittleEndian.PutUint32(result[40:], uint32(samples))
+	return result
+}
+
+func transcriptionRequest(audio []byte, filename string, fields map[string]string) *http.Request {
+	var body bytes.Buffer
+	writer := multipart.NewWriter(&body)
+	part, _ := writer.CreateFormFile("file", filename)
+	_, _ = part.Write(audio)
+	for name, value := range fields {
+		_ = writer.WriteField(name, value)
+	}
+	_ = writer.Close()
+	request := httptest.NewRequest("POST", "/v1/audio/transcriptions", &body)
+	request.Header.Set("Content-Type", writer.FormDataContentType())
+	return request
+}
+
+func TestAudioTranscriptionOAuthAndResponse(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, format := range []string{"json", "text"} {
+		t.Run(format, func(t *testing.T) {
+			upstream := &trackedResponseBody{Reader: strings.NewReader(`{"text":"known phrase","asset_pointer":"must-not-leak"}`)}
+			executor := &captureExecutor{responseBody: upstream, statusCode: 200}
+			handler := audioTestHandler(t, executor)
+			router := gin.New()
+			router.POST("/v1/audio/transcriptions", handler.HandleTranscription)
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, transcriptionRequest(recordingWAV(1), "prompt.wav", map[string]string{"language": "en", "model": "codex-transcribe", "response_format": format}))
+			if response.Code != 200 || !strings.Contains(response.Body.String(), "known phrase") || strings.Contains(response.Body.String(), "asset_pointer") {
+				t.Fatalf("unexpected response %d %s", response.Code, response.Body.String())
+			}
+			if executor.selectedAuth.ID != "audio-oauth" || executor.request.URL.String() != chatGPTAudioBaseURL+"/transcribe" {
+				t.Fatal("did not use native OAuth dictation")
+			}
+			if !upstream.closed.Load() || len(handler.audioSlots) != 0 {
+				t.Fatal("response or slot leaked")
+			}
+			reader := multipart.NewReader(bytes.NewReader(executor.body), strings.Split(executor.request.Header.Get("Content-Type"), "boundary=")[1])
+			part, err := reader.NextPart()
+			if err != nil || part.FormName() != "file" || part.Header.Get("Content-Type") != "audio/wav" {
+				t.Fatal("invalid upstream multipart")
+			}
+		})
+	}
+}
+
+func TestAudioTranscriptionRejectsInvalidUploads(t *testing.T) {
+	cases := []struct {
+		name    string
+		request func() *http.Request
+		status  int
+	}{
+		{"empty", func() *http.Request { return transcriptionRequest(nil, "a.wav", nil) }, 400},
+		{"unknown format", func() *http.Request { return transcriptionRequest([]byte("invalid audio"), "a.exe", nil) }, 415},
+		{"corrupt wav", func() *http.Request { return transcriptionRequest([]byte("RIFF0000WAVEbad"), "a.wav", nil) }, 400},
+		{"too long", func() *http.Request { return transcriptionRequest(recordingWAV(121), "a.wav", nil) }, 400},
+		{"oversize", func() *http.Request { return transcriptionRequest(make([]byte, maxAudioUpload), "a.wav", nil) }, 413},
+		{"model", func() *http.Request {
+			return transcriptionRequest(recordingWAV(1), "a.wav", map[string]string{"model": "text-model"})
+		}, 400},
+		{"options", func() *http.Request {
