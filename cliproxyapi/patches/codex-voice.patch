+)
+
+func TestLiveWebsocketInterruptionErrorsAndShutdown(t *testing.T) {
+	upstreamStopped := make(chan struct{})
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		connection, err := sidebandUpgrader.Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer connection.Close()
+		defer close(upstreamStopped)
+		if r.Header.Get("OpenAI-Alpha") != "quicksilver=v2" {
+			t.Error("native live handshake omitted required alpha header")
+		}
+		if r.URL.Path != "/v1/live" {
+			t.Error("native model used incorrect upstream route")
+		}
+		for {
+			kind, payload, err := connection.ReadMessage()
+			if err != nil {
+				return
+			}
+			if strings.Contains(string(payload), "response.cancel") {
+				payload = []byte(`{"type":"response.cancelled"}`)
+			}
+			if strings.Contains(string(payload), "invalid.event") {
+				payload = []byte(`{"type":"error","error":{"message":"private-provider-detail","token":"must-not-leak"}}`)
+			}
+			if err = connection.WriteMessage(kind, payload); err != nil {
+				return
+			}
+		}
+	}))
+	defer upstream.Close()
+	handler := audioTestHandler(t, &captureExecutor{})
+	handler.sidebandAPIBaseURL = "ws" + strings.TrimPrefix(upstream.URL, "http") + "/v1"
+	router := gin.New()
+	router.GET("/v1/realtime", handler.HandleDirectWebsocket)
+	proxy := httptest.NewServer(router)
+	defer proxy.Close()
+	connection, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(proxy.URL, "http")+"/v1/realtime?model=gpt-live-1-codex", nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer connection.Close()
+	_ = connection.SetReadDeadline(time.Now().Add(time.Second))
+	// Verify relay semantics only: this fixture's standard cancel event is not a claim
+	// that the native frameless upstream accepts the same interruption event.
+	for _, event := range []string{`{"type":"input_audio.append","audio":"AA=="}`, `{"type":"response.cancel"}`, `{"type":"invalid.event"}`} {
+		if err = connection.WriteMessage(websocket.TextMessage, []byte(event)); err != nil {
+			t.Fatal(err)
+		}
+		_, payload, readErr := connection.ReadMessage()
+		if readErr != nil {
+			t.Fatal(readErr)
+		}
+		if strings.Contains(string(payload), "private-provider-detail") || strings.Contains(string(payload), "must-not-leak") {
+			t.Fatal("provider error leaked")
+		}
+		var response map[string]any
+		if json.Unmarshal(payload, &response) != nil {
+			t.Fatal("invalid event")
+		}
+	}
+	handler.Close()
+	if _, _, err = connection.ReadMessage(); err == nil {
+		t.Fatal("shutdown left downstream connected")
+	}
+	select {
+	case <-upstreamStopped:
+	case <-time.After(time.Second):
+		t.Fatal("shutdown left upstream connected")
+	}
+	deadline := time.Now().Add(time.Second)
+	for len(handler.liveSlots) != 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if len(handler.liveSlots) != 0 {
+		t.Fatal("shutdown leaked live concurrency slot")
+	}
+}
+
+func TestAudioMissingOAuthFailsWithoutAPIKeyFallback(t *testing.T) {
+	manager := auth.NewManager(nil, nil, nil)
+	manager.RegisterExecutor(&captureExecutor{})
+	registerCredential(t, manager, &auth.Auth{ID: "api-only", Provider: "codex", Status: auth.StatusActive, Attributes: map[string]string{auth.AttributeAPIKey: "never-use"}})
+	handler := NewHandler(manager, nil)
+	defer handler.Close()
+	router := gin.New()
+	router.POST("/v1/audio/speech", handler.SpeechHandler(nil))
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest("POST", "/v1/audio/speech", strings.NewReader(`{"model":"codex-speech","input":"hello"}`)))
+	if response.Code != 503 || len(handler.audioSlots) != 0 {
+		t.Fatal("missing OAuth was not rejected cleanly")
+	}
+}
