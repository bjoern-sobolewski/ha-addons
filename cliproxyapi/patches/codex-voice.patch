+package middleware
+
+import (
+	"io"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+)
+
+func TestVoiceRoutesBypassEvenEnabledRequestBodyLogging(t *testing.T) {
+	for _, path := range []string{"/v1/audio/transcriptions", "/v1/audio/speech", "/v1/live", "/v1/realtime/calls"} {
+		t.Run(path, func(t *testing.T) {
+			logger := &spyRequestLogger{}
+			router := gin.New()
+			router.Use(RequestLoggingMiddleware(logger))
+			router.POST(path, func(c *gin.Context) { body, _ := io.ReadAll(c.Request.Body); c.Data(502, "text/plain", body) })
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, httptest.NewRequest("POST", path, strings.NewReader("private-audio-or-transcript")))
+			if logger.lastLogRequestID != "" || logger.lastStreamingRequestID != "" || logger.lastStreamWriter != nil {
+				t.Fatal("voice payload reached request logger")
+			}
+		})
+	}
+}
