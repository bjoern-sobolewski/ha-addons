+type cancellingAudioExecutor struct {
+	captureExecutor
+	closed atomic.Bool
+}
+
+func (e *cancellingAudioExecutor) HttpRequest(ctx context.Context, _ *auth.Auth, _ *http.Request) (*http.Response, error) {
+	<-ctx.Done()
+	e.closed.Store(true)
+	return nil, ctx.Err()
+}
+
+func TestAudioCancellationAndConcurrencyCleanup(t *testing.T) {
+	manager := auth.NewManager(nil, nil, nil)
+	executor := &cancellingAudioExecutor{}
+	manager.RegisterExecutor(executor)
+	registerCredential(t, manager, &auth.Auth{ID: "audio-oauth", Provider: "codex", Status: auth.StatusActive, Metadata: map[string]any{"access_token": "test"}})
+	handler := NewHandler(manager, nil)
+	defer handler.Close()
+	router := gin.New()
+	router.POST("/v1/audio/speech", handler.SpeechHandler(nil))
+	ctx, cancel := context.WithCancel(context.Background())
+	request := httptest.NewRequest("POST", "/v1/audio/speech", strings.NewReader(`{"model":"codex-speech","input":"hello"}`)).WithContext(ctx)
+	done := make(chan struct{})
+	go func() { router.ServeHTTP(httptest.NewRecorder(), request); close(done) }()
+	time.AfterFunc(20*time.Millisecond, cancel)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cancel did not stop upstream")
+	}
+	if !executor.closed.Load() || len(handler.audioSlots) != 0 {
+		t.Fatal("cancel leaked resources")
+	}
+	for i := 0; i < cap(handler.audioSlots); i++ {
+		handler.audioSlots <- struct{}{}
+	}
+	response := httptest.NewRecorder()
+	router.ServeHTTP(response, httptest.NewRequest("POST", "/v1/audio/speech", strings.NewReader(`{"model":"codex-speech","input":"hello"}`)))
+	if response.Code != 429 {
+		t.Fatal("concurrency not bounded")
+	}
+	for len(handler.audioSlots) > 0 {
+		<-handler.audioSlots
+	}
+}
+
+func TestClaimedLiveSessionStillExpires(t *testing.T) {
+	store := newSessionStore()
+	store.lifetime = 20 * time.Millisecond
+	media := &fakeMediaSession{}
+	stored := store.put("bounded-live", liveSession{media: media})
+	closed := make(chan struct{})
+	stored.resources.add(func() error { close(closed); return nil })
+	if _, claim := store.claim("bounded-live"); claim != sessionClaimAcquired {
+		t.Fatal("claim failed")
+	}
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("claimed session escaped lifetime bound")
+	}
+	deadline := time.Now().Add(time.Second)
+	for !media.closed.Load() && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if !media.closed.Load() {
+		t.Fatal("expired session retained media")
+	}
+}
