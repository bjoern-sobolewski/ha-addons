diff --git a/internal/client/codex/live/audio.go b/internal/client/codex/live/audio.go
new file mode 100644
index 00000000..4a0ace6b
--- /dev/null
+++ b/internal/client/codex/live/audio.go
@@ -0,0 +1,368 @@
+package live
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"mime"
+	"mime/multipart"
+	"net/http"
+	"net/textproto"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+	"unicode/utf8"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+const (
+	maxAudioUpload      = 16 << 20
+	maxAudioResponse    = 8 << 20
+	maxAudioSeconds     = 120
+	audioRequestTimeout = 60 * time.Second
+	chatGPTAudioBaseURL = "https://chatgpt.com/backend-api"
+)
+
+// SpeechHandler keeps existing provider routing unless Codex speech is explicitly requested.
+func (h *Handler) SpeechHandler(fallback gin.HandlerFunc) gin.HandlerFunc {
+	return func(c *gin.Context) {
+		controller := http.NewResponseController(c.Writer)
+		_ = controller.SetReadDeadline(time.Now().Add(15 * time.Second))
+		defer controller.SetReadDeadline(time.Time{})
+		body, err := io.ReadAll(http.MaxBytesReader(c.Writer, c.Request.Body, 1<<20))
+		if err != nil {
+			audioError(c, 413, "audio_request_too_large", "Speech request exceeds 1 MiB")
+			return
+		}
+		var payload struct {
+			Model        string   `json:"model"`
+			Input        string   `json:"input"`
+			Voice        string   `json:"voice"`
+			Format       string   `json:"response_format"`
+			Speed        *float64 `json:"speed"`
+			Instructions string   `json:"instructions"`
+		}
+		if json.Unmarshal(body, &payload) != nil || payload.Model != "codex-speech" {
+			c.Request.Body = io.NopCloser(bytes.NewReader(body))
+			fallback(c)
+			return
+		}
+		if strings.TrimSpace(payload.Input) == "" || utf8.RuneCountInString(payload.Input) > 4096 {
+			audioError(c, 400, "invalid_audio_input", "input must contain 1 to 4096 characters")
+			return
+		}
+		if (payload.Format != "" && payload.Format != "aac") || (payload.Voice != "" && payload.Voice != "default") || payload.Speed != nil || payload.Instructions != "" {
+			audioError(c, 400, "unsupported_speech_option", "Codex speech supports AAC, the default voice, and no speed or instruction overrides")
+			return
+		}
+		ctx, cancel, ok := h.beginAudio(c)
+		if !ok {
+			return
+		}
+		defer cancel()
+		requestBody, _ := json.Marshal(map[string]string{"text": payload.Input})
+		response, ok := h.audioRequest(c, ctx, "/read-aloud/synthesize", "application/json", requestBody)
+		if !ok {
+			return
+		}
+		// ChatGPT returns ADTS AAC. Never label a JSON/error page as playable audio.
+		if len(response) < 2 || response[0] != 0xff || response[1]&0xf6 != 0xf0 {
+			audioError(c, 502, "invalid_speech_response", "Speech upstream returned invalid AAC")
+			return
+		}
+		c.Data(200, "audio/aac", response)
+	}
+}
+
+func (h *Handler) HandleTranscription(c *gin.Context) {
+	ctx, cancel, ok := h.beginAudio(c)
+	if !ok {
+		return
+	}
+	defer cancel()
+	// A read deadline also bounds a client that stalls halfway through an upload.
+	controller := http.NewResponseController(c.Writer)
+	_ = controller.SetReadDeadline(time.Now().Add(15 * time.Second))
+	defer controller.SetReadDeadline(time.Time{})
+	reader, err := multipartReader(c)
+	if err != nil {
+		audioError(c, 400, "invalid_multipart", "Expected multipart/form-data with one file")
+		return
+	}
+	var audio []byte
+	filename, language, model, responseFormat := "", "", "", ""
+	seen := make(map[string]bool)
+	for {
+		part, readErr := reader.NextPart()
+		if errors.Is(readErr, io.EOF) {
+			break
+		}
+		if readErr != nil {
+			audioUploadError(c, readErr)
+			return
+		}
+		name := part.FormName()
+		if seen[name] {
+			audioError(c, 400, "invalid_multipart", "Duplicate multipart field")
+			return
+		}
+		seen[name] = true
+		if name == "file" {
+			filename = part.FileName()
+			audio, err = io.ReadAll(part)
+		} else {
+			value, fieldErr := io.ReadAll(io.LimitReader(part, 1025))
+			err = fieldErr
+			if len(value) > 1024 {
+				audioError(c, 400, "invalid_audio_option", "Multipart field exceeds 1024 bytes")
+				return
+			}
+			switch name {
+			case "language":
+				language = string(value)
+			case "model":
+				model = string(value)
+			case "response_format":
+				responseFormat = string(value)
+			default:
+				audioError(c, 400, "unsupported_audio_option", "Supported fields: file, model, language, response_format")
+				return
+			}
+		}
+		if err != nil {
+			audioUploadError(c, err)
+			return
+		}
+	}
+	if len(audio) == 0 || filename == "" {
+		audioError(c, 400, "empty_audio", "A nonempty audio file is required")
+		return
+	}
+	if (model != "" && model != "codex-transcribe") || (responseFormat != "" && responseFormat != "json" && responseFormat != "text") || !validAudioLanguage(language) {
+		audioError(c, 400, "unsupported_audio_option", "Use model codex-transcribe, json or text, and an optional ISO-639-1 language")
+		return
+	}
+	contentType := audioContentType(filename, audio)
+	if contentType == "" {
+		audioError(c, 415, "unsupported_audio_format", "Supported recordings: WAV, WebM/Opus, MP3, Ogg/Opus, FLAC, MP4/M4A")
+		return
+	}
+	if err = validateAudioDuration(ctx, audio); err != nil {
+		if errors.Is(err, exec.ErrNotFound) {
+			audioError(c, 503, "audio_decoder_unavailable", "Audio validation service unavailable")
+		} else {
+			audioError(c, 400, "invalid_audio", "Audio must be decodable, nonempty, and at most 120 seconds")
+		}
+		return
+	}
+	var body bytes.Buffer
+	writer := multipart.NewWriter(&body)
+	// A fixed filename avoids forwarding user-controlled paths or MIME headers.
+	partHeader := make(textproto.MIMEHeader)
+	partHeader.Set("Content-Disposition", `form-data; name="file"; filename="recording`+strings.ToLower(filepath.Ext(filename))+`"`)
+	partHeader.Set("Content-Type", contentType)
+	part, _ := writer.CreatePart(partHeader)
+	_, _ = part.Write(audio)
+	if language != "" {
+		_ = writer.WriteField("language", language)
+	}
+	_ = writer.Close()
+	response, ok := h.audioRequest(c, ctx, "/transcribe", writer.FormDataContentType(), body.Bytes())
+	if !ok {
+		return
+	}
+	var transcript struct {
+		Text *string `json:"text"`
+	}
+	if json.Unmarshal(response, &transcript) != nil || transcript.Text == nil {
+		audioError(c, 502, "invalid_transcription_response", "Dictation upstream returned an invalid transcript")
+		return
+	}
+	if responseFormat == "text" {
+		c.Data(200, "text/plain; charset=utf-8", []byte(*transcript.Text))
+	} else {
+		c.JSON(200, gin.H{"text": *transcript.Text})
+	}
+}
+
+func multipartReader(c *gin.Context) (*multipart.Reader, error) {
+	mediaType, params, err := mime.ParseMediaType(c.GetHeader("Content-Type"))
+	if err != nil || mediaType != "multipart/form-data" || params["boundary"] == "" {
+		return nil, errors.New("invalid multipart")
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, maxAudioUpload)
+	return multipart.NewReader(c.Request.Body, params["boundary"]), nil
+}
+
+func audioUploadError(c *gin.Context, err error) {
+	var tooLarge *http.MaxBytesError
+	if errors.As(err, &tooLarge) {
+		audioError(c, 413, "audio_upload_too_large", "Multipart upload exceeds 16 MiB")
+	} else {
+		audioError(c, 400, "invalid_multipart", "Audio upload was malformed or interrupted")
+	}
+}
+
+func validAudioLanguage(language string) bool {
+	return language == "" || len(language) == 2 && language[0] >= 'a' && language[0] <= 'z' && language[1] >= 'a' && language[1] <= 'z'
+}
+
+func audioContentType(filename string, audio []byte) string {
+	if len(audio) < 12 {
+		return ""
+	}
+	switch strings.ToLower(filepath.Ext(filename)) {
+	case ".wav":
+		if string(audio[:4]) == "RIFF" && string(audio[8:12]) == "WAVE" {
+			return "audio/wav"
+		}
+	case ".webm":
+		if bytes.Equal(audio[:4], []byte{0x1a, 0x45, 0xdf, 0xa3}) {
+			return "audio/webm"
+		}
+	case ".ogg":
+		if string(audio[:4]) == "OggS" {
+			return "audio/ogg"
+		}
+	case ".flac":
+		if string(audio[:4]) == "fLaC" {
+			return "audio/flac"
+		}
+	case ".mp3":
+		if string(audio[:3]) == "ID3" || audio[0] == 0xff && audio[1]&0xe0 == 0xe0 {
+			return "audio/mpeg"
+		}
+	case ".mp4", ".m4a":
+		if string(audio[4:8]) == "ftyp" {
+			return "audio/mp4"
+		}
+	}
+	return ""
+}
+
+func validateAudioDuration(ctx context.Context, audio []byte) error {
+	decodeCtx, cancel := context.WithTimeout(ctx, 15*time.Second)
+	defer cancel()
+	// No filesystem or network protocols: untrusted container references cannot fetch URLs.
+	command := exec.CommandContext(decodeCtx, "ffmpeg", "-nostdin", "-v", "error", "-protocol_whitelist", "pipe", "-i", "pipe:0", "-map", "0:a:0", "-vn", "-t", "121", "-ac", "1", "-ar", "24000", "-f", "s16le", "pipe:1")
+	command.Stdin = bytes.NewReader(audio)
+	var decoded bytes.Buffer
+	command.Stdout = &decoded
+	// Decoder diagnostics can contain untrusted media metadata; discard them.
+	if err := command.Run(); err != nil {
+		return err
+	}
+	if decoded.Len() < 4800 || decoded.Len() > maxAudioSeconds*24000*2 {
+		return errors.New("invalid audio duration")
+	}
+	return nil
+}
+
+func (h *Handler) beginAudio(c *gin.Context) (context.Context, context.CancelFunc, bool) {
+	c.Header("Cache-Control", "no-store")
+	if h == nil || h.authManager == nil {
+		audioError(c, 503, "audio_unavailable", "Codex audio unavailable")
+		return nil, nil, false
+	}
+	select {
+	case h.audioSlots <- struct{}{}:
+	default:
+		audioError(c, 429, "audio_concurrency_limit", "Audio concurrency limit reached; retry after the current request finishes")
+		return nil, nil, false
+	}
+	ctx, cancel := context.WithTimeout(c.Request.Context(), audioRequestTimeout)
+	stopShutdown := context.AfterFunc(h.voiceContext, cancel)
+	return ctx, func() { stopShutdown(); cancel(); <-h.audioSlots }, true
+}
+
+func (h *Handler) audioRequest(c *gin.Context, ctx context.Context, path, contentType string, body []byte) ([]byte, bool) {
+	ctx = context.WithValue(ctx, "gin", c)
+	selection, credential, err := h.selectOAuth(ctx, defaultLiveModel, coreexecutor.Options{Headers: liveSelectionHeaders(c)})
+	if selection != nil {
+		defer selection.End("audio_request_closed")
+		if err == nil {
+			var release func()
+			ctx, release, err = selection.AttemptContext(ctx)
+			if release != nil {
+				defer release()
+			}
+		}
+	}
+	if err != nil || credential == nil {
+		audioError(c, 503, "codex_audio_auth_unavailable", "No eligible Codex OAuth account is available")
+		return nil, false
+	}
+	headers := make(http.Header)
+	headers.Set("Content-Type", contentType)
+	headers.Set("Originator", "Codex Desktop")
+	setAccountHeader(headers, credential)
+	request, err := h.authManager.NewHttpRequest(ctx, credential, http.MethodPost, chatGPTAudioBaseURL+path, body, headers)
+	if err != nil {
+		audioError(c, 502, "audio_upstream_unavailable", "Unable to prepare Codex audio request")
+		return nil, false
+	}
+	response, err := h.authManager.HttpRequest(ctx, credential, request)
+	if err != nil {
+		audioTransportError(c, ctx)
+		return nil, false
+	}
+	defer response.Body.Close()
+	if response.StatusCode < 200 || response.StatusCode >= 300 {
+		status, code, message := 502, "audio_upstream_error", "Codex audio upstream rejected the request"
+		switch response.StatusCode {
+		case 401:
+			code = "audio_upstream_unauthorized"
+			message = "Codex OAuth requires refresh or sign-in"
+		case 403:
+			code = "audio_upstream_forbidden"
+			message = "Codex audio access is unavailable for the selected account"
+		case 404, 501:
+			status = 501
+			code = "audio_capability_not_supported"
+			message = "Audio capability is unavailable on the selected upstream"
+		case 429:
+			status = 429
+			code = "audio_upstream_rate_limited"
+			message = "Codex audio quota or rate limit reached"
+		}
+		if response.StatusCode == 401 && selection != nil {
+			h.authManager.ReportHomeUnauthorized(ctx, credential, "codex", defaultLiveModel, nil)
+		}
+		if selection == nil && response.StatusCode == 429 {
+			h.authManager.MarkResult(ctx, auth.Result{AuthID: credential.ID, Provider: "codex", Model: defaultLiveModel, Error: &auth.Error{HTTPStatus: 429, Message: "audio rate limit"}})
+		}
+		audioError(c, status, code, message)
+		return nil, false
+	}
+	result, err := io.ReadAll(io.LimitReader(response.Body, maxAudioResponse+1))
+	if err != nil {
+		audioTransportError(c, ctx)
+		return nil, false
+	}
+	if len(result) > maxAudioResponse {
+		audioError(c, 502, "audio_response_too_large", "Audio upstream response exceeds 8 MiB")
+		return nil, false
+	}
+	return result, true
+}
+
+func audioTransportError(c *gin.Context, ctx context.Context) {
+	if errors.Is(ctx.Err(), context.DeadlineExceeded) {
+		audioError(c, 504, "audio_timeout", "Codex audio request timed out")
+	} else if ctx.Err() != nil {
+		audioError(c, 408, "audio_cancelled", "Codex audio request cancelled")
+	} else {
+		audioError(c, 502, "audio_upstream_unavailable", "Codex audio transport unavailable")
+	}
+}
+
+func audioError(c *gin.Context, status int, code, message string) {
+	c.Header("Cache-Control", "no-store")
+	c.JSON(status, gin.H{"error": gin.H{"type": "audio_error", "code": code, "message": message}})
+}
