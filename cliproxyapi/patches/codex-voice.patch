+func TestAudioUpstreamFailuresSanitizedAndClosed(t *testing.T) {
+	for _, status := range []int{401, 403, 404, 429, 500, 200} {
+		t.Run(http.StatusText(status), func(t *testing.T) {
+			body := &trackedResponseBody{Reader: strings.NewReader(`{"secret":"sensitive-upstream-token"}`)}
+			executor := &captureExecutor{statusCode: status, responseBody: body}
+			handler := audioTestHandler(t, executor)
+			router := gin.New()
+			router.POST("/v1/audio/speech", handler.SpeechHandler(nil))
+			response := httptest.NewRecorder()
+			router.ServeHTTP(response, httptest.NewRequest("POST", "/v1/audio/speech", strings.NewReader(`{"model":"codex-speech","input":"hello"}`)))
+			if response.Code < 400 || strings.Contains(response.Body.String(), "sensitive-upstream-token") || !body.closed.Load() || len(handler.audioSlots) != 0 {
