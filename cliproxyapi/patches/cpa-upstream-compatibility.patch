diff --git a/internal/kvstore/backup_restore_test.go b/internal/kvstore/backup_restore_test.go
new file mode 100644
index 00000000..bf5ad5cb
--- /dev/null
+++ b/internal/kvstore/backup_restore_test.go
@@ -0,0 +1,54 @@
+package kvstore
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestBoltStoreStoppedBackupRestoresValuesAndExpiry(t *testing.T) {
+	ctx := context.Background()
+	now := time.Date(2026, 11, 15, 12, 0, 0, 0, time.UTC)
+	path := filepath.Join(t.TempDir(), "auth", "kv.db")
+	store, err := OpenBoltStore(path, WithNowFunc(func() time.Time { return now }), WithSweepInterval(0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close()
+	payload := []byte{0, 1, 255, 10}
+	if _, err := store.KVSet(ctx, "persistent", payload, KVSetOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := store.KVSet(ctx, "expiring", []byte("temporary"), KVSetOptions{EX: time.Minute}); err != nil {
+		t.Fatal(err)
+	}
+	if err := store.Close(); err != nil {
+		t.Fatal(err)
+	}
+	backup, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	restoredPath := filepath.Join(t.TempDir(), "kv.db")
+	if err := os.WriteFile(restoredPath, backup, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	restored, err := OpenBoltStore(restoredPath, WithNowFunc(func() time.Time { return now }), WithSweepInterval(0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer restored.Close()
+	if got, found, err := restored.KVGet(ctx, "persistent"); err != nil || !found || !bytes.Equal(got, payload) {
+		t.Fatalf("restored binary value = %v, %t, %v", got, found, err)
+	}
+	if got, found, err := restored.KVGet(ctx, "expiring"); err != nil || !found || string(got) != "temporary" {
+		t.Fatalf("restored unexpired value = %q, %t, %v", got, found, err)
+	}
+	now = now.Add(2 * time.Minute)
+	if _, found, err := restored.KVGet(ctx, "expiring"); err != nil || found {
+		t.Fatalf("restored expiry was extended: found=%t err=%v", found, err)
+	}
+}
