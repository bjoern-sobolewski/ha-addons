--- /dev/null
+++ b/src/utils/browserDateTime.ts
@@ -0,0 +1,41 @@
+// Display preferences follow the browser, independently of UI language.
+export function browserDateLocale(): string[] | undefined {
+  if (typeof navigator === 'undefined') return undefined;
+  return navigator.languages?.length
+    ? [...navigator.languages]
+    : navigator.language
+      ? [navigator.language]
+      : undefined;
+}
+export function browserTimeZone(): string {
+  return new Intl.DateTimeFormat().resolvedOptions().timeZone;
+}
+const formatters = new Map<string, Intl.DateTimeFormat>();
+export function browserDateTimeFormat(
+  options: Intl.DateTimeFormatOptions = {}
+): Intl.DateTimeFormat {
+  const locales = browserDateLocale();
+  const resolved = { ...options, timeZone: options.timeZone ?? browserTimeZone() };
+  const key = JSON.stringify([locales, resolved]);
+  let formatter = formatters.get(key);
+  if (!formatter) {
+    formatter = new Intl.DateTimeFormat(locales, resolved);
+    if (formatters.size >= 64) formatters.delete(formatters.keys().next().value!);
+    formatters.set(key, formatter);
+  }
+  return formatter;
+}
+export function formatBrowserDateTime(
+  value: string | number | Date,
+  options: Intl.DateTimeFormatOptions = {
+    year: 'numeric',
+    month: '2-digit',
+    day: '2-digit',
+    hour: '2-digit',
+    minute: '2-digit',
+    second: '2-digit',
+  }
+): string {
+  const date = value instanceof Date ? value : new Date(value);
+  return Number.isFinite(date.getTime()) ? browserDateTimeFormat(options).format(date) : '—';
+}
