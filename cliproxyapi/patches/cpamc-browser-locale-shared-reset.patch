@@ -0,0 +1,39 @@
+import { expect, spyOn, test } from 'bun:test';
+import { formatBrowserDateTime, browserDateTimeFormat } from '../src/utils/browserDateTime';
+const Native = Intl.DateTimeFormat;
+test('uses browser locale, hour cycle and time zone', () => {
+  const navigatorDescriptor = Object.getOwnPropertyDescriptor(globalThis, 'navigator');
+  using _format = spyOn(Intl, 'DateTimeFormat').mockImplementation(function (locale, options) {
+    return new Native(locale, { ...options, timeZone: options?.timeZone ?? 'Europe/Berlin' });
+  });
+  expect(_format).toBeDefined();
+  try {
+    for (const locale of ['de-DE', 'en-US', 'ar-EG']) {
+      Object.defineProperty(globalThis, 'navigator', {
+        configurable: true,
+        value: { languages: [locale] },
+      });
+      const value = '2026-12-31T23:30:00-08:00';
+      expect(formatBrowserDateTime(value)).toBe(
+        new Native(locale, {
+          year: 'numeric',
+          month: '2-digit',
+          day: '2-digit',
+          hour: '2-digit',
+          minute: '2-digit',
+          second: '2-digit',
+          timeZone: 'Europe/Berlin',
+        }).format(new Date(value))
+      );
+      expect(
+        browserDateTimeFormat({ hour: '2-digit', minute: '2-digit' }).resolvedOptions().hourCycle
+      ).toBe(
+        new Native(locale, { hour: '2-digit', minute: '2-digit' }).resolvedOptions().hourCycle
+      );
+    }
+  } finally {
+    if (navigatorDescriptor) Object.defineProperty(globalThis, 'navigator', navigatorDescriptor);
+    else Reflect.deleteProperty(globalThis, 'navigator');
+  }
+  expect(formatBrowserDateTime('bad')).toBe('—');
+});
