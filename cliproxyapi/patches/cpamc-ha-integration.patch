diff --git a/src/features/authFiles/CodexReconnectPage.tsx b/src/features/authFiles/CodexReconnectPage.tsx
new file mode 100644
index 0000000..459a6ef
--- /dev/null
+++ b/src/features/authFiles/CodexReconnectPage.tsx
@@ -0,0 +1,246 @@
+import { useEffect, useRef, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import { useLocation, useNavigate } from 'react-router-dom';
+import { Button } from '@/components/ui/Button';
+import { Card } from '@/components/ui/Card';
+import { Input } from '@/components/ui/Input';
+import { captureCodexReconnectApi } from '@/services/api/oauth';
+import { apiClient } from '@/services/api/client';
+import { useAuthStore, useQuotaStore } from '@/stores';
+import { copyToClipboard } from '@/utils/clipboard';
+import { getErrorMessage } from '@/utils/helpers';
+import { createOAuthAttempts } from '@/features/oauth/oauthAttempts';
+import { notifyAuthFilesChanged } from './authFilesEvents';
+import { codexReconnectFailure, readCodexReconnectTarget } from './reconnect';
+import styles from './CodexReconnectPage.module.scss';
+
+export function CodexReconnectPage() {
+  const { t } = useTranslation();
+  const location = useLocation();
+  const navigate = useNavigate();
+  const apiBase = useAuthStore((state) => state.apiBase);
+  const [status, setStatus] = useState<'idle' | 'starting' | 'waiting' | 'success' | 'error'>(
+    'idle'
+  );
+  const [login, setLogin] = useState<{ url: string; state: string }>();
+  const [callback, setCallback] = useState('');
+  const [error, setError] = useState('');
+  const [busy, setBusy] = useState(false);
+  const pending = useRef(false);
+  const recoveryApi = useRef<ReturnType<typeof captureCodexReconnectApi> | null>(null);
+  const attempts = useRef(
+    createOAuthAttempts({
+      setTimeout: (fn, delay) => window.setTimeout(fn, delay),
+      clearTimeout: (timer) => window.clearTimeout(timer),
+    })
+  );
+  const target = readCodexReconnectTarget(
+    location.state,
+    apiClient.getConnectionRevision(),
+    apiBase
+  );
+
+  useEffect(() => {
+    const unsubscribe = useAuthStore.subscribe((current, previous) => {
+      if (
+        current.apiBase !== previous.apiBase ||
+        current.managementKey !== previous.managementKey ||
+        current.isAuthenticated !== previous.isAuthenticated
+      ) {
+        attempts.current.invalidateAll();
+        setLogin(undefined);
+        setStatus('idle');
+        setBusy(false);
+        pending.current = false;
+      }
+    });
+    const activeAttempts = attempts.current;
+    return () => {
+      unsubscribe();
+      activeAttempts.invalidateAll();
+    };
+  }, []);
+
+  const complete = () => {
+    attempts.current.invalidateAll();
+    setLogin(undefined);
+    setStatus('success');
+    setBusy(false);
+    pending.current = false;
+    useQuotaStore.getState().clearQuotaCache();
+    notifyAuthFilesChanged();
+  };
+
+  const start = async () => {
+    if (!target || pending.current || login || status === 'success') return;
+    pending.current = true;
+    const attempt = attempts.current.begin('codex');
+    setError('');
+    setStatus('starting');
+    try {
+      const connectionApi = captureCodexReconnectApi();
+      recoveryApi.current = connectionApi;
+      const result = await connectionApi.start(target, attempt.signal);
+      if (!attempt.isCurrent()) return;
+      if (!result.state || !result.url) throw new Error(t('auth_files.reconnect_missing_state'));
+      setLogin({ url: result.url, state: result.state });
+      setStatus('waiting');
+      const poll = () =>
+        attempt.poll(
+          () => connectionApi.status(result.state!, attempt.signal),
+          (response) => {
+            if (response.status === 'ok') {
+              const failure = codexReconnectFailure(response, t('auth_files.reconnect_failed'));
+              if (failure) {
+                attempt.invalidate();
+                setLogin(undefined);
+                setStatus('error');
+                setError(failure);
+                pending.current = false;
+                return false;
+              }
+              complete();
+              return false;
+            }
+            if (response.status === 'error') {
+              attempt.invalidate();
+              setLogin(undefined);
+              setStatus('error');
+              setError(response.error || t('auth_files.reconnect_failed'));
+              return false;
+            }
+            return true;
+          },
+          (failure) => {
+            setStatus('error');
+            setError(getErrorMessage(failure));
+            if (attempt.isCurrent()) poll();
+          },
+          1500
+        );
+      poll();
+    } catch (failure) {
+      if (!attempt.isCurrent()) return;
+      attempt.invalidate();
+      setStatus('error');
+      setError(
+        (failure as { status?: number }).status === 404
+          ? t('auth_files.reconnect_requires_backend')
+          : getErrorMessage(failure)
+      );
+    } finally {
+      if (attempt.isCurrent()) pending.current = false;
+      // Invalidated attempts must not release a newer request's guard.
+      if (!attempts.current.get('codex')) pending.current = false;
+    }
+  };
+
+  const submit = async () => {
+    const attempt = attempts.current.get('codex');
+    if (!login || !attempt?.isCurrent() || pending.current || !callback.trim() || !recoveryApi.current) return;
+    pending.current = true;
+    setBusy(true);
+    try {
+      await recoveryApi.current.submit(callback.trim(), attempt.signal);
+      if (!attempt.isCurrent()) return;
+      setCallback('');
+      setError('');
+    } catch (failure) {
+      if (attempt.isCurrent()) setError(getErrorMessage(failure));
+    } finally {
+      if (attempt.isCurrent()) {
+        pending.current = false;
+        setBusy(false);
+      }
+    }
+  };
+
+  const back = async () => {
+    if (pending.current) return;
+    const attempt = attempts.current.get('codex');
+    if (login && attempt?.isCurrent() && recoveryApi.current) {
+      pending.current = true;
+      setBusy(true);
+      try {
+        const result = await recoveryApi.current.cancel(login.state, attempt.signal);
+        if (!attempt.isCurrent()) return;
+        if (!result.cancelled) {
+          const resultStatus = await recoveryApi.current.status(login.state, attempt.signal);
+          if (!attempt.isCurrent()) return;
+          if (resultStatus.status === 'wait')
+            throw new Error(t('auth_files.reconnect_cancel_failed'));
+          if (resultStatus.status === 'ok') {
+            const failure = codexReconnectFailure(resultStatus, t('auth_files.reconnect_failed'));
+            if (failure) throw new Error(failure);
+            complete();
+          }
+        }
+        attempt.invalidate();
+      } catch (failure) {
+        if (attempt.isCurrent()) {
+          setError(getErrorMessage(failure));
+          pending.current = false;
+          setBusy(false);
+        }
+        return;
+      }
+    }
+    navigate('/auth-files');
+  };
+
+  return (
+    <Card
+      className={styles.card}
+      title={<h1 className={styles.title}>{t('auth_files.reconnect_title')}</h1>}
+    >
+      <p>
+        {target
+          ? t('auth_files.reconnect_hint', { name: target.name })
+          : t('auth_files.reconnect_invalid')}
+      </p>
+      {error && (
+        <p className={styles.error} role="alert">
+          {error}
+        </p>
+      )}
+      {status === 'success' && (
+        <p className={styles.success} role="status">
+          {t('auth_files.reconnect_success')}
+        </p>
+      )}
+      {target && !login && status !== 'success' && (
+        <Button onClick={() => void start()} loading={status === 'starting'}>
+          {t('auth_files.reconnect_button')}
+        </Button>
+      )}
+      {login && (
+        <div className={styles.flow}>
+          <p role="status">{t('auth_files.reconnect_waiting')}</p>
+          <Button onClick={() => window.open(login.url, '_blank', 'noopener,noreferrer')}>
+            {t('auth_files.reconnect_open')}
+          </Button>
+          <Button variant="secondary" onClick={() => void copyToClipboard(login.url)}>
+            {t('auth_files.reconnect_copy')}
+          </Button>
+          <Input
+            label={t('auth_files.reconnect_callback')}
+            value={callback}
+            onChange={(event) => setCallback(event.target.value)}
+            hint={t('auth_files.reconnect_callback_hint')}
+            disabled={busy}
+          />
+          <Button onClick={() => void submit()} loading={busy} disabled={!callback.trim()}>
+            {t('auth_files.reconnect_submit')}
+          </Button>
+        </div>
+      )}
+      <Button
+        variant="secondary"
+        onClick={() => void back()}
+        disabled={status === 'starting' || busy}
+      >
+        {t(login ? 'auth_files.reconnect_cancel' : 'auth_files.reconnect_back')}
+      </Button>
+    </Card>
+  );
+}
