@@ -0,0 +1,85 @@
+import { describe, expect, spyOn, test } from 'bun:test';
+import {
+  codexReconnectFailure,
+  makeCodexReconnectTarget,
+  readCodexReconnectTarget,
+} from '../src/features/authFiles/reconnect';
+import { oauthApi } from '../src/services/api/oauth';
+import { apiClient } from '../src/services/api/client';
+
+describe('Codex reconnect identity', () => {
+  const file = { name: 'codex-existing.json', type: 'codex', authIndex: 'stable-index' };
+  test('uses the selected existing identity even when the credential is disabled', () => {
+    expect(makeCodexReconnectTarget({ ...file, disabled: true }, 3)).toEqual({
+      name: file.name,
+      authIndex: 'stable-index',
+      connectionRevision: 3,
+      apiBase: '',
+    });
+  });
+  test('rejects unsupported, runtime-only and unidentified credentials', () => {
+    for (const unsupported of [
+      { ...file, type: 'claude' },
+      { ...file, runtimeOnly: true },
+      { ...file, runtime_only: 'true' },
+      { ...file, authIndex: null },
+      { ...file, name: '../outside.json' },
+    ])
+      expect(makeCodexReconnectTarget(unsupported, 3)).toBeNull();
+  });
+  test('does not reuse a target after a connection change or direct navigation', () => {
+    const target = makeCodexReconnectTarget(file, 3);
+    expect(readCodexReconnectTarget(target, 3)).toEqual(target);
+    expect(readCodexReconnectTarget(target, 4)).toBeNull();
+    expect(readCodexReconnectTarget(target, 3, 'https://other.example.test')).toBeNull();
+    expect(readCodexReconnectTarget(null, 3)).toBeNull();
+    expect(readCodexReconnectTarget({ name: 'a', connectionRevision: 3 }, 3)).toBeNull();
+  });
+});
+
+describe('Codex reconnect API', () => {
+  test('uses an account-bound endpoint and forwards cancellation', async () => {
+    const signal = new AbortController().signal;
+    const get = spyOn(apiClient, 'get').mockResolvedValue({
+      url: 'https://auth.example.test',
+      state: 'fixture-state',
+    });
+    try {
+      await oauthApi.reconnectCodex(
+        { name: 'codex-existing.json', authIndex: 'stable-index' },
+        signal
+      );
+      expect(get).toHaveBeenCalledWith('/credentials/reconnect', {
+        params: { name: 'codex-existing.json', auth_index: 'stable-index', is_webui: true },
+        signal,
+      });
+    } finally {
+      get.mockRestore();
+    }
+  });
+  test('never falls back to creating an account on an older backend', async () => {
+    const error = Object.assign(new Error('not found'), { status: 404 });
+    const get = spyOn(apiClient, 'get').mockRejectedValue(error);
+    try {
+      await expect(
+        oauthApi.reconnectCodex({ name: 'codex-existing.json', authIndex: 'stable-index' })
+      ).rejects.toBe(error);
+      expect(get).toHaveBeenCalledTimes(1);
+    } finally {
+      get.mockRestore();
+    }
+  });
+});
+
+describe('Codex reconnect adoption outcomes', () => {
+  test('requires runtime adoption before claiming success', () => {
+    expect(codexReconnectFailure({ status: 'ok', saved: true, adopted: false, adoption_error: 'Runtime adoption failed' }, 'Reconnect failed')).toBe('Runtime adoption failed');
+    expect(codexReconnectFailure({ status: 'ok', saved: false }, 'Reconnect failed')).toBe('Reconnect failed');
+    expect(codexReconnectFailure({ status: 'ok', saved: true, adopted: true, requires_sign_in: true }, 'Reconnect failed')).toBe('Reconnect failed');
+    expect(codexReconnectFailure({ status: 'ok', verification_error: 'Verification pending' }, 'Reconnect failed')).toBe('Verification pending');
+  });
+  test('accepts successful modern adoption and compatible older status responses', () => {
+    expect(codexReconnectFailure({ status: 'ok', saved: true, adopted: true }, 'Reconnect failed')).toBeUndefined();
+    expect(codexReconnectFailure({ status: 'ok' }, 'Reconnect failed')).toBeUndefined();
+  });
+});
