diff --git a/src/features/authFiles/reconnect.ts b/src/features/authFiles/reconnect.ts
new file mode 100644
index 0000000..9003565
--- /dev/null
+++ b/src/features/authFiles/reconnect.ts
@@ -0,0 +1,51 @@
+import type { OAuthStatusResponse } from '@/services/api/oauth';
+import type { AuthFileItem } from '@/types';
+
+export interface CodexReconnectTarget {
+  name: string;
+  authIndex: string;
+  connectionRevision: number;
+  apiBase: string;
+}
+
+export function makeCodexReconnectTarget(
+  file: AuthFileItem,
+  connectionRevision: number,
+  apiBase = ''
+): CodexReconnectTarget | null {
+  const runtimeOnly = file.runtimeOnly ?? file['runtime_only'];
+  if (runtimeOnly === true || runtimeOnly === 'true') return null;
+  if (String(file.type ?? file.provider).toLowerCase() !== 'codex') return null;
+  const authIndex = typeof file.authIndex === 'string' ? file.authIndex.trim() : '';
+  if (!authIndex || !file.name || /[/\\]/.test(file.name)) return null;
+  return { name: file.name, authIndex, connectionRevision, apiBase };
+}
+
+export function readCodexReconnectTarget(
+  value: unknown,
+  connectionRevision: number,
+  apiBase = ''
+): CodexReconnectTarget | null {
+  if (!value || typeof value !== 'object') return null;
+  const target = value as Partial<CodexReconnectTarget>;
+  if (
+    typeof target.name !== 'string' ||
+    !target.name.trim() ||
+    /[/\\]/.test(target.name) ||
+    typeof target.authIndex !== 'string' ||
+    !target.authIndex.trim() ||
+    target.connectionRevision !== connectionRevision ||
+    target.apiBase !== apiBase
+  )
+    return null;
+  return target as CodexReconnectTarget;
+}
+
+/** Saved tokens alone do not prove that the running server adopted the account. */
+export function codexReconnectFailure(result: OAuthStatusResponse, fallback: string): string | undefined {
+  if (result.status !== 'ok') return undefined;
+  if (result.saved === false || result.adopted === false || result.requires_sign_in === true || result.verification_error) {
+    return result.adoption_error || result.verification_error || fallback;
+  }
+  return undefined;
+}
