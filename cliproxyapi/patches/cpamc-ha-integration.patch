@@ -0,0 +1,54 @@
+import { expect, test } from 'bun:test';
+import axios from 'axios';
+import { apiClient } from '../src/services/api/client';
+import { saveSharedApiKeyName, sharedApiKeyFingerprint } from '../src/features/config/apiKeyNames';
+import { captureCodexReconnectApi } from '../src/services/api/oauth';
+
+test('a shared-name write is pinned before the async Axios request interceptor runs', async () => {
+  const adapter = axios.defaults.adapter;
+  const originalWindow = globalThis.window;
+  globalThis.window = new EventTarget() as unknown as Window & typeof globalThis;
+  const requests: Array<{ baseURL?: string; authorization: unknown }> = [];
+  axios.defaults.adapter = async (config) => {
+    requests.push({ baseURL: config.baseURL, authorization: config.headers.Authorization });
+    return { config, status: 200, statusText: 'OK', headers: {}, data: { names: { [sharedApiKeyFingerprint('synthetic-key')]: 'Team' } } };
+  };
+  try {
+    apiClient.setConfig({ apiBase: 'http://fixture-original', managementKey: 'original-test-key' });
+    const result = saveSharedApiKeyName('synthetic-key', 'Team');
+    apiClient.setConfig({ apiBase: 'http://fixture-other', managementKey: 'other-test-key' });
+    await expect(result).rejects.toThrow('Connection changed');
+    expect(requests).toEqual([{ baseURL: 'http://fixture-original/v8/management', authorization: 'Bearer original-test-key' }]);
+  } finally {
+    axios.defaults.adapter = adapter;
+    globalThis.window = originalWindow;
+    apiClient.setConfig({ apiBase: '', managementKey: '' });
+  }
+});
+
+test('recovery start, callback and cancellation use the connection captured for that attempt', async () => {
+  const adapter = axios.defaults.adapter;
+  const originalWindow = globalThis.window;
+  globalThis.window = new EventTarget() as unknown as Window & typeof globalThis;
+  const requests: Array<{ baseURL?: string; url?: string; authorization: unknown }> = [];
+  axios.defaults.adapter = async (config) => {
+    requests.push({ baseURL: config.baseURL, url: config.url, authorization: config.headers.Authorization });
+    return { config, status: 200, statusText: 'OK', headers: {}, data: { status: 'ok', cancelled: true } };
+  };
+  try {
+    apiClient.setConfig({ apiBase: 'http://fixture-original', managementKey: 'original-test-key' });
+    const recovery = captureCodexReconnectApi();
+    apiClient.setConfig({ apiBase: 'http://fixture-other', managementKey: 'other-test-key' });
+    const signal = new AbortController().signal;
+    await recovery.start({ name: 'existing.json', authIndex: 'stable-index' }, signal);
+    await recovery.status('synthetic-state', signal);
+    await recovery.submit('http://localhost/callback?state=synthetic-state&code=synthetic', signal);
+    await recovery.cancel('synthetic-state', signal);
+    expect(requests.map((request) => request.url)).toEqual(['/credentials/reconnect', '/oauth/status', '/oauth/callback', '/oauth/session']);
+    expect(requests.every((request) => request.baseURL === 'http://fixture-original/v8/management' && request.authorization === 'Bearer original-test-key')).toBe(true);
+  } finally {
+    axios.defaults.adapter = adapter;
+    globalThis.window = originalWindow;
+    apiClient.setConfig({ apiBase: '', managementKey: '' });
+  }
+});
