+describe('Keeper email privacy', () => {
+  test('changes only the explicit per-file flag and supports disabling it', () => {
+    const json = { email: 'example.person@example.com', access_token: 'fixture-token', priority: 9 };
+    const editor = { ...makeEditor(json, ''), priority: '9', hideEmailInKeeper: true, hideEmailInKeeperTouched: true };
+    expect(buildAuthFileFieldsPatch(editor, resolveError)).toEqual({ hide_email_in_keeper: true });
+    expect(buildAuthFileFieldsPatch({ ...editor, hideEmailInKeeperTouched: false }, resolveError)).toEqual({});
+    expect(buildAuthFileFieldsPatch({ ...editor, json: { ...json, hide_email_in_keeper: true }, hideEmailInKeeper: false }, resolveError)).toEqual({ hide_email_in_keeper: false });
+    expect(json.email).toBe('example.person@example.com');
+    expect(json.access_token).toBe('fixture-token');
+  });
+});
