+
+describe('account model whitelist', () => {
+ test('saves exact models while preserving other account fields', () => {
+  const original = { access_token: 'synthetic-only', note: 'keep', excluded_models: ['gpt-6-sol'] };
+  const editor = { ...makeEditor(original, ''), allowedModelsText: ' gpt-6-astra\nGPT-6-ASTRA ', allowedModelsTouched: true };
+  expect(buildAuthFileFieldsPatch(editor, resolveError)).toEqual({ allowed_models: ['gpt-6-astra'] });
+  expect(original.note).toBe('keep');
+  expect(buildAuthFileFieldsPatch({ ...editor, allowedModelsTouched: false }, resolveError)).toEqual({});
+ });
+ test('clears the whitelist and preserves unchanged values', () => {
+  const editor = { ...makeEditor({ allowed_models: ['gpt-6-astra'] }, ''), allowedModelsTouched: true };
+  expect(buildAuthFileFieldsPatch(editor, resolveError)).toEqual({ allowed_models: [] });
+  expect(buildAuthFileFieldsPatch({ ...editor, allowedModelsText: 'gpt-6-astra' }, resolveError)).toEqual({});
+ });
+});
