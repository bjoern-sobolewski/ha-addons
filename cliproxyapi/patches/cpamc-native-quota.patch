diff --git a/tests/trafficQuotaWindows.test.tsx b/tests/trafficQuotaWindows.test.tsx
new file mode 100644
index 0000000..9a4a061
--- /dev/null
+++ b/tests/trafficQuotaWindows.test.tsx
@@ -0,0 +1,136 @@
+import { expect, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import i18n from '../src/i18n';
+import { trafficWindow } from '../src/features/quota/trafficWindows';
+import { QuotaWindowLabel } from '../src/features/quota/QuotaWindowLabel';
+import { quotaObservationState } from '../src/features/quota/quotaObservation';
+import { QuotaMeter } from '../src/features/quota/components/QuotaMeter';
+import type { QuotaClassMap } from '../src/features/quota/types';
+
+const fixture = {
+  auth_index: 'fixture',
+  provider: 'codex',
+  window: 'x-codex-primary',
+  observed_at: '2026-10-03T12:00:00Z',
+  source: 'api_response_headers',
+  accountLabel: 'Codex account 1',
+};
+const t = i18n.getFixedT('en');
+test('classifies primary and secondary by duration, retaining custom and named windows', () => {
+  const weekly = trafficWindow(
+    {
+      ...fixture,
+      headers: {
+        'x-codex-primary-used-percent': ['10'],
+        'x-codex-primary-window-minutes': ['10080'],
+      },
+    },
+    t
+  )!;
+  expect(weekly.label).toBe('Weekly limit');
+  expect(weekly.remaining).toBe(90);
+  const short = trafficWindow(
+    {
+      ...fixture,
+      window: 'x-codex-secondary',
+      headers: {
+        'x-codex-secondary-used-percent': ['80'],
+        'x-codex-secondary-window-minutes': ['300'],
+      },
+    },
+    t
+  )!;
+  expect(short.label).toBe('5-hour limit');
+  const custom = trafficWindow(
+    {
+      ...fixture,
+      headers: {
+        'x-codex-primary-used-percent': ['25'],
+        'x-codex-primary-window-minutes': ['90'],
+        'x-codex-limit-name': ['custom'],
+      },
+    },
+    t
+  )!;
+  expect(custom.label).toBe('custom · 90-minute limit');
+  const unknown = trafficWindow(
+    { ...fixture, headers: { 'x-codex-primary-used-percent': ['25'] } },
+    t
+  )!;
+  expect(unknown.label).toBe('primary');
+  expect(unknown.label).not.toBe('5-hour limit');
+});
+test('Claude ISO resets and relative resets preserve the actual observation time', () => {
+  const item = trafficWindow(
+    {
+      ...fixture,
+      provider: 'claude',
+      window: 'claude-7d',
+      headers: {
+        'anthropic-ratelimit-unified-7d-utilization': ['0.4'],
+        'anthropic-ratelimit-unified-7d-reset': ['2026-10-04T12:00:00Z'],
+      },
+    },
+    t
+  )!;
+  expect(item.label).toBe('Weekly limit');
+  expect(item.remaining).toBe(60);
+  expect(item.resetAtMs).toBe(Date.parse('2026-10-04T12:00:00Z'));
+  const relative = trafficWindow(
+    {
+      ...fixture,
+      headers: {
+        'x-codex-primary-used-percent': ['10'],
+        'x-codex-primary-reset-after-seconds': ['30'],
+      },
+    },
+    t
+  )!;
+  expect(relative.resetAtMs).toBe(Date.parse(fixture.observed_at) + 30000);
+  expect(
+    trafficWindow({ ...fixture, headers: { 'x-codex-primary-used-percent': ['Infinity'] } }, t)
+  ).toBeNull();
+});
+test('unknown, old and expired observations stay explicit without advancing captures', () => {
+  const now = Date.parse('2026-10-03T12:10:00Z');
+  expect(
+    quotaObservationState({ account: 'fixture', capturedAt: fixture.observed_at }, now).elapsed
+  ).toBe(600);
+  expect(
+    quotaObservationState({ account: 'fixture', capturedAt: fixture.observed_at }, now, now - 1)
+      .stale
+  ).toBe(true);
+  expect(quotaObservationState({ account: 'fixture' }, now).stale).toBe(true);
+  expect(
+    quotaObservationState({ account: 'fixture', capturedAt: '2026-10-03T13:00:00Z' }, now).elapsed
+  ).toBe(0);
+});
+test('window labels expose observation controls and native meters retain the three fill bands', () => {
+  const label = renderToStaticMarkup(
+    createElement(QuotaWindowLabel, {
+      label: 'Weekly limit',
+      className: 'quotaModel',
+      details: { account: 'fixture', capturedAt: fixture.observed_at },
+    })
+  );
+  expect(label).toContain('<button');
+  expect(label).toContain('aria-expanded="false"');
+  expect(label).not.toContain('<svg');
+  const classes = {
+    quotaBar: 'native-meter',
+    quotaBarFill: 'fill',
+    quotaBarFillHigh: 'green',
+    quotaBarFillMedium: 'amber',
+    quotaBarFillLow: 'red',
+  } as QuotaClassMap;
+  for (const [percent, color] of [
+    [90, 'green'],
+    [50, 'amber'],
+    [10, 'red'],
+  ] as const) {
+    const html = renderToStaticMarkup(createElement(QuotaMeter, { percent, classes }));
+    expect(html).toContain(`fill ${color}`);
+    expect(html).not.toContain('<progress');
+  }
+});
