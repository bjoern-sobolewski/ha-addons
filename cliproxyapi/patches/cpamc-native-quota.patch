new file mode 100644
index 0000000..d374d15
--- /dev/null
+++ b/src/features/quota/quotaObservation.ts
@@ -0,0 +1,24 @@
+export interface QuotaObservationDetails {
+  capturedAt?: string;
+  source?: string;
+  account: string;
+  stale?: boolean;
+}
+
+export function quotaObservationState(
+  details: QuotaObservationDetails,
+  now: number,
+  resetAtMs?: number | null
+) {
+  const captured = details.capturedAt ? Date.parse(details.capturedAt) : NaN;
+  const elapsed = Number.isFinite(captured)
+    ? Math.max(0, Math.floor((now - captured) / 1000))
+    : null;
+  return {
+    captured,
+    elapsed,
+    stale: Boolean(
+      details.stale || elapsed === null || elapsed > 900 || (resetAtMs != null && resetAtMs <= now)
+    ),
+  };
+}
diff --git a/src/features/quota/trafficWindows.ts b/src/features/quota/trafficWindows.ts
new file mode 100644
index 0000000..3e7ba41
--- /dev/null
+++ b/src/features/quota/trafficWindows.ts
@@ -0,0 +1,65 @@
+import type { TFunction } from 'i18next';
+import type { TrafficQuota } from './useTrafficQuota';
+
+export function trafficWindow(item: TrafficQuota & { accountLabel: string }, t: TFunction) {
+  const entries = Object.entries(item.headers);
+  const value = (suffix: string) =>
+    entries.find(([name]) => name.toLowerCase().endsWith(suffix))?.[1]?.[0];
+  const number = (text: string | undefined) =>
+    text === undefined || text.trim() === '' ? NaN : Number(text);
+  const used =
+    number(value('-used-percent') ?? value('-utilization')) *
+    (item.provider === 'claude' ? 100 : 1);
+  if (!Number.isFinite(used)) return null;
+  const minutes = number(value('-window-minutes'));
+  const seconds = number(value('-limit-window-seconds') ?? value('-window-seconds'));
+  const encoded = /(?:^|[-_])(\d+)(h|d)(?:[-_]|$)/i.exec(item.window);
+  const rawDuration =
+    Number.isFinite(minutes) && minutes > 0
+      ? minutes * 60
+      : Number.isFinite(seconds) && seconds > 0
+        ? seconds
+        : encoded
+          ? Number(encoded[1]) * (encoded[2].toLowerCase() === 'd' ? 86400 : 3600)
+          : null;
+  const duration =
+    rawDuration != null && Number.isFinite(rawDuration) && rawDuration > 0 ? rawDuration : null;
+  const limitName = value('-limit-name');
+  const period =
+    duration === 18000
+      ? t('codex_quota.primary_window')
+      : duration === 604800
+        ? t('codex_quota.secondary_window')
+        : duration != null
+          ? duration % 86400 === 0
+            ? t('quota_observation.days', { count: duration / 86400 })
+            : duration % 3600 === 0
+              ? t('quota_observation.hours', { count: duration / 3600 })
+              : t('quota_observation.minutes', { count: duration / 60 })
+          : item.window
+              .replace(/^x-codex-/, '')
+              .replace(/^claude-/, '')
+              .replace(/[-_]/g, ' ');
+  const label = limitName ? `${limitName} · ${period}` : period;
+  const rawReset = value('-reset-at') ?? value('-reset');
+  const resetSeconds = number(rawReset);
+  const observed = Date.parse(item.observed_at);
+  const after = number(value('-reset-after-seconds'));
+  const candidate =
+    rawReset != null
+      ? Number.isFinite(resetSeconds)
+        ? resetSeconds * 1000
+        : Date.parse(rawReset)
+      : Number.isFinite(observed) && Number.isFinite(after) && after >= 0
+        ? observed + after * 1000
+        : NaN;
+  const resetAtMs = Number.isFinite(candidate) && Math.abs(candidate) <= 8.64e15 ? candidate : null;
+  return {
+    id: item.window,
+    label,
+    duration,
+    resetAtMs,
+    remaining: Math.max(0, Math.min(100, 100 - used)),
+    details: { capturedAt: item.observed_at, source: item.source, account: item.accountLabel },
+  };
+}
