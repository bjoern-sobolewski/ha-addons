diff --git a/src/features/quota/QuotaWindowLabel.tsx b/src/features/quota/QuotaWindowLabel.tsx
new file mode 100644
index 0000000..369bac1
--- /dev/null
+++ b/src/features/quota/QuotaWindowLabel.tsx
@@ -0,0 +1,132 @@
+import { useEffect, useId, useRef, useState } from 'react';
+import { createPortal } from 'react-dom';
+import { useTranslation } from 'react-i18next';
+import styles from './QuotaWindowLabel.module.scss';
+
+import { quotaObservationState, type QuotaObservationDetails } from './quotaObservation';
+
+export function QuotaWindowLabel({
+  label,
+  className,
+  details,
+  resetAtMs,
+  title,
+}: {
+  label: string;
+  className: string;
+  details?: QuotaObservationDetails;
+  resetAtMs?: number | null;
+  title?: string;
+}) {
+  const { t } = useTranslation();
+  const [now, setNow] = useState(Date.now);
+  const [open, setOpen] = useState(false);
+  const [position, setPosition] = useState({ left: 0, top: 0 });
+  const anchor = useRef<HTMLButtonElement>(null);
+  const popup = useRef<HTMLSpanElement>(null);
+  const tooltipId = useId();
+  useEffect(() => {
+    if (!open) return;
+    const button = anchor.current;
+    if (!button) return;
+    const positionTooltip = () => {
+      const bounds = button.getBoundingClientRect();
+      const height = popup.current?.getBoundingClientRect().height ?? 150;
+      setPosition({
+        left: Math.max(8, Math.min(bounds.left, window.innerWidth - 308)),
+        top:
+          bounds.bottom + height + 14 <= window.innerHeight
+            ? bounds.bottom + 6
+            : Math.max(8, bounds.top - height - 6),
+      });
+    };
+    positionTooltip();
+    setNow(Date.now());
+    const timer = window.setInterval(() => {
+      if (!document.hidden) setNow(Date.now());
+    }, 1000);
+    const dismissOutside = (event: PointerEvent) => {
+      if (!button.contains(event.target as Node)) setOpen(false);
+    };
+    document.addEventListener('pointerdown', dismissOutside);
+    // Focusing a card may scroll it into view; keep its details attached.
+    window.addEventListener('resize', positionTooltip);
+    window.addEventListener('scroll', positionTooltip, true);
+    return () => {
+      window.clearInterval(timer);
+      document.removeEventListener('pointerdown', dismissOutside);
+      window.removeEventListener('resize', positionTooltip);
+      window.removeEventListener('scroll', positionTooltip, true);
+    };
+  }, [open]);
+  if (!details)
+    return (
+      <span className={className} title={title}>
+        {label}
+      </span>
+    );
+  const state = quotaObservationState(details, now, resetAtMs);
+  const age =
+    state.elapsed === null
+      ? t('quota_observation.unknown')
+      : t('quota_observation.age', {
+          minutes: Math.floor(state.elapsed / 60),
+          seconds: String(state.elapsed % 60).padStart(2, '0'),
+        });
+  const sourceKey: Record<string, string> = {
+    api_response_headers: 'traffic',
+    usage_header: 'traffic',
+    websocket_event: 'websocket',
+    scheduled: 'scheduled',
+    scheduled_provider_query: 'scheduled',
+    cache_backfill: 'scheduled',
+    manual: 'manual',
+    manual_provider_query: 'manual',
+    inspection: 'manual',
+  };
+  const content = [
+    label,
+    details.account,
+    `${t('quota_observation.observed')}: ${Number.isFinite(state.captured) ? new Date(state.captured).toLocaleString() : t('quota_observation.unknown')}`,
+    age,
+    `${t('quota_observation.source')}: ${t(`quota_observation.${sourceKey[details.source ?? ''] ?? 'unknown'}`)}`,
+    t(`quota_observation.${state.stale ? 'stale' : 'cached'}`),
+  ].join('\n');
+  return (
+    <>
+      <button
+        ref={anchor}
+        type="button"
+        className={`${className} ${styles.label}`}
+        title={title}
+        aria-label={t('quota_observation.details', { window: label })}
+        aria-expanded={open}
+        aria-describedby={open ? tooltipId : undefined}
+        onFocus={() => setOpen(true)}
+        onBlur={() => setOpen(false)}
+        onClick={() => setOpen(true)}
+        onKeyDown={(event) => {
+          if (event.key === 'Escape') {
+            event.stopPropagation();
+            setOpen(false);
+          }
+        }}
+      >
+        {label}
+      </button>
+      {open &&
+        createPortal(
+          <span
+            ref={popup}
+            id={tooltipId}
+            role="tooltip"
+            className={styles.tooltip}
+            style={position}
+          >
+            {content}
+          </span>,
+          document.body
+        )}
+    </>
+  );
+}
