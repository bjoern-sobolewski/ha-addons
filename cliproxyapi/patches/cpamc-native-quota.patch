+import { useTranslation } from 'react-i18next';
+import type { AuthFileItem } from '@/types';
+import { normalizeAuthIndex } from '@/utils/authIndex';
+import { useNow } from '@/hooks/useNow';
+import { buildResetDisplay } from '@/utils/quota';
+import { useTrafficQuota } from './useTrafficQuota';
+import { trafficWindow } from './trafficWindows';
+import { QuotaWindowLabel } from './QuotaWindowLabel';
+import { QuotaMeter } from './components/QuotaMeter';
+import { QuotaResetLabel } from './components/QuotaResetLabel';
+import type { QuotaClassMap } from './types';
+
+export function TrafficQuotaBody({
+  file,
+  classes,
+}: {
+  file: AuthFileItem;
+  classes: QuotaClassMap;
+}) {
+  const items = useTrafficQuota(normalizeAuthIndex(file.auth_index) ?? '');
+  const { t, i18n } = useTranslation();
+  const now = useNow();
+  const windows = items
+    .map((item) => trafficWindow(item, t))
+    .filter((window) => window != null)
+    .sort(
+      (a, b) =>
+        (a.duration ?? Infinity) - (b.duration ?? Infinity) || a.label.localeCompare(b.label)
+    );
+  const nextReset = Math.min(
+    ...windows.flatMap((window) =>
+      window.resetAtMs != null && window.resetAtMs > now ? [window.resetAtMs] : []
+    )
+  );
+  return (
+    <>
+      {windows.map((window, index) => {
+        const reset = buildResetDisplay(null, window.resetAtMs, now, i18n.resolvedLanguage);
+        return (
+          <div key={window.id} className={classes.quotaRow}>
+            <div className={classes.quotaRowHeader}>
+              <QuotaWindowLabel
+                label={window.label}
+                className={classes.quotaModel}
+                details={window.details}
+                resetAtMs={window.resetAtMs}
+              />
+              <div className={classes.quotaMeta}>
+                <span className={classes.quotaPercent}>{Math.round(window.remaining)}%</span>
+                {reset && (
+                  <QuotaResetLabel
+                    display={reset}
+                    classes={classes}
+                    soon={window.resetAtMs === nextReset && nextReset - now <= 3600000}
+                  />
+                )}
+              </div>
+            </div>
+            <div
+              role="meter"
+              aria-label={window.label}
+              aria-valuemin={0}
+              aria-valuemax={100}
+              aria-valuenow={window.remaining}
+            >
+              <QuotaMeter percent={window.remaining} classes={classes} index={index} />
+            </div>
+          </div>
+        );
+      })}
+    </>
+  );
 }
