@@ -0,0 +1,27 @@
+import type {AuthFileItem} from '@/types';
+import {normalizeAuthIndex} from '@/utils/authIndex';
+import {useTrafficQuota} from './useTrafficQuota';
+import {QuotaFreshness} from './QuotaFreshness';
+export function TrafficQuotaBody({file}:{file:AuthFileItem}) {
+ const items=useTrafficQuota(normalizeAuthIndex(file.auth_index)??'');
+ if(!items.length)return null;
+ return <div>{items.map(item=>{
+  const entries=Object.entries(item.headers);
+  const value=(suffix:string)=>entries.find(([key])=>key.toLowerCase().endsWith(suffix))?.[1]?.[0];
+  const raw=value('-used-percent')??value('-utilization');
+  const used=raw===undefined?NaN:Number(raw)*(item.provider==='claude'?100:1);
+  if(!Number.isFinite(used))return null;
+  const resetRaw=value('-reset-at')??value('-reset');
+  const after=value('-reset-after-seconds');
+  const resetMillis=resetRaw?Number(resetRaw)*1000:after?Date.parse(item.observed_at)+Number(after)*1000:NaN;
+  const resetAt=Number.isFinite(resetMillis)&&Math.abs(resetMillis)<8.64e15?new Date(resetMillis).toISOString():undefined;
+  const limitName=value('-limit-name');
+  const label=limitName ? `${limitName} ${item.window.endsWith('secondary')?'secondary':'primary'}` : item.window.replace(/^x-codex-/, '').replace(/^claude-/, '').replace(/-/g,' ');
+  return <div key={item.window} style={{padding:'8px 0'}}>
+   <div>{label} · {Math.max(0,100-used).toFixed(1)}% remaining</div>
+   <progress max={100} value={Math.max(0,Math.min(100,100-used))} style={{width:'100%'}} aria-label={`${label} remaining`} />
+   <QuotaFreshness capturedAt={item.observed_at} source={item.source} account={item.accountLabel} resetAt={resetAt}/>
+   {resetAt&&<div>Resets {new Date(resetAt).toLocaleString()}</div>}
+  </div>;
+ })}</div>;
+}
