diff --git a/src/features/quota/useTrafficQuota.ts b/src/features/quota/useTrafficQuota.ts
new file mode 100644
index 0000000..2a04389
--- /dev/null
+++ b/src/features/quota/useTrafficQuota.ts
@@ -0,0 +1,17 @@
+import {useSyncExternalStore} from 'react';
+import {apiClient} from '@/services/api/client';
+import {startQuotaPolling} from '@/utils/quotaPolling';
+export type TrafficQuota={auth_index:string;provider:string;window:string;headers:Record<string,string[]>;observed_at:string;source:string};
+let items:TrafficQuota[]=[];
+const listeners=new Set<()=>void>();let stop:(()=>void)|undefined;
+export function subscribeTrafficQuota(listener:()=>void){
+ listeners.add(listener);
+ if(!stop)stop=startQuotaPolling(async(signal)=>{const response=await apiClient.get<{items:TrafficQuota[]}>('/quota/observations',{signal});if(signal.aborted)return;items=response.items;listeners.forEach(fn=>fn())});
+ return ()=>{listeners.delete(listener);if(listeners.size===0){stop?.();stop=undefined;items=[]}};
+}
+export function useTrafficQuota(index:string){
+ const snapshot=useSyncExternalStore(subscribeTrafficQuota,()=>items);
+ // Each successful poll also rerenders to update relative age and stale flags.
+
+ return snapshot.filter(item=>item.auth_index===index).map(item=>({...item,accountLabel:`${item.provider} account ${[...new Set(snapshot.filter(x=>x.provider===item.provider).map(x=>x.auth_index))].sort().indexOf(item.auth_index)+1}`}));
+}
