+  width: min(100%, 36rem);
+  padding: 32px;
+  border: 1px solid var(--border-color);
+  border-radius: 16px;
+  background: var(--bg-primary);
+
+  h1 { margin: 0 0 12px; font-size: 24px; }
+  p { margin: 0; color: var(--text-secondary); line-height: 1.6; }
+}
+
+.actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px; }
diff --git a/src/pages/RouteErrorPage.tsx b/src/pages/RouteErrorPage.tsx
new file mode 100644
index 0000000..78a8f68
--- /dev/null
+++ b/src/pages/RouteErrorPage.tsx
@@ -0,0 +1,23 @@
+import { Link } from 'react-router-dom';
+import { useTranslation } from 'react-i18next';
+import { Button } from '@/components/ui/Button';
+import styles from './RouteErrorPage.module.scss';
+
+/** Recover from unexpected route failures without exposing response data or stacks. */
+export function RouteErrorPage() {
+  const { t } = useTranslation();
+  return (
+    <main className={styles.page}>
+      <section className={styles.card} role="alert" aria-labelledby="route-error-title">
+        <h1 id="route-error-title">{t('route_error.title')}</h1>
+        <p>{t('route_error.description')}</p>
+        <div className={styles.actions}>
+          <Button type="button" onClick={() => window.location.reload()}>
+            {t('route_error.reload')}
+          </Button>
+          <Link className="btn btn-secondary" to="/">{t('route_error.dashboard')}</Link>
+        </div>
+      </section>
+    </main>
+  );
+}
diff --git a/tests/routeErrorPage.test.tsx b/tests/routeErrorPage.test.tsx
new file mode 100644
index 0000000..a69469c
--- /dev/null
+++ b/tests/routeErrorPage.test.tsx
@@ -0,0 +1,30 @@
+import { expect, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { createMemoryRouter, RouterProvider } from 'react-router-dom';
+import i18n from '../src/i18n';
+import { RouteErrorPage } from '../src/pages/RouteErrorPage';
+
+test('route failures show recovery actions without leaking error text, stacks or credentials', async () => {
+ await i18n.changeLanguage('en');
+ const router = createMemoryRouter([{
+  errorElement: createElement(RouteErrorPage),
+  children: [
+   { path: '/auth-files', loader: () => { throw new Error('sensitive-response-fixture'); } },
+   { path: '/', element: createElement('p', null, 'Dashboard') },
+  ],
+ }], { initialEntries: ['/auth-files'] });
+ if (!router.state.initialized) await new Promise<void>((resolve) => {
+  const stop = router.subscribe((state) => { if (state.initialized) { stop(); resolve(); } });
+ });
+ const html = renderToStaticMarkup(createElement(RouterProvider, { router }));
+ expect(html).toContain('This page could not load');
+ expect(html).toContain('Reload page');
+ expect(html).toContain('href="/"');
+ expect(html).toContain('Go to dashboard');
+ expect(html).not.toContain('sensitive-response-fixture');
+ expect(html).not.toContain('Unexpected Application Error');
+ await router.navigate('/');
+ expect(router.state.errors).toBeNull();
+ router.dispose();
+});
