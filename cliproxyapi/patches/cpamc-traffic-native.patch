diff --git a/src/utils/quotaPolling.ts b/src/utils/quotaPolling.ts
new file mode 100644
index 0000000..0566811
--- /dev/null
+++ b/src/utils/quotaPolling.ts
@@ -0,0 +1,40 @@
+export function startQuotaPolling(
+  refresh: (signal: AbortSignal) => Promise<unknown>,
+  interval = 10_000
+) {
+  let stopped = false;
+  let visibleRefreshPending = false;
+  let controller: AbortController | null = null;
+  const run = async () => {
+    if (stopped || document.hidden || controller) return;
+    const current = new AbortController();
+    controller = current;
+    try {
+      await refresh(current.signal);
+    } catch {
+      /* callers present errors; retain last good data */
+    } finally {
+      if (controller === current) controller = null;
+      if (visibleRefreshPending && !stopped && !document.hidden) {
+        visibleRefreshPending = false;
+        void run();
+      }
+    }
+  };
+  const visibility = () => {
+    if (document.hidden) controller?.abort();
+    else {
+      if (controller) visibleRefreshPending = true;
+      else void run();
+    }
+  };
+  const timer = window.setInterval(() => void run(), interval);
+  document.addEventListener('visibilitychange', visibility);
+  void run();
+  return () => {
+    stopped = true;
+    window.clearInterval(timer);
+    document.removeEventListener('visibilitychange', visibility);
+    controller?.abort();
+  };
+}
diff --git a/tests/trafficNativeQuota.test.tsx b/tests/trafficNativeQuota.test.tsx
new file mode 100644
index 0000000..5a4ae42
--- /dev/null
+++ b/tests/trafficNativeQuota.test.tsx
@@ -0,0 +1,59 @@
+import { expect, test } from 'bun:test';
+import { createElement } from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import i18n from '../src/i18n';
+import { mergeTrafficQuota, trafficQuotaWindow, type TrafficQuota } from '../src/features/quota/trafficQuota';
+import { CodexQuotaBody } from '../src/features/quota/providers/codex/CodexQuotaBody';
+import { AuthFileObservation } from '../src/features/quota/authFileObservation';
+import { QUOTA_CLASS_KEYS, type QuotaClassMap } from '../src/features/quota/types';
+import type { CodexQuotaState } from '../src/types';
+import { CODEX_CONFIG } from '../src/features/quota/providers/codex/data';
+
+const t = i18n.getFixedT('en');
+const at = '2026-10-05T10:00:00Z';
+const sample: TrafficQuota = {auth_index:'fixture', provider:'codex',window:'x-codex-primary',observed_at:'2026-10-05T10:00:10Z',source:'websocket_event',headers:{'X-Codex-Primary-Used-Percent':['42'],'X-Codex-Primary-Window-Minutes':['10080'],'X-Codex-Primary-Reset-After-Seconds':['600']}};
+const native: CodexQuotaState = {status:'success',capturedAt:at,source:'provider_query',planType:'pro',creditBalance:'12.5',subscriptionActiveUntil:'2026-11-01T12:00:00Z',rateLimitResetCreditsAvailableCount:2,rateLimitResetCreditsApplicableAvailableCount:1,rateLimitResetCredits:[{id:'credit',status:'available',grantedAt:at,expiresAt:'2026-11-02T12:00:00Z'}],windows:[{id:'weekly',label:'Weekly',labelKey:'codex_quota.secondary_window',usedPercent:10,resetLabel:'old',periodHours:168,resetAtMs:Date.parse(at)+900000},{id:'gpt-reserve-weekly-0',label:'Reserve weekly',usedPercent:0,resetLabel:'-',periodHours:168}]};
+test('traffic updates matching native windows while preserving all account fields, reset eligibility and unrelated limits',()=>{
+ const merged=mergeTrafficQuota('codex',native,[sample],t) as CodexQuotaState;
+ expect(native.windows[0].usedPercent).toBe(10);
+ expect(merged.windows).toHaveLength(2);
+ expect(merged.windows[0]).toMatchObject({id:'weekly',usedPercent:42,capturedAt:sample.observed_at,source:'websocket_event',resetAtMs:Date.parse(sample.observed_at)+600000});
+ expect(merged.windows[1]).toMatchObject({usedPercent:0,capturedAt:at,source:'provider_query'});
+ for(const key of ['planType','creditBalance','subscriptionActiveUntil','rateLimitResetCredits','rateLimitResetCreditsApplicableAvailableCount'] as const) expect(merged[key]).toEqual(native[key]);
+ expect(merged.capturedAt).toBe(at);
+ expect(CODEX_CONFIG.canResetQuota?.(merged)).toBe(true);
+});
+test('late, equal, wrong-provider and invalid observations cannot overwrite native account data',()=>{
+ for(const bad of [{...sample,observed_at:at},{...sample,observed_at:'2026-10-05T09:00:00Z'},{...sample,provider:'claude'},{...sample,headers:{'x-codex-primary-used-percent':['NaN']}},{...sample,observed_at:'invalid'}]) expect(mergeTrafficQuota('codex',native,[bad],t)).toBe(native);
+});
+test('duration identifies a weekly primary; reserve windows match independently of their list index',()=>{
+ const reserve={...sample,window:'x-codex-additional-gpt-reserve-secondary',headers:{'X-Codex-Additional-gpt-reserve-Secondary-Used-Percent':['8'],'X-Codex-Additional-gpt-reserve-Secondary-Window-Minutes':['10080'],'X-Codex-Additional-gpt-reserve-Limit-Name':['gpt-reserve']}};
+ const merged=mergeTrafficQuota('codex',native,[reserve,sample],t) as CodexQuotaState;
+ expect(merged.windows).toHaveLength(2);
+ expect(merged.windows[1]).toMatchObject({id:'gpt-reserve-weekly-0',usedPercent:8});
+ expect(trafficQuotaWindow({...sample,headers:{'x-codex-primary-used-percent':['8']}},t)).toBeNull();
+ expect(trafficQuotaWindow({...sample,headers:{...sample.headers,'X-Codex-Primary-Window-Minutes':['90']}},t)?.label).toBe('90-minute limit');
+});
+test('traffic-only success never invents a plan, credits or reset action; metadata later survives further traffic',()=>{
+ const partial=mergeTrafficQuota('codex',undefined,[sample],t) as CodexQuotaState;
+ expect(partial.status).toBe('success');expect(partial.planType).toBeUndefined();expect(partial.creditBalance).toBeUndefined();
+ expect(CODEX_CONFIG.canResetQuota?.(partial)).toBe(false);
+ expect(partial.windows).toHaveLength(1);
+ const rendered=render(partial,true);
+ expect(rendered).toContain('quotaBar');expect(rendered).not.toContain('codexPlan');
+});
+function render(quota:CodexQuotaState,showAge:boolean){
+ const classes=Object.fromEntries(QUOTA_CLASS_KEYS.map(key=>[key,key])) as unknown as QuotaClassMap;
+ return renderToStaticMarkup(createElement(AuthFileObservation.Provider,{value:{...quota,showAge}},createElement(CodexQuotaBody,{quota,classes})));
+}
+test('native rendering retains metadata and meters; hiding age only removes the refresh icon and age',()=>{
+ const merged=mergeTrafficQuota('codex',native,[sample],t) as CodexQuotaState;
+ const visible=render(merged,true);const hidden=render(merged,false);
+ for(const html of [visible,hidden]){expect(html).toContain('12.5');expect(html).toContain('codexResetCreditRow');expect(html).toContain('58%');expect(html).toContain('quotaBar');expect(html).not.toContain('<progress');}
+ expect(visible).toContain('data-quota-updated');expect(hidden).not.toContain('data-quota-updated');
+});
+test('Claude usage observations preserve account plan and extra usage',()=>{
+ const base={status:'success' as const,capturedAt:at,planType:'plan_max',extraUsage:{is_enabled:true,monthly_limit:20000,used_credits:1200,utilization:6},windows:[{id:'seven-day',label:'Weekly',usedPercent:12,resetLabel:'-',periodHours:168}]};
+ const incoming={...sample,provider:'claude',window:'claude-7d',headers:{'anthropic-ratelimit-unified-7d-utilization':['0.5'],'anthropic-ratelimit-unified-7d-reset':['2026-10-06T10:00:00Z']}};
+ expect(mergeTrafficQuota('claude',base,[incoming],t)).toMatchObject({planType:'plan_max',extraUsage:base.extraUsage,windows:[{id:'seven-day',usedPercent:50}]});
+});
