diff --git a/src/features/quota/trafficQuota.ts b/src/features/quota/trafficQuota.ts
new file mode 100644
index 0000000..8a1729a
--- /dev/null
+++ b/src/features/quota/trafficQuota.ts
@@ -0,0 +1,163 @@
+import type { TFunction } from 'i18next';
+import type {
+  CodexQuotaWindow,
+  ClaudeQuotaWindow,
+  CodexQuotaState,
+  ClaudeQuotaState,
+} from '@/types';
+import type { QuotaCardState } from './providers';
+import type { QuotaObservation } from './observationFormat';
+
+export interface TrafficQuota {
+  auth_index: string;
+  provider: string;
+  window: string;
+  headers: Record<string, string[]>;
+  observed_at: string;
+  source: string;
+}
+export type ObservedWindow = CodexQuotaWindow & QuotaObservation;
+const normalizeName = (name: string) =>
+  name
+    .trim()
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+const instant = (value: string | undefined): number | null => {
+  if (!value?.trim()) return null;
+  const numeric = Number(value);
+  const ms = Number.isFinite(numeric) ? numeric * 1000 : Date.parse(value);
+  return Number.isFinite(ms) && Math.abs(ms) <= 8.64e15 ? ms : null;
+};
+
+/** Traffic supplies window measurements only. Never manufacture account metadata. */
+export function trafficQuotaWindow(item: TrafficQuota, t: TFunction): ObservedWindow | null {
+  const captured = Date.parse(item.observed_at);
+  if (!Number.isFinite(captured)) return null;
+  const entries = Object.entries(item.headers);
+  const value = (suffix: string) =>
+    entries.find(([key]) => key.toLowerCase().endsWith(suffix))?.[1]?.[0];
+  const number = (suffix: string) => {
+    const raw = value(suffix);
+    return raw?.trim() && Number.isFinite(Number(raw)) ? Number(raw) : null;
+  };
+  const raw = number(item.provider === 'claude' ? '-utilization' : '-used-percent');
+  const usedPercent = raw === null ? null : raw * (item.provider === 'claude' ? 100 : 1);
+  if (usedPercent === null || usedPercent < 0 || usedPercent > 100) return null;
+  const after = number('-reset-after-seconds');
+  const resetAtMs =
+    instant(value('-reset-at') ?? value('-reset')) ??
+    (after !== null && after >= 0 && Math.abs(captured + after * 1000) <= 8.64e15
+      ? captured + after * 1000
+      : null);
+  let id: string;
+  let labelKey: string;
+  let labelParams: Record<string, string | number> | undefined;
+  let hours: number;
+  if (item.provider === 'codex') {
+    const minutes = number('-window-minutes');
+    // Order is not a duration: primary may be weekly. Missing durations cannot
+    // safely identify a native row, so do not invent a secondary/5-hour limit.
+    if (minutes === null || minutes <= 0) return null;
+    hours = minutes / 60;
+    const period =
+      hours === 5
+        ? 'five-hour'
+        : hours === 168
+          ? 'weekly'
+          : hours >= 672 && hours <= 744
+            ? 'monthly'
+            : `minutes-${minutes}`;
+    const name = value('-limit-name');
+    const review = item.window.startsWith('x-codex-code-review-');
+    const prefix = review ? 'code-review-' : name ? `${normalizeName(name)}-` : '';
+    id = prefix + period;
+    labelKey =
+      hours === 5
+        ? 'codex_quota.primary_window'
+        : hours === 168
+          ? 'codex_quota.secondary_window'
+          : period === 'monthly'
+            ? 'codex_quota.team_secondary_window'
+            : 'quota_traffic.custom_window';
+    if (review && !period.startsWith('minutes-'))
+      labelKey = `codex_quota.code_review_${hours === 5 ? 'primary_window' : period === 'monthly' ? 'team_secondary_window' : 'secondary_window'}`;
+    if (name && !review && !period.startsWith('minutes-')) {
+      labelKey = `codex_quota.additional_${hours === 5 ? 'primary_window' : period === 'monthly' ? 'team_secondary_window' : 'secondary_window'}`;
+      labelParams = { name };
+    } else if (period.startsWith('minutes-'))
+      labelParams = { minutes, name: name ? `${name} · ` : '' };
+  } else if (item.provider === 'claude') {
+    const names: Record<string, [string, string, number]> = {
+      'claude-5h': ['five-hour', 'five_hour', 5],
+      'claude-7d': ['seven-day', 'seven_day', 168],
+      'claude-7d-opus': ['seven-day-opus', 'seven_day_opus', 168],
+      'claude-7d-sonnet': ['seven-day-sonnet', 'seven_day_sonnet', 168],
+    };
+    const meta = names[item.window];
+    if (!meta) return null;
+    [id, labelKey, hours] = meta;
+    labelKey = `claude_quota.${labelKey}`;
+  } else return null;
+  return {
+    id,
+    label: t(labelKey, labelParams),
+    labelKey,
+    labelParams,
+    usedPercent,
+    resetAtMs,
+    resetLabel: resetAtMs === null ? '-' : new Date(resetAtMs).toISOString(),
+    periodHours: hours,
+    capturedAt: item.observed_at,
+    source: item.source,
+  };
+}
+
+const windowIdentity = (window: CodexQuotaWindow | ClaudeQuotaWindow) =>
+  window.id.replace(/-(five-hour|weekly|monthly)-\d+$/, '-$1');
+
+/** Per-window recency merge. Preserve every native field and unmatched row. */
+export function mergeTrafficQuota(
+  provider: string,
+  stored: QuotaCardState | undefined,
+  items: TrafficQuota[],
+  t: TFunction
+): QuotaCardState | undefined {
+  if (provider !== 'codex' && provider !== 'claude') return stored;
+  const native = stored as CodexQuotaState | ClaudeQuotaState | undefined;
+  const hasAccount = native?.status === 'success';
+  const windows: ObservedWindow[] =
+    (hasAccount ? native.windows : [])?.map((window) => ({
+      ...window,
+      capturedAt: stored?.capturedAt,
+      source: stored?.source,
+    })) ?? [];
+  let changed = false;
+  for (const item of items) {
+    if (item.provider !== provider) continue;
+    const incoming = trafficQuotaWindow(item, t);
+    if (!incoming) continue;
+    const index = windows.findIndex((window) => windowIdentity(window) === incoming.id);
+    const prior = index < 0 ? stored?.capturedAt : windows[index].capturedAt;
+    // Equal/late samples never replace a more complete account observation.
+    if (
+      Number.isFinite(Date.parse(prior ?? '')) &&
+      Date.parse(incoming.capturedAt!) <= Date.parse(prior!)
+    )
+      continue;
+    if (index < 0) windows.push(incoming);
+    else
+      windows[index] = {
+        ...windows[index],
+        usedPercent: incoming.usedPercent,
+        ...(incoming.resetAtMs !== null
+          ? { resetAtMs: incoming.resetAtMs, resetLabel: incoming.resetLabel }
+          : {}),
+        capturedAt: incoming.capturedAt,
+        source: incoming.source,
+      };
+    changed = true;
+  }
+  if (!changed) return stored;
+  return { ...(hasAccount ? stored : {}), status: 'success', windows } as CodexQuotaState;
+}
