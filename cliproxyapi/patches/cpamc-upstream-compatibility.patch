+
+async function withGlobalCrypto(source: unknown, run: () => Promise<void>) {
+  const descriptor = Object.getOwnPropertyDescriptor(globalThis, 'crypto');
+  try {
+    Object.defineProperty(globalThis, 'crypto', { configurable: true, value: source });
+    await run();
+  } finally {
+    if (descriptor) Object.defineProperty(globalThis, 'crypto', descriptor);
+    else Reflect.deleteProperty(globalThis, 'crypto');
+  }
+}
+
+function mockSharedResetOptions() {
+  return spyOn(quotaResetApi, 'options').mockResolvedValue({
+    provider: 'claude',
+    organizationId: organization,
+    usage: { cedar_ember: block },
+    status: { grants: [{ id: grant.id }] },
+    selectedGrantId: grant.id,
+  });
+}
+
+describe('Claude shared-backend default request ID integration', () => {
+  test('HTTP crypto fallback sends a secure request ID to CPA without provider passthrough', async () => {
+    using options = mockSharedResetOptions();
+    using redeem = spyOn(quotaResetApi, 'redeem').mockResolvedValue({ code: 'reset' });
+    using passthrough = spyOn(apiCallApi, 'request');
+    await withGlobalCrypto(
+      {
+        getRandomValues(bytes: Uint8Array) {
+          bytes.fill(10);
+          return bytes;
+        },
+      },
+      async () => {
+        const operations = createResetGrantOperations();
+        expect(await operations.run('account', 'index', grant.id)).toEqual({
+          code: 'reset',
+          unresolved: false,
+        });
+        expect(redeem).toHaveBeenCalledWith({
+          auth_index: 'index',
+          provider: 'claude',
+          organization_id: organization,
+          grant_id: grant.id,
+          request_id: '0a'.repeat(16),
+        });
+        expect(operations.inspect('account')).toMatchObject({
+          requestId: '0a'.repeat(16),
+          code: 'reset',
+        });
+      }
+    );
+    expect(options).toHaveBeenCalledTimes(2);
+    expect(redeem).toHaveBeenCalledTimes(1);
+    expect(passthrough).not.toHaveBeenCalled();
+  });
+
+  test('unknown shared claims retain the secure ID and selected grant until the same retry settles', async () => {
+    using options = mockSharedResetOptions();
+    using redeem = spyOn(quotaResetApi, 'redeem').mockResolvedValue({ code: 'unknown' });
+    let randomCalls = 0;
+    await withGlobalCrypto(
+      {
+        getRandomValues(bytes: Uint8Array) {
+          bytes.fill(++randomCalls);
+          return bytes;
+        },
+      },
+      async () => {
+        const operations = createResetGrantOperations();
+        await expect(operations.run('account', 'index', grant.id)).rejects.toBeInstanceOf(
+          AnthropicResetGrantUnknownOutcome
+        );
+        const pending = operations.inspect('account');
+        expect(pending?.grant.id).toBe(grant.id);
+        expect(pending?.requestId).toBe('01'.repeat(16));
+        await expect(operations.run('account', 'index', 'different-grant')).rejects.toThrow(
+          'expired'
+        );
+        options.mockResolvedValue({
+          provider: 'claude',
+          organizationId: organization,
+          status: { grants: [] },
+        });
+        redeem.mockResolvedValue({ code: 'already_used' });
+        expect(await operations.run('account', 'index', grant.id)).toEqual({
+          code: 'already_used',
+          unresolved: false,
+        });
+        expect(
+          redeem.mock.calls.map(([request]) => [request.request_id, request.grant_id])
+        ).toEqual([
+          ['01'.repeat(16), grant.id],
+          ['01'.repeat(16), grant.id],
+        ]);
+        expect(randomCalls).toBe(1);
+      }
+    );
+  });
+
+  test('missing secure randomness prevents shared spending and journaling without leaving busy state', async () => {
+    using options = mockSharedResetOptions();
+    using redeem = spyOn(quotaResetApi, 'redeem');
+    await withGlobalCrypto({}, async () => {
+      const operations = createResetGrantOperations();
+      for (let attempt = 0; attempt < 2; attempt++) {
+        await expect(operations.run('account', 'index', grant.id)).rejects.toMatchObject({
+          stage: 'request_id',
+          reason: 'generation_failed',
+        });
+        expect(operations.inspect('account')).toBeUndefined();
+      }
+    });
+    expect(options).toHaveBeenCalledTimes(4);
+    expect(redeem).not.toHaveBeenCalled();
+  });
+});
