diff --git a/internal/api/handlers/management/keeper_email_privacy.go b/internal/api/handlers/management/keeper_email_privacy.go
new file mode 100644
index 00000000..dc8e3568
--- /dev/null
+++ b/internal/api/handlers/management/keeper_email_privacy.go
@@ -0,0 +1,130 @@
+package management
+
+import (
+	"encoding/json"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type keeperPrivacyEntry struct {
+	Name   string `json:"name"`
+	Email  string `json:"email"`
+	Hidden bool   `json:"hidden"`
+}
+
+var keeperPrivacyMu sync.Mutex
+
+// KeeperEmailPrivacy is a trusted management-only policy feed. Credentials and
+// tokens are deliberately excluded; CPAMC remains the sole policy editor.
+func (h *Handler) KeeperEmailPrivacy(c *gin.Context) {
+	if h.authManager == nil {
+		c.JSON(http.StatusServiceUnavailable, gin.H{"error": "auth manager unavailable"})
+		return
+	}
+	entries, err := h.keeperPrivacySnapshot()
+	if err != nil {
+		c.JSON(503, gin.H{"error": "email privacy policy unavailable"})
+		return
+	}
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, gin.H{"version": 1, "entries": entries})
+}
+
+// Keep tombstones before management deletion as well as during reads. A Keeper
+// admin cannot reveal historical addresses by deleting a hidden credential before
+// Keeper has fetched it for the first time. The .policy file is not an auth JSON.
+func (h *Handler) keeperPrivacySnapshot() ([]keeperPrivacyEntry, error) {
+	keeperPrivacyMu.Lock()
+	defer keeperPrivacyMu.Unlock()
+	entries := make([]keeperPrivacyEntry, 0)
+	for _, a := range h.authManager.List() {
+		if a == nil {
+			continue
+		}
+		name := strings.TrimSpace(a.FileName)
+		if name == "" {
+			name = a.ID
+		}
+		entries = append(entries, keeperPrivacyEntry{name, authEmail(a), authEmailHiddenInKeeper(a)})
+	}
+	h.mu.Lock()
+	dir := h.cfg.AuthDir
+	h.mu.Unlock()
+	if dir == "" {
+		return entries, nil
+	}
+	path := filepath.Join(dir, ".keeper-email-privacy.policy")
+	archived := []keeperPrivacyEntry{}
+	data, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return nil, err
+	}
+	if len(data) > 0 {
+		if err = json.Unmarshal(data, &archived); err != nil {
+			return nil, err
+		}
+	}
+	present := map[string]bool{}
+	hidden := map[string]bool{}
+	for _, e := range entries {
+		present[strings.ToLower(e.Email)] = true
+		if e.Hidden {
+			hidden[strings.ToLower(e.Email)] = true
+		}
+	}
+	for _, e := range archived {
+		if !present[strings.ToLower(e.Email)] {
+			entries = append(entries, e)
+		}
+	}
+	retained := make([]keeperPrivacyEntry, 0)
+	for _, e := range entries {
+		if e.Hidden || hidden[strings.ToLower(e.Email)] {
+			e.Hidden = true
+			retained = append(retained, e)
+		}
+	}
+	next, err := json.Marshal(retained)
+	if err != nil {
+		return nil, err
+	}
+	if string(next) != string(data) && (len(retained) > 0 || len(data) > 0) {
+		file, err := os.CreateTemp(dir, ".keeper-email-privacy-*.policy")
+		if err != nil {
+			return nil, err
+		}
+		name := file.Name()
+		defer os.Remove(name)
+		if err = file.Chmod(0600); err == nil {
+			_, err = file.Write(next)
+		}
+		if err == nil {
+			err = file.Sync()
+		}
+		closeErr := file.Close()
+		if err != nil {
+			return nil, err
+		}
+		if closeErr != nil {
+			return nil, closeErr
+		}
+		if err = os.Rename(name, path); err != nil {
+			return nil, err
+		}
+	}
+	return entries, nil
+}
+
+func authEmailHiddenInKeeper(a *coreauth.Auth) bool {
+	if a == nil {
+		return false
+	}
+	value, _ := a.Metadata["hide_email_in_keeper"].(bool)
+	return value
+}
diff --git a/internal/api/handlers/management/keeper_email_privacy_test.go b/internal/api/handlers/management/keeper_email_privacy_test.go
new file mode 100644
index 00000000..96c5c3b8
--- /dev/null
