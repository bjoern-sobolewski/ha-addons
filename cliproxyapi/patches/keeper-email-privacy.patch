@@ -0,0 +1,66 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+func TestKeeperEmailPrivacyPersistsAndValidates(t *testing.T) {
+	dir := t.TempDir()
+	manager := coreauth.NewManager(&memoryAuthStore{}, nil, nil)
+	_, err := manager.Register(context.Background(), &coreauth.Auth{ID: "private.json", FileName: "private.json", Provider: "codex", Attributes: map[string]string{"path": filepath.Join(dir, "private.json")}, Metadata: map[string]any{"email": "example.person@example.com", "access_token": "must-not-be-in-feed"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: dir}, manager)
+	for _, value := range []string{`"true"`, `null`, `1`, `{}`, `[]`} {
+		_, err := normalizeAuthFilePatchFields(map[string]json.RawMessage{"hide_email_in_keeper": json.RawMessage(value)})
+		if err == nil {
+			t.Fatalf("accepted %s", value)
+		}
+	}
+	if _, err = normalizeAuthFilePatchFields(map[string]json.RawMessage{"hide_email_in_keeper.child": json.RawMessage(`true`)}); err == nil {
+		t.Fatal("nested policy accepted")
+	}
+	for _, value := range []string{"true", "false", "true"} {
+		rec := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(rec)
+		c.Request = httptest.NewRequest(http.MethodPatch, "/v8/management/credentials/fields", strings.NewReader(`{"name":"private.json","hide_email_in_keeper":`+value+`}`))
+		c.Request.Header.Set("Content-Type", "application/json")
+		h.PatchAuthFileFields(c)
+		if rec.Code != 200 {
+			t.Fatal(rec.Body.String())
+		}
+		entry, _ := manager.GetByID("private.json")
+		if authEmailHiddenInKeeper(entry) != (value == "true") {
+			t.Fatal("flag did not persist")
+		}
+	}
+	rec := httptest.NewRecorder()
+	c, _ := gin.CreateTestContext(rec)
+	h.KeeperEmailPrivacy(c)
+	if rec.Code != 200 || strings.Contains(rec.Body.String(), "must-not-be-in-feed") || !strings.Contains(rec.Body.String(), `"hidden":true`) {
+		t.Fatal(rec.Body.String())
+	}
+	// Emulate deletion before Keeper's next read, then a process restart.
+	manager.Remove(context.Background(), "private.json")
+	restarted := NewHandlerWithoutConfigFilePath(&config.Config{AuthDir: dir}, coreauth.NewManager(&memoryAuthStore{}, nil, nil))
+	entries, err := restarted.keeperPrivacySnapshot()
+	if err != nil || len(entries) != 1 || !entries[0].Hidden {
+		t.Fatalf("lost archived privacy: %v", err)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, ".keeper-email-privacy.policy"))
+	if err != nil || strings.Contains(string(data), "must-not-be-in-feed") {
+		t.Fatal("unsafe archive")
+	}
+}
