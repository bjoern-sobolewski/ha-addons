new file mode 100644
index 00000000..14661587
--- /dev/null
+++ b/sdk/cliproxy/auth/keeper_email_privacy_test.go
@@ -0,0 +1,23 @@
+package auth
+
+import "testing"
+
+func TestKeeperEmailPrivacySurvivesRefreshAndRelogin(t *testing.T) {
+	base := &Auth{Metadata: map[string]any{"hide_email_in_keeper": true, "access_token": "old"}}
+	current := base.Clone()
+	updated := base.Clone()
+	delete(updated.Metadata, "hide_email_in_keeper")
+	updated.Metadata["access_token"] = "new"
+	if MergeRefreshedAuth(base, current, updated).Metadata["hide_email_in_keeper"] != true {
+		t.Fatal("refresh erased privacy")
+	}
+	current.Metadata["hide_email_in_keeper"] = false
+	if MergeRefreshedAuth(base, current, updated).Metadata["hide_email_in_keeper"] != false {
+		t.Fatal("refresh undid concurrent setting")
+	}
+	relogin := &Auth{Metadata: map[string]any{"access_token": "relogin"}}
+	MergeExistingAuthMetadata(relogin, base.Metadata)
+	if relogin.Metadata["hide_email_in_keeper"] != true || relogin.Metadata["access_token"] != "relogin" {
+		t.Fatal("relogin lost privacy or new credentials")
+	}
+}
