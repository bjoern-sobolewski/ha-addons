@@ -0,0 +1,22 @@
+package api
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/routinglive"
+	"strings"
+)
+
+// Request lifetime follows the handler, including streaming delivery and cancellation.
+func routingActivityMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		if !strings.HasPrefix(c.Request.URL.Path, "/v1/") || c.Request.Method == "GET" || websocket.IsWebSocketUpgrade(c.Request) {
+			c.Next()
+			return
+		}
+		id := routinglive.Default.Begin("http", c.GetHeader("Authorization"), c.GetHeader("Session_id"))
+		c.Request = c.Request.WithContext(routinglive.WithID(c.Request.Context(), id))
+		defer func() { routinglive.Default.End(id, c.Writer.Status()) }()
+		c.Next()
+	}
+}
