+func (s *Session) telemetryLocked() {
+	routinglive.Default.Change(s.telemetryID, func(r *routinglive.Row) {
+		state := "idle"
+		if len(s.tools) > 0 {
+			state = "waiting_tools"
+		}
+		if len(s.ops) > 0 {
+			state = "running"
+		}
+		if s.uncertain {
+			state = "protocol_wait"
+		}
+		if s.closed {
+			state = "reconnecting"
+		}
+		r.State = state
+		r.Active = len(s.ops)
+		r.Tools = len(s.tools)
+		r.Draining = s.draining
+		r.Uncertain = s.uncertain
+		r.Work = make([]routinglive.Work, 0, min(len(s.ops), 128))
+		for i, op := range s.ops {
+			if i >= 128 {
+				break
+			}
+			state := "queued"
+			if op.response != "" {
+				state = "generating"
+			}
+			id := op.response
+			if id == "" {
+				id = op.event
+			}
+			if id == "" {
+				id = fmt.Sprintf("%s:%d:%d", s.telemetryID, op.started.UnixNano(), i)
+			}
+			r.Work = append(r.Work, routinglive.Work{ID: routinglive.Ref(id), Kind: op.kind, State: state, Started: op.started})
+		}
+	})
+}
