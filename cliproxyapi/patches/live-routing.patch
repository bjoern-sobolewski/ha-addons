+package management
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/routinglive"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/sessionrebalance"
+	"net/http"
+)
+
+func (h *Handler) GetRoutingActivity(c *gin.Context) {
+	accounts := map[string]string{}
+	labelCounts := map[string]int{}
+	if h.authManager != nil {
+		for _, a := range h.authManager.List() {
+			label := a.Label
+			if email := authEmail(a); email != "" {
+				label = email
+			}
+			if label == "" {
+				label = a.Provider + " · " + a.Index
+			}
+			accounts[a.Index] = label
+			labelCounts[label]++
+		}
+	}
+	for index, label := range accounts {
+		if labelCounts[label] > 1 {
+			short := index
+			if len(short) > 8 {
+				short = short[:8]
+			}
+			accounts[index] = label + " · " + short
+		}
+	}
+	clients := map[string]string{}
+	h.mu.Lock()
+	names, _ := h.readAPIKeyNamesLocked()
+	if h.cfg != nil {
+		for _, key := range h.cfg.APIKeys {
+			digest := sha256.Sum256([]byte(key))
+			if name := names[hex.EncodeToString(digest[:])]; name != "" {
+				clients[routinglive.Ref("Bearer "+key)] = name
+			}
+		}
+	}
+	h.mu.Unlock()
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, gin.H{"activity": routinglive.Default.Snapshot(), "rebalances": sessionrebalance.Default.Snapshots(), "bindings": h.authManager.RoutingBindings(), "accounts": accounts, "clients": clients})
+}
