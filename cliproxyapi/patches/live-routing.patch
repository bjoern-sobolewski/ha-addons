@@ -1739,3 +1739,26 @@ func equalStrings(left, right []string) bool {
 	}
 	return true
 }
+
+// AffinityBinding contains only routing identity and lifetime, never content fingerprints.
+type AffinityBinding struct {
+	SessionID, AuthID string
+	ExpiresAt         time.Time
+}
+
+func (m *MerklePrefixMatcher) AffinityBindings() []AffinityBinding {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	out := []AffinityBinding{}
+	now := m.now()
+	seen := map[string]bool{}
+	for _, ns := range m.groups {
+		for _, g := range ns.groups {
+			if now.Before(g.expiresAt) && !seen[g.sessionID] {
+				seen[g.sessionID] = true
+				out = append(out, AffinityBinding{g.sessionID, g.authID, g.expiresAt})
+			}
+		}
+	}
+	return out
+}
