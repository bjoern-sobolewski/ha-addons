@@ -0,0 +1,43 @@
+package sessionrebalance
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/routinglive"
+	"testing"
+)
+
+func TestLiveSocketWorkAndToolsRemainDistinct(t *testing.T) {
+	c := New()
+	s := c.Register(func() {})
+	defer s.Unregister()
+	s.Describe("Bearer test-secret", "test-session")
+	find := func() routinglive.Row {
+		for _, r := range routinglive.Default.Snapshot().Rows {
+			if r.ID == s.telemetryID {
+				return r
+			}
+		}
+		t.Fatal("missing live socket")
+		return routinglive.Row{}
+	}
+	if r := find(); r.State != "idle" || r.Active != 0 {
+		t.Fatal(r)
+	}
+	s.Input([]byte(`{"type":"response.create","event_id":"event-a"}`))
+	s.Output([]byte(`{"type":"response.created","response":{"id":"r-a"}}`))
+	if r := find(); r.Active != 1 || len(r.Work) != 1 || r.Work[0].State != "generating" {
+		t.Fatal(r)
+	}
+	before := len(routinglive.Default.Snapshot().Events)
+	s.Output([]byte(`{"type":"response.output_text.delta","delta":"private text"}`))
+	if len(routinglive.Default.Snapshot().Events) != before {
+		t.Fatal("token delta caused routing invalidation")
+	}
+	s.Output([]byte(`{"type":"response.completed","response":{"id":"r-a","output":[{"type":"function_call","call_id":"secret-tool-id"}]}}`))
+	if r := find(); r.State != "waiting_tools" || r.Active != 0 || r.Tools != 1 {
+		t.Fatal(r)
+	}
+	s.Input([]byte(`{"type":"response.create","event_id":"event-b","input":[{"type":"function_call_output","call_id":"secret-tool-id","output":"private result"}]}`))
+	if r := find(); r.Tools != 0 || r.Active != 1 || r.Work[0].State != "queued" {
+		t.Fatal(r)
+	}
+}
