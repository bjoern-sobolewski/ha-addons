+)
+
+func TestRoutingActivitySurvivesDetachedExecutionContext(t *testing.T) {
+	c, _ := gin.CreateTestContext(httptest.NewRecorder())
+	c.Request = httptest.NewRequest("POST", "/v1/responses", nil)
+	c.Request = c.Request.WithContext(routinglive.WithID(c.Request.Context(), "live-request"))
