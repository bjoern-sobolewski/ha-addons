+++ b/internal/routinglive/registry_test.go
@@ -0,0 +1,59 @@
+package routinglive
+
+import (
+	"encoding/json"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestEphemeralReferencesSnapshotsAndLateSelections(t *testing.T) {
+	r := New()
+	id := r.Begin("http", "Bearer secret-client-key", "private-session-id")
+	if r.Ref("private-session-id") == New().Ref("private-session-id") {
+		t.Fatal("references must rotate with runtime")
+	}
+	r.Select(id, "account-index", "codex", "model", "private-session-id", "sticky", 2, []Candidate{{Account: "account-index", Status: "selected"}})
+	snapshot := r.Snapshot()
+	snapshot.Rows[0].Candidates[0].Account = "mutated"
+	if r.Snapshot().Rows[0].Candidates[0].Account != "account-index" {
+		t.Fatal("snapshot aliases mutable state")
+	}
+	raw, _ := json.Marshal(r.Snapshot())
+	if strings.Contains(string(raw), "secret-client-key") || strings.Contains(string(raw), "private-session-id") {
+		t.Fatal("raw client/session identifiers leaked")
+	}
+	r.End(id, 200)
+	r.Select(id, "late", "codex", "model", "", "scheduler", 0, nil)
+	if len(r.Snapshot().Rows) != 0 {
+		t.Fatal("late result resurrected request")
+	}
+}
+func TestBoundedConcurrentTelemetry(t *testing.T) {
+	r := New()
+	var wg sync.WaitGroup
+	for i := 0; i < 16; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 100; j++ {
+				id := r.Begin("http", "client", "")
+				r.Change(id, func(row *Row) { row.State = "running" })
+				r.Select(id, "a", "codex", "m", "", "scheduler", 0, nil)
+				r.Snapshot()
+				r.End(id, 200)
+			}
+		}()
+	}
+	wg.Wait()
+	if len(r.Snapshot().Events) > 200 || len(r.Snapshot().Rows) != 0 {
+		t.Fatal("history or lifetime bound violated")
+	}
+	for i := 0; i < 4097; i++ {
+		r.Begin("http", "", "")
+	}
+	v := r.Snapshot()
+	if len(v.Rows) != 4096 || v.Dropped != 1 {
+		t.Fatal("activity capacity not enforced")
+	}
+}
