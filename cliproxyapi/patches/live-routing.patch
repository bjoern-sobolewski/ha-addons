diff --git a/internal/routinglive/registry.go b/internal/routinglive/registry.go
new file mode 100644
index 00000000..f11a8ebf
--- /dev/null
+++ b/internal/routinglive/registry.go
@@ -0,0 +1,215 @@
+// Package routinglive holds bounded, ephemeral administration telemetry. No bodies or credentials.
+package routinglive
+
+import (
+	"context"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/live"
+	"sort"
+	"strconv"
+	"sync"
+	"time"
+)
+
+type Candidate struct {
+	Account   string `json:"account"`
+	Pool      string `json:"pool"`
+	Priority  int    `json:"priority"`
+	Websocket bool   `json:"websocket"`
+	Status    string `json:"status"`
+}
+type Row struct {
+	ID         string      `json:"id"`
+	Kind       string      `json:"kind"`
+	Session    string      `json:"session,omitempty"`
+	Client     string      `json:"client,omitempty"`
+	Model      string      `json:"model,omitempty"`
+	Account    string      `json:"account,omitempty"`
+	Pool       string      `json:"pool,omitempty"`
+	Transport  string      `json:"transport"`
+	State      string      `json:"state"`
+	Reason     string      `json:"reason,omitempty"`
+	Priority   int         `json:"priority"`
+	Active     int         `json:"active"`
+	Tools      int         `json:"tools"`
+	Draining   bool        `json:"draining"`
+	Uncertain  bool        `json:"uncertain"`
+	Attempts   int         `json:"attempts"`
+	Started    time.Time   `json:"started_at"`
+	Updated    time.Time   `json:"updated_at"`
+	Candidates []Candidate `json:"candidates"`
+	Work       []Work      `json:"work"`
+}
+type Work struct {
+	ID      string    `json:"id"`
+	Kind    string    `json:"kind"`
+	State   string    `json:"state"`
+	Started time.Time `json:"started_at"`
+}
+type Event struct {
+	ID      uint64    `json:"id"`
+	At      time.Time `json:"at"`
+	Row     string    `json:"row"`
+	Account string    `json:"account,omitempty"`
+	Pool    string    `json:"pool,omitempty"`
+	Reason  string    `json:"reason"`
+}
+type Snapshot struct {
+	At      time.Time `json:"at"`
+	Since   time.Time `json:"since"`
+	Rows    []Row     `json:"rows"`
+	Events  []Event   `json:"events"`
+	Dropped uint64    `json:"dropped"`
+}
+type Registry struct {
+	mu      sync.Mutex
+	secret  [32]byte
+	since   time.Time
+	next    uint64
+	rows    map[string]Row
+	events  []Event
+	dropped uint64
+}
+
+func New() *Registry {
+	r := &Registry{since: time.Now(), rows: map[string]Row{}}
+	if _, err := rand.Read(r.secret[:]); err != nil {
+		panic(err)
+	}
+	return r
+}
+
+var Default = New()
+
+func (r *Registry) Ref(value string) string {
+	if value == "" {
+		return ""
+	}
+	h := hmac.New(sha256.New, r.secret[:])
+	h.Write([]byte(value))
+	return hex.EncodeToString(h.Sum(nil)[:8])
+}
+func Ref(value string) string { return Default.Ref(value) }
+func bounded(s string) string {
+	if len(s) > 160 {
+		return s[:160]
+	}
+	return s
+}
+func (r *Registry) Begin(kind, client, session string) string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if len(r.rows) >= 4096 {
+		r.dropped++
+		return ""
+	}
+	r.next++
+	id := r.Ref(kind + strconv.FormatUint(r.next, 10))
+	now := time.Now()
+	r.rows[id] = Row{ID: id, Kind: kind, Client: r.Ref(client), Session: r.Ref(session), Transport: kind, State: "selecting", Started: now, Updated: now, Candidates: []Candidate{}}
+	live.Default.Publish("routing")
+	return id
+}
+func (r *Registry) Change(id string, f func(*Row)) {
+	if id == "" {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	v, ok := r.rows[id]
+	if !ok {
+		return
+	}
+	previous := v
+	f(&v)
+	if previous.State != v.State || previous.Draining != v.Draining {
+		reason := v.State
+		if v.Draining && !previous.Draining {
+			reason = "rebalance_requested"
+		}
+		r.eventLocked(v, reason)
+	}
+	v.Updated = time.Now()
+	r.rows[id] = v
+	live.Default.Publish("routing")
+}
+func (r *Registry) eventLocked(v Row, reason string) {
+	r.next++
+	r.events = append(r.events, Event{r.next, time.Now(), v.ID, v.Account, v.Pool, reason})
+	if len(r.events) > 200 {
+		r.events = append([]Event(nil), r.events[len(r.events)-200:]...)
+	}
+}
+func (r *Registry) End(id string, status int) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if v, ok := r.rows[id]; ok {
+		reason := "completed"
+		if status >= 400 {
+			reason = "failed"
+		} else if v.Kind == "websocket" {
+			reason = "disconnected"
+		}
+		r.eventLocked(v, reason)
+		delete(r.rows, id)
+		live.Default.Publish("routing")
+	}
+}
+func (r *Registry) Select(id, account, pool, model, session, reason string, priority int, candidates []Candidate) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	v, ok := r.rows[id]
+	if !ok {
+		return
+	}
+	v.Account = bounded(account)
+	v.Pool = bounded(pool)
+	v.Model = bounded(model)
+	if session != "" {
+		v.Session = r.Ref(session)
+	}
+	v.Reason = reason
+	v.Priority = priority
+	v.Attempts++
+	v.Updated = time.Now()
+	if v.Kind == "http" {
+		v.State = "running"
+		v.Active = 1
+	}
+	v.Candidates = append([]Candidate{}, candidates...)
+	r.rows[id] = v
+	r.eventLocked(v, reason)
+	live.Default.Publish("routing")
+}
+func (r *Registry) Snapshot() Snapshot {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	now := time.Now()
+	out := Snapshot{At: now, Since: r.since, Rows: []Row{}, Events: []Event{}, Dropped: r.dropped}
+	for _, v := range r.rows {
+		v.Candidates = append([]Candidate{}, v.Candidates...)
+		v.Work = append([]Work{}, v.Work...)
+		out.Rows = append(out.Rows, v)
+	}
+	sort.Slice(out.Rows, func(i, j int) bool { return out.Rows[i].Started.Before(out.Rows[j].Started) })
+	for _, v := range r.events {
+		if now.Sub(v.At) < 10*time.Minute {
+			out.Events = append(out.Events, v)
+		}
+	}
+	return out
+}
+
+type key struct{}
+
+func WithID(ctx context.Context, id string) context.Context { return context.WithValue(ctx, key{}, id) }
+func ID(ctx context.Context) string {
+	if ctx == nil {
+		return ""
+	}
+	v, _ := ctx.Value(key{}).(string)
+	return v
+}
