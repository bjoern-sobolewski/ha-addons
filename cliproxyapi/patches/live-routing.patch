@@ -0,0 +1,81 @@
+package auth
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/routinglive"
+	ex "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"testing"
+	"time"
+)
+
+func TestRoutingSnapshotExplainsSelectionAndPoolScope(t *testing.T) {
+	m := NewManager(nil, &FillFirstSelector{}, nil)
+	var selected *Auth
+	for _, spec := range []struct {
+		id, provider, priority string
+		disabled               bool
+	}{
+		{"live-a", "codex", "10", false}, {"live-b", "codex", "0", false},
+		{"live-disabled", "codex", "20", true}, {"live-other", "claude", "30", false},
+	} {
+		a, err := m.Register(WithSkipPersist(context.Background()), &Auth{ID: spec.id, Provider: spec.provider, Disabled: spec.disabled, Status: StatusActive, Attributes: map[string]string{"priority": spec.priority}})
+		if err != nil {
+			t.Fatal(err)
+		}
+		registry.GetGlobalRegistry().RegisterClient(a.ID, a.Provider, []*registry.ModelInfo{{ID: "live-model"}})
+		defer registry.GetGlobalRegistry().UnregisterClient(a.ID)
+		if spec.id == "live-a" {
+			selected = a
+		}
+	}
+	id := routinglive.Default.Begin("http", "private-client", "private-session")
+	defer routinglive.Default.End(id, 200)
+	ctx := routinglive.WithID(context.Background(), id)
+	m.recordRoutingSelection(ctx, selected, "live-model", ex.Options{Metadata: map[string]any{}}, nil)
+	for _, row := range routinglive.Default.Snapshot().Rows {
+		if row.ID != id {
+			continue
+		}
+		if row.Reason != "scheduler" || row.Priority != 10 || row.Account != selected.Index || row.Active != 1 {
+			t.Fatal(row)
+		}
+		if len(row.Candidates) != 3 || row.Candidates[0].Status != "selected" {
+			t.Fatal(row.Candidates)
+		}
+		statuses := map[string]int{}
+		for _, c := range row.Candidates {
+			statuses[c.Status]++
+		}
+		if statuses["selected"] != 1 || statuses["lower_priority"] != 1 || statuses["disabled"] != 1 {
+			t.Fatal(statuses)
+		}
+		return
+	}
+	t.Fatal("missing selected request")
+}
+
+func TestRoutingBindingsFollowRealAffinityAndExpiry(t *testing.T) {
+	s := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &FillFirstSelector{}, TTL: time.Hour})
+	defer s.Stop()
+	m := NewManager(nil, s, nil)
+	a, err := m.Register(WithSkipPersist(context.Background()), &Auth{ID: "binding-live", Provider: "codex", Status: StatusActive})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.cache.mu.Lock()
+	s.cache.groups["test"] = sessionEntry{authID: a.ID, expiresAt: time.Now().Add(time.Hour), binding: sessionBinding{sessionID: "private-session"}}
+	s.cache.mu.Unlock()
+	bindings := m.RoutingBindings()
+	if len(bindings) != 1 || bindings[0].Session != routinglive.Ref("private-session") || bindings[0].Account != a.Index || bindings[0].Source != "explicit" {
+		t.Fatal(bindings)
+	}
+	s.cache.mu.Lock()
+	entry := s.cache.groups["test"]
+	entry.expiresAt = time.Now().Add(-time.Second)
+	s.cache.groups["test"] = entry
+	s.cache.mu.Unlock()
+	if len(m.RoutingBindings()) != 0 {
+		t.Fatal("expired binding appeared live")
+	}
+}
