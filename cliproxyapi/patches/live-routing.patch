diff --git a/sdk/cliproxy/auth/routing_activity.go b/sdk/cliproxy/auth/routing_activity.go
new file mode 100644
index 00000000..6f3cd489
--- /dev/null
+++ b/sdk/cliproxy/auth/routing_activity.go
@@ -0,0 +1,164 @@
+package auth
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/routinglive"
+	ex "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"sort"
+	"time"
+)
+
+const liveReasonKey = "routing_observed_reason"
+
+func routingReason(opts ex.Options, reason string) {
+	if opts.Metadata != nil {
+		opts.Metadata[liveReasonKey] = reason
+	}
+}
+func (m *Manager) recordRoutingSelection(ctx context.Context, a *Auth, model string, opts ex.Options, tried map[string]struct{}) {
+	id := routinglive.ID(ctx)
+	if id == "" || a == nil {
+		return
+	}
+	reason, _ := opts.Metadata[liveReasonKey].(string)
+	if reason == "" {
+		reason = "scheduler"
+	}
+	if pinnedAuthIDFromMetadata(opts.Metadata) != "" {
+		reason = "pinned"
+	}
+	if m.HomeEnabled() {
+		reason = "home_scheduler"
+	} else if m.hasPluginScheduler() {
+		reason = "plugin_scheduler"
+	}
+	fastWebsocket := reason == "scheduler" && m.useSchedulerFastPath() && ex.DownstreamWebsocket(ctx) && SessionRebalancePool(a) == "codex" && authWebsocketsEnabled(a)
+	if fastWebsocket {
+		reason = "websocket_preference"
+	}
+	if len(tried) > 0 {
+		reason = "retry_" + reason
+	}
+	pool := SessionRebalancePool(a)
+	candidates := []routinglive.Candidate{}
+	now := time.Now()
+	eligibility := authSelectionEligibilityForRequest(ctx, opts)
+	m.selectorMu.Lock()
+	selector := m.selector
+	m.selectorMu.Unlock()
+	weighted := false
+	switch s := selector.(type) {
+	case *WeightedRoundRobinSelector:
+		weighted = true
+	case *SessionAffinitySelector:
+		_, weighted = s.fallback.(*WeightedRoundRobinSelector)
+	}
+	for _, other := range m.List() {
+		if SessionRebalancePool(other) != pool {
+			continue
+		}
+		status := "eligible"
+		switch {
+		case other.Disabled || other.Status == StatusDisabled:
+			status = "disabled"
+		case !QuotaPolicyAllows(eligibility.forDrain(other), now):
+			status = "quota_minimum"
+		case !eligibility.allows(eligibility.forDrain(other)):
+			status = "request_policy"
+		case !m.authSupportsRouteModel(registry.GetGlobalRegistry(), other, model):
+			status = "model_unsupported"
+		case weighted && len(positiveWeightAuths([]*Auth{other})) == 0:
+			status = "zero_weight"
+		default:
+			if blocked, _, _ := isAuthBlockedForModel(other, m.selectionModelForAuth(other, model), now); blocked {
+				status = "cooldown"
+			}
+		}
+		if _, ok := tried[other.ID]; ok {
+			status = "already_tried"
+		}
+		if status == "eligible" {
+			if pinnedAuthIDFromMetadata(opts.Metadata) != "" && other.ID != a.ID {
+				status = "outside_pin"
+			} else if fastWebsocket && !authWebsocketsEnabled(other) {
+				status = "http_deprioritized"
+			} else if (reason == "scheduler" || reason == "websocket_preference" || reason == "new_binding") && authPriority(other) < authPriority(a) {
+				status = "lower_priority"
+			}
+		}
+		if other.ID == a.ID {
+			status = "selected"
+		}
+		candidates = append(candidates, routinglive.Candidate{Account: other.Index, Pool: pool, Priority: authPriority(other), Websocket: authWebsocketsEnabled(other), Status: status})
+	}
+	sort.Slice(candidates, func(i, j int) bool {
+		if (candidates[i].Status == "selected") != (candidates[j].Status == "selected") {
+			return candidates[i].Status == "selected"
+		}
+		return candidates[i].Account < candidates[j].Account
+	})
+	if len(candidates) > 128 {
+		candidates = candidates[:128]
+	}
+	session, _ := opts.Metadata[ex.CanonicalSessionIDMetadataKey].(string)
+	routinglive.Default.Select(id, a.Index, pool, model, session, reason, authPriority(a), candidates)
+}
+
+type RoutingBinding struct {
+	Session string    `json:"session"`
+	Account string    `json:"account"`
+	Pool    string    `json:"pool"`
+	Source  string    `json:"source"`
+	Expires time.Time `json:"expires_at"`
+}
+
+func (m *Manager) RoutingBindings() []RoutingBinding {
+	out := []RoutingBinding{}
+	if m == nil {
+		return out
+	}
+	auths := map[string]*Auth{}
+	for _, a := range m.List() {
+		auths[a.ID] = a
+	}
+	m.selectorMu.Lock()
+	selector := m.selector
+	m.selectorMu.Unlock()
+	s, ok := selector.(*SessionAffinitySelector)
+	if !ok || s == nil {
+		return out
+	}
+	seen := map[string]bool{}
+	add := func(session, auth, source string, expires time.Time) {
+		a := auths[auth]
+		if a == nil || session == "" {
+			return
+		}
+		key := routinglive.Ref(session)
+		if seen[key] {
+			return
+		}
+		seen[key] = true
+		out = append(out, RoutingBinding{key, a.Index, SessionRebalancePool(a), source, expires})
+	}
+	if s.cache != nil {
+		s.cache.mu.RLock()
+		for _, v := range s.cache.groups {
+			if time.Now().Before(v.expiresAt) {
+				add(v.binding.sessionID, v.authID, "explicit", v.expiresAt)
+			}
+		}
+		s.cache.mu.RUnlock()
+	}
+	if s.matcher != nil {
+		for _, v := range s.matcher.AffinityBindings() {
+			add(v.SessionID, v.AuthID, "prefix", v.ExpiresAt)
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Session < out[j].Session })
+	if len(out) > 4096 {
+		out = out[:4096]
+	}
+	return out
+}
