diff --git a/internal/quotatraffic/reset_credits.go b/internal/quotatraffic/reset_credits.go
new file mode 100644
index 00000000..be384759
--- /dev/null
+++ b/internal/quotatraffic/reset_credits.go
@@ -0,0 +1,40 @@
+package quotatraffic
+
+import (
+	"encoding/json"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/live"
+	"time"
+)
+
+func CaptureResetCredits(index string, body []byte, at time.Time, source string) {
+	if index == "" || at.IsZero() {
+		return
+	}
+	var payload struct {
+		AvailableCount *int `json:"available_count"`
+		Credits        *struct {
+			AvailableCount *int `json:"available_count"`
+		} `json:"rate_limit_reset_credits"`
+	}
+	if json.Unmarshal(body, &payload) != nil {
+		return
+	}
+	count := payload.AvailableCount
+	if payload.Credits != nil {
+		count = payload.Credits.AvailableCount
+	}
+	if count == nil || *count < 0 || *count > 10000 {
+		return
+	}
+	cache.Lock()
+	key := index + "\x00codex\x00reset-credits"
+	old, exists := cache.items[key]
+	if (exists && !at.After(old.ObservedAt)) || (!exists && len(cache.items) >= maxObservations) {
+		cache.Unlock()
+		return
+	}
+	value := *count
+	cache.items[key] = Observation{AuthIndex: index, Provider: "codex", Window: "reset-credits", ObservedAt: at, Source: source, ResetCreditsAvailableCount: &value}
+	cache.Unlock()
+	live.Default.Publish("quota")
+}
