diff --git a/internal/api/handlers/management/live.go b/internal/api/handlers/management/live.go
new file mode 100644
index 00000000..9052f8b4
--- /dev/null
+++ b/internal/api/handlers/management/live.go
@@ -0,0 +1,75 @@
+package management
+
+import (
+	"encoding/json"
+	"fmt"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/live"
+	"net/http"
+	"strings"
+	"time"
+)
+
+func (h *Handler) GetLiveStats(c *gin.Context) {
+	subscription := live.Default.Subscribe("", false)
+	if subscription == nil {
+		c.Status(http.StatusServiceUnavailable)
+		return
+	}
+	defer subscription.Close()
+	provided := strings.TrimSpace(c.GetHeader("Authorization"))
+	if strings.HasPrefix(strings.ToLower(provided), "bearer ") {
+		provided = strings.TrimSpace(provided[7:])
+	}
+	if provided == "" {
+		provided = c.GetHeader("X-Management-Key")
+	}
+	ip := c.ClientIP()
+	local := ip == "127.0.0.1" || ip == "::1"
+	c.Header("Content-Type", "text/event-stream")
+	c.Header("Cache-Control", "no-store")
+	c.Header("X-Accel-Buffering", "no")
+	seq := 0
+	send := func(topics []string) bool {
+		if allowed, _, _ := h.AuthenticateManagementKey(ip, local, provided); !allowed {
+			return false
+		}
+		seq++
+		payload, _ := json.Marshal(gin.H{"topics": topics})
+		_ = http.NewResponseController(c.Writer).SetWriteDeadline(time.Now().Add(10 * time.Second))
+		_, err := fmt.Fprintf(c.Writer, "id: %d\nevent: change\ndata: %s\n\n", seq, payload)
+		c.Writer.Flush()
+		return err == nil
+	}
+	if !send([]string{"sync"}) {
+		return
+	}
+	tick := time.NewTicker(15 * time.Second)
+	defer tick.Stop()
+	for {
+		select {
+		case <-c.Request.Context().Done():
+			return
+		case <-subscription.Wake:
+			timer := time.NewTimer(150 * time.Millisecond)
+			select {
+			case <-c.Request.Context().Done():
+				timer.Stop()
+				return
+			case <-timer.C:
+			}
+			topics := subscription.Drain()
+			if len(topics) == 0 {
+				continue
+			}
+			if !send(topics) {
+				return
+			}
+		case <-tick.C:
+			allowed, _, _ := h.AuthenticateManagementKey(ip, local, provided)
+			if !allowed || !send([]string{"clock"}) {
+				return
+			}
+		}
+	}
+}
