@@ -0,0 +1,33 @@
+package quotatraffic
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestResetCreditsAreNumericScopedAndMonotonic(t *testing.T) {
+	resetCache()
+	at := time.Now()
+	CaptureResetCredits("a", []byte(`{"available_count":3,"token":"never-copy-this"}`), at, "manual_provider_query")
+	for _, body := range []string{`{"available_count":-1}`, `{"available_count":10001}`, `{"available_count":"4"}`, `{"available_count":1.5}`, `{}`} {
+		CaptureResetCredits("a", []byte(body), at.Add(time.Second), "manual_provider_query")
+	}
+	CaptureResetCredits("a", []byte(`{"available_count":8}`), at.Add(-time.Second), "manual_provider_query")
+	if len(Read(map[string]bool{"b": true})) != 0 {
+		t.Fatal("cross-account observation")
+	}
+	rows := Read(map[string]bool{"a": true})
+	if len(rows) != 1 || rows[0].ResetCreditsAvailableCount == nil || *rows[0].ResetCreditsAvailableCount != 3 {
+		t.Fatalf("bad count: %+v", rows)
+	}
+	body, _ := json.Marshal(rows)
+	if strings.Contains(string(body), "never-copy") {
+		t.Fatal("raw provider data leaked")
+	}
+	CaptureResetCredits("a", []byte(`{"rate_limit_reset_credits":{"available_count":0}}`), at.Add(time.Second), "manual_provider_query")
+	if *Read(map[string]bool{"a": true})[0].ResetCreditsAvailableCount != 0 {
+		t.Fatal("zero count lost")
+	}
+}
