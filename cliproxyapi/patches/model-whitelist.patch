new file mode 100644
index 0000000..cd86e3c
--- /dev/null
+++ b/sdk/cliproxy/auth/allowed_models.go
@@ -0,0 +1,141 @@
+package auth
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// AllowedModelsFromMetadata reads an optional exact upstream-model whitelist.
+// Missing, null and empty lists preserve unrestricted model eligibility.
+func AllowedModelsFromMetadata(metadata map[string]any) ([]string, error) {
+	value := metadata["allowed_models"]
+	if value == nil {
+		return nil, nil
+	}
+	var entries []string
+	switch models := value.(type) {
+	case []string:
+		entries = models
+	case []any:
+		for _, model := range models {
+			name, ok := model.(string)
+			if !ok {
+				return nil, fmt.Errorf("allowed_models must be a string array or null")
+			}
+			entries = append(entries, name)
+		}
+	default:
+		return nil, fmt.Errorf("allowed_models must be a string array or null")
+	}
+	result := make([]string, 0, len(entries))
+	seen := make(map[string]bool)
+	for _, entry := range entries {
+		name := strings.ToLower(strings.TrimSpace(entry))
+		if name == "" {
+			continue
+		}
+		if strings.ContainsAny(name, "*?\\()") {
+			return nil, fmt.Errorf("allowed_models requires exact upstream model IDs")
+		}
+		if !seen[name] {
+			result = append(result, name)
+			seen[name] = true
+		}
+	}
+	return result, nil
+}
+
+// AllowsUpstreamModel fails closed for malformed persisted whitelists.
+func (a *Auth) AllowsUpstreamModel(model string) bool {
+	if a == nil {
+		return true
+	}
+	allowed, err := AllowedModelsFromMetadata(a.Metadata)
+	if err != nil {
+		return false
+	}
+	if len(allowed) == 0 {
+		return true
+	}
+	model = canonicalModelKey(model)
+	for _, name := range allowed {
+		if model == name {
+			return true
+		}
+	}
+	return false
+}
+
+// ModelAllowedForAuth resolves caller aliases before applying the account whitelist.
+func (m *Manager) ModelAllowedForAuth(auth *Auth, routeModel string) bool {
+	if auth == nil || auth.Metadata["allowed_models"] == nil {
+		return true
+	}
+	model := m.selectionModelForAuth(auth, routeModel)
+	if pool := m.resolveOpenAICompatUpstreamModelPool(auth, model); len(pool) > 0 {
+		for _, upstream := range pool {
+			if !auth.AllowsUpstreamModel(upstream) {
+				return false
+			}
+		}
+		return true
+	}
+	return auth.AllowsUpstreamModel(m.applyAPIKeyModelAlias(auth, model))
+}
+
+// Keep whitelist changes in the existing model-publication fence so a stale
+// catalog computation cannot restore models removed by an account edit.
+func syncAllowedModelsAttribute(auth *Auth) {
+	if auth == nil {
+		return
+	}
+	allowed, err := AllowedModelsFromMetadata(auth.Metadata)
+	if len(allowed) == 0 && err == nil {
+		delete(auth.Attributes, "allowed_models_hash")
+		return
+	}
+	value := "invalid"
+	if err == nil {
+		sort.Strings(allowed)
+		hash := sha256.Sum256([]byte(strings.Join(allowed, "\x00")))
+		value = hex.EncodeToString(hash[:])
+	}
+	if auth.Attributes == nil {
+		auth.Attributes = make(map[string]string)
+	}
+	auth.Attributes["allowed_models_hash"] = value
+}
+
+type requestedUpstreamModelContextKey struct{}
+
+// WithRequestedUpstreamModel applies the account whitelist to special routes
+// whose models are deliberately absent from the ordinary inference registry.
+func WithRequestedUpstreamModel(ctx context.Context, model string) context.Context {
+	return context.WithValue(ctx, requestedUpstreamModelContextKey{}, model)
+}
+
+type currentModelWhitelistContextKey struct{}
+
+func (m *Manager) withCurrentModelWhitelist(ctx context.Context, account *Auth) context.Context {
+	if m.HomeEnabled() {
+		return ctx
+	}
+	accountID := account.ID
+	return context.WithValue(ctx, currentModelWhitelistContextKey{}, func(model string) bool {
+		current, exists := m.GetByID(accountID)
+		return exists && current.AllowsUpstreamModel(model)
+	})
+}
+
+// ModelWhitelistAllows rechecks live policy before each new pinned duplex turn.
+// Already admitted output and interruption do not use this admission gate.
+func ModelWhitelistAllows(ctx context.Context, account *Auth, upstreamModel string) bool {
+	if current, ok := ctx.Value(currentModelWhitelistContextKey{}).(func(string) bool); ok {
+		return current(upstreamModel)
+	}
+	return account.AllowsUpstreamModel(upstreamModel)
+}
