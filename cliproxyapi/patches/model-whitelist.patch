diff --git a/sdk/cliproxy/service_allowed_models_test.go b/sdk/cliproxy/service_allowed_models_test.go
new file mode 100644
index 0000000..96c83d2
--- /dev/null
+++ b/sdk/cliproxy/service_allowed_models_test.go
@@ -0,0 +1,66 @@
+package cliproxy
+
+import (
+	"context"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"testing"
+)
+
+func TestAccountWhitelistModelRegistration(t *testing.T) {
+	manager := coreauth.NewManager(nil, nil, nil)
+	aliases := map[string][]config.OAuthModelAlias{"codex": {{Name: "gpt-6-astra", Alias: "gpt-6-astra-fast", Fork: true}}}
+	cfg := &config.Config{OAuthModelAlias: aliases}
+	manager.SetConfig(cfg)
+	manager.SetOAuthModelAlias(aliases)
+	account, err := manager.Register(context.Background(), &coreauth.Auth{ID: "registration-whitelist", Provider: "codex", Attributes: map[string]string{"plan_type": "pro"}, Metadata: map[string]any{"allowed_models": []string{"gpt-6-astra"}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	service := &Service{cfg: cfg, coreManager: manager}
+	defer GlobalModelRegistry().UnregisterClient(account.ID)
+	if !service.registerModelsForAuth(context.Background(), account) {
+		t.Fatal("registration superseded")
+	}
+	models := GlobalModelRegistry().GetModelsForClient(account.ID)
+	if len(models) != 2 {
+		t.Fatalf("registered %d models, want Astra and Fast: %v", len(models), models)
+	}
+	for _, model := range models {
+		if model.ID != "gpt-6-astra" && model.ID != "gpt-6-astra-fast" {
+			t.Fatalf("unexpected model %s", model.ID)
+		}
+	}
+
+	excluded := account.Clone()
+	excluded.Attributes["excluded_models"] = "gpt-6-astra"
+	excluded, err = manager.Update(context.Background(), excluded)
+	if err != nil {
+		t.Fatal(err)
+	}
+	service.registerModelsForAuth(context.Background(), excluded)
+	if len(GlobalModelRegistry().GetModelsForClient(account.ID)) != 0 {
+		t.Fatal("whitelist bypassed exclusions")
+	}
+	account, err = manager.Update(context.Background(), account)
+	if err != nil {
+		t.Fatal(err)
+	}
+	service.registerModelsForAuth(context.Background(), account)
+	staleFence := newModelRegistrationFence(account, cfg)
+	current := account.Clone()
+	current.Metadata["allowed_models"] = []string{"gpt-6-sol"}
+	current, err = manager.Update(context.Background(), current)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if service.registerResolvedModelsForAuthFenced(account, staleFence, "codex", []*ModelInfo{{ID: "gpt-6-astra"}}) {
+		t.Fatal("stale registration bypassed whitelist fence")
+	}
+	if !service.registerModelsForAuth(context.Background(), current) {
+		t.Fatal("updated registration failed")
+	}
+	if GlobalModelRegistry().ClientSupportsModel(account.ID, "gpt-6-astra") {
+		t.Fatal("removed model remains routable")
+	}
+}
