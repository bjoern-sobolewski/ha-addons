diff --git a/internal/runtime/executor/codex_websockets_model_whitelist_test.go b/internal/runtime/executor/codex_websockets_model_whitelist_test.go
new file mode 100644
index 0000000..ee538a8
--- /dev/null
+++ b/internal/runtime/executor/codex_websockets_model_whitelist_test.go
@@ -0,0 +1,101 @@
+package executor
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	authpkg "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	core "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	translator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// A whitelist change bars new native duplex turns while retaining interrupts.
+func TestCodexDuplexModelWhitelistChanges(t *testing.T) {
+	received := make(chan string, 8)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := (&websocket.Upgrader{}).Upgrade(w, r, nil)
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		for {
+			_, payload, err := conn.ReadMessage()
+			if err != nil {
+				return
+			}
+			kind := gjson.GetBytes(payload, "type").String()
+			received <- kind
+			event := []byte(`{"type":"response.created","response":{"id":"r1","output":[]}}`)
+			if kind == "response.interrupt" {
+				event = []byte(`{"type":"response.incomplete","response":{"id":"r1","output":[],"incomplete_details":{"reason":"interrupted"}}}`)
+			}
+			if err := conn.WriteMessage(websocket.TextMessage, event); err != nil {
+				return
+			}
+		}
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	input := make(chan core.WebsocketInput, 8)
+	ctx = core.WithWebsocketInput(core.WithDownstreamWebsocket(ctx), input)
+	exec := NewCodexWebsocketsExecutor(&config.Config{Codex: config.CodexConfig{ResponseSteering: true}})
+	exec.store = &codexWebsocketSessionStore{sessions: make(map[string]*codexWebsocketSession)}
+	auth := &authpkg.Auth{ID: "policy-duplex", Index: "policy-duplex", Provider: "codex", Attributes: map[string]string{"api_key": "test-key", "base_url": server.URL, "websockets": "true"}}
+	result, err := exec.ExecuteStream(ctx, auth, core.Request{Model: "gpt-6-astra", Payload: []byte(`{"model":"gpt-6-astra","input":[]}`)}, core.Options{SourceFormat: translator.FromString("codex"), Metadata: map[string]any{core.ExecutionSessionMetadataKey: "policy-duplex"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	next := func() []byte {
+		t.Helper()
+		select {
+		case c, ok := <-result.Chunks:
+			if !ok || c.Err != nil {
+				t.Fatalf("stream closed: %v", c.Err)
+			}
+			return c.Payload
+		case <-ctx.Done():
+			t.Fatal(ctx.Err())
+			return nil
+		}
+	}
+	if got := gjson.GetBytes(next(), "type").String(); got != "response.created" {
+		t.Fatal(got)
+	}
+	if got := <-received; got != "response.create" {
+		t.Fatal(got)
+	}
+	auth.Metadata = map[string]any{"allowed_models": []string{"gpt-6-sol"}}
+	for _, kind := range []string{"response.create", "response.append", "response.steer"} {
+		input <- core.WebsocketInput{Payload: []byte(`{"type":"` + kind + `","model":"gpt-6-astra","input":[]}`)}
+		if got := gjson.GetBytes(next(), "error.code").String(); got != "model_whitelist_excluded" {
+			t.Fatalf("%s: %s", kind, got)
+		}
+	}
+	if err := exec.InterruptExecutionSession(ctx, "policy-duplex", []byte(`{"type":"response.interrupt","response_id":"r1"}`)); err != nil {
+		t.Fatal(err)
+	}
+	if got := gjson.GetBytes(next(), "type").String(); got != "response.incomplete" {
+		t.Fatal(got)
+	}
+	if got := <-received; got != "response.interrupt" {
+		t.Fatalf("excluded traffic reached provider: %s", got)
+	}
+	auth.Metadata = map[string]any{"allowed_models": []string{}}
+	input <- core.WebsocketInput{Payload: []byte(`{"type":"response.create","model":"gpt-6-astra","input":[]}`)}
+	if got := gjson.GetBytes(next(), "type").String(); got != "response.created" {
+		t.Fatal(got)
+	}
+	if got := <-received; got != "response.create" {
+		t.Fatal(got)
+	}
+	cancel()
+	for range result.Chunks {
+	}
+}
