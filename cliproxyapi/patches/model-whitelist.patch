+package auth
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"testing"
+)
+
+func TestAccountModelWhitelist(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	manager.SetConfig(&config.Config{})
+	manager.SetOAuthModelAlias(map[string][]config.OAuthModelAlias{"codex": {{Name: "gpt-6-astra", Alias: "gpt-6-astra-fast", Fork: true}}})
+	account := &Auth{ID: "whitelist-test", Provider: "codex", Prefix: "dedicated", Metadata: map[string]any{"allowed_models": []any{" GPT-6-ASTRA ", "gpt-6-astra"}}}
+	for _, model := range []string{"gpt-6-astra", "gpt-6-astra(high)", "gpt-6-astra-fast", "dedicated/gpt-6-astra-fast"} {
+		if !manager.ModelAllowedForAuth(account, model) {
+			t.Errorf("allowed model rejected: %s", model)
+		}
+	}
+	for _, model := range []string{"gpt-6-sol", "gpt-6-astra-new", "new-model"} {
+		if manager.ModelAllowedForAuth(account, model) {
+			t.Errorf("non-whitelisted model allowed: %s", model)
+		}
+	}
+	// Selection must reject a blocked model even while an old catalog still lists it.
+	catalog := registry.GetGlobalRegistry()
+	catalog.RegisterClient(account.ID, "codex", []*registry.ModelInfo{{ID: "gpt-6-sol"}})
+	defer catalog.UnregisterClient(account.ID)
+	if manager.authSupportsRouteModel(catalog, account, "gpt-6-sol") {
+		t.Fatal("stale registry bypassed whitelist")
+	}
+	for _, invalid := range []any{true, "gpt-6-astra", []any{"gpt-6-astra", 2}, []string{"*"}} {
+		account.Metadata["allowed_models"] = invalid
+		if manager.ModelAllowedForAuth(account, "gpt-6-astra") {
+			t.Fatal("malformed whitelist did not fail closed")
+		}
+	}
+	for _, empty := range []any{nil, []any{}, []string{" "}} {
+		account.Metadata["allowed_models"] = empty
+		if !manager.ModelAllowedForAuth(account, "gpt-6-sol") {
+			t.Fatal("empty whitelist restricted account")
+		}
+	}
+}
+func TestWhitelistPreservedOnRefresh(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	account := &Auth{ID: "whitelist-refresh", Provider: "codex", Metadata: map[string]any{"allowed_models": []string{"gpt-6-astra"}}}
+	registered, err := manager.Register(context.Background(), account)
+	if err != nil {
+		t.Fatal(err)
+	}
+	stale := registered.Clone()
+	current := registered.Clone()
+	current.Metadata["allowed_models"] = []string{"gpt-6-sol"}
+	current, err = manager.Update(context.Background(), current)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if current.Attributes["allowed_models_hash"] == registered.Attributes["allowed_models_hash"] {
+		t.Fatal("whitelist change missing from registration fence")
+	}
+	refreshed := MergeRefreshedAuth(registered, current, stale)
+	if !refreshed.AllowsUpstreamModel("gpt-6-sol") || refreshed.AllowsUpstreamModel("gpt-6-astra") {
+		t.Fatal("refresh overwrote current whitelist")
+	}
+}
+
+func TestWhitelistDuplexAdmissionUsesCurrentAccount(t *testing.T) {
+	manager := NewManager(nil, nil, nil)
+	original, err := manager.Register(context.Background(), &Auth{ID: "duplex-whitelist", Provider: "codex"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx := manager.withCurrentModelWhitelist(context.Background(), original)
+	if !ModelWhitelistAllows(ctx, original, "gpt-6-sol") {
+		t.Fatal("unrestricted initial admission failed")
+	}
+	updated := original.Clone()
+	updated.Metadata = map[string]any{"allowed_models": []string{"gpt-6-astra"}}
+	if _, err = manager.Update(context.Background(), updated); err != nil {
+		t.Fatal(err)
+	}
+	if ModelWhitelistAllows(ctx, original, "gpt-6-sol") {
+		t.Fatal("pinned snapshot bypassed current whitelist")
+	}
+	if !ModelWhitelistAllows(ctx, original, "gpt-6-astra") {
+		t.Fatal("current allowed model rejected")
+	}
+	eligibility := authSelectionEligibilityForRequest(WithRequestedUpstreamModel(context.Background(), "gpt-live-1.1-codex"), cliproxyexecutor.Options{})
+	current, _ := manager.GetByID(original.ID)
+	if eligibility.allows(current) {
+		t.Fatal("special voice route bypassed whitelist")
+	}
+}
