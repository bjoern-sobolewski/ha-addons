+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"github.com/tidwall/gjson"
+)
+
+type oversizedTransportChoice struct{ http, ws bool }
+type oversizedCaptureExecutor struct {
+	websocketProviderCaptureExecutor
+	choices chan oversizedTransportChoice
+}
+
+func (e *oversizedCaptureExecutor) ExecuteStream(ctx context.Context, auth *coreauth.Auth, req coreexecutor.Request, opts coreexecutor.Options) (*coreexecutor.StreamResult, error) {
+	e.choices <- oversizedTransportChoice{coreexecutor.RequiredUpstreamHTTP(ctx), coreexecutor.RequiredUpstreamWebsocket(ctx)}
+	return e.websocketCaptureExecutor.ExecuteStream(ctx, auth, req, opts)
+}
+
+func TestResponsesWebsocketOversizedTransportBoundaries(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	for _, tc := range []struct {
+		name, provider, kind, parent string
+		large, wantHTTP, wantWS      bool
+	}{
+		{name: "small Codex", provider: "codex", kind: "response.create"},
+		{name: "large Codex reset", provider: "codex", kind: "response.create", large: true, wantHTTP: true},
+		{name: "large xAI unchanged", provider: "xai", kind: "response.create", large: true},
+		{name: "large delta must retain upstream state", provider: "codex", kind: "response.create", parent: `,"previous_response_id":"resp-upstream"`, large: true, wantWS: true},
+		{name: "large append must retain upstream state", provider: "codex", kind: "response.append", large: true, wantWS: true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			exec := &oversizedCaptureExecutor{websocketProviderCaptureExecutor: websocketProviderCaptureExecutor{provider: tc.provider}, choices: make(chan oversizedTransportChoice, 4)}
+			manager := coreauth.NewManager(nil, nil, nil)
+			manager.RegisterExecutor(exec)
+			auth := &coreauth.Auth{ID: "size-boundary", Provider: tc.provider, Status: coreauth.StatusActive, Attributes: map[string]string{"websockets": "true"}}
+			if _, err := manager.Register(context.Background(), auth); err != nil {
+				t.Fatal(err)
+			}
+			registry.GetGlobalRegistry().RegisterClient(auth.ID, auth.Provider, []*registry.ModelInfo{{ID: "boundary-model"}})
+			defer registry.GetGlobalRegistry().UnregisterClient(auth.ID)
+			h := NewOpenAIResponsesAPIHandler(handlers.NewBaseAPIHandlers(&sdkconfig.SDKConfig{}, manager))
+			router := gin.New()
+			router.GET("/responses", h.ResponsesWebsocket)
+			server := httptest.NewServer(router)
+			defer server.Close()
+			c, _, err := websocket.DefaultDialer.Dial("ws"+strings.TrimPrefix(server.URL, "http")+"/responses", nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer c.Close()
+			turn := func(body string) {
+				t.Helper()
+				_ = c.SetReadDeadline(time.Now().Add(10 * time.Second))
+				if err := c.WriteMessage(websocket.TextMessage, []byte(body)); err != nil {
+					t.Fatal(err)
+				}
+				_, event, err := c.ReadMessage()
+				if err != nil {
+					t.Fatal(err)
+				}
+				if gjson.GetBytes(event, "type").String() != "response.completed" {
+					t.Fatalf("unexpected response: %.300s", event)
+				}
+			}
+			turn(`{"type":"response.create","model":"boundary-model","input":[]}`)
+			<-exec.choices
+			content := "small"
+			if tc.large {
+				content = strings.Repeat("x", responsesWebsocketCodexHTTPThreshold)
+			}
+			turn(`{"type":"` + tc.kind + `"` + tc.parent + `,"input":[{"type":"message","role":"user","content":"` + content + `"}]}`)
+			got := <-exec.choices
+			if got.http != tc.wantHTTP || got.ws != tc.wantWS {
+				t.Fatalf("transport requirements=%+v, want HTTP=%v WS=%v", got, tc.wantHTTP, tc.wantWS)
+			}
+		})
+	}
+}
