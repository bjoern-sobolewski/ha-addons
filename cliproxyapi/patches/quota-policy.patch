+func TestQuotaPolicyAllLimitsUnknownZeroAndStorageFailure(t *testing.T) {
+	s := NewPolicyStore()
+	dir := t.TempDir()
+	filename := filepath.Join(dir, "policies.json")
+	_ = s.Load(filename)
+	now := time.Now()
+	index := t.Name()
+	Capture(index, "claude", http.Header{"Anthropic-Ratelimit-Unified-7d-Opus-Utilization": {"1"}}, now, "api_response_headers")
+	if err := s.Set(index, "claude", map[string]float64{"claude-7d-opus": 0}); err != nil {
+		t.Fatal(err)
+	}
+	if s.Allows(index, "claude", now) {
+		t.Fatal("zero threshold did not block model-specific exhaustion")
+	}
+	if err := s.Set(index, "claude", map[string]float64{"claude-5h": 10}); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.State(index, "claude", now).Reason; got != "quota_unknown" {
+		t.Fatal(got)
+	}
+	// Other threads can update other accounts without lost settings.
+	var wg sync.WaitGroup
+	for _, id := range []string{"one", "two"} {
+		wg.Add(1)
+		go func(id string) {
+			defer wg.Done()
+			if err := s.Set(id, "codex", map[string]float64{"window": 10}); err != nil {
+				t.Error(err)
+			}
+		}(id)
+	}
+	wg.Wait()
+	if len(s.Thresholds("one", "codex")) != 1 || len(s.Thresholds("two", "codex")) != 1 {
+		t.Fatal("lost concurrent account edit")
+	}
+	if err := s.CompareAndSet(index, "claude", map[string]float64{}, map[string]float64{}); !errors.Is(err, ErrPolicyChanged) {
+		t.Fatalf("expected conflict, got %v", err)
+	}
+	// Replacing a destination directory fails atomically and leaves the old in-memory policy intact.
+	s.path = filepath.Join(dir, "directory")
+	_ = os.Mkdir(s.path, 0700)
+	if err := s.Set(index, "claude", map[string]float64{}); err == nil {
+		t.Fatal("storage failure reported success")
+	}
+	if s.Allows(index, "claude", now) {
+		t.Fatal("storage failure erased active policy")
+	}
+	if err := s.Set(index, "claude", map[string]float64{"x": 101}); err == nil {
+		t.Fatal("invalid minimum accepted")
+	}
+	if err := os.WriteFile(filename, []byte(`{"broken":null`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := NewPolicyStore().Load(filename); err == nil {
+		t.Fatal("corrupt policy silently ignored")
+	}
+	for _, content := range []string{`{"codex:account":null}`, `{"unknown:account":{"window":10}}`, `{"codex:":{"window":10}}`} {
+		if err := os.WriteFile(filename, []byte(content), 0600); err != nil {
+			t.Fatal(err)
+		}
+		if err := NewPolicyStore().Load(filename); err == nil {
+			t.Fatalf("invalid policy structure accepted: %s", content)
+		}
+	}
+}
