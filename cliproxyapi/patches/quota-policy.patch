@@ -0,0 +1,64 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/quotatraffic"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestQuotaPolicyContractPreservesManualSettingsAndRejectsInvalidEdits(t *testing.T) {
+	old := quotatraffic.RoutingPolicies
+	defer func() { quotatraffic.RoutingPolicies = old }()
+	store := quotatraffic.NewPolicyStore()
+	quotatraffic.RoutingPolicies = store
+	if err := store.Load(filepath.Join(t.TempDir(), "policy.json")); err != nil {
+		t.Fatal(err)
+	}
+	manager := coreauth.NewManager(nil, nil, nil)
+	auth, err := manager.Register(coreauth.WithSkipPersist(context.Background()), &coreauth.Auth{ID: t.Name(), Provider: "codex", Disabled: true, Status: coreauth.StatusDisabled, Attributes: map[string]string{"priority": "7"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	quotatraffic.Capture(auth.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"90"}, "X-Codex-Primary-Window-Minutes": {"300"}}, time.Now(), "api_response_headers")
+	h := &Handler{authManager: manager}
+	put := func(thresholds any, expected any) int {
+		data, _ := json.Marshal(map[string]any{"auth_index": auth.Index, "provider": "codex", "thresholds": thresholds, "expected_thresholds": expected})
+		recorder := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(recorder)
+		c.Request = httptest.NewRequest("PUT", "/", strings.NewReader(string(data)))
+		c.Request.Header.Set("Content-Type", "application/json")
+		h.PutQuotaPolicy(c)
+		return recorder.Code
+	}
+	for _, v := range []any{nil, map[string]any{"x-codex-primary@300": nil}, map[string]any{"x-codex-primary@300": 101}, map[string]any{"unobserved": 10}} {
+		if got := put(v, map[string]float64{}); got != 400 {
+			t.Fatalf("invalid edit returned %d", got)
+		}
+	}
+	threshold := map[string]float64{"x-codex-primary@300": 10}
+	if got := put(threshold, map[string]float64{}); got != 200 {
+		t.Fatal(got)
+	}
+	if got := put(map[string]float64{}, map[string]float64{}); got != 409 {
+		t.Fatal("stale edit accepted", got)
+	}
+	current, _ := manager.GetByID(auth.ID)
+	if !current.Disabled || current.Attributes["priority"] != "7" {
+		t.Fatal("manual fields changed")
+	}
+	if got := put(map[string]float64{}, threshold); got != 200 {
+		t.Fatal(got)
+	}
+	current, _ = manager.GetByID(auth.ID)
+	if !current.Disabled {
+		t.Fatal("clearing policy enabled manually disabled account")
+	}
+}
