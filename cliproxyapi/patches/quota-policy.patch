+)
+
+func TestQuotaPolicyAdmissionAcrossSchedulersAffinityPinsAndRetries(t *testing.T) {
+	old := quotatraffic.RoutingPolicies
+	defer func() { quotatraffic.RoutingPolicies = old }()
+	store := quotatraffic.NewPolicyStore()
+	quotatraffic.RoutingPolicies = store
+	if err := store.Load(filepath.Join(t.TempDir(), "policies.json")); err != nil {
+		t.Fatal(err)
+	}
+	for _, kind := range []string{"builtin", "legacy", "plugin", "affinity", "affinity-quota"} {
+		t.Run(kind, func(t *testing.T) {
+			manager := NewManager(nil, &FillFirstSelector{}, nil)
+			switch kind {
+			case "legacy":
+				manager.SetPluginScheduler(&fakePluginScheduler{})
+			case "plugin":
+				manager.SetPluginScheduler(&fakePluginScheduler{handled: true, pick: func(_ context.Context, req pluginapi.SchedulerPickRequest) (pluginapi.SchedulerPickResponse, bool, error) {
+					return pluginapi.SchedulerPickResponse{AuthID: req.Candidates[0].ID}, true, nil
+				}})
+			case "affinity", "affinity-quota":
+				mode := SessionAffinityRebindOnAny
+				if kind == "affinity-quota" {
+					mode = SessionAffinityRebindOnQuota
+				}
+				affinity := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &FillFirstSelector{}, TTL: time.Hour, RebindOn: mode})
+				defer affinity.Stop()
+				manager.SetSelector(affinity)
+			}
+			manager.RegisterExecutor(schedulerTestExecutor{provider: "codex"})
+			id := t.Name()
+			high, low := id+"-high", id+"-low"
+			model := id + "-model"
+			for _, a := range []*Auth{{ID: high, Provider: "codex", Status: StatusActive, Attributes: map[string]string{"priority": "10", "websockets": "true"}}, {ID: low, Provider: "codex", Status: StatusActive, Attributes: map[string]string{"priority": "0", "websockets": "true"}}} {
+				if _, err := manager.Register(WithSkipPersist(context.Background()), a); err != nil {
+					t.Fatal(err)
+				}
+				registry.GetGlobalRegistry().RegisterClient(a.ID, "codex", []*registry.ModelInfo{{ID: model}})
+				defer registry.GetGlobalRegistry().UnregisterClient(a.ID)
+			}
+			opts := cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.DerivedSessionIDMetadataKey: "quota-policy-session"}}
+			pick := func(mixed bool, tried map[string]struct{}) (*Auth, error) {
+				if mixed {
+					a, _, _, err := manager.pickNextMixed(context.Background(), []string{"codex"}, model, opts, tried)
+					return a, err
+				}
+				a, _, err := manager.pickNext(context.Background(), "codex", model, opts, tried)
+				return a, err
+			}
+			a, err := pick(false, nil)
+			if err != nil || a.ID != high {
+				t.Fatalf("initial pick %v %v", a, err)
+			}
+			now := time.Now()
+			quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"90"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now, "websocket_event")
+			threshold := map[string]float64{"x-codex-primary@300": 10}
+			if err := store.Set(a.Index, "codex", threshold); err != nil {
+				t.Fatal(err)
+			}
+			for _, mixed := range []bool{false, true} {
+				got, err := pick(mixed, nil)
+				if err != nil || got.ID != low {
+					t.Fatalf("excluded priority/binding bypass: %v %v", got, err)
+				}
+			}
+			// The last eligible account already failed: retry must not revive the protected account.
+			if _, err := pick(false, map[string]struct{}{low: {}}); err == nil {
+				t.Fatal("retry bypassed policy")
+			}
+			pinned := opts
+			pinned.Metadata = map[string]any{cliproxyexecutor.PinnedAuthMetadataKey: high}
+			if got, _, err := manager.pickNext(context.Background(), "codex", model, pinned, nil); err == nil || got != nil {
+				t.Fatal("pin bypassed policy")
+			}
+			quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"89"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now.Add(time.Second), "websocket_event")
+			got, _, err := manager.pickNext(context.Background(), "codex", model, cliproxyexecutor.Options{}, nil)
+			if err != nil || got.ID != high {
+				t.Fatalf("fresh recovery %v %v", got, err)
+			}
+			if a.Disabled || a.Attributes["priority"] != "10" {
+				t.Fatal("policy changed manual settings")
+			}
+		})
+	}
+}
