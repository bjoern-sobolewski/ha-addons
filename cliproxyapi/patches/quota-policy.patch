+++ b/internal/quotatraffic/policy_fraction_test.go
@@ -0,0 +1,22 @@
+package quotatraffic
+
+import (
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestQuotaPolicyFractionalBoundary(t *testing.T) {
+	s := NewPolicyStore()
+	if err := s.Load(filepath.Join(t.TempDir(), "policy.json")); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	policyObservation(t.Name(), "300", "80.1", now)
+	if err := s.Set(t.Name(), "codex", map[string]float64{"x-codex-primary@300": 19.9}); err != nil {
+		t.Fatal(err)
+	}
+	if s.Allows(t.Name(), "codex", now) {
+		t.Fatal("fractional equality bypassed minimum")
+	}
+}
diff --git a/internal/quotatraffic/policy_test.go b/internal/quotatraffic/policy_test.go
new file mode 100644
index 00000000..9bb9af00
--- /dev/null
+++ b/internal/quotatraffic/policy_test.go
@@ -0,0 +1,133 @@
+package quotatraffic
+
+import (
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+func policyObservation(index, window string, remaining string, at time.Time) {
+	Capture(index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {remaining}, "X-Codex-Primary-Window-Minutes": {window}, "X-Codex-Primary-Reset-After-Seconds": {"3600"}}, at, "websocket_event")
+}
+func TestQuotaPolicyBoundariesRecoveryAndIndependentWindows(t *testing.T) {
+	s := NewPolicyStore()
+	filename := filepath.Join(t.TempDir(), "policies.json")
+	if err := s.Load(filename); err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	index := t.Name()
+	policyObservation(index, "300", "80", now)
+	state := s.State(index, "codex", now)
+	if len(state.Windows) != 1 || !s.Allows(index, "codex", now.Add(24*time.Hour)) {
+		t.Fatal("unconfigured behavior changed")
+	}
+	id := state.Windows[0].ID
+	if err := s.Set(index, "codex", map[string]float64{id: 20}); err != nil {
+		t.Fatal(err)
+	}
+	if got := s.State(index, "codex", now).Reason; got != "minimum_reached" {
+		t.Fatal(got)
+	}
+	policyObservation(index, "300", "79.9", now.Add(time.Second))
+	if !s.Allows(index, "codex", now.Add(time.Second)) {
+		t.Fatal("fresh recovery did not permit admission")
+	}
+	if got := s.State(index, "codex", now.Add(16*time.Minute)).Reason; got != "quota_stale" {
+		t.Fatal(got)
+	}
+	if got := s.State(index, "codex", now.Add(2*time.Hour)).Reason; got != "awaiting_reset_observation" {
+		t.Fatal(got)
+	}
+	// The provider changed the actual primary duration: do not transfer 5h's setting to weekly.
+	policyObservation(index, "10080", "1", now.Add(2*time.Hour))
+	if got := s.State(index, "codex", now.Add(2*time.Hour)).Reason; got != "quota_unknown" {
