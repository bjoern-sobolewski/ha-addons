diff --git a/internal/quotatraffic/policy.go b/internal/quotatraffic/policy.go
new file mode 100644
index 00000000..de07ad9a
--- /dev/null
+++ b/internal/quotatraffic/policy.go
@@ -0,0 +1,311 @@
+package quotatraffic
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/live"
+)
+
+const PolicyMaxAge = 15 * time.Minute
+
+type WindowPolicy struct {
+	ID         string    `json:"id"`
+	Label      string    `json:"label"`
+	Minimum    *float64  `json:"minimum_remaining_percent"`
+	Remaining  *float64  `json:"remaining_percent"`
+	ObservedAt time.Time `json:"observed_at"`
+	ResetAt    time.Time `json:"reset_at"`
+	Source     string    `json:"source"`
+	Excluded   bool      `json:"excluded"`
+	Reason     string    `json:"reason"`
+}
+
+type PolicyState struct {
+	AuthIndex        string             `json:"auth_index"`
+	Provider         string             `json:"provider"`
+	ManuallyDisabled bool               `json:"manually_disabled"`
+	Thresholds       map[string]float64 `json:"thresholds"`
+	Windows          []WindowPolicy     `json:"windows"`
+	Excluded         bool               `json:"excluded"`
+	Reason           string             `json:"reason"`
+}
+
+type PolicyStore struct {
+	mu       sync.RWMutex
+	path     string
+	settings map[string]map[string]float64
+}
+
+// Settings belong to CPA so every consumer, retry and pinned transport sees the
+// same policy even when Keeper is offline. No credential or provider body is stored.
+var RoutingPolicies = NewPolicyStore()
+
+func NewPolicyStore() *PolicyStore            { return &PolicyStore{settings: map[string]map[string]float64{}} }
+func policyKey(index, provider string) string { return provider + ":" + index }
+
+func validThresholds(values map[string]float64) bool {
+	if len(values) > 64 {
+		return false
+	}
+	for id, n := range values {
+		if len(id) == 0 || len(id) > 256 || strings.ContainsAny(id, "\r\n\x00") || math.IsNaN(n) || math.IsInf(n, 0) || n < 0 || n > 100 {
+			return false
+		}
+	}
+	return true
+}
+
+// Load must succeed before serving requests. Corrupt/unreadable policy files
+// must never silently turn a configured safeguard off.
+func (s *PolicyStore) Load(filename string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	data, err := os.ReadFile(filename)
+	settings := map[string]map[string]float64{}
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return fmt.Errorf("read quota policy file: %w", err)
+	}
+	if err == nil {
+		if json.Unmarshal(data, &settings) != nil || settings == nil || len(settings) > 4096 {
+			return errors.New("invalid quota policy file")
+		}
+		for key, v := range settings {
+			provider, index, ok := strings.Cut(key, ":")
+			if !ok || index == "" || (provider != "codex" && provider != "claude") || v == nil || !validThresholds(v) {
+				return errors.New("invalid quota policy file")
+			}
+		}
+	}
+	s.path = filename
+	s.settings = settings
+	return nil
+}
+
+func (s *PolicyStore) Thresholds(index, provider string) map[string]float64 {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+	out := map[string]float64{}
+	for id, n := range s.settings[policyKey(index, provider)] {
+		out[id] = n
+	}
+	return out
+}
+
+// Set commits to disk before publishing to readers. Failed persistence keeps the
+// old policy active; replacing one account never overwrites another's settings.
+var ErrPolicyChanged = errors.New("quota policy changed")
+
+func (s *PolicyStore) Set(index, provider string, values map[string]float64) error {
+	return s.set(index, provider, values, nil)
+}
+func (s *PolicyStore) CompareAndSet(index, provider string, values, expected map[string]float64) error {
+	return s.set(index, provider, values, &expected)
+}
+func (s *PolicyStore) set(index, provider string, values map[string]float64, expected *map[string]float64) error {
+	if index == "" || (provider != "codex" && provider != "claude") || !validThresholds(values) {
+		return errors.New("invalid quota policy")
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if expected != nil {
+		current := s.settings[policyKey(index, provider)]
+		if len(current) != 0 || len(*expected) != 0 {
+			if !reflect.DeepEqual(current, *expected) {
+				return ErrPolicyChanged
+			}
+		}
+	}
+	next := make(map[string]map[string]float64, len(s.settings)+1)
+	for k, v := range s.settings {
+		next[k] = v
+	}
+	key := policyKey(index, provider)
+	if len(values) == 0 {
+		delete(next, key)
+	} else {
+		copied := map[string]float64{}
+		for k, v := range values {
+			copied[k] = v
+		}
+		next[key] = copied
+	}
+	if len(next) > 4096 {
+		return errors.New("too many quota policies")
+	}
+	if s.path == "" {
+		return errors.New("quota policy persistence is unavailable")
+	}
+	data, err := json.MarshalIndent(next, "", "  ")
+	if err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(s.path), ".quota-policy-*")
+	if err != nil {
+		return err
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	if err = file.Chmod(0600); err == nil {
+		_, err = file.Write(data)
+	}
+	if err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err == nil {
+		err = os.Rename(name, s.path)
+	}
+	if err != nil {
+		return err
+	}
+	s.settings = next
+	live.Default.Publish("quota")
+	return nil
+}
+
+func observationWindow(o Observation) (WindowPolicy, bool) {
+	w := WindowPolicy{ID: o.Window, Label: o.Window, ObservedAt: o.ObservedAt, Source: o.Source}
+	for key, values := range o.Headers {
+		if len(values) == 0 {
+			continue
+		}
+		lower := strings.ToLower(key)
+		if strings.HasSuffix(lower, "-used-percent") || strings.HasSuffix(lower, "-utilization") {
+			used, err := strconv.ParseFloat(values[0], 64)
+			if err != nil {
+				continue
+			}
+			if strings.HasSuffix(lower, "-utilization") {
+				used *= 100
+			}
+			remaining := 100 - used
+			if remaining >= 0 && remaining <= 100 {
+				w.Remaining = &remaining
+			}
+		}
+		if strings.HasSuffix(lower, "-window-minutes") {
+			minutes, err := strconv.ParseInt(values[0], 10, 64)
+			if err == nil && minutes > 0 {
+				w.ID = o.Window + "@" + strconv.FormatInt(minutes, 10)
+				w.Label = fmt.Sprintf("%s (%d min)", o.Window, minutes)
+			}
+		}
+		if strings.HasSuffix(lower, "-reset-at") || strings.HasSuffix(lower, "-reset") {
+			n, err := strconv.ParseInt(values[0], 10, 64)
+			if err == nil && n > 0 {
+				w.ResetAt = time.Unix(n, 0)
+			}
+		}
+	}
+	// Relative reset is anchored to capture time, never to the cache-read clock.
+	if w.ResetAt.IsZero() {
+		for key, values := range o.Headers {
+			if strings.HasSuffix(strings.ToLower(key), "-reset-after-seconds") && len(values) > 0 {
+				n, err := strconv.ParseInt(values[0], 10, 64)
+				if err == nil && n >= 0 && n <= int64((365*24*time.Hour)/time.Second) {
+					w.ResetAt = o.ObservedAt.Add(time.Duration(n) * time.Second)
+				}
+			}
+		}
+	}
+	if w.Remaining != nil {
+		scope := strings.TrimPrefix(o.Window, "x-codex-")
+		scope = strings.TrimSuffix(strings.TrimSuffix(scope, "-primary"), "-secondary")
+		if scope == "primary" || scope == "secondary" {
+			scope = "Codex"
+		}
+		scope = strings.TrimPrefix(scope, "claude-")
+		if at := strings.LastIndex(w.ID, "@"); at >= 0 {
+			minutes, _ := strconv.Atoi(w.ID[at+1:])
+			period := fmt.Sprintf("%d min", minutes)
+			if minutes == 300 {
+				period = "5-hour"
+			}
+			if minutes == 10080 {
+				period = "Weekly"
+			}
+			w.Label = period + " · " + scope
+		} else {
+			w.Label = scope
+		}
+	}
+	return w, w.Remaining != nil
+}
+
+// All configured windows protect the whole account, including additional/model
+// limits: this intentionally needs no guessing about provider model aliases.
+func (s *PolicyStore) State(index, provider string, now time.Time) PolicyState {
+	thresholds := s.Thresholds(index, provider)
+	state := PolicyState{AuthIndex: index, Provider: provider, Thresholds: thresholds, Windows: []WindowPolicy{}}
+	windows := map[string]WindowPolicy{}
+	for _, o := range Read(map[string]bool{index: true}) {
+		if o.Provider == provider {
+			if w, ok := observationWindow(o); ok {
+				windows[w.ID] = w
+			}
+		}
+	}
+	for id, n := range thresholds {
+		w := windows[id]
+		w.ID = id
+		if w.Label == "" {
+			w.Label = id
+		}
+		minimum := n
+		w.Minimum = &minimum
+		windows[id] = w
+	}
+	ids := make([]string, 0, len(windows))
+	for id := range windows {
+		ids = append(ids, id)
+	}
+	sort.Strings(ids)
+	for _, id := range ids {
+		w := windows[id]
+		if w.Minimum != nil {
+			switch {
+			case w.Remaining == nil || w.ObservedAt.IsZero():
+				w.Reason = "quota_unknown"
+			case w.ObservedAt.After(now.Add(time.Minute)):
+				w.Reason = "quota_unknown"
+			case !w.ResetAt.IsZero() && !w.ResetAt.After(now):
+				w.Reason = "awaiting_reset_observation"
+			case now.Sub(w.ObservedAt) > PolicyMaxAge:
+				w.Reason = "quota_stale"
+			case *w.Remaining <= *w.Minimum+1e-9: // tolerate subtraction roundoff at a fractional boundary
+				w.Reason = "minimum_reached"
+			}
+			w.Excluded = w.Reason != ""
+			if w.Excluded {
+				state.Excluded = true
+				if state.Reason == "" {
+					state.Reason = w.Reason
+				}
+			}
+		}
+		state.Windows = append(state.Windows, w)
+	}
+	return state
+}
+
+func (s *PolicyStore) Allows(index, provider string, now time.Time) bool {
+	// Preserve the original hot path completely for unconfigured accounts.
+	s.mu.RLock()
+	configured := len(s.settings[policyKey(index, provider)]) > 0
+	s.mu.RUnlock()
+	return !configured || !s.State(index, provider, now).Excluded
+}
diff --git a/internal/quotatraffic/policy_fraction_test.go b/internal/quotatraffic/policy_fraction_test.go
new file mode 100644
index 00000000..917ce2b6
