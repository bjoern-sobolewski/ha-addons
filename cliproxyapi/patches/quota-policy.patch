+package auth
+
+import (
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/quotatraffic"
+	"time"
+)
+
+// QuotaPolicyAllows is an admission check, independent of manual disabled and cooldown state.
+func QuotaPolicyAllows(auth *Auth, now time.Time) bool {
+	return auth != nil && quotatraffic.RoutingPolicies.Allows(auth.Index, auth.Provider, now)
+}
