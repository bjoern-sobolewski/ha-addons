new file mode 100644
index 00000000..141712a7
--- /dev/null
+++ b/internal/api/handlers/management/quota_policy.go
@@ -0,0 +1,73 @@
+package management
+
+import (
+	"errors"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/quotatraffic"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"net/http"
+	"time"
+)
+
+func quotaPolicyState(a *coreauth.Auth) quotatraffic.PolicyState {
+	state := quotatraffic.RoutingPolicies.State(a.Index, a.Provider, time.Now())
+	state.ManuallyDisabled = a.Disabled || a.Status == coreauth.StatusDisabled
+	return state
+}
+
+func (h *Handler) GetQuotaPolicies(c *gin.Context) {
+	items := []quotatraffic.PolicyState{}
+	if h.authManager != nil {
+		for _, a := range h.authManager.List() {
+			if a != nil && (a.Provider == "codex" || a.Provider == "claude") {
+				items = append(items, quotaPolicyState(a))
+			}
+		}
+	}
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, gin.H{"items": items})
+}
+
+func (h *Handler) PutQuotaPolicy(c *gin.Context) {
+	var body struct {
+		AuthIndex  string              `json:"auth_index"`
+		Provider   string              `json:"provider"`
+		Thresholds map[string]*float64 `json:"thresholds"`
+		Expected   *map[string]float64 `json:"expected_thresholds"`
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 32768)
+	if c.ShouldBindJSON(&body) != nil || body.AuthIndex == "" || body.Thresholds == nil || body.Expected == nil {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid quota policy"})
+		return
+	}
+	if h.authManager != nil {
+		for _, a := range h.authManager.List() {
+			if a == nil || a.Index != body.AuthIndex || a.Provider != body.Provider {
+				continue
+			}
+			known := map[string]bool{}
+			for _, w := range quotaPolicyState(a).Windows {
+				known[w.ID] = true
+			}
+			values := map[string]float64{}
+			for id, n := range body.Thresholds {
+				if !known[id] || n == nil || !(*n >= 0 && *n <= 100) {
+					c.JSON(http.StatusBadRequest, gin.H{"error": "threshold must be 0–100 for an observed or already configured window"})
+					return
+				}
+				values[id] = *n
+			}
+			if err := quotatraffic.RoutingPolicies.CompareAndSet(a.Index, a.Provider, values, *body.Expected); err != nil {
+				if errors.Is(err, quotatraffic.ErrPolicyChanged) {
+					c.JSON(http.StatusConflict, gin.H{"error": "quota policy changed; reload and retry"})
+					return
+				}
+				c.JSON(http.StatusInternalServerError, gin.H{"error": "quota policy could not be persisted"})
+				return
+			}
+			c.JSON(http.StatusOK, quotaPolicyState(a))
+			return
+		}
+	}
+	c.JSON(http.StatusNotFound, gin.H{"error": "quota policy account not found"})
+}
