--- /dev/null
+++ b/internal/api/handlers/management/quota_observations.go
@@ -0,0 +1,20 @@
+package management
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/quotatraffic"
+	"net/http"
+)
+
+func (h *Handler) GetQuotaObservations(c *gin.Context) {
+	allowed := map[string]bool{}
+	if h.authManager != nil {
+		for _, a := range h.authManager.List() {
+			if a != nil && !a.Disabled {
+				allowed[a.Index] = true
+			}
+		}
+	}
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, gin.H{"items": quotatraffic.Read(allowed)})
+}
