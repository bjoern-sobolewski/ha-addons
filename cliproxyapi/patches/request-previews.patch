diff --git a/internal/promptpreview/preview.go b/internal/promptpreview/preview.go
new file mode 100644
index 00000000..7398f020
--- /dev/null
+++ b/internal/promptpreview/preview.go
@@ -0,0 +1,181 @@
+// Package promptpreview extracts bounded user-text previews, never full request bodies.
+package promptpreview
+
+import (
+	"context"
+	"crypto/sha256"
+	"strings"
+	"sync"
+	"time"
+	"unicode"
+
+	"github.com/tidwall/gjson"
+)
+
+const CharacterLimit = 240
+const sessionLimit = 4096
+const sessionLifetime = 24 * time.Hour
+
+type Preview struct {
+	Initial string `json:"initial,omitempty"`
+	Current string `json:"current,omitempty"`
+}
+
+type sessionPreview struct {
+	preview Preview
+	updated time.Time
+}
+
+type Store struct {
+	mu       sync.Mutex
+	sessions map[[32]byte]sessionPreview
+}
+
+func New() *Store { return &Store{sessions: make(map[[32]byte]sessionPreview)} }
+
+var Default = New()
+
+// Text normalizes whitespace and bounds Unicode characters before any persistence.
+func Text(value string) string {
+	var result strings.Builder
+	count := 0
+	space := false
+	for _, character := range value {
+		if unicode.IsSpace(character) {
+			space = result.Len() > 0
+			continue
+		}
+		if unicode.IsControl(character) || unicode.Is(unicode.Cf, character) {
+			continue
+		}
+		if count >= CharacterLimit {
+			break
+		}
+		if space {
+			result.WriteByte(' ')
+			count++
+			space = false
+			if count >= CharacterLimit {
+				break
+			}
+		}
+		result.WriteRune(character)
+		count++
+	}
+	return result.String()
+}
+
+func userText(content gjson.Result) string {
+	if content.Type == gjson.String {
+		return Text(content.String())
+	}
+	if !content.IsArray() {
+		return ""
+	}
+	var parts []string
+	content.ForEach(func(_, part gjson.Result) bool {
+		kind := part.Get("type").String()
+		if kind == "input_text" || kind == "text" || kind == "" {
+			if text := Text(part.Get("text").String()); text != "" {
+				parts = append(parts, text)
+			}
+		}
+		return len(parts) < CharacterLimit
+	})
+	return Text(strings.Join(parts, " "))
+}
+
+func isClientContext(text string) bool {
+	for _, prefix := range []string{"# AGENTS.md instructions", "<environment_context>", "<user_instructions>", "<permissions instructions>", "<external_", "<turn_aborted>"} {
+		if strings.HasPrefix(text, prefix) {
+			return true
+		}
+	}
+	return false
+}
+
+// Extract accepts explicit user messages only. Assistant text, system/developer
+// instructions, tool arguments/results and non-text parts are never previews.
+func Extract(payload []byte) Preview {
+	root := gjson.ParseBytes(payload)
+	input := root.Get("input")
+	if input.Type == gjson.String {
+		text := Text(input.String())
+		if !isClientContext(text) {
+			return Preview{Initial: text, Current: text}
+		}
+		return Preview{}
+	}
+	if !input.IsArray() {
+		input = root.Get("messages")
+	}
+	var preview Preview
+	input.ForEach(func(_, message gjson.Result) bool {
+		if message.Get("role").String() != "user" {
+			return true
+		}
+		text := userText(message.Get("content"))
+		if text == "" || isClientContext(text) {
+			return true
+		}
+		if preview.Initial == "" {
+			preview.Initial = text
+		}
+		preview.Current = text
+		return true
+	})
+	return preview
+}
+
+// Observe scopes continuity by both client and explicit session identity. Without
+// a session, no cross-request state is retained. Idle entries expire in memory.
+func (s *Store) Observe(client, session string, payload []byte) Preview {
+	preview := Extract(payload)
+	if session == "" {
+		return preview
+	}
+	key := sha256.Sum256([]byte(client + "\x00" + session))
+	now := time.Now()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	previous, exists := s.sessions[key]
+	if exists && now.Sub(previous.updated) < sessionLifetime {
+		if previous.preview.Initial != "" {
+			preview.Initial = previous.preview.Initial
+		}
+		if preview.Current == "" {
+			preview.Current = previous.preview.Current
+		}
+	}
+	if preview.Initial == "" && preview.Current == "" {
+		return preview
+	}
+	if !exists && len(s.sessions) >= sessionLimit {
+		var oldestKey [32]byte
+		var oldest time.Time
+		for entryKey, entry := range s.sessions {
+			if oldest.IsZero() || entry.updated.Before(oldest) {
+				oldest, oldestKey = entry.updated, entryKey
+			}
+		}
+		delete(s.sessions, oldestKey)
+	}
+	s.sessions[key] = sessionPreview{preview: preview, updated: now}
+	return preview
+}
+
+type contextKey struct{}
+
+func WithContext(ctx context.Context, preview Preview) context.Context {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return context.WithValue(ctx, contextKey{}, preview)
+}
+func FromContext(ctx context.Context) Preview {
+	if ctx == nil {
+		return Preview{}
+	}
+	preview, _ := ctx.Value(contextKey{}).(Preview)
+	return preview
+}
diff --git a/internal/promptpreview/preview_test.go b/internal/promptpreview/preview_test.go
new file mode 100644
index 00000000..db847d42
--- /dev/null
+++ b/internal/promptpreview/preview_test.go
@@ -0,0 +1,60 @@
+package promptpreview
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+)
+
+func TestExtractOnlyUserText(t *testing.T) {
+	payload := []byte(`{"instructions":"private system","input":[{"role":"system","content":"secret system"},{"role":"developer","content":"secret developer"},{"role":"user","content":"<environment_context>metadata</environment_context>"},{"role":"user","content":[{"type":"input_text","text":"First\n actual prompt"},{"type":"input_image","image_url":"secret image"}]},{"role":"assistant","content":"secret answer"},{"type":"function_call_output","output":"secret tool result"},{"role":"user","content":"Current user question"}]}`)
+	preview := Extract(payload)
+	if preview.Initial != "First actual prompt" || preview.Current != "Current user question" {
+		t.Fatalf("unexpected preview: %+v", preview)
+	}
+	encoded, _ := json.Marshal(preview)
+	if strings.Contains(string(encoded), "secret") {
+		t.Fatal("non-user content was captured")
+	}
+	if Extract([]byte(`{"input":[{"type":"function_call_output","output":"not a prompt"}]}`)) != (Preview{}) {
+		t.Fatal("tool result captured")
+	}
+	if Extract([]byte(`{"input":"Simple prompt"}`)).Current != "Simple prompt" {
+		t.Fatal("string input missing")
+	}
+}
+
+func TestPreviewCharacterBoundAndSessionIsolation(t *testing.T) {
+	long := strings.Repeat("🙂", 300)
+	if text := Text(" \n" + long); utf8.RuneCountInString(text) != CharacterLimit || !utf8.ValidString(text) {
+		t.Fatal("Unicode limit broken")
+	}
+	store := New()
+	observe := func(client, session, prompt string) Preview {
+		payload, _ := json.Marshal(map[string]any{"input": prompt})
+		return store.Observe(client, session, payload)
+	}
+	observe("a", "session", "First")
+	preview := observe("a", "session", "Next")
+	if preview.Initial != "First" || preview.Current != "Next" {
+		t.Fatal(preview)
+	}
+	if observe("b", "session", "Other client").Initial != "Other client" {
+		t.Fatal("client scope leaked")
+	}
+	if observe("a", "", "Stateless").Initial != "Stateless" {
+		t.Fatal("stateless preview leaked")
+	}
+	if preview := store.Observe("a", "session", []byte(`{"input":[{"type":"function_call_output","output":"secret"}]}`)); preview.Current != "Next" {
+		t.Fatal("tool continuation lost user prompt")
+	}
+	for key, entry := range store.sessions {
+		entry.updated = time.Now().Add(-sessionLifetime - time.Minute)
+		store.sessions[key] = entry
+	}
+	if observe("a", "session", "After expiry").Initial != "After expiry" {
+		t.Fatal("expired initial retained")
+	}
+}
