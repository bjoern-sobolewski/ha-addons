diff --git a/internal/routinglive/activity.go b/internal/routinglive/activity.go
new file mode 100644
index 00000000..a5f6efa0
--- /dev/null
+++ b/internal/routinglive/activity.go
@@ -0,0 +1,162 @@
+package routinglive
+
+import (
+	"bytes"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/live"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/promptpreview"
+	"github.com/tidwall/gjson"
+)
+
+type Activity struct {
+	Phase        string     `json:"phase"`
+	Since        time.Time  `json:"since"`
+	LastOutput   *time.Time `json:"last_output_at,omitempty"`
+	OutputEvents uint64     `json:"output_events"`
+	ToolNames    []string   `json:"tool_names,omitempty"`
+}
+
+func (r *Registry) ObserveInput(id string, payload []byte) {
+	r.mu.Lock()
+	row, exists := r.rows[id]
+	r.mu.Unlock()
+	if !exists {
+		return
+	}
+	session := row.Session
+	if session == "" {
+		session = row.ID
+	}
+	preview := promptpreview.Default.Observe(row.Client, session, payload)
+	phase := "waiting_upstream"
+	gjson.GetBytes(payload, "input").ForEach(func(_, item gjson.Result) bool {
+		if kind := item.Get("type").String(); kind == "function_call_output" || kind == "custom_tool_call_output" {
+			phase = "continuing_tools"
+		}
+		return true
+	})
+	r.Change(id, func(row *Row) {
+		row.PromptPreview = preview
+		row.Activity = Activity{Phase: phase, Since: time.Now()}
+	})
+}
+
+func (r *Registry) SetPromptPreview(id string, preview promptpreview.Preview) {
+	r.Change(id, func(row *Row) {
+		row.PromptPreview = preview
+		if row.Activity.Phase == "" {
+			row.Activity = Activity{Phase: "waiting_upstream", Since: time.Now()}
+		}
+	})
+}
+
+// ObserveOutput stores event kinds and bounded tool names, never output text or
+// arguments. Repeated deltas publish at most once a second per connection.
+func (r *Registry) ObserveOutput(id string, payload []byte) {
+	for _, line := range bytes.Split(payload, []byte{'\n'}) {
+		line = bytes.TrimSpace(bytes.TrimPrefix(bytes.TrimSpace(line), []byte("data:")))
+		if len(line) == 0 || line[0] != '{' {
+			continue
+		}
+		r.observeEvent(id, gjson.ParseBytes(line))
+	}
+}
+
+func (r *Registry) observeEvent(id string, event gjson.Result) {
+	kind := event.Get("type").String()
+	phase := ""
+	item := event.Get("item")
+	switch kind {
+	case "response.created", "response.in_progress":
+		phase = "waiting_output"
+	case "response.output_text.delta", "response.audio.delta", "response.output_audio.delta":
+		phase = "generating"
+	case "response.reasoning.delta", "response.reasoning_text.delta", "response.reasoning_summary_text.delta":
+		phase = "reasoning"
+	case "response.function_call_arguments.delta", "response.custom_tool_call_input.delta":
+		phase = "requesting_tool"
+	case "response.output_item.added", "response.output_item.done":
+		switch item.Get("type").String() {
+		case "function_call", "custom_tool_call":
+			phase = "requesting_tool"
+		case "reasoning":
+			phase = "reasoning"
+		case "message":
+			phase = "generating"
+		}
+	case "response.completed", "response.done":
+		phase = "response_finished"
+	case "response.failed", "response.incomplete", "error":
+		phase = "response_failed"
+	default:
+		if event.Get("choices.0.delta.content").Exists() {
+			phase = "generating"
+		}
+		if event.Get("choices.0.delta.tool_calls").Exists() {
+			phase = "requesting_tool"
+		}
+	}
+	if phase == "" {
+		return
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	row, exists := r.rows[id]
+	if !exists {
+		return
+	}
+	now := time.Now()
+	previousPhase := row.Activity.Phase
+	if previousPhase != phase {
+		row.Activity.Phase, row.Activity.Since = phase, now
+	}
+	row.Activity.LastOutput = &now
+	if strings.HasSuffix(kind, ".delta") || event.Get("choices").IsArray() {
+		row.Activity.OutputEvents++
+	}
+	row.Activity.ToolNames = appendToolName(row.Activity.ToolNames, item)
+	if kind == "response.completed" || kind == "response.done" {
+		event.Get("response.output").ForEach(func(_, output gjson.Result) bool {
+			row.Activity.ToolNames = appendToolName(row.Activity.ToolNames, output)
+			return len(row.Activity.ToolNames) < 8
+		})
+	}
+	shouldPublish := previousPhase != phase || now.Sub(row.Updated) >= time.Second
+	if shouldPublish {
+		row.Updated = now
+	}
+	r.rows[id] = row
+	if shouldPublish {
+		live.Default.Publish("routing")
+	}
+}
+
+func appendToolName(names []string, item gjson.Result) []string {
+	if kind := item.Get("type").String(); kind != "function_call" && kind != "custom_tool_call" {
+		return names
+	}
+	name := safeToolName(item.Get("name").String())
+	if name == "" || len(names) >= 8 {
+		return names
+	}
+	for _, existing := range names {
+		if existing == name {
+			return names
+		}
+	}
+	return append(names, name)
+}
+
+func safeToolName(name string) string {
+	if len(name) > 80 {
+		return ""
+	}
+	for _, character := range name {
+		if !strings.ContainsRune("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-", character) {
+			return ""
+		}
+	}
+	return name
+}
diff --git a/internal/routinglive/activity_test.go b/internal/routinglive/activity_test.go
new file mode 100644
index 00000000..a0551bc9
--- /dev/null
+++ b/internal/routinglive/activity_test.go
@@ -0,0 +1,35 @@
+package routinglive
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestObservedActivityWithoutOutputBodies(t *testing.T) {
+	registry := New()
+	id := registry.Begin("websocket", "client", "session")
+	registry.ObserveInput(id, []byte(`{"type":"response.create","input":"User question"}`))
+	registry.ObserveOutput(id, []byte(`{"type":"response.created","response":{"id":"private-response-id"}}`))
+	registry.ObserveOutput(id, []byte("data: {\"type\":\"response.output_text.delta\",\"delta\":\"private answer\"}\n\n"))
+	row := registry.Snapshot().Rows[0]
+	if row.Activity.Phase != "generating" || row.Activity.OutputEvents != 1 || row.Activity.LastOutput == nil || row.PromptPreview.Current != "User question" {
+		t.Fatalf("missing observed activity: %+v", row)
+	}
+	registry.ObserveOutput(id, []byte(`{"type":"response.output_item.added","item":{"type":"function_call","name":"exec_command","arguments":"private argument"}}`))
+	row = registry.Snapshot().Rows[0]
+	if row.Activity.Phase != "requesting_tool" || len(row.Activity.ToolNames) != 1 || row.Activity.ToolNames[0] != "exec_command" {
+		t.Fatal(row.Activity)
+	}
+	encoded, _ := json.Marshal(registry.Snapshot())
+	for _, secret := range []string{"private answer", "private argument", "private-response-id"} {
+		if strings.Contains(string(encoded), secret) {
+			t.Fatalf("captured output body: %s", secret)
+		}
+	}
+	registry.End(id, 200)
+	registry.ObserveOutput(id, []byte(`{"type":"response.output_text.delta","delta":"late"}`))
+	if len(registry.Snapshot().Rows) != 0 {
+		t.Fatal("late output resurrected completed activity")
+	}
+}
