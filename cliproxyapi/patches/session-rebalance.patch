+package sessionrebalance
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func assertNotClosed(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+		t.Fatal("closed before safe boundary")
+	default:
+	}
+}
+func assertClosed(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(time.Second):
+		t.Fatal("safe session not closed")
+	}
+}
+func TestSessionRebalanceDrainsToolsAndQueuedCreates(t *testing.T) {
+	c := New()
+	closed := make(chan struct{})
+	s := c.Register(func() { close(closed) })
+	defer s.Unregister()
+	s.Input([]byte(`{"type":"response.create","event_id":"one"}`))
+	s.SetPool("codex")
+	s.Output([]byte(`{"type":"response.created","response":{"id":"r1"}}`))
+	j := c.Request("codex", "priority_saved")
+	if j.Waiting != 1 || j.Rebalanced != 0 {
+		t.Fatal(j)
+	}
+	s.Output([]byte(`{"type":"response.completed","response":{"id":"r1","output":[{"type":"function_call","call_id":"tool1"},{"type":"custom_tool_call","call_id":"tool2"}]}}`))
+	assertNotClosed(t, closed)
+	s.Input([]byte(`{"type":"response.create","event_id":"two","previous_response_id":"r1","input":[{"type":"function_call_output","call_id":"tool1"}]}`))
+	s.Output([]byte(`{"type":"response.created","response":{"id":"r2"}}`))
+	s.Output([]byte(`{"type":"response.completed","response":{"id":"r2","output":[]}}`))
+	assertNotClosed(t, closed)
+	s.Input([]byte(`{"type":"response.create","event_id":"three","input":[{"type":"custom_tool_call_output","call_id":"tool2"}]}`))
+	s.Input([]byte(`{"type":"response.create","event_id":"four"}`))
+	s.Output([]byte(`{"type":"response.created","response":{"id":"r3"}}`))
+	s.Output([]byte(`{"type":"response.completed","response":{"id":"r3","output":[]}}`))
+	assertNotClosed(t, closed)
+	s.Output([]byte(`{"type":"error","error":{"event_id":"four"}}`))
+	assertClosed(t, closed)
+	if s.Input([]byte(`{"type":"response.create"}`)) {
+		t.Fatal("admitted input after retirement")
+	}
+	j = c.Snapshots()[0]
+	if j.Rebalanced != 1 || j.Waiting != 0 {
+		t.Fatal(j)
+	}
+}
+func TestSessionRebalancePoolScopeAndLateSelection(t *testing.T) {
+	c := New()
+	one, two, other, late := make(chan struct{}), make(chan struct{}), make(chan struct{}), make(chan struct{})
+	a := c.Register(func() { close(one) })
+	a.SetPool("codex")
+	b := c.Register(func() { close(two) })
+	b.SetPool("codex")
+	x := c.Register(func() { close(other) })
+	x.SetPool("claude")
+	l := c.Register(func() { close(late) })
+	l.Input([]byte(`{"type":"response.create"}`))
+	c.Request("codex", "priority_saved")
+	assertClosed(t, one)
+	assertClosed(t, two)
+	assertNotClosed(t, other)
+	l.SetPool("codex")
+	assertNotClosed(t, late)
+	l.Output([]byte(`{"type":"response.completed","response":{"id":"late"}}`))
+	assertClosed(t, late)
+	fresh := c.Register(func() { t.Error("new session retired by old request") })
+	fresh.SetPool("codex")
+	for _, s := range []*Session{a, b, x, l, fresh} {
+		s.Unregister()
+	}
+}
+func TestSessionRebalanceAcceptedSteerWaitsForSuccessor(t *testing.T) {
+	c := New()
+	closed := make(chan struct{})
+	s := c.Register(func() { close(closed) })
+	defer s.Unregister()
+	s.Input([]byte(`{"type":"response.create"}`))
+	s.SetPool("codex")
+	s.Output([]byte(`{"type":"response.created","response":{"id":"r1"}}`))
+	s.Input([]byte(`{"type":"response.steer","event_id":"steer","previous_response_id":"r1"}`))
+	c.Request("codex", "quota_policy_excluded")
+	s.Output([]byte(`{"type":"response.steer.accepted","steer":{"id":"s1","previous_response_id":"r1"}}`))
+	s.Output([]byte(`{"type":"response.completed","response":{"id":"r1"}}`))
+	assertNotClosed(t, closed)
+	s.Output([]byte(`{"type":"response.created","response":{"id":"r2","previous_response_id":"r1"}}`))
+	s.Output([]byte(`{"type":"response.completed","response":{"id":"r2"}}`))
+	assertClosed(t, closed)
+}
+func TestSessionRebalanceConcurrentAdmission(t *testing.T) {
+	for range 100 {
+		c := New()
+		closed := make(chan struct{})
+		s := c.Register(func() { close(closed) })
+		s.SetPool("codex")
+		var admitted bool
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() { defer wg.Done(); admitted = s.Input([]byte(`{"type":"response.create","event_id":"race"}`)) }()
+		go func() { defer wg.Done(); c.Request("codex", "priority_saved") }()
+		wg.Wait()
+		if admitted {
+			assertNotClosed(t, closed)
+			s.Output([]byte(`{"type":"error","error":{"event_id":"race"}}`))
+		}
+		assertClosed(t, closed)
+		s.Unregister()
+	}
+}
+
+func TestAffinityOnlyDoesNotDrainOrRetireSockets(t *testing.T) {
+	c := New()
+	closed := make(chan struct{}, 1)
+	s := c.Register(func() { closed <- struct{}{} })
+	defer s.Unregister()
+	s.SetPool("codex")
+	snapshot := c.Request("codex", "priority_saved", false)
+	if snapshot.Waiting != 0 || snapshot.Rebalanced != 0 || snapshot.ReconnectWebsockets || !snapshot.AffinityRebalanced || s.Draining() {
+		t.Fatal(snapshot)
+	}
+	s.SetPool("codex")
+	if !s.Input([]byte(`{"type":"response.create"}`)) {
+		t.Fatal("affinity reset fenced socket admission")
+	}
+	select {
+	case <-closed:
+		t.Fatal("affinity reset closed socket")
+	default:
+	}
+}
