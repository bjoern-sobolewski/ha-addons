@@ -0,0 +1,59 @@
+package management
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/sessionrebalance"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"net/http"
+	"time"
+)
+
+func (h *Handler) GetSessionRebalances(c *gin.Context) {
+	c.Header("Cache-Control", "no-store")
+	c.JSON(http.StatusOK, gin.H{"items": sessionrebalance.Default.Snapshots()})
+}
+func (h *Handler) PostSessionRebalance(c *gin.Context) {
+	var body struct {
+		AuthIndex           string `json:"auth_index"`
+		ExpectedPriority    *int   `json:"expected_priority"`
+		ReconnectWebsockets bool   `json:"reconnect_websockets"`
+	}
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	if c.ShouldBindJSON(&body) != nil || body.AuthIndex == "" || body.ExpectedPriority == nil {
+		c.JSON(400, gin.H{"error": "auth_index required"})
+		return
+	}
+	if h.authManager != nil {
+		deadline := time.NewTimer(5 * time.Second)
+		defer deadline.Stop()
+		tick := time.NewTicker(25 * time.Millisecond)
+		defer tick.Stop()
+		for {
+			h.mu.Lock()
+			reloadReady := h.appliedReloadGeneration >= h.reloadGeneration
+			h.mu.Unlock()
+			for _, a := range h.authManager.List() {
+				if a != nil && a.Index == body.AuthIndex {
+					pool := coreauth.SessionRebalancePool(a)
+					if pool == "" {
+						break
+					}
+					if !reloadReady || coreauth.SessionRebalancePriority(a) != *body.ExpectedPriority {
+						continue
+					}
+					c.JSON(200, h.authManager.RebalanceSessions(pool, "priority_saved", body.ReconnectWebsockets))
+					return
+				}
+			}
+			select {
+			case <-c.Request.Context().Done():
+				return
+			case <-deadline.C:
+				c.JSON(409, gin.H{"error": "saved priority is not active yet; retry rebalance"})
+				return
+			case <-tick.C:
+			}
+		}
+	}
+	c.JSON(404, gin.H{"error": "account pool not found"})
+}
