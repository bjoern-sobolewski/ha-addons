new file mode 100644
index 00000000..c1132222
--- /dev/null
+++ b/sdk/cliproxy/auth/session_rebalance.go
@@ -0,0 +1,289 @@
+package auth
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/live"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/quotatraffic"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/sessionrebalance"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	"time"
+)
+
+// A pool is the actual scheduling executor, including named compatibility pools.
+func SessionRebalancePool(a *Auth) string {
+	if a == nil {
+		return ""
+	}
+	return canonicalSchedulingProvider(executorKeyFromAuth(a))
+}
+
+func (m *Manager) RebalanceSessions(pool, reason string, reconnect ...bool) sessionrebalance.Snapshot {
+	ids := []string{}
+	for _, a := range m.List() {
+		if SessionRebalancePool(a) == pool {
+			ids = append(ids, a.ID)
+		}
+	}
+	m.selectorMu.Lock()
+	sel := m.selector
+	m.selectorMu.Unlock()
+	if s, ok := sel.(*SessionAffinitySelector); ok && s != nil {
+		s.rebalanceMu.Lock()
+		defer s.rebalanceMu.Unlock()
+		s.rebalanceEpoch++
+		if s.authRebalanceEpoch == nil {
+			s.authRebalanceEpoch = map[string]uint64{}
+		}
+		for _, id := range ids {
+			s.authRebalanceEpoch[id] = s.rebalanceEpoch
+			s.InvalidateAuth(id)
+		}
+	}
+	retire := len(reconnect) > 0 && reconnect[0]
+	return sessionrebalance.Default.Request(pool, reason, retire)
+}
+
+// Recovery must remain preferable for 30 seconds. Automatic socket retirement is
+// additionally limited to once per pool per two minutes; explicit saves bypass it.
+const quotaRecoveryStability = 30 * time.Second
+const quotaReconnectInterval = 2 * time.Minute
+
+type quotaRecovery struct {
+	since     time.Time
+	websocket bool
+}
+type quotaRebalanceState struct {
+	eligible      map[string]bool
+	pending       map[string]quotaRecovery
+	lastReconnect map[string]time.Time
+}
+
+func (m *Manager) CheckQuotaRebalances(previous map[string]bool, now time.Time) {
+	m.quotaRebalanceMu.Lock()
+	defer m.quotaRebalanceMu.Unlock()
+	if previous == nil {
+		if m.quotaRebalancePrevious == nil {
+			m.quotaRebalancePrevious = map[string]bool{}
+		}
+		previous = m.quotaRebalancePrevious
+	}
+	if m.quotaRecoveryState == nil {
+		m.quotaRecoveryState = &quotaRebalanceState{eligible: map[string]bool{}, pending: map[string]quotaRecovery{}, lastReconnect: map[string]time.Time{}}
+	}
+	state := m.quotaRecoveryState
+	auths := m.List()
+	pools := map[string]bool{}
+	reasons := map[string]string{}
+	seen := map[string]bool{}
+	seenRoutes := map[string]bool{}
+	registryRef := registry.GetGlobalRegistry()
+	for _, a := range auths {
+		if a == nil {
+			continue
+		}
+		key := a.Provider + ":" + a.Index
+		seen[key] = true
+		excluded := !QuotaPolicyAllows(a, now)
+		settings := quotatraffic.RoutingPolicies.RebalanceSettings(a.Index, a.Provider)
+		pool := SessionRebalancePool(a)
+		if excluded && !previous[key] && settings.RebalanceSessions {
+			pools[pool] = pools[pool] || settings.ReconnectWebsockets
+			reasons[pool] = "quota_policy_excluded"
+		}
+		previous[key] = excluded
+		if len(quotatraffic.RoutingPolicies.Thresholds(a.Index, a.Provider)) == 0 {
+			continue
+		}
+		// Use the same model mapping, admission checks, weight exclusions and
+		// WebSocket precedence as normal selection, without selecting or probing.
+		for _, model := range registryRef.GetModelsForClient(a.ID) {
+			if model == nil {
+				continue
+			}
+			routeKey := key + "\x00" + model.ID
+			seenRoutes[routeKey] = true
+			var candidates []*Auth
+			for _, candidate := range auths {
+				if candidate != nil && SessionRebalancePool(candidate) == pool && m.authSupportsRouteModel(registryRef, candidate, model.ID) {
+					candidates = append(candidates, candidate)
+				}
+			}
+			m.selectorMu.Lock()
+			selector := m.selector
+			m.selectorMu.Unlock()
+			weighted := false
+			switch sel := selector.(type) {
+			case *WeightedRoundRobinSelector:
+				weighted = true
+			case *SessionAffinitySelector:
+				_, weighted = sel.fallback.(*WeightedRoundRobinSelector)
+			}
+			if weighted {
+				candidates = positiveWeightAuths(candidates)
+			}
+			available, _ := m.availableAuthsForRouteModelAcrossPriorities(candidates, pool, model.ID, now)
+			eligible := false
+			for _, candidate := range available {
+				if candidate.ID == a.ID {
+					eligible = true
+					break
+				}
+			}
+			was, known := state.eligible[routeKey]
+			state.eligible[routeKey] = eligible
+			if !eligible || !settings.RebalanceSessions {
+				delete(state.pending, routeKey)
+				continue
+			}
+			if known && !was {
+				state.pending[routeKey] = quotaRecovery{}
+			}
+			pending, recovering := state.pending[routeKey]
+			if !recovering {
+				continue
+			}
+			httpPreferred := recoveryImprovesPreference(a, available)
+			websocketCandidates := available
+			if pool == "codex" {
+				var enabled []*Auth
+				for _, candidate := range available {
+					if authWebsocketsEnabled(candidate) {
+						enabled = append(enabled, candidate)
+					}
+				}
+				if len(enabled) > 0 {
+					websocketCandidates = enabled
+				}
+			}
+			websocketPreferred := recoveryImprovesPreference(a, websocketCandidates)
+			// A recovered WS-enabled credential also outranks an HTTP-only pin,
+			// independently of numeric priority, just as the existing scheduler does.
+			if pool == "codex" && authWebsocketsEnabled(a) && recoveryIsHighest(a, websocketCandidates) {
+				for _, candidate := range available {
+					if !authWebsocketsEnabled(candidate) {
+						websocketPreferred = true
+					}
+				}
+			}
+			if !httpPreferred && !websocketPreferred {
+				state.pending[routeKey] = quotaRecovery{}
+				continue
+			}
+			if pending.since.IsZero() || pending.websocket != websocketPreferred {
+				state.pending[routeKey] = quotaRecovery{since: now, websocket: websocketPreferred}
+				continue
+			}
+			if now.Sub(pending.since) < quotaRecoveryStability {
+				continue
+			}
+			// Defer a quick recovery until the reconnect quiet period ends. Keep
+			// the stable recovery pending instead of silently losing the migration.
+			if settings.ReconnectWebsockets && websocketPreferred && !state.lastReconnect[pool].IsZero() && now.Sub(state.lastReconnect[pool]) < quotaReconnectInterval {
+				continue
+			}
+			pools[pool] = pools[pool] || (settings.ReconnectWebsockets && websocketPreferred)
+			if reasons[pool] == "" {
+				reasons[pool] = "quota_policy_recovered"
+			}
+			delete(state.pending, routeKey)
+		}
+	}
+	for key := range previous {
+		if !seen[key] {
+			delete(previous, key)
+		}
+	}
+	for key := range state.eligible {
+		if !seenRoutes[key] {
+			delete(state.eligible, key)
+			delete(state.pending, key)
+		}
+	}
+	for pool, reconnect := range pools {
+		if pool == "" {
+			continue
+		}
+		if reconnect && !state.lastReconnect[pool].IsZero() && now.Sub(state.lastReconnect[pool]) < quotaReconnectInterval {
+			reconnect = false
+		}
+		if reconnect {
+			state.lastReconnect[pool] = now
+		}
+		m.RebalanceSessions(pool, reasons[pool], reconnect)
+	}
+}
+func recoveryIsHighest(a *Auth, available []*Auth) bool {
+	found := false
+	for _, candidate := range available {
+		if candidate.ID == a.ID {
+			found = true
+		}
+		if authPriority(candidate) > authPriority(a) {
+			return false
+		}
+	}
+	return found
+}
+func recoveryImprovesPreference(a *Auth, available []*Auth) bool {
+	if !recoveryIsHighest(a, available) {
+		return false
+	}
+	for _, candidate := range available {
+		if authPriority(candidate) < authPriority(a) {
+			return true
+		}
+	}
+	return false
+}
+
+func (m *Manager) WatchQuotaRebalances(ctx context.Context) {
+	if m == nil {
+		return
+	}
+	var previous map[string]bool
+	sub := live.Default.Subscribe("", false)
+	if sub == nil {
+		return
+	}
+	defer sub.Close()
+	tick := time.NewTicker(time.Second)
+	defer tick.Stop()
+	m.CheckQuotaRebalances(previous, time.Now())
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-tick.C:
+			m.CheckQuotaRebalances(previous, time.Now())
+		case <-sub.Wake:
+			for _, topic := range sub.Drain() {
+				if topic == "quota" || topic == "accounts" {
+					m.CheckQuotaRebalances(previous, time.Now())
+					break
+				}
+			}
+		}
+	}
+}
+
+func SessionRebalancePriority(a *Auth) int { return authPriority(a) }
+
+// Stamp before snapshotting candidates. An older request may finish, but may
+// not create affinity using a candidate snapshot read before invalidation.
+func (m *Manager) stampSessionRebalance(opts cliproxyexecutor.Options) {
+	if opts.Metadata == nil {
+		return
+	}
+	if _, ok := opts.Metadata["session_rebalance_epoch"]; ok {
+		return
+	}
+	m.selectorMu.Lock()
+	sel := m.selector
+	m.selectorMu.Unlock()
+	if s, ok := sel.(*SessionAffinitySelector); ok && s != nil {
+		s.rebalanceMu.Lock()
+		opts.Metadata["session_rebalance_epoch"] = s.rebalanceEpoch
+		s.rebalanceMu.Unlock()
+	}
+}
