+	"time"
+)
+
+func TestSessionRebalanceClearsWholePoolAndFencesLateResults(t *testing.T) {
+	for _, lcp := range []bool{false, true} {
+		t.Run(map[bool]string{false: "explicit", true: "lcp"}[lcp], func(t *testing.T) {
+			s := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{Fallback: &FillFirstSelector{}, TTL: time.Hour})
+			defer s.Stop()
+			m := NewManager(nil, s, nil)
+			a := &Auth{ID: "rebalance-a", Provider: "codex", Status: StatusActive, Attributes: map[string]string{"priority": "10"}}
+			b := &Auth{ID: "rebalance-b", Provider: "codex", Status: StatusActive, Attributes: map[string]string{"priority": "0"}}
+			x := &Auth{ID: "rebalance-x", Provider: "claude", Status: StatusActive}
+			for _, auth := range []*Auth{a, b, x} {
+				if _, err := m.Register(WithSkipPersist(context.Background()), auth); err != nil {
+					t.Fatal(err)
+				}
+			}
+			opts := cliproxyexecutor.Options{Headers: http.Header{"Session-Id": {"rebalance-session"}}, Metadata: map[string]any{}}
+			if lcp {
+				opts.Headers = nil
+				opts.SourceFormat = sdktranslator.FormatOpenAI
+				opts.OriginalRequest = []byte(`{"messages":[{"role":"system","content":"stable"},{"role":"user","content":"hello"}]}`)
+				opts.Metadata[cliproxyexecutor.CallerScopeMetadataKey] = "rebalance-scope"
+			}
+			got, err := s.Pick(context.Background(), "codex", "model", opts, []*Auth{a, b})
+			if err != nil || got.ID != a.ID {
+				t.Fatalf("initial: %v %v", got, err)
+			}
+			s.cache.Set("mixed::other::model", b.ID)
+			s.cache.Set("claude::unrelated::model", x.ID)
+			// A plain priority save preserves a previously bound session.
+			a.Attributes["priority"] = "0"
+			b.Attributes["priority"] = "20"
+			got, err = s.Pick(context.Background(), "codex", "model", opts, []*Auth{a, b})
+			if err != nil || got.ID != a.ID {
+				t.Fatalf("plain save broke affinity: %v %v", got, err)
+			}
+			m.RebalanceSessions("codex", "priority_saved")
+			// Simulate selection from a candidate snapshot read before invalidation.
+			if _, err := s.Pick(context.Background(), "codex", "model", opts, []*Auth{a, b}); err != nil {
+				t.Fatal(err)
+			}
+			// Simulate an old request completing after cache invalidation.
+			s.OnResult(Result{AuthID: a.ID, Provider: "codex", Model: "model", Success: true, Options: opts})
+			if _, ok := s.cache.Get("mixed::other::model"); ok {
+				t.Fatal("other account in same pool stayed bound")
+			}
+			if _, ok := s.cache.Get("claude::unrelated::model"); !ok {
+				t.Fatal("unrelated pool cleared")
+			}
+			fresh := opts
+			fresh.Metadata = map[string]any{}
+			if lcp {
+				fresh.Metadata[cliproxyexecutor.CallerScopeMetadataKey] = "rebalance-scope"
+			}
+			got, err = s.Pick(context.Background(), "codex", "model", fresh, []*Auth{a, b})
+			if err != nil || got.ID != b.ID {
+				t.Fatalf("late completion restored old binding: %v %v", got, err)
+			}
+		})
+	}
+}
