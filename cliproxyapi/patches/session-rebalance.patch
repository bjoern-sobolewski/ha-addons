diff --git a/internal/sessionrebalance/rebalance.go b/internal/sessionrebalance/rebalance.go
new file mode 100644
index 00000000..75a2c5cd
--- /dev/null
+++ b/internal/sessionrebalance/rebalance.go
@@ -0,0 +1,324 @@
+// Package sessionrebalance coordinates conservative, pool-scoped socket draining.
+package sessionrebalance
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/live"
+	"github.com/tidwall/gjson"
+	"sync"
+	"time"
+)
+
+type Snapshot struct {
+	ReconnectWebsockets bool      `json:"reconnect_websockets"`
+	AffinityRebalanced  bool      `json:"affinity_rebalanced"`
+	ID                  uint64    `json:"id"`
+	Pool                string    `json:"pool"`
+	Reason              string    `json:"reason"`
+	Rebalanced          int       `json:"sessions_rebalanced"`
+	Waiting             int       `json:"waiting"`
+	WaitingResponses    int       `json:"waiting_for_responses"`
+	WaitingTools        int       `json:"waiting_for_tools"`
+	WaitingProtocol     int       `json:"waiting_for_protocol"`
+	RequestedAt         time.Time `json:"requested_at"`
+}
+type job struct {
+	Snapshot
+	waiting map[*Session]bool
+}
+type Coordinator struct {
+	mu       sync.Mutex
+	sequence uint64
+	epochs   map[string]uint64
+	sessions map[*Session]bool
+	jobs     []*job
+}
+
+var Default = New()
+
+func New() *Coordinator {
+	return &Coordinator{epochs: map[string]uint64{}, sessions: map[*Session]bool{}}
+}
+
+type operation struct{ event, kind, response, parent, steer string }
+type Session struct {
+	owner *Coordinator
+	born  uint64
+	pools map[string]bool
+	ops   []*operation
+	tools map[string]bool
+	// Ambiguous protocol state waits for disconnect instead of guessing idle.
+	uncertain        bool
+	draining, closed bool
+	close            func()
+}
+
+func (c *Coordinator) Register(close func()) *Session {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	s := &Session{owner: c, born: c.sequence, pools: map[string]bool{}, tools: map[string]bool{}, close: close}
+	c.sessions[s] = true
+	return s
+}
+func (s *Session) SetPool(pool string) {
+	if s == nil || pool == "" {
+		return
+	}
+	c := s.owner
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	s.pools[pool] = true
+	if c.epochs[pool] > s.born {
+		s.draining = true
+		for _, j := range c.jobs {
+			if j.ReconnectWebsockets && j.Pool == pool && j.ID > s.born && !s.closed {
+				j.waiting[s] = true
+			}
+		}
+	}
+	s.finishLocked()
+}
+func (s *Session) Draining() bool {
+	if s == nil {
+		return false
+	}
+	s.owner.mu.Lock()
+	defer s.owner.mu.Unlock()
+	return s.draining && !s.closed
+}
+func (s *Session) Unregister() {
+	if s == nil {
+		return
+	}
+	c := s.owner
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	delete(c.sessions, s)
+	for _, j := range c.jobs {
+		delete(j.waiting, s)
+	}
+	live.Default.Publish("rebalance")
+}
+func (c *Coordinator) Request(pool, reason string, reconnect ...bool) Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	c.sequence++
+	retire := len(reconnect) == 0 || reconnect[0]
+	if retire {
+		c.epochs[pool] = c.sequence
+	}
+	j := &job{Snapshot: Snapshot{ReconnectWebsockets: retire, AffinityRebalanced: true, ID: c.sequence, Pool: pool, Reason: reason, RequestedAt: time.Now()}, waiting: map[*Session]bool{}}
+	// A newer request supersedes progress for this pool; the sessions keep draining.
+	retained := c.jobs[:0]
+	for _, old := range c.jobs {
+		if old.Pool != pool || (!retire && len(old.waiting) > 0) {
+			retained = append(retained, old)
+		}
+	}
+	c.jobs = append(retained, j)
+	// Completed history is bounded; active drains are retained.
+	if len(c.jobs) > 64 {
+		for i, old := range c.jobs {
+			if len(old.waiting) == 0 && old != j {
+				c.jobs = append(c.jobs[:i], c.jobs[i+1:]...)
+				break
+			}
+		}
+	}
+	for s := range c.sessions {
+		if retire && s.pools[pool] && !s.closed {
+			s.draining = true
+			j.waiting[s] = true
+			s.finishLocked()
+		}
+	}
+	live.Default.Publish("rebalance")
+	return j.snapshot()
+}
+func (j *job) snapshot() Snapshot {
+	v := j.Snapshot
+	v.Waiting = len(j.waiting)
+	for s := range j.waiting {
+		if len(s.ops) > 0 {
+			v.WaitingResponses++
+		}
+		if len(s.tools) > 0 {
+			v.WaitingTools++
+		}
+		if s.uncertain {
+			v.WaitingProtocol++
+		}
+	}
+	return v
+}
+func (c *Coordinator) Snapshots() []Snapshot {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	out := make([]Snapshot, 0, len(c.jobs))
+	for _, j := range c.jobs {
+		out = append(out, j.snapshot())
+	}
+	return out
+}
+func (s *Session) finishLocked() {
+	if !s.draining || s.closed || s.uncertain || len(s.ops) > 0 || len(s.tools) > 0 {
+		return
+	}
+	s.closed = true
+	for _, j := range s.owner.jobs {
+		if j.waiting[s] {
+			delete(j.waiting, s)
+			j.Rebalanced++
+		}
+	}
+	// Fence admission before closing. The callback serializes its close frame
+	// behind the final successful downstream data write.
+	go s.close()
+	live.Default.Publish("rebalance")
+}
+
+// Input runs before enqueueing: queued creates prevent idle retirement.
+func (s *Session) Input(payload []byte) bool {
+	if s == nil {
+		return true
+	}
+	c := s.owner
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if s.closed {
+		return false
+	}
+	kind := gjson.GetBytes(payload, "type").String()
+	if kind != "response.create" && kind != "response.append" && kind != "response.steer" {
+		return true
+	}
+	if len(s.ops) >= 256 {
+		s.uncertain = true
+		return true
+	}
+	s.ops = append(s.ops, &operation{event: gjson.GetBytes(payload, "event_id").String(), kind: kind, parent: gjson.GetBytes(payload, "previous_response_id").String()})
+	gjson.GetBytes(payload, "input").ForEach(func(_, item gjson.Result) bool {
+		if item.Get("type").String() == "function_call_output" || item.Get("type").String() == "custom_tool_call_output" {
+			delete(s.tools, item.Get("call_id").String())
+		}
+		return true
+	})
+	return true
+}
+
+// Output runs after delivery. Ambiguous errors conservatively block retirement.
+func (s *Session) Output(payload []byte) {
+	if s == nil {
+		return
+	}
+	c := s.owner
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	kind := gjson.GetBytes(payload, "type").String()
+	id := gjson.GetBytes(payload, "response.id").String()
+	switch kind {
+	case "response.created":
+		var op *operation
+		for _, o := range s.ops {
+			if o.kind != "response.steer" && o.response == "" {
+				op = o
+				break
+			}
+		}
+		if op == nil {
+			op = &operation{kind: "automatic"}
+			s.ops = append(s.ops, op)
+		}
+		op.response = id
+		parent := gjson.GetBytes(payload, "response.previous_response_id").String()
+		for _, o := range s.ops {
+			if o.kind == "response.steer" && o.steer != "" && (parent == "" || o.parent == parent) {
+				o.response = id
+			}
+		}
+	case "response.steer.accepted":
+		for _, o := range s.ops {
+			if o.kind == "response.steer" && o.steer == "" {
+				o.steer = gjson.GetBytes(payload, "steer.id").String()
+				if parent := gjson.GetBytes(payload, "steer.previous_response_id").String(); parent != "" {
+					o.parent = parent
+				}
+				break
+			}
+		}
+	case "response.steer.failed":
+		event := gjson.GetBytes(payload, "error.event_id").String()
+		steer := gjson.GetBytes(payload, "steer.id").String()
+		for i, o := range s.ops {
+			if o.kind == "response.steer" && ((steer != "" && o.steer == steer) || (event != "" && o.event == event)) {
+				s.ops = append(s.ops[:i], s.ops[i+1:]...)
+				break
+			}
+		}
+	case "response.output_item.done":
+		s.observeTool(gjson.GetBytes(payload, "item"))
+	case "response.completed", "response.done", "response.incomplete", "response.failed", "error":
+		gjson.GetBytes(payload, "response.output").ForEach(func(_, item gjson.Result) bool { s.observeTool(item); return true })
+		if id == "" {
+			id = gjson.GetBytes(payload, "response_id").String()
+		}
+		event := gjson.GetBytes(payload, "error.event_id").String()
+		matched := false
+		keep := s.ops[:0]
+		for _, o := range s.ops {
+			done := (id != "" && o.response == id) || (event != "" && o.event == event)
+			if done {
+				matched = true
+			} else {
+				keep = append(keep, o)
+			}
+		}
+		s.ops = keep
+		if !matched {
+			if len(s.ops) == 1 && s.ops[0].kind != "response.steer" && s.ops[0].response == "" {
+				s.ops = nil
+			} else if len(s.ops) > 0 {
+				s.uncertain = true
+			}
+		}
+	}
+	s.finishLocked()
+}
+func (s *Session) observeTool(item gjson.Result) {
+	kind := item.Get("type").String()
+	if kind == "function_call" || kind == "custom_tool_call" {
+		if id := item.Get("call_id").String(); id != "" {
+			if len(s.tools) >= 4096 {
+				s.uncertain = true
+			} else {
+				s.tools[id] = true
+			}
+		}
+	}
+}
+
+type contextKey struct{}
+
+func WithSession(ctx context.Context, s *Session) context.Context {
+	return context.WithValue(ctx, contextKey{}, s)
+}
+func FromContext(ctx context.Context) *Session {
+	if ctx == nil {
+		return nil
+	}
+	s, _ := ctx.Value(contextKey{}).(*Session)
+	return s
+}
+
+type quotaCheckKey struct{}
+
+func WithQuotaCheck(ctx context.Context, check func()) context.Context {
+	return context.WithValue(ctx, quotaCheckKey{}, check)
+}
+func CheckQuota(ctx context.Context) {
+	if ctx != nil {
+		if check, ok := ctx.Value(quotaCheckKey{}).(func()); ok {
+			check()
+		}
+	}
+}
