@@ -0,0 +1,63 @@
+package management
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/sessionrebalance"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestSessionRebalanceWaitsForRuntimePriority(t *testing.T) {
+	old := sessionrebalance.Default
+	sessionrebalance.Default = sessionrebalance.New()
+	defer func() { sessionrebalance.Default = old }()
+	m := coreauth.NewManager(nil, nil, nil)
+	a, err := m.Register(coreauth.WithSkipPersist(context.Background()), &coreauth.Auth{ID: t.Name(), Provider: "codex", Attributes: map[string]string{"priority": "0"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := &Handler{authManager: m}
+	closed := make(chan struct{})
+	s := sessionrebalance.Default.Register(func() { close(closed) })
+	s.SetPool("codex")
+	defer s.Unregister()
+	started := make(chan struct{})
+	done := make(chan *httptest.ResponseRecorder)
+	go func() {
+		data, _ := json.Marshal(map[string]any{"auth_index": a.Index, "expected_priority": 7, "reconnect_websockets": true})
+		r := httptest.NewRecorder()
+		c, _ := gin.CreateTestContext(r)
+		c.Request = httptest.NewRequest("POST", "/", strings.NewReader(string(data)))
+		c.Request.Header.Set("Content-Type", "application/json")
+		close(started)
+		h.PostSessionRebalance(c)
+		done <- r
+	}()
+	<-started
+	select {
+	case <-closed:
+		t.Fatal("retired socket before saved priority reached runtime")
+	case <-time.After(50 * time.Millisecond):
+	}
+	if _, _, err := m.Modify(coreauth.WithSkipPersist(context.Background()), a.ID, a.RegistrationEpoch, func(current *coreauth.Auth) error { current.Attributes["priority"] = "7"; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case r := <-done:
+		if r.Code != 200 {
+			t.Fatal(r.Code)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("did not observe runtime reload")
+	}
+	select {
+	case <-closed:
+	case <-time.After(time.Second):
+		t.Fatal("did not retire after runtime reload")
+	}
+}
