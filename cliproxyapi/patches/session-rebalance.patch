+func TestSessionRebalanceQuotaTransitionsAndDrainIsolation(t *testing.T) {
+	oldCoordinator := sessionrebalance.Default
+	sessionrebalance.Default = sessionrebalance.New()
+	defer func() { sessionrebalance.Default = oldCoordinator }()
+	old := quotatraffic.RoutingPolicies
+	defer func() { quotatraffic.RoutingPolicies = old }()
+	store := quotatraffic.NewPolicyStore()
+	quotatraffic.RoutingPolicies = store
+	if err := store.Load(filepath.Join(t.TempDir(), "policy.json")); err != nil {
+		t.Fatal(err)
+	}
+	m := NewManager(nil, nil, nil)
+	a, err := m.Register(WithSkipPersist(context.Background()), &Auth{ID: "auto-rebalance", Provider: "codex", Status: StatusActive})
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.Now()
+	quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"79"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now, "websocket_event")
+	if err := store.Set(a.Index, "codex", map[string]float64{"x-codex-primary@300": 20}); err != nil {
+		t.Fatal(err)
+	}
+	previous := map[string]bool{}
+	baseline := len(sessionrebalance.Default.Snapshots())
+	m.CheckQuotaRebalances(previous, now)
+	if len(sessionrebalance.Default.Snapshots()) != baseline {
+		t.Fatal("eligible policy rebalanced")
+	}
+	quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"80"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now.Add(time.Second), "websocket_event")
+	m.CheckQuotaRebalances(previous, now.Add(time.Second))
+	m.CheckQuotaRebalances(previous, now.Add(2*time.Second))
+	if len(sessionrebalance.Default.Snapshots()) != baseline+1 {
+		t.Fatal("transition missing or repeated")
+	}
+	c := sessionrebalance.New()
+	s := c.Register(func() {})
+	defer s.Unregister()
+	s.Input([]byte(`{"type":"response.create"}`))
+	s.SetPool("codex")
+	c.Request("codex", "quota_policy_excluded")
+	ctx := sessionrebalance.WithSession(context.Background(), s)
+	opts := cliproxyexecutor.Options{Metadata: map[string]any{cliproxyexecutor.PinnedAuthMetadataKey: a.ID}}
+	drain := authSelectionEligibilityForRequest(ctx, opts).forDrain(a)
+	if !QuotaPolicyAllows(drain, now.Add(time.Second)) {
+		t.Fatal("pending pinned tools cannot drain")
+	}
+	if QuotaPolicyAllows(a, now.Add(time.Second)) {
+		t.Fatal("drain changed shared account eligibility")
+	}
+	unpinned := authSelectionEligibilityForRequest(ctx, cliproxyexecutor.Options{}).forDrain(a)
+	if QuotaPolicyAllows(unpinned, now.Add(time.Second)) {
+		t.Fatal("unpinned request bypassed minimum")
+	}
+}
