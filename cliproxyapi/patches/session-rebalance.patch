+func TestQuotaRecoveryEligibilityStabilityAndTransport(t *testing.T) {
+	for _, scenario := range []string{"preferred", "disabled", "cooldown", "http-only", "lower-priority", "incompatible"} {
+		t.Run(scenario, func(t *testing.T) {
+			old := quotatraffic.RoutingPolicies
+			defer func() { quotatraffic.RoutingPolicies = old }()
+			store := quotatraffic.NewPolicyStore()
+			quotatraffic.RoutingPolicies = store
+			_ = store.Load(filepath.Join(t.TempDir(), "policy.json"))
+			oldC := sessionrebalance.Default
+			sessionrebalance.Default = sessionrebalance.New()
+			defer func() { sessionrebalance.Default = oldC }()
+			m := NewManager(nil, nil, nil)
+			a, _ := m.Register(WithSkipPersist(context.Background()), &Auth{ID: t.Name() + "a", Provider: "codex", Status: StatusActive, Attributes: map[string]string{"priority": "10", "websockets": "true"}})
+			b, _ := m.Register(WithSkipPersist(context.Background()), &Auth{ID: t.Name() + "b", Provider: "codex", Status: StatusActive, Attributes: map[string]string{"priority": "0", "websockets": "true"}})
+			r := registry.GetGlobalRegistry()
+			r.RegisterClient(a.ID, "codex", []*registry.ModelInfo{{ID: "recovery-model"}})
+			r.RegisterClient(b.ID, "codex", []*registry.ModelInfo{{ID: "recovery-model"}})
+			defer r.UnregisterClient(a.ID)
+			defer r.UnregisterClient(b.ID)
+			now := time.Now()
+			quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"90"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now, "websocket_event")
+			initial := store.RebalanceSettings(a.Index, "codex")
+			opted := quotatraffic.RebalanceSettings{RebalanceSessions: true, ReconnectWebsockets: true}
+			_ = store.CompareAndSetWithRebalance(a.Index, "codex", map[string]float64{"x-codex-primary@300": 20}, map[string]float64{}, &opted, &initial)
+			switch scenario {
+			case "disabled":
+				a.Disabled = true
+			case "cooldown":
+				a.Unavailable = true
+				a.NextRetryAfter = now.Add(time.Hour)
+			case "http-only":
+				a.Attributes["websockets"] = "false"
+			case "lower-priority":
+				a.Attributes["priority"] = "-1"
+			case "incompatible":
+				r.RegisterClient(a.ID, "codex", []*registry.ModelInfo{{ID: "other-model"}})
+			}
+			_, _, _ = m.Modify(WithSkipPersist(context.Background()), a.ID, a.RegistrationEpoch, func(current *Auth) error {
+				current.Disabled = a.Disabled
+				current.Unavailable = a.Unavailable
+				current.NextRetryAfter = a.NextRetryAfter
+				current.Attributes = a.Attributes
+				return nil
+			})
+			previous := map[string]bool{}
+			m.CheckQuotaRebalances(previous, now)
+			quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"10"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now.Add(time.Second), "websocket_event")
+			m.CheckQuotaRebalances(previous, now.Add(time.Second))
+			m.CheckQuotaRebalances(previous, now.Add(20*time.Second))
+			if snapshots := sessionrebalance.Default.Snapshots(); snapshots[len(snapshots)-1].Reason == "quota_policy_recovered" {
+				t.Fatal("unstable recovery triggered")
+			}
+			m.CheckQuotaRebalances(previous, now.Add(132*time.Second))
+			snapshots := sessionrebalance.Default.Snapshots()
+			job := snapshots[len(snapshots)-1]
+			switch scenario {
+			case "preferred":
+				if job.Reason != "quota_policy_recovered" || !job.ReconnectWebsockets {
+					t.Fatal("preferred recovery missing", job)
+				}
+			case "http-only":
+				if job.Reason == "quota_policy_recovered" && job.ReconnectWebsockets {
+					t.Fatal("HTTP recovery outranked WS account")
+				}
+			default:
+				if job.Reason == "quota_policy_recovered" {
+					t.Fatal("nonpreferred recovery", job)
+				}
+			}
+			// Immediate quota flapping may clear affinity but cannot retire another socket.
+			quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"90"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now.Add(133*time.Second), "websocket_event")
+			m.CheckQuotaRebalances(previous, now.Add(133*time.Second))
+			snapshots = sessionrebalance.Default.Snapshots()
+			if scenario == "preferred" && snapshots[len(snapshots)-1].ReconnectWebsockets {
+				t.Fatal("flapping repeatedly reconnects")
+			}
+			quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"10"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now.Add(134*time.Second), "websocket_event")
+			m.CheckQuotaRebalances(previous, now.Add(134*time.Second))
+			quotatraffic.Capture(a.Index, "codex", http.Header{"X-Codex-Primary-Used-Percent": {"90"}, "X-Codex-Primary-Window-Minutes": {"300"}}, now.Add(135*time.Second), "websocket_event")
+			m.CheckQuotaRebalances(previous, now.Add(135*time.Second))
+			snapshots = sessionrebalance.Default.Snapshots()
+			if snapshots[len(snapshots)-1].ReconnectWebsockets {
+				t.Fatal("repeated exclusion bypassed reconnect quiet period")
+			}
+		})
+	}
+}
