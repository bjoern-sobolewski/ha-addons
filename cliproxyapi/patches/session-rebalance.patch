+package quotatraffic
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestRebalanceSettingsMigrationPersistenceAndConflict(t *testing.T) {
+	file := filepath.Join(t.TempDir(), "policy.json")
+	if err := os.WriteFile(file, []byte(`{"codex:a":{"window":10}}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	s := NewPolicyStore()
+	if err := s.Load(file); err != nil {
+		t.Fatal(err)
+	}
+	initial := s.RebalanceSettings("a", "codex")
+	if !initial.RebalanceSessions || initial.ReconnectWebsockets {
+		t.Fatal(initial)
+	}
+	opted := RebalanceSettings{true, true}
+	values := map[string]float64{"window": 10}
+	if err := s.CompareAndSetWithRebalance("a", "codex", values, values, &opted, &initial); err != nil {
+		t.Fatal(err)
+	}
+	if err := s.CompareAndSetWithRebalance("a", "codex", values, values, &initial, &initial); !errors.Is(err, ErrPolicyChanged) {
+		t.Fatal("stale behavior overwrite", err)
+	}
+	if err := s.Set("a", "codex", map[string]float64{}); err != nil {
+		t.Fatal(err)
+	}
+	reopened := NewPolicyStore()
+	if err := reopened.Load(file); err != nil {
+		t.Fatal(err)
+	}
+	if reopened.RebalanceSettings("a", "codex") != opted {
+		t.Fatal("old request or threshold clearing lost preferences")
+	}
+}
