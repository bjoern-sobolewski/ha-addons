+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+type resetDoer func(*http.Request) (*http.Response, error)
+
+func (f resetDoer) Do(r *http.Request) (*http.Response, error) { return f(r) }
+func resetReply(body string) *http.Response {
+	return &http.Response{StatusCode: 200, Body: io.NopCloser(strings.NewReader(body)), Header: http.Header{}}
+}
+func resetFixture(t *testing.T, provider string) (*Handler, *coreauth.Auth) {
+	t.Helper()
+	manager := coreauth.NewManager(nil, nil, nil)
+	a := &coreauth.Auth{ID: "reset-test", Index: "reset-index", Provider: provider, Metadata: map[string]any{"access_token": "synthetic-token", "account_id": "synthetic-account"}, Attributes: map[string]string{"runtime_only": "true"}, Quota: coreauth.QuotaState{Exceeded: true}, Unavailable: true}
+	if _, err := manager.Register(context.Background(), a); err != nil {
+		t.Fatal(err)
+	}
+	h := &Handler{cfg: &config.Config{AuthDir: t.TempDir()}, authManager: manager}
+	return h, a
+}
+func resetRequest(h *Handler, id, provider, choice string) *httptest.ResponseRecorder {
+	rec := httptest.NewRecorder()
+	ctx, _ := gin.CreateTestContext(rec)
+	ctx.Request = httptest.NewRequest("POST", "/v8/management/quota/reset", strings.NewReader(`{"auth_index":"reset-index","provider":"`+provider+`","request_id":"`+id+`"`+choice+`}`))
+	ctx.Request.Header.Set("Content-Type", "application/json")
+	h.RedeemQuotaReset(ctx)
+	return rec
+}
+
+const resetID = "11111111-1111-4111-8111-111111111111"
+const otherResetID = "22222222-2222-4222-8222-222222222222"
+const resetCredits = `{"available_count":2,"credits":[{"id":"later","status":"available","reset_type":"codex_rate_limits","expires_at":"2099-01-01T00:00:00Z"},{"id":"soon","status":"available","reset_type":"codex_rate_limits","expires_at":"2098-01-01T00:00:00Z"}]}`
+
+func TestSharedResetAutomaticExplicitAndReplay(t *testing.T) {
+	for _, choice := range []string{"", `,"credit_id":"later"`} {
+		t.Run(choice, func(t *testing.T) {
+			h, _ := resetFixture(t, "codex")
+			posts := 0
+			h.resetHTTPClient = resetDoer(func(r *http.Request) (*http.Response, error) {
+				if r.URL.Host != "chatgpt.com" || r.Header.Get("Authorization") != "Bearer synthetic-token" {
+					t.Fatal("wrong provider authentication")
+				}
+				if r.Method == "GET" {
+					return resetReply(resetCredits), nil
+				}
+				posts++
+				var body map[string]string
+				if json.NewDecoder(r.Body).Decode(&body) != nil {
+					t.Fatal("invalid provider body")
+				}
+				if body["redeem_request_id"] != resetID {
+					t.Fatal("request ID changed")
+				}
+				if choice == "" && len(body) != 1 {
+					t.Fatal("automatic credit selection changed")
+				}
+				if choice != "" && body["credit_id"] != "later" {
+					t.Fatal("explicit credit choice lost")
+				}
+				return resetReply(`{"code":"reset","windows_reset":2}`), nil
+			})
+			for range 2 {
+				rec := resetRequest(h, resetID, "codex", choice)
+				if rec.Code != 200 || !strings.Contains(rec.Body.String(), `"code":"reset"`) {
+					t.Fatal(rec.Code, rec.Body.String())
+				}
+			}
+			if posts != 1 {
+				t.Fatal("duplicate spend", posts)
+			}
+			a, _ := h.authManager.GetByID("reset-test")
+			if a.Quota.Exceeded || a.Unavailable {
+				t.Fatal("cooldown not cleared")
+			}
+			// Restart loads the successful result rather than spending again.
+			restarted := &Handler{cfg: h.cfg, authManager: h.authManager, resetHTTPClient: resetDoer(func(*http.Request) (*http.Response, error) { t.Fatal("replayed provider call"); return nil, nil })}
+			if rec := resetRequest(restarted, resetID, "codex", choice); rec.Code != 200 {
+				t.Fatal(rec.Body.String())
+			}
+			if rec := resetRequest(restarted, resetID, "codex", `,"credit_id":"soon"`); rec.Code != 409 {
+				t.Fatal("payload conflict accepted")
+			}
+		})
+	}
+}
+func TestSharedResetUnknownRequiresSameIDAndKeepsCooldown(t *testing.T) {
+	h, _ := resetFixture(t, "codex")
+	posts := 0
+	h.resetHTTPClient = resetDoer(func(r *http.Request) (*http.Response, error) {
+		if r.Method == "GET" {
+			return resetReply(resetCredits), nil
+		}
+		posts++
+		if posts == 1 {
+			return nil, errors.New("lost response")
+		}
+		return resetReply(`{"code":"already_redeemed"}`), nil
+	})
+	if rec := resetRequest(h, resetID, "codex", ""); !strings.Contains(rec.Body.String(), `"unknown"`) {
+		t.Fatal(rec.Body.String())
+	}
+	a, _ := h.authManager.GetByID("reset-test")
+	if !a.Quota.Exceeded {
+		t.Fatal("unknown outcome cleared cooldown")
+	}
+	if rec := resetRequest(h, otherResetID, "codex", ""); rec.Code != 409 {
+		t.Fatal("new ID allowed while ambiguous")
+	}
+	if rec := resetRequest(h, resetID, "codex", ""); !strings.Contains(rec.Body.String(), `"already_redeemed"`) {
+		t.Fatal(rec.Body.String())
+	}
+	if posts != 2 {
+		t.Fatal(posts)
+	}
+}
+func TestSharedResetConcurrentAccountProtection(t *testing.T) {
+	h, _ := resetFixture(t, "codex")
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	var posts atomic.Int32
+	h.resetHTTPClient = resetDoer(func(r *http.Request) (*http.Response, error) {
+		if r.Method == "GET" {
+			return resetReply(resetCredits), nil
+		}
+		posts.Add(1)
+		close(entered)
+		<-release
+		return resetReply(`{"code":"reset"}`), nil
+	})
+	done := make(chan *httptest.ResponseRecorder)
+	go func() { done <- resetRequest(h, resetID, "codex", "") }()
+	<-entered
+	for _, id := range []string{resetID, otherResetID} {
+		if rec := resetRequest(h, id, "codex", ""); rec.Code != 409 {
+			t.Fatal("concurrent reset accepted")
+		}
+	}
+	close(release)
+	if rec := <-done; rec.Code != 200 {
+		t.Fatal(rec.Body.String())
+	}
+	if posts.Load() != 1 {
+		t.Fatal("duplicate provider call")
+	}
+}
+func TestSharedResetClaudeEligibilityAndChoice(t *testing.T) {
+	const org = "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
+	h, _ := resetFixture(t, "claude")
+	posts := 0
+	h.resetHTTPClient = resetDoer(func(r *http.Request) (*http.Response, error) {
+		if strings.Contains(r.URL.Path, "profile") {
+			return resetReply(`{"organization":{"uuid":"` + org + `"}}`), nil
+		}
+		if r.Method == "GET" {
+			return resetReply(`{"cedar_ember":{"eligible":true,"at_limit":true,"next_grant_id":"first","grants":[{"id":"first","resets_total":2,"resets_left":2,"usable_now":true},{"id":"chosen","resets_total":1,"resets_left":1,"usable_now":true}]}}`), nil
+		}
+		posts++
+		var body map[string]string
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		if body["grant_id"] != "chosen" || body["request_id"] != resetID || body["program"] != "cedar_ember" || r.URL.Path != "/api/organizations/"+org+"/reset_rate_limits" {
+			t.Fatal("Claude choice changed", body)
+		}
+		return resetReply(`{"result":"reset"}`), nil
+	})
+	options, err := h.quotaResetOptions(context.Background(), h.authByIndex("reset-index"))
+	if err != nil || options.SelectedGrantID != "first" {
+		t.Fatal("shared selection", options, err)
+	}
+	if rec := resetRequest(h, otherResetID, "claude", `,"grant_id":"missing","organization_id":"`+org+`"`); !strings.Contains(rec.Body.String(), "ineligible") {
+		t.Fatal(rec.Body.String())
+	}
+	if posts != 0 {
+		t.Fatal("ineligible grant spent")
+	}
+	if rec := resetRequest(h, resetID, "claude", `,"grant_id":"chosen","organization_id":"`+org+`"`); !strings.Contains(rec.Body.String(), `"reset"`) {
+		t.Fatal(rec.Body.String())
+	}
+	if posts != 1 {
+		t.Fatal(posts)
+	}
+}
+func TestSharedResetExpiredCreditAndProviderReplacement(t *testing.T) {
+	if codexResetEligible(json.RawMessage(`{"available_count":1,"credits":[{"id":"old","status":"available","reset_type":"codex_rate_limits","expires_at":"2000-01-01T00:00:00Z"}]}`), "old", time.Now()) {
+		t.Fatal("expired explicit credit accepted")
+	}
+	h, _ := resetFixture(t, "codex")
+	if rec := resetRequest(h, resetID, "claude", ""); rec.Code != 409 {
+		t.Fatal("provider replacement accepted")
+	}
+}
+
+func TestSharedResetClaudePolicyGates(t *testing.T) {
+	now := time.Date(2026, 11, 6, 12, 0, 0, 0, time.UTC)
+	for _, tc := range []struct {
+		name   string
+		change func(*ClaudeResetGrantStatus, *ClaudeResetGrant)
+	}{
+		{"ineligible", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) { s.Eligible = false }},
+		{"paused", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) { g.Paused = true }},
+		{"not usable", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) { g.UsableNow = false }},
+		{"exhausted", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) { g.ResetsLeft = 0 }},
+		{"requires limit", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) { s.AtLimit = false }},
+		{"future", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) {
+			g.StartsAt = now.Add(time.Hour).Format(time.RFC3339)
+		}},
+		{"expired", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) { g.EndsAt = now.Format(time.RFC3339) }},
+		{"cooldown", func(s *ClaudeResetGrantStatus, g *ClaudeResetGrant) {
+			s.CooldownUntil = now.Add(time.Hour).Format(time.RFC3339)
+		}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			status := &ClaudeResetGrantStatus{Eligible: true, AtLimit: true}
+			grant := ClaudeResetGrant{ID: "test", ResetsLeft: 1, UsableNow: true, UseRequiresLimit: true}
+			if !claudeGrantUsable(status, grant, now) {
+				t.Fatal("valid grant blocked")
+			}
+			tc.change(status, &grant)
+			if claudeGrantUsable(status, grant, now) {
+				t.Fatal("unsafe grant accepted")
+			}
+		})
+	}
+}
+
+func TestSharedResetInvalidJournalFailsClosed(t *testing.T) {
+	for _, data := range []string{"null", "{", "{\"invalid\":null}"} {
+		t.Run(data, func(t *testing.T) {
+			h, _ := resetFixture(t, "codex")
+			if err := os.WriteFile(h.resetJournalPath(), []byte(data), 0600); err != nil {
+				t.Fatal(err)
+			}
+			h.resetHTTPClient = resetDoer(func(*http.Request) (*http.Response, error) {
+				t.Fatal("provider called with invalid journal")
+				return nil, nil
+			})
+			if rec := resetRequest(h, resetID, "codex", ""); rec.Code != 503 {
+				t.Fatal(rec.Code, rec.Body.String())
+			}
+		})
+	}
+}
+func TestSharedResetStorageRequiredBeforeSpending(t *testing.T) {
+	h, _ := resetFixture(t, "codex")
+	h.cfg.AuthDir = filepath.Join(h.cfg.AuthDir, "missing")
+	posts := 0
+	h.resetHTTPClient = resetDoer(func(r *http.Request) (*http.Response, error) {
+		if r.Method == "GET" {
+			return resetReply(resetCredits), nil
+		}
+		posts++
+		return resetReply("{\"code\":\"reset\"}"), nil
+	})
+	if rec := resetRequest(h, resetID, "codex", ""); rec.Code != 503 || posts != 0 {
+		t.Fatal("spent without persistence", rec.Code, posts)
+	}
+	if err := os.Mkdir(h.cfg.AuthDir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if rec := resetRequest(h, resetID, "codex", ""); rec.Code != 200 || posts != 1 {
+		t.Fatal("failed to recover from storage error", rec.Code, posts)
+	}
+	h, _ = resetFixture(t, "codex")
+	h.cfg.AuthDir = ""
+	if rec := resetRequest(h, resetID, "codex", ""); rec.Code != 503 {
+		t.Fatal("allowed nonpersistent reset", rec.Code)
+	}
+}
