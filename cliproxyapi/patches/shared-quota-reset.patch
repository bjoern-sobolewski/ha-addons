diff --git a/internal/api/handlers/management/quota_reset.go b/internal/api/handlers/management/quota_reset.go
new file mode 100644
index 00000000..4cf818dd
--- /dev/null
+++ b/internal/api/handlers/management/quota_reset.go
@@ -0,0 +1,445 @@
+package management
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// Omitting credit_id preserves OpenAI's automatic credit selection.
+type quotaResetRequest struct {
+	AuthIndex      string `json:"auth_index"`
+	Provider       string `json:"provider"`
+	RequestID      string `json:"request_id"`
+	CreditID       string `json:"credit_id,omitempty"`
+	GrantID        string `json:"grant_id,omitempty"`
+	OrganizationID string `json:"organization_id,omitempty"`
+}
+type quotaResetResult struct {
+	Code           string `json:"code"`
+	WindowsReset   int    `json:"windowsReset,omitempty"`
+	RecoveryFailed bool   `json:"recoveryFailed,omitempty"`
+}
+type quotaResetOperation struct {
+	Request   quotaResetRequest `json:"request"`
+	Identity  string            `json:"identity"`
+	CreatedAt time.Time         `json:"created_at"`
+	Result    quotaResetResult  `json:"result"`
+	Busy      bool              `json:"-"`
+}
+type quotaResetOptions struct {
+	Provider        string                  `json:"provider"`
+	Credits         json.RawMessage         `json:"credits,omitempty"`
+	Usage           json.RawMessage         `json:"usage,omitempty"`
+	Status          *ClaudeResetGrantStatus `json:"status,omitempty"`
+	SelectedGrantID string                  `json:"selectedGrantId,omitempty"`
+	OrganizationID  string                  `json:"organizationId,omitempty"`
+}
+
+func resetIdentity(a *coreauth.Auth) string {
+	email, account := authIdentityEmailAndAccountID(a)
+	sum := sha256.Sum256([]byte(a.ID + "\x00" + a.Provider + "\x00" + email + "\x00" + account))
+	return hex.EncodeToString(sum[:])
+}
+
+// No caller-controlled URLs or headers reach the provider from this endpoint.
+func (h *Handler) resetProviderCall(ctx context.Context, a *coreauth.Auth, method, path string, body any) (int, []byte, error) {
+	token, err := h.resolveTokenForAuth(ctx, a, "")
+	if err != nil || token == "" {
+		return 0, nil, errors.New("account authentication unavailable")
+	}
+	origin := "https://chatgpt.com"
+	if a.Provider == "claude" {
+		origin = "https://api.anthropic.com"
+	}
+	var data []byte
+	if body != nil {
+		data, err = json.Marshal(body)
+		if err != nil {
+			return 0, nil, err
+		}
+	}
+	req, err := http.NewRequestWithContext(ctx, method, origin+path, bytes.NewReader(data))
+	if err != nil {
+		return 0, nil, err
+	}
+	req.Header.Set("Authorization", "Bearer "+token)
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("Content-Type", "application/json")
+	if a.Provider == "claude" {
+		req.Header.Set("anthropic-beta", "oauth-2025-04-20")
+		req.Header.Set("User-Agent", "claude-cli/2.1.280 (external, cli)")
+	} else {
+		req.Header.Set("OpenAI-Beta", "codex-1")
+		req.Header.Set("Originator", "Codex Desktop")
+		req.Header.Set("User-Agent", "Codex Desktop/0.160.1")
+		_, account := authIdentityEmailAndAccountID(a)
+		if account != "" {
+			req.Header.Set("Chatgpt-Account-Id", account)
+		}
+	}
+	// Same bound as management API-call. Never redirect credentials to another host.
+	client := &http.Client{Transport: h.apiCallTransport(a, ""), Timeout: defaultAPICallTimeout, CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	var doer interface {
+		Do(*http.Request) (*http.Response, error)
+	} = client
+	if h.resetHTTPClient != nil {
+		doer = h.resetHTTPClient
+	}
+	resp, err := doer.Do(req)
+	if err != nil {
+		return 0, nil, errors.New("provider request failed")
+	}
+	defer resp.Body.Close()
+	data, err = io.ReadAll(io.LimitReader(resp.Body, 2<<20))
+	return resp.StatusCode, data, err
+}
+func (h *Handler) quotaResetOptions(ctx context.Context, a *coreauth.Auth) (quotaResetOptions, error) {
+	options := quotaResetOptions{Provider: a.Provider}
+	if a.Provider == "codex" {
+		code, data, err := h.resetProviderCall(ctx, a, "GET", "/backend-api/wham/rate-limit-reset-credits", nil)
+		if err != nil || code < 200 || code >= 300 || !json.Valid(data) {
+			return options, errors.New("reset credits unavailable")
+		}
+		options.Credits = data
+		return options, nil
+	}
+	if a.Provider != "claude" {
+		return options, errors.New("unsupported reset provider")
+	}
+	code, data, err := h.resetProviderCall(ctx, a, "GET", "/api/oauth/usage?cedar_ember=1&skip_spend=1", nil)
+	if err != nil || code < 200 || code >= 300 {
+		return options, errors.New("reset grants unavailable")
+	}
+	var usage struct {
+		Grants json.RawMessage `json:"cedar_ember"`
+	}
+	if json.Unmarshal(data, &usage) != nil {
+		return options, errors.New("invalid reset grants")
+	}
+	options.Status = parseClaudeResetGrants(usage.Grants)
+	if options.Status == nil {
+		return options, errors.New("invalid reset grants")
+	}
+	options.Usage = data
+	if grant := selectClaudeResetGrant(options.Status, time.Now()); grant != nil {
+		options.SelectedGrantID = grant.ID
+	}
+	code, data, err = h.resetProviderCall(ctx, a, "GET", "/api/oauth/profile", nil)
+	var profile struct {
+		Organization struct {
+			UUID string `json:"uuid"`
+		} `json:"organization"`
+	}
+	if err != nil || code < 200 || code >= 300 || json.Unmarshal(data, &profile) != nil || !claudeUUIDPattern.MatchString(profile.Organization.UUID) {
+		return options, errors.New("reset organization unavailable")
+	}
+	options.OrganizationID = strings.ToLower(profile.Organization.UUID)
+	// The popup offers only currently usable grants. Keep original usage for quota display.
+	original := options.Status
+	filtered := *original
+	filtered.Grants = []ClaudeResetGrant{}
+	filtered.AvailableCount = 0
+	for _, grant := range original.Grants {
+		if claudeGrantUsable(original, grant, time.Now()) {
+			filtered.Grants = append(filtered.Grants, grant)
+			filtered.AvailableCount += grant.ResetsLeft
+		}
+	}
+	options.Status = &filtered
+	return options, nil
+}
+func (h *Handler) GetQuotaResetOptions(c *gin.Context) {
+	a := h.authByIndex(strings.TrimSpace(c.Query("auth_index")))
+	if a == nil {
+		c.JSON(404, gin.H{"error": "auth not found"})
+		return
+	}
+	options, err := h.quotaResetOptions(c.Request.Context(), a)
+	if err != nil {
+		c.JSON(502, gin.H{"error": err.Error()})
+		return
+	}
+	c.JSON(200, options)
+}
+func (h *Handler) resetJournalPath() string {
+	cfg := h.configSnapshot()
+	if cfg == nil || cfg.AuthDir == "" {
+		return ""
+	}
+	return filepath.Join(cfg.AuthDir, ".quota-reset-journal.ledger")
+}
+
+// Persist before spending. On restart unfinished operations remain ambiguous.
+func (h *Handler) loadResetJournal() error {
+	if h.resetLoaded {
+		return nil
+	}
+	if h.resetJournalPath() == "" {
+		return errors.New("persistent reset journal unavailable")
+	}
+	h.resetOperations = map[string]*quotaResetOperation{}
+	if path := h.resetJournalPath(); path != "" {
+		data, err := os.ReadFile(path)
+		if err != nil && !os.IsNotExist(err) {
+			return errors.New("reset journal unavailable")
+		}
+		if err == nil && (json.Unmarshal(data, &h.resetOperations) != nil || h.resetOperations == nil) {
+			return errors.New("reset journal invalid")
+		}
+	}
+	for id, op := range h.resetOperations {
+		if op == nil || op.Request.RequestID != id || !validQuotaResetRequestID(op.Request.Provider, id) || op.Identity == "" || op.CreatedAt.IsZero() {
+			return errors.New("reset journal invalid")
+		}
+	}
+	h.resetLoaded = true
+	return nil
+}
+func (h *Handler) saveResetJournal() error {
+	path := h.resetJournalPath()
+	if path == "" {
+		return nil
+	}
+	data, err := json.Marshal(h.resetOperations)
+	if err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".quota-reset-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if err = f.Chmod(0600); err == nil {
+		_, err = f.Write(data)
+	}
+	if err == nil {
+		err = f.Sync()
+	}
+	closeErr := f.Close()
+	if err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	return os.Rename(name, path)
+}
+func (h *Handler) RedeemQuotaReset(c *gin.Context) {
+	c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 4096)
+	var req quotaResetRequest
+	if c.ShouldBindJSON(&req) != nil || !validQuotaResetRequestID(req.Provider, req.RequestID) || req.AuthIndex == "" || (req.Provider != "codex" && req.Provider != "claude") || len(req.CreditID) > 200 {
+		c.JSON(400, gin.H{"error": "invalid reset request"})
+		return
+	}
+	if (req.Provider == "codex" && (req.GrantID != "" || req.OrganizationID != "")) || (req.Provider == "claude" && req.CreditID != "") {
+		c.JSON(400, gin.H{"error": "invalid provider choice"})
+		return
+	}
+	a := h.authByIndex(req.AuthIndex)
+	if a == nil || a.Provider != req.Provider {
+		c.JSON(409, gin.H{"error": "account changed"})
+		return
+	}
+	identity := resetIdentity(a)
+	h.resetMu.Lock()
+	if err := h.loadResetJournal(); err != nil {
+		h.resetMu.Unlock()
+		c.JSON(503, gin.H{"error": err.Error()})
+		return
+	}
+	op := h.resetOperations[req.RequestID]
+	retry := op != nil
+	if op != nil {
+		if op.Request != req || op.Identity != identity {
+			h.resetMu.Unlock()
+			c.JSON(409, gin.H{"error": "reset request identity conflict"})
+			return
+		}
+		if op.Busy {
+			h.resetMu.Unlock()
+			c.JSON(409, gin.H{"error": "reset in progress"})
+			return
+		}
+		if op.Result.Code != "unknown" {
+			result := op.Result
+			h.resetMu.Unlock()
+			c.JSON(200, result)
+			return
+		}
+		if time.Since(op.CreatedAt) > 10*time.Minute {
+			h.resetMu.Unlock()
+			c.JSON(409, gin.H{"error": "ambiguous reset retry expired"})
+			return
+		}
+	} else {
+		for _, prior := range h.resetOperations {
+			if prior.Identity == identity && (prior.Busy || prior.Result.Code == "unknown") {
+				h.resetMu.Unlock()
+				c.JSON(409, gin.H{"error": "account has an unresolved reset"})
+				return
+			}
+
+		}
+		if len(h.resetOperations) >= 4096 {
+			h.resetMu.Unlock()
+			c.JSON(503, gin.H{"error": "reset journal full"})
+			return
+		}
+		op = &quotaResetOperation{Request: req, Identity: identity, CreatedAt: time.Now(), Result: quotaResetResult{Code: "unknown"}}
+		h.resetOperations[req.RequestID] = op
+	}
+	op.Busy = true
+	if err := h.saveResetJournal(); err != nil {
+		op.Busy = false
+		if !retry {
+			delete(h.resetOperations, req.RequestID)
+		}
+		h.resetMu.Unlock()
+		c.JSON(503, gin.H{"error": "reset journal unavailable"})
+		return
+	}
+	h.resetMu.Unlock()
+	result := h.executeQuotaReset(c.Request.Context(), a, req, retry)
+	h.resetMu.Lock()
+	// A retry refusal cannot prove an earlier ambiguous POST did not spend.
+	if !retry || result.Code == "reset" || result.Code == "already_redeemed" || result.Code == "already_used" {
+		op.Result = result
+	}
+	op.Busy = false
+	if retry && op.Result.Code == "unknown" {
+		result.Code = "unknown"
+	}
+	_ = h.saveResetJournal() // The previously persisted unknown state remains safe on failure.
+	h.resetMu.Unlock()
+	c.JSON(200, result)
+}
+func (h *Handler) executeQuotaReset(ctx context.Context, a *coreauth.Auth, req quotaResetRequest, retry bool) quotaResetResult {
+	result := quotaResetResult{Code: "unknown"}
+	path := "/backend-api/wham/rate-limit-reset-credits/consume"
+	body := map[string]string{"redeem_request_id": req.RequestID}
+	if req.Provider == "claude" {
+		if !claudeGrantIDPattern.MatchString(req.GrantID) || !claudeUUIDPattern.MatchString(req.OrganizationID) {
+			return quotaResetResult{Code: "unavailable"}
+		}
+		if !retry {
+			options, err := h.quotaResetOptions(ctx, a)
+			if err != nil {
+				return quotaResetResult{Code: "unavailable"}
+			}
+			valid := false
+			for _, grant := range options.Status.Grants {
+				if grant.ID == req.GrantID && claudeGrantUsable(options.Status, grant, time.Now()) {
+					valid = true
+				}
+			}
+			if !valid || options.OrganizationID != strings.ToLower(req.OrganizationID) {
+				return quotaResetResult{Code: "ineligible"}
+			}
+		}
+		path = "/api/organizations/" + strings.ToLower(req.OrganizationID) + "/reset_rate_limits"
+		body = map[string]string{"program": "cedar_ember", "grant_id": req.GrantID, "request_id": req.RequestID}
+	} else {
+		if !retry {
+			options, err := h.quotaResetOptions(ctx, a)
+			if err != nil || !codexResetEligible(options.Credits, req.CreditID, time.Now()) {
+				return quotaResetResult{Code: "unavailable"}
+			}
+		}
+		if req.CreditID != "" {
+			body["credit_id"] = req.CreditID
+		}
+	}
+	current := h.authByIndex(req.AuthIndex)
+	if current == nil || resetIdentity(current) != resetIdentity(a) {
+		return quotaResetResult{Code: "unavailable"}
+	}
+	code, data, err := h.resetProviderCall(ctx, current, "POST", path, body)
+	if err != nil {
+		return result
+	}
+	if code == 429 {
+		return quotaResetResult{Code: "rate_limited"}
+	}
+	if code == 401 || code == 403 {
+		return quotaResetResult{Code: "auth_error"}
+	}
+	if code < 200 || code >= 300 {
+		return result
+	}
+	var response struct {
+		Code         string `json:"code"`
+		Result       string `json:"result"`
+		WindowsReset int    `json:"windows_reset"`
+	}
+	if json.Unmarshal(data, &response) != nil {
+		return result
+	}
+	value := response.Code
+	if req.Provider == "claude" {
+		value = response.Result
+	}
+	switch value {
+	case "reset", "already_redeemed", "already_used", "not_limited", "cooldown", "ineligible", "unavailable":
+		result.Code = value
+	}
+	result.WindowsReset = response.WindowsReset
+	if result.Code == "reset" || result.Code == "already_redeemed" || result.Code == "already_used" {
+		current = h.authByIndex(req.AuthIndex)
+		if current == nil || resetIdentity(current) != resetIdentity(a) || h.authManager == nil {
+			result.RecoveryFailed = true
+		} else {
+			updated, _, err := h.authManager.ResetQuota(ctx, a.ID)
+			result.RecoveryFailed = err != nil || updated == nil
+		}
+	}
+	return result
+}
+
+func validQuotaResetRequestID(provider, id string) bool {
+	if claudeUUIDPattern.MatchString(id) {
+		return true
+	}
+	if provider != "claude" || len(id) != 32 {
+		return false
+	}
+	_, err := hex.DecodeString(id)
+	return err == nil
+}
+func codexResetEligible(raw json.RawMessage, creditID string, now time.Time) bool {
+	var data struct {
+		Available *int `json:"available_count"`
+		Credits   []struct {
+			ID      string `json:"id"`
+			Status  string `json:"status"`
+			Type    string `json:"reset_type"`
+			Expires string `json:"expires_at"`
+		} `json:"credits"`
+	}
+	if json.Unmarshal(raw, &data) != nil {
+		return false
+	}
+	if creditID == "" && data.Available != nil {
+		return *data.Available > 0
+	}
+	for _, credit := range data.Credits {
+		expiry, err := time.Parse(time.RFC3339Nano, credit.Expires)
+		if credit.Status == "available" && credit.Type == "codex_rate_limits" && err == nil && now.Before(expiry) && (creditID == "" || credit.ID == creditID) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/internal/api/handlers/management/quota_reset_grants.go b/internal/api/handlers/management/quota_reset_grants.go
new file mode 100644
index 00000000..47e04d7c
--- /dev/null
+++ b/internal/api/handlers/management/quota_reset_grants.go
@@ -0,0 +1,154 @@
+package management
+
+import (
+	"encoding/json"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+	"unicode"
+)
+
+var claudeGrantIDPattern = regexp.MustCompile(`^[a-z0-9_-]{1,40}$`)
+var claudeUUIDPattern = regexp.MustCompile(`(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+
+type ClaudeResetGrant struct {
+	ID               string   `json:"id"`
+	Label            string   `json:"label,omitempty"`
+	ResetsTotal      int      `json:"resetsTotal"`
+	ResetsLeft       int      `json:"resetsLeft"`
+	StartsAt         string   `json:"startsAt,omitempty"`
+	EndsAt           string   `json:"endsAt,omitempty"`
+	Clears           []string `json:"clears"`
+	Paused           bool     `json:"paused"`
+	UsableNow        bool     `json:"usableNow"`
+	UseRequiresLimit bool     `json:"useRequiresLimit"`
+}
+
+type ClaudeResetGrantStatus struct {
+	Eligible         bool               `json:"eligible"`
+	IneligibleReason string             `json:"ineligibleReason,omitempty"`
+	AtLimit          bool               `json:"atLimit"`
+	Grants           []ClaudeResetGrant `json:"grants"`
+	NextGrantID      string             `json:"nextGrantId,omitempty"`
+	WeeklyResetsAt   string             `json:"weeklyResetsAt,omitempty"`
+	CooldownUntil    string             `json:"cooldownUntil,omitempty"`
+	AvailableCount   int                `json:"availableCount"`
+}
+
+// Validate optional reset metadata without affecting ordinary quota observations.
+func parseClaudeResetGrants(raw json.RawMessage) *ClaudeResetGrantStatus {
+	var block struct {
+		Eligible         *bool   `json:"eligible"`
+		IneligibleReason *string `json:"ineligible_reason"`
+		AtLimit          *bool   `json:"at_limit"`
+		Grants           []struct {
+			ID            string   `json:"id"`
+			Label         string   `json:"label"`
+			Total         *int     `json:"resets_total"`
+			Left          *int     `json:"resets_left"`
+			Starts        *string  `json:"starts_at"`
+			Ends          *string  `json:"ends_at"`
+			Clears        []string `json:"clears"`
+			Paused        *bool    `json:"paused"`
+			Usable        *bool    `json:"usable_now"`
+			RequiresLimit *bool    `json:"use_requires_limit"`
+		} `json:"grants"`
+		Next     *string `json:"next_grant_id"`
+		Weekly   *string `json:"weekly_resets_at"`
+		Cooldown *string `json:"cooldown_until"`
+	}
+	if json.Unmarshal(raw, &block) != nil || block.Eligible == nil || len(block.Grants) > 64 || !claudeOptionalTimeValid(block.Weekly) || !claudeOptionalTimeValid(block.Cooldown) {
+		return nil
+	}
+	status := &ClaudeResetGrantStatus{Eligible: *block.Eligible, AtLimit: block.AtLimit != nil && *block.AtLimit, Grants: []ClaudeResetGrant{}, WeeklyResetsAt: optionalClaudeString(block.Weekly), CooldownUntil: optionalClaudeString(block.Cooldown)}
+	if block.IneligibleReason != nil {
+		switch *block.IneligibleReason {
+		case "config_off", "tier", "seat", "mobile", "surface", "cli_version", "no_grant", "tenure", "other_experiment", "unavailable", "unknown":
+			status.IneligibleReason = *block.IneligibleReason
+		default:
+			status.IneligibleReason = "unknown"
+		}
+	}
+	seen := map[string]bool{}
+	for _, g := range block.Grants {
+		if !claudeGrantIDPattern.MatchString(g.ID) || seen[g.ID] || g.Total == nil || g.Left == nil || *g.Total < 0 || *g.Left < 0 || *g.Left > *g.Total || !claudeOptionalTimeValid(g.Starts) || !claudeOptionalTimeValid(g.Ends) {
+			return nil
+		}
+		seen[g.ID] = true
+		// Validate optional reset metadata without affecting ordinary quota observations.
+		clears := append([]string{}, g.Clears...)
+		label := strings.Join(strings.Fields(strings.Map(func(r rune) rune {
+			if unicode.IsControl(r) {
+				return ' '
+			}
+			return r
+		}, g.Label)), " ")
+		if len([]rune(label)) > 120 {
+			label = string([]rune(label)[:120])
+		}
+		status.Grants = append(status.Grants, ClaudeResetGrant{ID: g.ID, Label: label, ResetsTotal: *g.Total, ResetsLeft: *g.Left, StartsAt: optionalClaudeString(g.Starts), EndsAt: optionalClaudeString(g.Ends), Clears: clears, Paused: g.Paused != nil && *g.Paused, UsableNow: g.Usable != nil && *g.Usable, UseRequiresLimit: g.RequiresLimit == nil || *g.RequiresLimit})
+		// Validate optional reset metadata without affecting ordinary quota observations.
+		if *g.Left > int(^uint(0)>>1)-status.AvailableCount {
+			return nil
+		}
+		status.AvailableCount += *g.Left
+	}
+	if block.Next != nil && seen[*block.Next] {
+		status.NextGrantID = *block.Next
+	}
+	return status
+}
+
+func optionalClaudeString(value *string) string {
+	if value == nil {
+		return ""
+	}
+	return *value
+}
+func claudeOptionalTimeValid(value *string) bool {
+	if value == nil {
+		return true
+	}
+	_, err := time.Parse(time.RFC3339Nano, *value)
+	return err == nil
+}
+
+func claudeGrantUsable(status *ClaudeResetGrantStatus, grant ClaudeResetGrant, now time.Time) bool {
+	if status == nil || !status.Eligible || grant.Paused || !grant.UsableNow || grant.ResetsLeft <= 0 || (grant.UseRequiresLimit && !status.AtLimit) {
+		return false
+	}
+	for _, bound := range []struct {
+		value string
+		start bool
+	}{{grant.StartsAt, true}, {grant.EndsAt, false}, {status.CooldownUntil, true}} {
+		if bound.value == "" {
+			continue
+		}
+		at, err := time.Parse(time.RFC3339Nano, bound.value)
+		if err != nil || (bound.start && now.Before(at)) || (!bound.start && !now.Before(at)) {
+			return false
+		}
+	}
+	return true
+}
+
+func selectClaudeResetGrant(status *ClaudeResetGrantStatus, now time.Time) *ClaudeResetGrant {
+	if status == nil {
+		return nil
+	}
+	usable := []ClaudeResetGrant{}
+	for _, grant := range status.Grants {
+		if claudeGrantUsable(status, grant, now) {
+			if grant.ID == status.NextGrantID {
+				return &grant
+			}
+			usable = append(usable, grant)
+		}
+	}
+	sort.Slice(usable, func(i, j int) bool { return usable[i].ID < usable[j].ID })
+	if len(usable) == 0 {
+		return nil
+	}
+	return &usable[0]
+}
