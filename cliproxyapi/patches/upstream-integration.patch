+func TestCodexReconnectSerializesFinalCheckWithRefreshWriter(t *testing.T) {
+	_, target, record, raw, state := reconnectFixture(t)
+	storage := &atomicCodexReconnectStorage{record.Storage.(*codex.CodexTokenStorage), target.path, sha256.Sum256(raw), state}
+	locked, release, writerDone := make(chan struct{}), make(chan struct{}), make(chan error, 1)
+	concurrent := []byte(`{"type":"codex","account_id":"account-original","access_token":"renewed-by-concurrent-writer","websockets":true}`)
+	go func() {
+		writerDone <- codex.WithFileLock(target.path, func() error {
+			close(locked)
+			<-release
+			return os.WriteFile(target.path, concurrent, 0600)
+		})
+	}()
+	<-locked
+	reconnectDone := make(chan error, 1)
+	go func() { reconnectDone <- storage.SaveTokenToFile(target.path) }()
+	select {
+	case err := <-reconnectDone:
+		close(release)
+		<-writerDone
+		t.Fatalf("reconnect bypassed credential file lock: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(release)
+	if err := <-writerDone; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-reconnectDone; !errors.Is(err, errCodexReconnectChanged) {
+		t.Fatalf("newer credential was overwritten: %v", err)
+	}
+	after, err := os.ReadFile(target.path)
+	if err != nil || string(after) != string(concurrent) {
+		t.Fatal("concurrent refreshed credential was lost")
+	}
+}
