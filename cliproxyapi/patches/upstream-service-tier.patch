diff --git a/internal/runtime/executor/helps/upstream_service_tier.go b/internal/runtime/executor/helps/upstream_service_tier.go
new file mode 100644
index 0000000..6349494
--- /dev/null
+++ b/internal/runtime/executor/helps/upstream_service_tier.go
@@ -0,0 +1,36 @@
+package helps
+
+import (
+	"strings"
+
+	"github.com/tidwall/gjson"
+)
+
+// SetUpstreamServiceTier records the final outgoing tier for this attempt.
+// It records request intent only; response-reported tiers remain independent.
+func (r *UsageReporter) SetUpstreamServiceTier(payload []byte) {
+	if r == nil || !gjson.ValidBytes(payload) {
+		return
+	}
+	tier := strings.ToLower(strings.TrimSpace(gjson.GetBytes(payload, "service_tier").String()))
+	if tier == "" {
+		tier = "auto"
+	}
+	switch tier {
+	case "auto", "default", "standard", "priority", "fast", "flex", "scale", "batch":
+	default:
+		return
+	}
+	r.upstreamTierMu.Lock()
+	r.upstreamServiceTier = tier
+	r.upstreamTierMu.Unlock()
+}
+
+func (r *UsageReporter) UpstreamServiceTier() string {
+	if r == nil {
+		return ""
+	}
+	r.upstreamTierMu.RLock()
+	defer r.upstreamTierMu.RUnlock()
+	return r.upstreamServiceTier
+}
diff --git a/internal/runtime/executor/helps/upstream_service_tier_test.go b/internal/runtime/executor/helps/upstream_service_tier_test.go
new file mode 100644
index 0000000..ef78f24
--- /dev/null
+++ b/internal/runtime/executor/helps/upstream_service_tier_test.go
@@ -0,0 +1,28 @@
+package helps
+
+import (
+	"context"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/usage"
+	"testing"
+)
+
+func TestOutgoingTierIsIndependentOfClientAndResponse(t *testing.T) {
+	r := NewUsageReporter(usage.WithServiceTier(context.Background(), "auto"), "codex", "model", nil)
+	if r.UpstreamServiceTier() != "" {
+		t.Fatal("unsent requests must remain unknown")
+	}
+	r.SetUpstreamServiceTier([]byte(`{"service_tier":"priority"}`))
+	record := r.buildRecord(usage.Detail{ResponseServiceTier: "default", TotalTokens: 1}, false)
+	if record.ServiceTier != "auto" || record.UpstreamServiceTier != "priority" || record.ResponseServiceTier != "default" {
+		t.Fatalf("tiers must remain independent: %+v", record)
+	}
+	// A subsequent attempt must use its own outgoing payload.
+	r.SetUpstreamServiceTier([]byte(`{"service_tier":"default"}`))
+	if r.UpstreamServiceTier() != "default" {
+		t.Fatal("retry tier was not updated")
+	}
+	r.SetUpstreamServiceTier([]byte(`{"model":"model"}`))
+	if r.UpstreamServiceTier() != "auto" {
+		t.Fatal("omitted outgoing tier should be auto")
+	}
+}
