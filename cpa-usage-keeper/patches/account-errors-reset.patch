@@ -0,0 +1,77 @@
+package test
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	. "cpa-usage-keeper/internal/api"
+	"cpa-usage-keeper/internal/cpa"
+	"cpa-usage-keeper/internal/cpa/dto/quotareset"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/quota"
+)
+
+func TestQuotaResetHTTPPreservesRequestAcrossServiceAndCPARetry(t *testing.T) {
+	for _, provider := range []string{"codex", "claude"} {
+		t.Run(provider, func(t *testing.T) {
+			const requestID = "11111111-1111-4111-8111-111111111111"
+			var requests []quotareset.Request
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != http.MethodPost || r.URL.Path != "/v8/management/quota/reset" {
+					t.Errorf("unexpected upstream request: %s %s", r.Method, r.URL.Path)
+					w.WriteHeader(http.StatusNotFound)
+					return
+				}
+				var request quotareset.Request
+				if err := json.NewDecoder(r.Body).Decode(&request); err != nil {
+					t.Error(err)
+					w.WriteHeader(http.StatusBadRequest)
+					return
+				}
+				requests = append(requests, request)
+				code := "reset"
+				if len(requests) > 1 {
+					code = "already_redeemed"
+				}
+				_ = json.NewEncoder(w).Encode(quotareset.Result{Code: code, WindowsReset: 2})
+			}))
+			defer upstream.Close()
+
+			db := openAPITestDatabase(t)
+			identity := entities.UsageIdentity{Identity: "synthetic", Provider: provider, Type: provider, AuthType: entities.UsageIdentityAuthTypeCredential}
+			if err := db.Create(&identity).Error; err != nil {
+				t.Fatal(err)
+			}
+			service := quota.NewService(db, cpa.NewClient(upstream.URL, "synthetic-management-key", time.Second, false))
+			t.Cleanup(service.StopRefreshTasks)
+			router := NewRouter(nil, nil, nil, nil, AuthConfig{}, nil, "", OptionalProviders{Quota: service})
+			request := quota.ResetRequest{AuthIndex: " synthetic ", RequestID: requestID}
+			if provider == "claude" {
+				request.GrantID = "chosen"
+				request.OrganizationID = requestID
+			}
+			body, err := json.Marshal(request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, expectedCode := range []string{"reset", "already_redeemed"} {
+				response := serveCredentialMutation(router, http.MethodPost, "/api/v1/quota/reset", string(body))
+				var result quota.ResetResponse
+				if response.Code != http.StatusOK || json.Unmarshal(response.Body.Bytes(), &result) != nil || result.Code != expectedCode || result.AuthIndex != "synthetic" || result.WindowsReset != 2 {
+					t.Fatalf("reset response: %d %s", response.Code, response.Body.String())
+				}
+			}
+			if len(requests) != 2 {
+				t.Fatalf("expected two attempts with the same request ID, got %+v", requests)
+			}
+			for _, forwarded := range requests {
+				if forwarded.AuthIndex != "synthetic" || forwarded.Provider != provider || forwarded.RequestID != requestID || forwarded.GrantID != request.GrantID || forwarded.OrganizationID != request.OrganizationID || forwarded.CreditID != "" {
+					t.Fatalf("reset identity or selection lost: %+v", forwarded)
+				}
+			}
+		})
+	}
+}
