@@ -0,0 +1,52 @@
+package operationerror
+
+import (
+	"errors"
+	"fmt"
+)
+
+// Details contains only safe diagnostics, never raw provider bodies or credentials.
+type Details struct {
+	Source string `json:"error_source"`
+	Status int    `json:"error_status,omitempty"`
+	Reason string `json:"error_reason"`
+}
+
+type Failure interface {
+	FailureDetails() Details
+}
+
+func Describe(err error) Details {
+	var failure Failure
+	if errors.As(err, &failure) {
+		return failure.FailureDetails()
+	}
+	return Details{Source: "unknown", Reason: "The app could not confirm the failure source. Check the app logs."}
+}
+
+func HTTP(source string, status int) Details {
+	reason := "The service rejected the request."
+	switch status {
+	case 401, 403:
+		reason = "Authentication or permission was rejected. Check the account connection."
+	case 402:
+		reason = "The account has insufficient credits or requires payment."
+	case 404:
+		reason = "The account or requested operation was not found. Refresh the account list."
+	case 409, 412:
+		reason = "The account state changed or another operation is in progress. Refresh before retrying."
+	case 429:
+		reason = "The service is rate limiting requests. Wait before retrying."
+	default:
+		if status >= 500 {
+			reason = "The service is temporarily unavailable."
+		}
+	}
+	return Details{Source: source, Status: status, Reason: fmt.Sprintf("HTTP %d. %s", status, reason)}
+}
+
+func Display(err error) string {
+	details := Describe(err)
+	label := map[string]string{"keeper": "Keeper app", "cpa": "CPA proxy", "provider": "Upstream provider", "unknown": "Source unconfirmed"}[details.Source]
+	return label + ": " + details.Reason
+}
