+package test
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	. "cpa-usage-keeper/internal/api"
+	"cpa-usage-keeper/internal/cpa"
+	"cpa-usage-keeper/internal/cpa/dto/quotareset"
+	"cpa-usage-keeper/internal/quota"
+)
+
+func TestAccountErrorsPreserveCPAAndProviderOriginWithoutRawSecrets(t *testing.T) {
+	for _, test := range []struct { name, upstream, source string; status int }{
+		{"CPA authentication", `{"error":"synthetic-secret-token"}`, "cpa", 401},
+		{"provider authentication", `{"error_source":"provider","error_status":403,"error_reason":"synthetic-secret-token"}`, "provider", 403},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				status := http.StatusBadGateway
+				if test.source == "cpa" { status = test.status }
+				w.WriteHeader(status)
+				_, _ = w.Write([]byte(test.upstream))
+			}))
+			defer server.Close()
+			client := cpa.NewClient(server.URL, "synthetic-management-key", time.Second, false)
+			_, err := client.RedeemQuotaReset(context.Background(), quotareset.Request{})
+			provider := &quotaProviderStub{resetErr: err}
+			router := NewRouter(nil, nil, nil, nil, AuthConfig{}, nil, "", OptionalProviders{Quota: provider})
+			response := serveCredentialMutation(router, http.MethodPost, "/api/v1/quota/reset", `{"auth_index":"synthetic","request_id":"11111111-1111-4111-8111-111111111111"}`)
+			var result struct { Source string `json:"error_source"`; Reason string `json:"error_reason"`; Status int `json:"error_status"` }
+			if json.Unmarshal(response.Body.Bytes(), &result) != nil || result.Source != test.source || result.Reason == "" {
+				t.Fatalf("failure source lost: %d %s", response.Code, response.Body.String())
+			}
+			if test.source == "provider" && result.Status != test.status { t.Fatalf("upstream status lost: %+v", result) }
+			if strings.Contains(response.Body.String(), "synthetic-secret-token") { t.Fatal("raw provider or CPA error exposed") }
+		})
+	}
+}
+
+func TestQuotaResetValidationClearlyNamesTheMissingRequestID(t *testing.T) {
+	service := quota.NewService(nil, nil)
+	t.Cleanup(service.StopRefreshTasks)
+	router := NewRouter(nil, nil, nil, nil, AuthConfig{}, nil, "", OptionalProviders{Quota: service})
+	response := serveCredentialMutation(router, http.MethodPost, "/api/v1/quota/reset", `{"auth_index":"synthetic"}`)
+	if response.Code != http.StatusBadRequest || !strings.Contains(response.Body.String(), "request_id") || !strings.Contains(response.Body.String(), `"error_source":"keeper"`) {
+		t.Fatalf("misleading validation error: %d %s", response.Code, response.Body.String())
+	}
+}
