@@ -0,0 +1,29 @@
+import { describe, expect, it, vi } from 'vitest'
+import { ApiError } from '../api'
+import { accountActionError, resetResultError } from '../accountErrors'
+import { runQuotaResetForAuthIndex } from '@/components/usage/credentials/useCredentialsTabData'
+
+describe('account error provenance', () => {
+  it('distinguishes app validation from upstream authentication', () => {
+    expect(accountActionError(new ApiError('auth_index and UUID request_id are required', 400), 'Reset failed')).toContain('Keeper app: auth_index and UUID request_id are required')
+    const error = new ApiError('quota_reset_failed', 502)
+    error.errorSource = 'provider'
+    error.errorStatus = 401
+    error.errorReason = 'Account authentication was rejected.'
+    expect(accountActionError(error, 'Reset failed')).toBe('Upstream provider: Account authentication was rejected. (HTTP 401)')
+  })
+
+  it('does not guess an upstream cause or expose raw network errors', () => {
+    expect(accountActionError(new Error('synthetic-secret-token'), 'Save failed')).toContain('Source unconfirmed: Save failed')
+    expect(accountActionError(new Error('synthetic-secret-token'), 'Save failed')).not.toContain('synthetic-secret-token')
+  })
+
+  it.each(['unknown', 'unavailable', 'auth_error', 'rate_limited', 'not_limited', 'cooldown', 'ineligible'])('never reports %s as a successful reset', async (code) => {
+    const refresh = vi.fn()
+    const result = { authIndex: 'synthetic', code, error_source: 'provider' }
+    const outcome = await runQuotaResetForAuthIndex('synthetic', { resetUsageQuota: vi.fn().mockResolvedValue(result), refreshQuotaForAuthIndex: refresh })
+    expect(outcome.kind).toBe('warning')
+    expect(refresh).not.toHaveBeenCalled()
+    expect(resetResultError(result)).toContain('Upstream provider:')
+  })
+})
