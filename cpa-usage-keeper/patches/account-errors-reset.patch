+import i18n from '@/i18n'
+import { ApiError } from './api'
+import type { UsageQuotaResetResponse } from './types'
+
+export function accountActionError(error: unknown, fallback: string): string {
+  if (!(error instanceof ApiError)) {
+    return `${i18n.t('account_errors.unconfirmed')}: ${fallback} ${i18n.t('account_errors.connection')}`
+  }
+  const source = error.errorSource === 'unknown' ? 'unconfirmed' : ['keeper', 'cpa', 'provider'].includes(error.errorSource ?? '') ? error.errorSource! : 'keeper'
+  const validation = error.message === 'auth_index and UUID request_id are required' ? error.message : undefined
+  const reason = error.errorReason || validation || fallback
+  return `${i18n.t(`account_errors.${source}`)}: ${reason} (HTTP ${error.errorStatus || error.status})`
+}
+
+export function resetResultError(result: UsageQuotaResetResponse): string {
+  const source = result.error_source && ['keeper', 'cpa', 'provider'].includes(result.error_source) ? result.error_source : 'unconfirmed'
+  const code = result.code || 'unknown'
+  const reason = result.error_reason || i18n.t(`account_errors.reset_${code}`, { defaultValue: i18n.t('account_errors.reset_unknown') })
+  const status = result.error_status ? ` (HTTP ${result.error_status})` : ''
+  return `${i18n.t(`account_errors.${source}`)}: ${reason}${status} ${i18n.t('account_errors.reset_retry')}`
+}
