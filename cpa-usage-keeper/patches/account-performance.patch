--- a/web/src/lib/api.ts
+++ b/web/src/lib/api.ts
@@ -1110,3 +1110,14 @@ export async function fetchReadOnlyReport<T>(path: string, params = new URLSearc
  const response=await apiFetch(apiPath('/read-only/'+path)+'?'+params.toString(),{signal,cache:'no-store'});
  if(!response.ok) await parseApiError(response,'Unable to load reporting data');return response.json();
 }
+
+export interface AccountPerformanceOptions { readOnlyAccountId?: string; days: string; metric: string; models: string[]; mode: string; context: string; output: string; effort: string }
+export async function fetchAccountPerformance(authIndex: string, options: AccountPerformanceOptions, signal?: AbortSignal): Promise<import('./types').PerformanceReport> {
+  const params = new URLSearchParams({ days: options.days, metric: options.metric })
+  for (const model of options.models) params.append('model', model)
+  for (const key of ['mode', 'context', 'output', 'effort'] as const) if (options[key]) params.set(key, options[key])
+  const path = options.readOnlyAccountId ? `/read-only/accounts/${encodeURIComponent(options.readOnlyAccountId)}/performance` : `/quota/performance/${encodeURIComponent(authIndex)}`
+  const response = await apiFetch(`${apiPath(path)}?${params}`, { signal })
+  if (!response.ok) await parseApiError(response, `Failed to load performance: ${response.status}`)
+  return response.json()
+}
