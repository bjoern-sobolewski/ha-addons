+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Chart } from 'react-chartjs-2'
+import type { ChartData, ChartOptions } from 'chart.js'
+import '@/lib/chartjs'
+import { ApiError, fetchAccountPerformance } from '@/lib/api'
+import type { PerformanceReport, PerformanceStats } from '@/lib/types'
+import { Button } from '@/components/ui/Button'
+import { useThemeStore } from '@/stores'
+import { getUsageChartTheme, USAGE_CHART_COMPOSITION_COLORS } from '@/utils/usage/chartConfig'
+import styles from './WeeklyQuotaValuePanel.module.scss'
+import performanceStyles from './PerformancePanel.module.scss'
+
+export function PerformancePanel({ authIndex, readOnlyAccountId, onAuthRequired }: { authIndex: string; readOnlyAccountId?: string; onAuthRequired?: () => void }) {
+  const { t, i18n } = useTranslation()
+  const isDark = useThemeStore(state => state.resolvedTheme) === 'dark'
+  const [days, setDays] = useState('30')
+  const [metric, setMetric] = useState('latency')
+  const [mode, setMode] = useState('')
+  const [context, setContext] = useState('')
+  const [output, setOutput] = useState('')
+  const [effort, setEffort] = useState('')
+  const [models, setModels] = useState<string[]>([])
+  const [basis, setBasis] = useState<'raw' | 'matched'>('raw')
+  const [tail, setTail] = useState(false)
+  const [revision, setRevision] = useState(0)
+  const [result, setResult] = useState<{ key: string; report?: PerformanceReport; error?: boolean }>()
+  const [options, setOptions] = useState<{ models: string[]; efforts: string[] }>({ models: [], efforts: [] })
+  const requestKey = JSON.stringify([authIndex, readOnlyAccountId, days, metric, mode, context, output, effort, models, revision])
+  const loading = result?.key !== requestKey
+  const report = loading ? undefined : result?.report
+  useEffect(() => {
+    const controller = new AbortController()
+    fetchAccountPerformance(authIndex, { readOnlyAccountId, days, metric, mode, context, output, effort, models }, controller.signal)
+      .then(report => {
+        if (controller.signal.aborted) return
+        setResult({ key: requestKey, report })
+        setOptions({ models: report.models, efforts: report.efforts })
+      })
+      .catch((error: unknown) => {
+        if (controller.signal.aborted) return
+        if (error instanceof ApiError && error.status === 401) onAuthRequired?.()
+        setResult({ key: requestKey, error: true })
+      })
+    return () => controller.abort()
+  }, [authIndex, readOnlyAccountId, days, metric, mode, context, output, effort, models, requestKey, onAuthRequired])
