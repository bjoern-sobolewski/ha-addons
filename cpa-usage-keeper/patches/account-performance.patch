+package quota
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/repository"
+	"errors"
+	"fmt"
+	"gorm.io/gorm"
+	"strings"
+)
+
+func (s *Service) GetAccountPerformance(ctx context.Context, request repository.PerformanceQuery) (repository.PerformanceReport, error) {
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	request.AuthIndex = strings.TrimSpace(request.AuthIndex)
+	if err := repository.ValidatePerformanceQuery(request); err != nil {
+		return repository.PerformanceReport{}, fmt.Errorf("%w: %v", ErrValidation, err)
+	}
+	if s == nil || s.db == nil {
+		return repository.PerformanceReport{}, fmt.Errorf("performance database unavailable")
+	}
+	identity, err := repository.GetActiveAuthFileUsageIdentityByAuthIndex(ctx, s.db, request.AuthIndex)
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return repository.PerformanceReport{}, ErrNotFound
+	}
+	if err != nil {
+		return repository.PerformanceReport{}, err
+	}
+	if normalizeIdentityType(identity.Type) != "codex" {
+		return repository.PerformanceReport{}, ErrUnsupportedType
+	}
+	return repository.BuildAccountPerformance(ctx, s.db, request)
+}
