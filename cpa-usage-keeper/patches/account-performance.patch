@@ -0,0 +1,82 @@
+package api
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/quota"
+	"cpa-usage-keeper/internal/repository"
+	"cpa-usage-keeper/internal/service"
+	"errors"
+	"github.com/gin-gonic/gin"
+	"strconv"
+	"strings"
+)
+
+type accountPerformanceProvider interface {
+	GetAccountPerformance(context.Context, repository.PerformanceQuery) (repository.PerformanceReport, error)
+}
+
+func accountPerformanceRequest(c *gin.Context, authIndex string) (repository.PerformanceQuery, error) {
+	days := 30
+	if value, ok := c.GetQuery("days"); ok {
+		n, err := strconv.Atoi(value)
+		if err != nil {
+			return repository.PerformanceQuery{}, err
+		}
+		days = n
+	}
+	metric := c.DefaultQuery("metric", "latency")
+	q := repository.PerformanceQuery{AuthIndex: authIndex, Days: days, Metric: metric, Models: c.QueryArray("model"), Mode: c.Query("mode"), Context: c.Query("context"), Output: c.Query("output"), Effort: c.Query("effort")}
+	return q, repository.ValidatePerformanceQuery(q)
+}
+func serveAccountPerformance(c *gin.Context, provider QuotaProvider, authIndex string) {
+	setNoStoreHeaders(c)
+	reader, ok := provider.(accountPerformanceProvider)
+	if !ok {
+		c.JSON(503, gin.H{"error": "Performance unavailable"})
+		return
+	}
+	request, err := accountPerformanceRequest(c, authIndex)
+	if err != nil {
+		c.JSON(400, gin.H{"error": "Invalid performance filter"})
+		return
+	}
+	report, err := reader.GetAccountPerformance(c.Request.Context(), request)
+	if err != nil {
+		switch {
+		case errors.Is(err, quota.ErrNotFound):
+			c.JSON(404, gin.H{"error": "Account not found"})
+		case errors.Is(err, quota.ErrValidation), errors.Is(err, quota.ErrUnsupportedType):
+			c.JSON(400, gin.H{"error": "Invalid performance request"})
+		default:
+			writeInternalError(c, "Performance unavailable", err)
+		}
+		return
+	}
+	c.JSON(200, report)
+}
+func registerAccountPerformanceRoutes(router gin.IRoutes, provider QuotaProvider) {
+	router.GET("/quota/performance/:auth_index", func(c *gin.Context) { serveAccountPerformance(c, provider, strings.TrimSpace(c.Param("auth_index"))) })
+}
+func registerReadOnlyPerformanceRoutes(group *gin.RouterGroup, identities service.UsageIdentityProvider, provider QuotaProvider) {
+	group.GET("/accounts/:id/performance", func(c *gin.Context) {
+		setNoStoreHeaders(c)
+		reader, ok := identities.(service.UsageIdentityReader)
+		if !ok {
+			c.JSON(503, gin.H{"error": "Performance unavailable"})
+			return
+		}
+		id, err := strconv.ParseInt(c.Param("id"), 10, 64)
+		if err != nil || id <= 0 {
+			c.JSON(400, gin.H{"error": "Invalid account"})
+			return
+		}
+		detail, err := reader.GetUsageIdentity(c.Request.Context(), id)
+		if err != nil || detail.Identity.IsDeleted || detail.Identity.AuthType != entities.UsageIdentityAuthTypeAuthFile || detail.Identity.Type != "codex" {
+			c.JSON(404, gin.H{"error": "Account not found"})
+			return
+		}
+		// Identity is resolved server-side. DTO exposes only aggregate model/mode timing.
+		serveAccountPerformance(c, provider, detail.Identity.Identity)
+	})
+}
