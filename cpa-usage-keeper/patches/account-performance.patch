+package test
+
+import (
+	"context"
+	. "cpa-usage-keeper/internal/api"
+	"cpa-usage-keeper/internal/auth"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/quota"
+	"cpa-usage-keeper/internal/repository"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+)
+
+type performanceProviderStub struct {
+	quotaProviderStub
+	request repository.PerformanceQuery
+	err     error
+	calls   int
+}
+
+func (p *performanceProviderStub) GetAccountPerformance(_ context.Context, q repository.PerformanceQuery) (repository.PerformanceReport, error) {
+	p.request = q
+	p.calls++
+	return repository.PerformanceReport{Metric: q.Metric, Groups: []repository.PerformanceGroup{{Model: "model-a", Mode: "normal"}}}, p.err
+}
+func TestPerformanceAdminValidationAndErrors(t *testing.T) {
+	provider := &performanceProviderStub{}
+	router := NewRouter(nil, nil, nil, nil, AuthConfig{}, nil, "", OptionalProviders{Quota: provider})
+	response := serveAPIGet(router, "/api/v1/quota/performance/account?days=7&metric=ttft&model=a&model=b&mode=fast&context=small&output=short&effort=low")
+	if response.Code != 200 || provider.request.AuthIndex != "account" || provider.request.Days != 7 || len(provider.request.Models) != 2 || provider.request.Metric != "ttft" || provider.request.Context != "small" {
+		t.Fatalf("bad forwarding: %d %+v", response.Code, provider.request)
+	}
+	for _, query := range []string{"days=1", "days=bad", "metric=bad", "mode=bad", "context=bad"} {
+		if serveAPIGet(router, "/api/v1/quota/performance/account?"+query).Code != 400 {
+			t.Fatal("invalid query accepted")
+		}
+	}
+	for _, item := range []struct {
+		err    error
+		status int
+	}{{quota.ErrNotFound, 404}, {quota.ErrUnsupportedType, 400}, {quota.ErrValidation, 400}} {
+		provider.err = item.err
+		if serveAPIGet(router, "/api/v1/quota/performance/account").Code != item.status {
+			t.Fatal("wrong error mapping")
+		}
+	}
+}
+func TestPerformanceReadOnlyResolutionSanitizationAndRoleIsolation(t *testing.T) {
+	sessions := auth.NewSessionManager(time.Hour)
+	cfg := AuthConfig{Enabled: true, LoginPassword: "admin-password-long", ReadOnlyPassword: "read-password-long"}
+	row := entities.UsageIdentity{ID: 3, Identity: "secret-auth-index", Name: "secret-name", Type: "codex", AuthType: 1}
+	identities := reportingIdentityStub{identityMetadataStub{items: []entities.UsageIdentity{row}}}
+	provider := &performanceProviderStub{}
+	router := NewRouter(nil, nil, nil, nil, cfg, NewAuthHandler(cfg, sessions), "", OptionalProviders{CPAAPIKeys: &reportingKeysStub{}, UsageIdentity: identities, Quota: provider})
+	login := serveCredentialMutation(router, "POST", "/api/v1/auth/read-only-login", `{"password":"read-password-long"}`)
+	cookie := login.Result().Cookies()[0]
+	viewer, _, _ := sessions.CreateAPIKeyViewer(1)
+	viewerCookie := &http.Cookie{Name: cookie.Name, Value: viewer}
+	path := "/api/v1/read-only/accounts/3/performance?auth_index=attacker"
+	response := serveAPIGet(router, path, cookie)
+	if response.Code != 200 || provider.request.AuthIndex != "secret-auth-index" || strings.Contains(response.Body.String(), "secret-") {
+		t.Fatalf("read-only leak or account override: %d %s", response.Code, response.Body.String())
+	}
+	if serveAPIGet(router, path).Code != 401 || serveAPIGet(router, path, viewerCookie).Code != 403 || serveAPIGet(router, "/api/v1/quota/performance/secret-auth-index", cookie).Code != 403 {
+		t.Fatal("role isolation failed")
+	}
+	for _, item := range []entities.UsageIdentity{{ID: 3, Identity: "secret-auth-index", Type: "codex", AuthType: 1, IsDeleted: true}, {ID: 3, Identity: "secret-auth-index", Type: "codex", AuthType: 2}, {ID: 3, Identity: "secret-auth-index", Type: "claude", AuthType: 1}} {
+		identities.items[0] = item
+		if serveAPIGet(router, path, cookie).Code != 404 {
+			t.Fatal("inactive or wrong account kind accepted")
+		}
+	}
+}
