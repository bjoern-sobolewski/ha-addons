+package test
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/quota"
+	"cpa-usage-keeper/internal/repository"
+	"errors"
+	"testing"
+)
+
+func TestAccountPerformanceRejectsInactiveWrongIdentityAndInvalidQuery(t *testing.T) {
+	db := openQuotaTestDB(t)
+	for _, row := range []entities.UsageIdentity{{AuthType: entities.UsageIdentityAuthTypeAuthFile, Identity: "codex", Provider: "codex", Type: "codex"}, {AuthType: entities.UsageIdentityAuthTypeAuthFile, Identity: "claude", Provider: "claude", Type: "claude"}, {AuthType: entities.UsageIdentityAuthTypeAuthFile, Identity: "deleted", Provider: "codex", Type: "codex", IsDeleted: true}, {AuthType: entities.UsageIdentityAuthTypeAIProvider, Identity: "api", Provider: "codex", Type: "codex"}} {
+		seedUsageIdentity(t, db, row)
+	}
+	service := newQuotaServiceWithRegistry(t, db, quota.NewProviderRegistry(nil))
+	for _, item := range []struct {
+		id  string
+		err error
+	}{{"", quota.ErrValidation}, {"missing", quota.ErrNotFound}, {"deleted", quota.ErrNotFound}, {"api", quota.ErrNotFound}, {"claude", quota.ErrUnsupportedType}} {
+		_, err := service.GetAccountPerformance(context.Background(), repository.PerformanceQuery{AuthIndex: item.id, Days: 30, Metric: "latency"})
+		if !errors.Is(err, item.err) {
+			t.Fatalf("%s: %v", item.id, err)
+		}
+	}
+	_, err := service.GetAccountPerformance(context.Background(), repository.PerformanceQuery{AuthIndex: "codex", Days: 1, Metric: "latency"})
+	if !errors.Is(err, quota.ErrValidation) {
+		t.Fatal("query not validated before scan")
+	}
+}
diff --git a/internal/repository/account_performance.go b/internal/repository/account_performance.go
new file mode 100644
index 0000000..2f46711
--- /dev/null
+++ b/internal/repository/account_performance.go
@@ -0,0 +1,396 @@
+package repository
+
+import (
+	"context"
+	"fmt"
+	"math"
+	"sort"
+	"strings"
+	"time"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/timeutil"
+	"gorm.io/gorm"
+	"gorm.io/plugin/dbresolver"
+)
+
+// Performance contains aggregate timings only, never keys, identities or raw requests.
+type PerformanceQuery struct {
+	AuthIndex                     string
+	Days                          int
+	Metric                        string
+	Models                        []string
+	Mode, Context, Output, Effort string
+	Now                           time.Time
+}
+type PerformanceStats struct {
+	Samples int      `json:"samples"`
+	Median  *float64 `json:"median"`
+	P90     *float64 `json:"p90"`
+	P10     *float64 `json:"p10"`
+}
+type PerformanceDay struct {
+	Day     string           `json:"day"`
+	Raw     PerformanceStats `json:"raw"`
+	Matched PerformanceStats `json:"matched"`
+}
+type PerformanceGroup struct {
+	Model    string           `json:"model"`
+	Mode     string           `json:"mode"`
+	Requests int              `json:"requests"`
+	Failed   int              `json:"failed"`
+	Raw      PerformanceStats `json:"raw"`
+	Matched  PerformanceStats `json:"matched"`
+	Coverage float64          `json:"coverage"`
+	Days     []PerformanceDay `json:"days"`
+}
+type PerformanceReport struct {
+	GeneratedAt         time.Time          `json:"generated_at"`
+	RangeStart          time.Time          `json:"range_start"`
+	Metric              string             `json:"metric"`
+	Models              []string           `json:"models"`
+	Efforts             []string           `json:"efforts"`
+	Groups              []PerformanceGroup `json:"groups"`
+	CommonCells         int                `json:"common_cells"`
+	ComparisonGroups    int                `json:"comparison_groups"`
+	MinSamples          int                `json:"min_samples"`
+	MinCellSamples      int                `json:"min_cell_samples"`
+	MinDailySamples     int                `json:"min_daily_samples"`
+	MinDailyCellSamples int                `json:"min_daily_cell_samples"`
+}
+type performanceCell struct{ context, output, cache, effort, stream, executor string }
+type performanceObservation struct {
+	value float64
+	day   string
+}
+type performanceWork struct {
+	group  PerformanceGroup
+	values []float64
+	cells  map[performanceCell][]performanceObservation
+	daily  map[string][]float64
+}
+type weightedPerformanceValue struct{ value, weight float64 }
+
+func ValidatePerformanceQuery(q PerformanceQuery) error {
+	if strings.TrimSpace(q.AuthIndex) == "" {
+		return fmt.Errorf("account is required")
+	}
+	if q.Days != 7 && q.Days != 30 && q.Days != 90 {
+		return fmt.Errorf("days must be 7, 30 or 90")
+	}
+	if !oneOf(q.Metric, "latency", "ttft", "tps", "phase") {
+		return fmt.Errorf("invalid metric")
+	}
+	if !oneOf(q.Mode, "", "normal", "fast", "unknown") || !oneOf(q.Context, "", "small", "medium", "large", "huge") || !oneOf(q.Output, "", "short", "medium", "long", "huge") {
+		return fmt.Errorf("invalid workload filter")
+	}
+	if len(q.Models) > 20 || len(q.Effort) > 100 {
+		return fmt.Errorf("too many filters")
+	}
+	for _, model := range q.Models {
+		if len(model) > 200 || strings.TrimSpace(model) == "" {
+			return fmt.Errorf("invalid model")
+		}
+	}
+	return nil
+}
+func oneOf(value string, options ...string) bool {
+	for _, x := range options {
+		if value == x {
+			return true
+		}
+	}
+	return false
+}
+func performanceSize(value int64, limits []int64, names []string) string {
+	for i, limit := range limits {
+		if value < limit {
+			return names[i]
+		}
+	}
+	return names[len(names)-1]
+}
+func performanceMetric(e entities.UsageEvent, metric string) (float64, bool) {
+	if e.Failed || (e.Generate != nil && !*e.Generate) || e.LatencyMS <= 0 {
+		return 0, false
+	}
+	switch metric {
+	case "latency":
+		return float64(e.LatencyMS) / 1000, true
+	case "ttft":
+		if e.TTFTMS != nil && *e.TTFTMS >= 0 && *e.TTFTMS < e.LatencyMS {
+			return float64(*e.TTFTMS) / 1000, true
+		}
+	case "tps":
+		if e.OutputTokens > 0 {
+			return float64(e.OutputTokens) * 1000 / float64(e.LatencyMS), true
+		}
+	case "phase":
+		// Approximate active-phase rate, not visible decode speed. Avoid tiny denominators.
+		if e.Stream != nil && *e.Stream && e.OutputTokens >= 32 && e.TTFTMS != nil && *e.TTFTMS >= 0 && e.LatencyMS-*e.TTFTMS >= 250 {
+			return float64(e.OutputTokens) * 1000 / float64(e.LatencyMS-*e.TTFTMS), true
+		}
+	}
+	return 0, false
+}
+func performanceWorkload(e entities.UsageEvent) performanceCell {
+	cache := "unknown"
+	if e.InputTokens > 0 && e.CacheReadTokens >= 0 && e.CacheReadTokens <= e.InputTokens {
+		share := float64(e.CacheReadTokens) / float64(e.InputTokens)
+		cache = "low"
+		if share >= .9 {
+			cache = "high"
+		} else if share >= .5 {
+			cache = "medium"
+		}
+	}
+	stream := "unknown"
+	if e.Stream != nil {
+		stream = "batch"
+		if *e.Stream {
+			stream = "stream"
+		}
+	}
+	effort := strings.ToLower(strings.TrimSpace(e.ReasoningEffort))
+	if effort == "" {
+		effort = "unknown"
+	}
+	executor := strings.TrimSpace(e.ExecutorType)
+	if executor == "" {
+		executor = "unknown"
+	}
+	// Canonical output includes reasoning: keep matching and throughput on that same basis.
+	return performanceCell{
+		performanceSize(e.InputTokens, []int64{8000, 32000, 128000}, []string{"small", "medium", "large", "huge"}),
+		performanceSize(e.OutputTokens, []int64{256, 1024, 4096}, []string{"short", "medium", "long", "huge"}),
+		cache, effort, stream, executor,
+	}
+}
+
+func BuildAccountPerformance(ctx context.Context, db *gorm.DB, q PerformanceQuery) (PerformanceReport, error) {
+	report := PerformanceReport{Metric: q.Metric, Models: []string{}, Efforts: []string{}, Groups: []PerformanceGroup{}, MinSamples: 20, MinCellSamples: 5, MinDailySamples: 20, MinDailyCellSamples: 3}
+	if err := ValidatePerformanceQuery(q); err != nil {
+		return report, err
+	}
+	if q.Now.IsZero() {
+		q.Now = time.Now()
+	}
+	report.GeneratedAt = q.Now.UTC()
+	report.RangeStart = report.GeneratedAt.Add(-time.Duration(q.Days) * 24 * time.Hour)
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	projection := "COALESCE(model, '') AS model, COALESCE(upstream_service_tier, '') AS upstream_service_tier, timestamp, COALESCE(failed, 0) AS failed, generate, COALESCE(latency_ms, 0) AS latency_ms, ttft_ms, COALESCE(input_tokens, 0) AS input_tokens, COALESCE(output_tokens, 0) AS output_tokens, COALESCE(reasoning_tokens, 0) AS reasoning_tokens, COALESCE(cache_read_tokens, 0) AS cache_read_tokens, COALESCE(reasoning_effort, '') AS reasoning_effort, stream, COALESCE(executor_type, '') AS executor_type"
+	filter := "auth_type = ? AND auth_index = ? AND provider = ? AND timestamp >= ? AND timestamp < ?"
+	args := []any{"oauth", q.AuthIndex, "codex", timeutil.FormatStorageTime(report.RangeStart), timeutil.FormatStorageTime(report.GeneratedAt)}
+	source := "usage_events"
+	if db.Migrator().HasTable(&entities.UsageEventArchive{}) {
+		source = "(SELECT " + projection + " FROM usage_events WHERE " + filter + " UNION ALL SELECT " + projection + " FROM usage_events_archive WHERE " + filter + ")"
+		args = append(append([]any{}, args...), args...)
+	} else {
+		source += " WHERE " + filter
+	}
+	rows, err := db.WithContext(ctx).Clauses(dbresolver.Read).Raw("SELECT "+projection+" FROM "+source, args...).Rows()
+	if err != nil {
+		return report, fmt.Errorf("read account performance: %w", err)
+	}
+	defer rows.Close()
+	groups := map[[2]string]*performanceWork{}
+	models := map[string]bool{}
+	efforts := map[string]bool{}
+	for rows.Next() {
+		var e entities.UsageEvent
+		if err := rows.Scan(&e.Model, &e.UpstreamServiceTier, &e.Timestamp, &e.Failed, &e.Generate, &e.LatencyMS, &e.TTFTMS, &e.InputTokens, &e.OutputTokens, &e.ReasoningTokens, &e.CacheReadTokens, &e.ReasoningEffort, &e.Stream, &e.ExecutorType); err != nil {
+			return report, err
+		}
+		e.Timestamp = timeutil.NormalizeStorageTime(e.Timestamp)
+		models[e.Model] = true
+		cell := performanceWorkload(e)
+		efforts[cell.effort] = true
+		if len(q.Models) > 0 && !oneOf(e.Model, q.Models...) {
+			continue
+		}
+		mode := quotaRequestedMode(e.UpstreamServiceTier)
+		if q.Mode != "" && mode != q.Mode || q.Context != "" && cell.context != q.Context || q.Output != "" && cell.output != q.Output || q.Effort != "" && cell.effort != q.Effort {
+			continue
+		}
+		key := [2]string{e.Model, mode}
+		work := groups[key]
+		if work == nil {
+			work = &performanceWork{group: PerformanceGroup{Model: e.Model, Mode: mode, Days: []PerformanceDay{}}, cells: map[performanceCell][]performanceObservation{}, daily: map[string][]float64{}}
+			groups[key] = work
+		}
+		work.group.Requests++
+		if e.Failed {
+			work.group.Failed++
+		}
+		value, valid := performanceMetric(e, q.Metric)
+		if !valid || !isFinitePerformance(value) {
+			continue
+		}
+		day := e.Timestamp.UTC().Format("2006-01-02")
+		work.values = append(work.values, value)
+		work.daily[day] = append(work.daily[day], value)
+		work.cells[cell] = append(work.cells[cell], performanceObservation{value, day})
+	}
+	if err := rows.Err(); err != nil {
+		return report, err
+	}
+	for x := range models {
+		report.Models = append(report.Models, x)
+	}
+	sort.Strings(report.Models)
+	for x := range efforts {
+		report.Efforts = append(report.Efforts, x)
+	}
+	sort.Strings(report.Efforts)
+	ordered := []*performanceWork{}
+	eligible := []*performanceWork{}
+	for _, work := range groups {
+		ordered = append(ordered, work)
+		if len(work.values) >= report.MinSamples && work.group.Mode != "unknown" {
+			eligible = append(eligible, work)
+		}
+	}
+	sort.Slice(ordered, func(i, j int) bool {
+		if ordered[i].group.Model == ordered[j].group.Model {
+			return ordered[i].group.Mode < ordered[j].group.Mode
+		}
+		return ordered[i].group.Model < ordered[j].group.Model
+	})
+	// Sort before summation: stable distributions regardless of Go map iteration order.
+	sort.Slice(eligible, func(i, j int) bool {
+		if eligible[i].group.Model == eligible[j].group.Model {
+			return eligible[i].group.Mode < eligible[j].group.Mode
+		}
+		return eligible[i].group.Model < eligible[j].group.Model
+	})
+	weights := performanceCommonWeights(eligible, report.MinCellSamples, report.MinSamples)
+	report.CommonCells = len(weights)
+	if len(weights) > 0 {
+		report.ComparisonGroups = len(eligible)
+	}
+	for _, work := range ordered {
+		work.group.Raw = performanceUnweightedStats(work.values)
+		if oneOfWork(work, eligible) && len(weights) > 0 {
+			work.group.Matched = performanceMatchedStats(work, weights, "", report.MinCellSamples, report.MinSamples)
+			work.group.Coverage = float64(work.group.Matched.Samples) / float64(len(work.values))
+		}
+		// Include every UTC date, so missing days remain gaps instead of joined lines.
+		for date := report.RangeStart.UTC().Truncate(24 * time.Hour); !date.After(report.GeneratedAt.UTC().Truncate(24 * time.Hour)); date = date.AddDate(0, 0, 1) {
+			day := date.Format("2006-01-02")
+			raw := performanceUnweightedStats(work.daily[day])
+			point := PerformanceDay{Day: day, Raw: raw}
+			if raw.Samples < 3 {
+				point.Raw.Median = nil
+				point.Raw.P90 = nil
+				point.Raw.P10 = nil
+			}
+			if oneOfWork(work, eligible) && len(weights) > 0 {
+				point.Matched = performanceMatchedStats(work, weights, day, report.MinDailyCellSamples, report.MinDailySamples)
+			}
+			work.group.Days = append(work.group.Days, point)
+		}
+		report.Groups = append(report.Groups, work.group)
+	}
+	return report, nil
+}
+func isFinitePerformance(v float64) bool { return !math.IsNaN(v) && !math.IsInf(v, 0) }
+func oneOfWork(w *performanceWork, all []*performanceWork) bool {
+	for _, x := range all {
+		if x == w {
+			return true
+		}
+	}
+	return false
+}
+func performanceCommonWeights(groups []*performanceWork, minCell, minTotal int) map[performanceCell]float64 {
+	weights := map[performanceCell]float64{}
+	if len(groups) < 2 {
+		return weights
+	}
+	for cell := range groups[0].cells {
+		common := true
+		for _, g := range groups {
+			if len(g.cells[cell]) < minCell {
+				common = false
+				break
+			}
+		}
+		if common {
+			weights[cell] = 0
+		}
+	}
+	totals := make([]int, len(groups))
+	for i, g := range groups {
+		for cell := range weights {
+			totals[i] += len(g.cells[cell])
+		}
+		if totals[i] < minTotal {
+			return map[performanceCell]float64{}
+		}
+	}
+	for cell := range weights {
+		for i, g := range groups {
+			weights[cell] += float64(len(g.cells[cell])) / float64(totals[i]) / float64(len(groups))
+		}
+	}
+	return weights
+}
+func performanceMatchedStats(work *performanceWork, weights map[performanceCell]float64, day string, minCell, minTotal int) PerformanceStats {
+	values := []weightedPerformanceValue{}
+	for cell, weight := range weights {
+		observations := work.cells[cell]
+		selected := []float64{}
+		for _, x := range observations {
+			if day == "" || day == x.day {
+				selected = append(selected, x.value)
+			}
+		}
+		// Never drop an unsupported cell and silently change the reference mix.
+		if len(selected) < minCell {
+			return PerformanceStats{}
+		}
+		for _, x := range selected {
+			values = append(values, weightedPerformanceValue{x, weight / float64(len(selected))})
+		}
+	}
+	if len(values) < minTotal {
+		return PerformanceStats{}
+	}
+	return performanceWeightedStats(values)
+}
+func performanceUnweightedStats(values []float64) PerformanceStats {
+	weighted := make([]weightedPerformanceValue, len(values))
+	for i, x := range values {
+		weighted[i] = weightedPerformanceValue{x, 1}
+	}
+	return performanceWeightedStats(weighted)
+}
+func performanceWeightedStats(values []weightedPerformanceValue) PerformanceStats {
+	stats := PerformanceStats{Samples: len(values)}
+	if len(values) == 0 {
+		return stats
+	}
+	sort.Slice(values, func(i, j int) bool { return values[i].value < values[j].value })
+	total := 0.0
+	for _, x := range values {
+		total += x.weight
+	}
+	quantile := func(q float64) *float64 {
+		sum := 0.0
+		for _, x := range values {
+			sum += x.weight
+			if sum+1e-12 >= q*total {
+				v := x.value
+				return &v
+			}
+		}
+		v := values[len(values)-1].value
+		return &v
+	}
+	stats.Median = quantile(.5)
+	stats.P90 = quantile(.9)
+	stats.P10 = quantile(.1)
+	return stats
+}
