+package test
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/repository"
+	"fmt"
+	"gorm.io/gorm"
+	"math"
+	"reflect"
+	"testing"
+	"time"
+)
+
+var performanceNow = time.Date(2026, 10, 9, 12, 0, 0, 0, time.UTC)
+
+func performanceQuery(metric string) repository.PerformanceQuery {
+	return repository.PerformanceQuery{AuthIndex: "performance-account", Days: 30, Metric: metric, Now: performanceNow}
+}
+func seedPerformance(t *testing.T, db *gorm.DB, model string, input, latency int64, n int, at time.Time) {
+	t.Helper()
+	stream, generate := true, true
+	ttft := int64(1000)
+	for i := 0; i < n; i++ {
+		e := entities.UsageEvent{EventKey: fmt.Sprintf("%s-%d-%d-%d", model, input, at.UnixNano(), i), AuthType: "oauth", AuthIndex: "performance-account", Provider: "codex", Model: model, UpstreamServiceTier: "default", Timestamp: at, InputTokens: input, OutputTokens: 100, ReasoningEffort: "low", Stream: &stream, Generate: &generate, ExecutorType: "codex-websocket", LatencyMS: latency, TTFTMS: &ttft}
+		if err := db.Create(&e).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+func getPerformance(t *testing.T, db *gorm.DB, q repository.PerformanceQuery) repository.PerformanceReport {
+	t.Helper()
+	report, err := repository.BuildAccountPerformance(context.Background(), db, q)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return report
+}
+func TestPerformanceMatchedDistributionsAndArchiveEquivalence(t *testing.T) {
+	db := openTestDatabase(t)
+	at := performanceNow.Add(-time.Hour)
+	seedPerformance(t, db, "a", 1000, 5000, 50, at)
+	seedPerformance(t, db, "a", 40000, 100000, 5, at)
+	seedPerformance(t, db, "b", 1000, 2000, 5, at)
+	seedPerformance(t, db, "b", 40000, 80000, 50, at)
+	seedPerformance(t, db, "a", 200000, 900000, 20, at)
+	failed := entities.UsageEvent{EventKey: "failed", AuthType: "oauth", AuthIndex: "performance-account", Provider: "codex", Model: "a", UpstreamServiceTier: "default", Timestamp: at, Failed: true, LatencyMS: 1}
+	if err := db.Create(&failed).Error; err != nil {
+		t.Fatal(err)
+	}
+	report := getPerformance(t, db, performanceQuery("latency"))
+	if report.CommonCells != 2 || report.ComparisonGroups != 2 {
+		t.Fatalf("wrong overlap: %+v", report)
+	}
+	a, b := report.Groups[0], report.Groups[1]
+	if *a.Raw.Median != 5 || *b.Raw.Median != 80 || *a.Matched.Median != 5 || *b.Matched.Median != 2 || *a.Matched.P90 != 100 || *b.Matched.P90 != 80 {
+		t.Fatalf("percentiles were not weighted request distributions: %+v %+v", a, b)
+	}
+	if a.Matched.Samples != 55 || a.Raw.Samples != 75 || a.Failed != 1 || math.Abs(a.Coverage-55.0/75) > 1e-12 {
+		t.Fatal("lost unmatched or failed coverage")
+	}
+	if err := db.Exec("INSERT INTO usage_events_archive (" + entities.UsageEventStorageColumns + ") SELECT " + entities.UsageEventStorageColumns + " FROM usage_events").Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Exec("DELETE FROM usage_events").Error; err != nil {
+		t.Fatal(err)
+	}
+	archived := getPerformance(t, db, performanceQuery("latency"))
+	if !reflect.DeepEqual(report, archived) {
+		t.Fatal("archiving changed performance distributions")
+	}
+}
+func TestPerformanceDailyFixedMixDoesNotDropUnsupportedBuckets(t *testing.T) {
+	db := openTestDatabase(t)
+	day1 := performanceNow.Add(-25 * time.Hour)
+	day2 := performanceNow.Add(-time.Hour)
+	for _, model := range []string{"a", "b"} {
+		seedPerformance(t, db, model, 1000, 2000, 15, day1)
+		seedPerformance(t, db, model, 40000, 8000, 15, day1)
+		seedPerformance(t, db, model, 1000, 2000, 30, day2)
+	}
+	report := getPerformance(t, db, performanceQuery("latency"))
+	for _, group := range report.Groups {
+		if group.Matched.Samples != 60 {
+			t.Fatal("missing supported summary")
+		}
+		for _, day := range group.Days {
+			if day.Day == day1.Format("2006-01-02") && day.Matched.Median == nil {
+				t.Fatal("supported day lost")
+			}
+			if day.Day == day2.Format("2006-01-02") && (day.Raw.Median == nil || day.Matched.Median != nil) {
+				t.Fatal("daily mix silently changed or raw disappeared")
+			}
+		}
+	}
+}
+func TestPerformanceRangeAccountProviderAndFilters(t *testing.T) {
+	db := openTestDatabase(t)
+	at := performanceNow.Add(-time.Hour)
+	seedPerformance(t, db, "a", 1000, 2000, 20, at)
+	seedPerformance(t, db, "b", 1000, 3000, 20, at)
+	seedPerformance(t, db, "old", 1000, 100000, 20, performanceNow.Add(-31*24*time.Hour))
+	for i, field := range []string{"auth_index", "provider", "auth_type"} {
+		seedPerformance(t, db, fmt.Sprintf("other%d", i), 1000, 2000, 3, at)
+		if err := db.Model(&entities.UsageEvent{}).Where("model = ?", fmt.Sprintf("other%d", i)).Update(field, "other").Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	seedPerformance(t, db, "future", 1000, 100000, 20, performanceNow)
+	q := performanceQuery("latency")
+	q.Models = []string{"b"}
+	q.Context = "small"
+	q.Output = "short"
+	q.Effort = "low"
+	report := getPerformance(t, db, q)
+	if len(report.Groups) != 1 || report.Groups[0].Model != "b" || report.Groups[0].Raw.Samples != 20 || report.CommonCells != 0 || !reflect.DeepEqual(report.Models, []string{"a", "b"}) {
+		t.Fatalf("isolation/filters/options failed: %+v", report)
+	}
+	q.Context = "large"
+	if len(getPerformance(t, db, q).Groups) != 0 {
+		t.Fatal("context filter ignored")
+	}
+}
+func TestPerformanceMissingInvalidTimingsAndPhaseFloor(t *testing.T) {
+	db := openTestDatabase(t)
+	at := performanceNow.Add(-time.Hour)
+	seedPerformance(t, db, "a", 1000, 2000, 8, at)
+	var events []entities.UsageEvent
+	if err := db.Find(&events).Error; err != nil {
+		t.Fatal(err)
+	}
+	changes := []map[string]any{{"ttft_ms": nil}, {"ttft_ms": 2000}, {"ttft_ms": -1}, {"ttft_ms": 1950}, {"stream": false}, {"stream": nil}, {"output_tokens": 1}, {"generate": false}}
+	for i, e := range events {
+		if err := db.Model(&entities.UsageEvent{}).Where("id = ?", e.ID).Updates(changes[i]).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	if n := getPerformance(t, db, performanceQuery("phase")).Groups[0].Raw.Samples; n != 0 {
+		t.Fatalf("phase guessed from missing/unstable samples: %d", n)
+	}
+	if n := getPerformance(t, db, performanceQuery("ttft")).Groups[0].Raw.Samples; n != 4 {
+		t.Fatalf("invalid ttft included: %d", n)
+	}
+	if n := getPerformance(t, db, performanceQuery("latency")).Groups[0].Raw.Samples; n != 7 {
+		t.Fatalf("non-generation timing included: %d", n)
+	}
+	seedPerformance(t, db, "b", 1000, 2000, 20, at)
+	phase := getPerformance(t, db, performanceQuery("phase"))
+	if *phase.Groups[1].Raw.Median != 100 {
+		t.Fatal("wrong active-phase denominator")
+	}
+	tps := getPerformance(t, db, performanceQuery("tps"))
+	if *tps.Groups[1].Raw.Median != 50 {
+		t.Fatal("raw TPS changed")
+	}
+}
+func TestPerformanceUnknownModesSparseAndEffortMismatch(t *testing.T) {
+	db := openTestDatabase(t)
+	at := performanceNow.Add(-time.Hour)
+	for _, model := range []string{"a", "b", "unknown", "sparse"} {
+		n := 20
+		if model == "sparse" {
+			n = 3
+		}
+		seedPerformance(t, db, model, 1000, 2000, n, at)
+	}
+	db.Model(&entities.UsageEvent{}).Where("model = ?", "unknown").Update("upstream_service_tier", "")
+	db.Model(&entities.UsageEvent{}).Where("model = ?", "b").Update("reasoning_effort", "high")
+	report := getPerformance(t, db, performanceQuery("latency"))
+	if report.CommonCells != 0 {
+		t.Fatal("different reasoning effort matched")
+	}
+	db.Model(&entities.UsageEvent{}).Where("model = ?", "b").Update("reasoning_effort", "low")
+	report = getPerformance(t, db, performanceQuery("latency"))
+	if report.ComparisonGroups != 2 {
+		t.Fatal("unknown/sparse groups entered normalization")
+	}
+	for _, g := range report.Groups {
+		if (g.Model == "unknown" || g.Model == "sparse") && (g.Raw.Median == nil || g.Matched.Median != nil) {
+			t.Fatal("raw results lost or unsupported match invented")
+		}
+	}
+}
+func TestPerformanceValidation(t *testing.T) {
+	for _, q := range []repository.PerformanceQuery{{Days: 30, Metric: "latency"}, {AuthIndex: "a", Days: 1, Metric: "latency"}, {AuthIndex: "a", Days: 30, Metric: "guess"}, {AuthIndex: "a", Days: 30, Metric: "latency", Mode: "confirmed-fast"}} {
+		if repository.ValidatePerformanceQuery(q) == nil {
+			t.Fatal("invalid filters accepted")
+		}
+	}
+}
