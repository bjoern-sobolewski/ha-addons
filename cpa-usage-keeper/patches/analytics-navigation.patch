new file mode 100644
index 0000000..5f938c3
--- /dev/null
+++ b/web/src/components/usage/credentials/analyticsModels.ts
@@ -0,0 +1,26 @@
+import { USAGE_CHART_COMPOSITION_COLORS } from '@/utils/usage/chartConfig'
+
+export type AnalyticsModel = { model: string; requests: number }
+export type ModelSelection = 'top' | 'all' | string[]
+
+export function rankAnalyticsModels(usage: AnalyticsModel[], names: string[] = []): AnalyticsModel[] {
+  const counts = new Map(names.map(model => [model, 0]))
+  for (const item of usage) counts.set(item.model, (counts.get(item.model) ?? 0) + item.requests)
+  return [...counts].map(([model, requests]) => ({ model, requests }))
+    .sort((a, b) => b.requests - a.requests || a.model.localeCompare(b.model))
+}
+
+export function selectedAnalyticsModels(selection: ModelSelection, models: AnalyticsModel[]): string[] {
+  if (selection === 'top') return models.slice(0, 2).map(item => item.model)
+  if (selection === 'all') return models.map(item => item.model)
+  return selection.filter(model => models.some(item => item.model === model))
+}
+
+export function analyticsModelColor(model: string, models: AnalyticsModel[]): string {
+  const names = models.map(item => item.model).sort()
+  return USAGE_CHART_COMPOSITION_COLORS[Math.max(0, names.indexOf(model)) % USAGE_CHART_COMPOSITION_COLORS.length].base
+}
+
+export function analyticsModeSelected(mode: string, filter: string): boolean {
+  return filter === 'captured' ? mode === 'normal' || mode === 'fast' : !filter || mode === filter
+}
