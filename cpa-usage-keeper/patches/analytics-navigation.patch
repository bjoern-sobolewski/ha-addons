diff --git a/web/src/components/usage/credentials/AnalyticsModelPicker.tsx b/web/src/components/usage/credentials/AnalyticsModelPicker.tsx
new file mode 100644
index 0000000..328f762
--- /dev/null
+++ b/web/src/components/usage/credentials/AnalyticsModelPicker.tsx
@@ -0,0 +1,35 @@
+import { useEffect, useRef } from 'react'
+import { useTranslation } from 'react-i18next'
+import { analyticsModelColor, selectedAnalyticsModels, type AnalyticsModel, type ModelSelection } from './analyticsModels'
+import styles from './WeeklyQuotaValuePanel.module.scss'
+
+export function AnalyticsModelPicker({ models, selection, onChange }: { models: AnalyticsModel[]; selection: ModelSelection; onChange: (selection: ModelSelection) => void }) {
+  const { t, i18n } = useTranslation()
+  const ref = useRef<HTMLDetailsElement>(null)
+  const selected = selectedAnalyticsModels(selection, models)
+  useEffect(() => {
+    const close = (event: PointerEvent) => { if (!ref.current?.contains(event.target as Node)) ref.current?.removeAttribute('open') }
+    document.addEventListener('pointerdown', close)
+    return () => document.removeEventListener('pointerdown', close)
+  }, [])
+  return <details ref={ref} className={styles.modelDropdown} onKeyDown={event => {
+    if (event.key === 'Escape') { ref.current?.removeAttribute('open'); ref.current?.querySelector('summary')?.focus(); event.stopPropagation() }
+  }}>
+    <summary aria-label={t('analytics.models', 'Models')}>{t('analytics.models', 'Models')} · {selection === 'top' ? t('analytics.top_short', 'Top 2') : `${selected.length} ${t('analytics.selected', 'selected')}`}</summary>
+    <div className={styles.modelMenu}>
+      <div className={styles.pickerActions}>
+        <button type="button" aria-pressed={selection === 'top'} onClick={() => onChange('top')}>{t('analytics.top', 'Top 2 by requests')}</button>
+        <button type="button" aria-pressed={selection === 'all'} onClick={() => onChange('all')}>{t('analytics.all', 'Show all')}</button>
+        <button type="button" onClick={() => onChange([])}>{t('analytics.clear', 'Clear')}</button>
+      </div>
+      <div className={styles.modelOptions} role="group" aria-label={t('analytics.models', 'Models')}>
+        {models.map(item => <label key={item.model} className={styles.modelOption}>
+          <input type="checkbox" aria-label={item.model || 'Unnamed model'} checked={selected.includes(item.model)} onChange={() => onChange(selected.includes(item.model) ? selected.filter(value => value !== item.model) : [...selected, item.model])} />
+          <span className={styles.swatch} style={{ backgroundColor: analyticsModelColor(item.model, models) }} />
+          <span>{item.model || '—'}</span><small>{new Intl.NumberFormat(i18n.language, { notation: 'compact', maximumFractionDigits: 1 }).format(item.requests)}</small>
+        </label>)}
+      </div>
+      <p className={styles.meta}>{t('analytics.ranking_note', 'Ranked by recorded requests in this period.')}</p>
+    </div>
+  </details>
+}
