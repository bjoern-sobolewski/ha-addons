@@ -0,0 +1,14 @@
+import { afterEach, beforeEach, vi } from 'vitest'
+const NativeDateTimeFormat = Intl.DateTimeFormat
+// Give UI fixtures explicit browser preferences, independent of their API timezone.
+export function setBrowserPreferences(timeZone = 'UTC', locale = 'en-US-u-hc-h23') {
+  vi.spyOn(navigator, 'languages', 'get').mockReturnValue([locale])
+  vi.spyOn(navigator, 'language', 'get').mockReturnValue(locale)
+  vi.spyOn(Intl, 'DateTimeFormat').mockImplementation(function(locales, options) {
+    return new NativeDateTimeFormat(locales, { timeZone, ...options })
+  } as typeof Intl.DateTimeFormat)
+}
+export function setupBrowserPreferences(timeZone = 'UTC', locale = 'en-US-u-hc-h23') {
+  beforeEach(() => setBrowserPreferences(timeZone, locale))
+  afterEach(() => vi.restoreAllMocks())
+}
