diff --git a/internal/quota/shared_reset.go b/internal/quota/shared_reset.go
new file mode 100644
index 00000000..659fd2fc
--- /dev/null
+++ b/internal/quota/shared_reset.go
@@ -0,0 +1,42 @@
+package quota
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/cpa/dto/quotareset"
+	"errors"
+)
+
+type sharedResetClient interface {
+	QuotaResetOptions(context.Context, string) (quotareset.Options, error)
+	RedeemQuotaReset(context.Context, quotareset.Request) (quotareset.Result, error)
+}
+
+func sharedReset(caller ManagementAPICaller) (sharedResetClient, error) {
+	client, ok := caller.(sharedResetClient)
+	if !ok {
+		return nil, errors.New("CPA shared reset API unavailable")
+	}
+	return client, nil
+}
+func (c upstreamResponseRecordingCaller) QuotaResetOptions(ctx context.Context, index string) (quotareset.Options, error) {
+	client, err := sharedReset(c.ManagementClient)
+	if err != nil {
+		return quotareset.Options{}, err
+	}
+	return client.QuotaResetOptions(ctx, index)
+}
+func (c upstreamResponseRecordingCaller) RedeemQuotaReset(ctx context.Context, req quotareset.Request) (quotareset.Result, error) {
+	client, err := sharedReset(c.ManagementClient)
+	if err != nil {
+		return quotareset.Result{}, err
+	}
+	return client.RedeemQuotaReset(ctx, req)
+}
+func redeemSharedReset(ctx context.Context, caller ManagementAPICaller, input ProviderInput, provider, grant, org string) (ProviderResetOutput, error) {
+	client, err := sharedReset(caller)
+	if err != nil {
+		return ProviderResetOutput{}, err
+	}
+	out, err := client.RedeemQuotaReset(ctx, quotareset.Request{AuthIndex: input.Identity.Identity, Provider: provider, RequestID: input.ResetRequestID, GrantID: grant, OrganizationID: org})
+	return ProviderResetOutput{Code: out.Code, WindowsReset: out.WindowsReset, RecoveryFailed: out.RecoveryFailed}, err
+}
