+package emailprivacy
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+)
+
+func privateName(name string) string {
+	sum := sha256.Sum256([]byte(name))
+	return "private-credential-" + hex.EncodeToString(sum[:12]) + ".json"
+}
diff --git a/internal/emailprivacy/policy.go b/internal/emailprivacy/policy.go
new file mode 100644
index 00000000..ffb7c937
--- /dev/null
+++ b/internal/emailprivacy/policy.go
@@ -0,0 +1,200 @@
+// Package emailprivacy enforces CPAMC's per-credential email visibility policy.
+package emailprivacy
+
+import (
+	"encoding/json"
+	"errors"
+	"net/url"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+type Entry struct {
+	Name   string `json:"name"`
+	Email  string `json:"email"`
+	Hidden bool   `json:"hidden"`
+}
+
+// Mask counts Unicode characters rather than bytes and always adds the mask.
+func Mask(email string) string {
+	at := strings.LastIndex(email, "@")
+	if at <= 0 || at == len(email)-1 {
+		return "[hidden email]"
+	}
+	local := []rune(email[:at])
+	if len(local) > 6 {
+		local = local[:6]
+	}
+	return string(local) + "**" + email[at:]
+}
+
+type Rule struct {
+	Pattern     *regexp.Regexp
+	Replacement string
+}
+type Policy struct {
+	Entries []Entry
+	Rules   []Rule
+	Names   map[string]string
+}
+
+// Build retains privacy for removed credentials and old addresses, so deleting a
+// file cannot make historical usage public again. A visible current copy of the
+// same email only clears protection if no other copy still hides it.
+func Build(previous, current []Entry) Policy {
+	hidden := map[string]Entry{}
+	for _, e := range previous {
+		if e.Hidden && e.Email != "" {
+			hidden[strings.ToLower(e.Email)] = e
+		}
+	}
+	for _, e := range current {
+		if !e.Hidden && e.Email != "" {
+			delete(hidden, strings.ToLower(e.Email))
+		}
+	}
+	for _, e := range current {
+		if e.Hidden && e.Email != "" {
+			hidden[strings.ToLower(e.Email)] = e
+		}
+	}
+	p := Policy{Names: map[string]string{}}
+	keys := make([]string, 0, len(hidden))
+	for key := range hidden {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+	for _, key := range keys {
+		p.Entries = append(p.Entries, hidden[key])
+	}
+	replacements := map[string]string{}
+	add := func(original, masked string) {
+		if original == "" || original == masked {
+			return
+		}
+		replacements[original] = masked
+		if encoded := url.QueryEscape(original); encoded != original {
+			replacements[encoded] = url.QueryEscape(masked)
+		}
+		if encoded := url.PathEscape(original); encoded != original {
+			replacements[encoded] = url.PathEscape(masked)
+		}
+	}
+	for _, e := range p.Entries {
+		add(e.Email, Mask(e.Email))
+	}
+	// Names may contain addresses not identical to the email metadata. Hide the
+	// whole filename and keep a reversible server-only mapping for batch actions.
+	for _, e := range append(append([]Entry{}, p.Entries...), current...) {
+		if _, ok := hidden[strings.ToLower(e.Email)]; !ok || e.Name == "" {
+			continue
+		}
+		// Stable filename handles avoid collisions between accounts with equal prefixes.
+		alias := privateName(e.Name)
+		p.Names[alias] = e.Name
+		add(e.Name, alias)
+	}
+	originals := make([]string, 0, len(replacements))
+	for key := range replacements {
+		originals = append(originals, key)
+	}
+	sort.Slice(originals, func(i, j int) bool {
+		if len(originals[i]) == len(originals[j]) {
+			return originals[i] < originals[j]
+		}
+		return len(originals[i]) > len(originals[j])
+	})
+	for _, key := range originals {
+		p.Rules = append(p.Rules, Rule{regexp.MustCompile("(?i)" + regexp.QuoteMeta(key)), replacements[key]})
+	}
+	return p
+}
+
+func (p Policy) Text(s string) string {
+	for _, rule := range p.Rules {
+		s = rule.Pattern.ReplaceAllStringFunc(s, func(string) string { return rule.Replacement })
+	}
+	return s
+}
+
+// JSON decodes escaped strings before scrubbing, including object keys. Numbers
+// remain json.Number, preserving identifiers beyond JavaScript's safe range.
+func (p Policy) JSON(body []byte) ([]byte, error) {
+	var value any
+	decoder := json.NewDecoder(strings.NewReader(string(body)))
+	decoder.UseNumber()
+	if err := decoder.Decode(&value); err != nil {
+		return nil, err
+	}
+	var walk func(any) any
+	walk = func(v any) any {
+		switch typed := v.(type) {
+		case string:
+			return p.Text(typed)
+		case []any:
+			for i, item := range typed {
+				typed[i] = walk(item)
+			}
+		case map[string]any:
+			out := make(map[string]any, len(typed))
+			for key, item := range typed {
+				out[p.Text(key)] = walk(item)
+			}
+			return out
+		}
+		return v
+	}
+	return json.Marshal(walk(value))
+}
+
+func Load(path string) ([]Entry, error) {
+	if path == "" {
+		return nil, nil
+	}
+	data, err := os.ReadFile(path)
+	if errors.Is(err, os.ErrNotExist) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	var entries []Entry
+	err = json.Unmarshal(data, &entries)
+	return entries, err
+}
+
+func Save(path string, entries []Entry) error {
+	if path == "" {
+		return nil
+	}
+	data, err := json.Marshal(entries)
+	if err != nil {
+		return err
+	}
+	if err = os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(filepath.Dir(path), ".email-privacy-*")
+	if err != nil {
+		return err
+	}
+	name := file.Name()
+	defer os.Remove(name)
+	if err = file.Chmod(0600); err == nil {
+		_, err = file.Write(data)
+	}
+	if err == nil {
+		err = file.Sync()
+	}
+	closeErr := file.Close()
+	if err != nil {
+		return err
+	}
+	if closeErr != nil {
+		return closeErr
+	}
+	return os.Rename(name, path)
+}
diff --git a/internal/emailprivacy/policy_test.go b/internal/emailprivacy/policy_test.go
new file mode 100644
index 00000000..01fcaeb9
--- /dev/null
+++ b/internal/emailprivacy/policy_test.go
@@ -0,0 +1,65 @@
+package emailprivacy
+
+import (
+	"encoding/json"
+	"net/url"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestPolicyEscapesHistoryAndAliases(t *testing.T) {
+	email := "example.person+work@example.com"
+	p := Build(nil, []Entry{{"codex-" + email + ".json", email, true}, {"public.json", "visible@example.com", false}})
+	body := `{"example.person+work@example.com":"ex\u0061mple.person+work@example.com","filename":"codex-example.person+work@example.com.json","nested":[{"url":"` + url.QueryEscape(email) + `","text":"EXAMPLE.PERSON+WORK@EXAMPLE.COM","visible":"visible@example.com"}],"large":9223372036854775807}`
+	result, err := p.JSON([]byte(body))
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(result)
+	if strings.Contains(strings.ToLower(text), strings.ToLower(email)) || strings.Contains(text, url.QueryEscape(email)) {
+		t.Fatal("private address escaped sanitization")
+	}
+	if !strings.Contains(text, "exampl**@example.com") || !strings.Contains(text, "visible@example.com") || !strings.Contains(text, "9223372036854775807") {
+		t.Fatal(text)
+	}
+	var parsed map[string]any
+	if err = json.Unmarshal(result, &parsed); err != nil {
+		t.Fatal(err)
+	}
+	alias := parsed["filename"].(string)
+	if p.Names[alias] != "codex-"+email+".json" {
+		t.Fatal("batch action handle is not reversible on server")
+	}
+	for _, tc := range []struct{ value, want string }{{"ab@x.com", "ab**@x.com"}, {"abcdef@x.com", "abcdef**@x.com"}, {"你好世界甲乙丙@x.com", "你好世界甲乙**@x.com"}, {"invalid", "[hidden email]"}} {
+		if got := Mask(tc.value); got != tc.want {
+			t.Fatalf("mask %q = %q", tc.value, got)
+		}
+	}
+}
+
+func TestPolicySurvivesDeleteRestartAndDuplicateFiles(t *testing.T) {
+	private := Entry{"one.json", "private.user@example.com", true}
+	p := Build(nil, []Entry{private})
+	path := filepath.Join(t.TempDir(), "privacy.json")
+	if err := Save(path, p.Entries); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := Load(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	deleted := Build(loaded, nil)
+	if deleted.Text(private.Email) == private.Email {
+		t.Fatal("deleting a file revealed history")
+	}
+	visible := private
+	visible.Hidden = false
+	if len(Build(loaded, []Entry{visible}).Entries) != 0 {
+		t.Fatal("CPAMC cannot turn privacy off")
+	}
+	visible.Name = "other.json"
+	if len(Build(loaded, []Entry{visible, private}).Entries) != 1 {
+		t.Fatal("visible duplicate bypassed a hidden copy")
+	}
+}
