new file mode 100644
index 00000000..402b9776
--- /dev/null
+++ b/internal/api/email_privacy.go
@@ -0,0 +1,207 @@
+package api
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"reflect"
+	"strings"
+	"time"
+
+	"cpa-usage-keeper/internal/emailprivacy"
+	"github.com/gin-gonic/gin"
+)
+
+type EmailPrivacySource interface {
+	KeeperEmailPrivacy(context.Context) ([]emailprivacy.Entry, error)
+}
+
+// EmailPrivacyBoundary is applied to every data API, including download-token
+// routes and viewer APIs. Live SSE carries topic names only and is registered
+// before this boundary. No frontend reveal control can undo these replacements.
+type EmailPrivacyBoundary struct {
+	source EmailPrivacySource
+	path   string
+	gate   chan struct{}
+}
+
+func NewEmailPrivacyBoundary(source EmailPrivacySource, path string) *EmailPrivacyBoundary {
+	return &EmailPrivacyBoundary{source: source, path: path, gate: make(chan struct{}, 1)}
+}
+
+func (b *EmailPrivacyBoundary) policy(ctx context.Context) (emailprivacy.Policy, error) {
+	ctx, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	select {
+	case b.gate <- struct{}{}:
+		defer func() { <-b.gate }()
+	case <-ctx.Done():
+		return emailprivacy.Policy{}, ctx.Err()
+	}
+	previous, err := emailprivacy.Load(b.path)
+	if err != nil {
+		return emailprivacy.Policy{}, err
+	}
+	current, err := b.source.KeeperEmailPrivacy(ctx)
+	if err != nil {
+		return emailprivacy.Policy{}, err
+	}
+	for _, entry := range current {
+		if entry.Hidden && (entry.Email == "" || emailprivacy.Mask(entry.Email) == "[hidden email]") {
+			return emailprivacy.Policy{}, errors.New("hidden credential has no valid email")
+		}
+	}
+	policy := emailprivacy.Build(previous, current)
+	if !reflect.DeepEqual(previous, policy.Entries) {
+		if err = emailprivacy.Save(b.path, policy.Entries); err != nil {
+			return emailprivacy.Policy{}, err
+		}
+	}
+	return policy, nil
+}
+
+func (b *EmailPrivacyBoundary) Middleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		policy, err := b.policy(c.Request.Context())
+		if err != nil {
+			privacyUnavailable(c)
+			return
+		}
+		setNoStoreHeaders(c)
+		// Logs are arbitrary upstream text/binary and can contain encoded tokens.
+		// Blocking the raw surface also covers previously minted download tokens.
+		if strings.Contains(c.FullPath(), "/request-log") {
+			if len(policy.Entries) > 0 {
+				c.AbortWithStatusJSON(http.StatusForbidden, gin.H{"error": "Raw request logs are unavailable while an email is hidden in Keeper. Manage email visibility in CPAMC."})
+				return
+			}
+			c.Next()
+			return
+		}
+		if err = restorePrivateCredentialNames(c, policy.Names); err != nil {
+			c.AbortWithStatusJSON(http.StatusBadRequest, gin.H{"error": "Invalid credential request"})
+			return
+		}
+		original := c.Writer
+		buffered := &privacyWriter{ResponseWriter: original, status: http.StatusOK}
+		c.Writer = buffered
+		c.Next()
+		c.Writer = original
+		// Recheck after handlers: a switch enabled while a report was being generated
+		// must protect that report too. Fail closed if CPA or the durable policy fails.
+		policy, err = b.policy(c.Request.Context())
+		if err != nil || buffered.overflow {
+			privacyUnavailable(c)
+			return
+		}
+		body := buffered.body.Bytes()
+		if len(policy.Entries) > 0 && len(body) > 0 {
+			contentType := original.Header().Get("Content-Type")
+			switch {
+			case strings.Contains(contentType, "json"):
+				body, err = policy.JSON(body)
+			case strings.Contains(contentType, "csv"), strings.HasPrefix(contentType, "text/"):
+				body = []byte(policy.Text(string(body)))
+			default:
+				err = errors.New("unsupported private response")
+			}
+			if err != nil {
+				privacyUnavailable(c)
+				return
+			}
+		}
+		for key, values := range original.Header() {
+			for i, value := range values {
+				values[i] = policy.Text(value)
+			}
+			original.Header()[key] = values
+		}
+		original.Header().Del("Content-Length")
+		original.Header().Del("ETag")
+		original.WriteHeader(buffered.status)
+		_, _ = original.Write(body)
+	}
+}
+
+func privacyUnavailable(c *gin.Context) {
+	for key := range c.Writer.Header() {
+		c.Writer.Header().Del(key)
+	}
+	setNoStoreHeaders(c)
+	c.AbortWithStatusJSON(http.StatusServiceUnavailable, gin.H{"error": "Email visibility could not be verified. Refresh before retrying any change."})
+}
+
+func restorePrivateCredentialNames(c *gin.Context, names map[string]string) error {
+	path := c.FullPath()
+	if (c.Request.Method != http.MethodPatch && c.Request.Method != http.MethodDelete) || (!strings.HasSuffix(path, "/credentials/status") && !strings.HasSuffix(path, "/credentials")) || len(names) == 0 {
+		return nil
+	}
+	data, err := io.ReadAll(io.LimitReader(c.Request.Body, 4*1024*1024+1))
+	if err != nil {
+		return err
+	}
+	if len(data) > 4*1024*1024 {
+		return errors.New("request too large")
+	}
+	var value map[string]json.RawMessage
+	if err = json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	if raw, ok := value["names"]; ok {
+		var items []string
+		if err = json.Unmarshal(raw, &items); err != nil {
+			return err
+		}
+		for i, name := range items {
+			if original, ok := names[name]; ok {
+				items[i] = original
+			}
+		}
+		value["names"], _ = json.Marshal(items)
+	}
+	data, err = json.Marshal(value)
+	if err != nil {
+		return err
+	}
+	c.Request.Body = io.NopCloser(bytes.NewReader(data))
+	c.Request.ContentLength = int64(len(data))
+	return nil
+}
+
+const maxPrivacyResponseBytes = 32 * 1024 * 1024
+
+type privacyWriter struct {
+	gin.ResponseWriter
+	body     bytes.Buffer
+	status   int
+	written  bool
+	overflow bool
+}
+
+func (w *privacyWriter) WriteHeader(status int) {
+	if !w.written {
+		w.status = status
+	}
+}
+func (w *privacyWriter) WriteHeaderNow() { w.written = true }
+func (w *privacyWriter) Write(data []byte) (int, error) {
+	w.written = true
+	if w.body.Len()+len(data) > maxPrivacyResponseBytes {
+		w.overflow = true
+		return len(data), nil
+	}
+	return w.body.Write(data)
+}
+func (w *privacyWriter) WriteString(s string) (int, error) { return w.Write([]byte(s)) }
+func (w *privacyWriter) Status() int                       { return w.status }
+func (w *privacyWriter) Size() int {
+	if !w.written {
+		return -1
+	}
+	return w.body.Len()
+}
+func (w *privacyWriter) Written() bool { return w.written }
+func (w *privacyWriter) Flush()        { w.WriteHeaderNow() }
diff --git a/internal/api/email_privacy_test.go b/internal/api/email_privacy_test.go
new file mode 100644
index 00000000..9a53429b
--- /dev/null
+++ b/internal/api/email_privacy_test.go
@@ -0,0 +1,130 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+
+	"cpa-usage-keeper/internal/emailprivacy"
+	"github.com/gin-gonic/gin"
+)
+
+type privacySourceStub struct {
+	mu      sync.Mutex
+	entries []emailprivacy.Entry
+	fail    bool
+}
+
+func (s *privacySourceStub) KeeperEmailPrivacy(context.Context) ([]emailprivacy.Entry, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.fail {
+		return nil, errors.New("unavailable")
+	}
+	return append([]emailprivacy.Entry{}, s.entries...), nil
+}
+
+func TestEmailPrivacyBoundaryCoversAllDataSurfaces(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	const email = "example.secret@example.com"
+	source := &privacySourceStub{entries: []emailprivacy.Entry{{Name: "codex-" + email + ".json", Email: email, Hidden: true}}}
+	path := filepath.Join(t.TempDir(), "privacy.json")
+	router := NewRouter(nil, nil, nil, nil, AuthConfig{}, nil, "/keeper", OptionalProviders{EmailPrivacy: NewEmailPrivacyBoundary(source, path)})
+	// Use the same boundary as production for synthetic payloads with historical
+	// labels, routing account maps, nested details, filenames and CSV exports.
+	group := router.Group("/fixture", NewEmailPrivacyBoundary(source, path).Middleware())
+	group.GET("/report", func(c *gin.Context) {
+		c.Header("X-Account", email)
+		c.JSON(200, gin.H{"email": email, "history": []string{email}, "accounts": map[string]string{"index": email}, "file_name": "codex-" + email + ".json"})
+	})
+	group.GET("/export", func(c *gin.Context) {
+		c.Header("Content-Disposition", "attachment; filename="+email+".csv")
+		c.Data(200, "text/csv", []byte("account\n"+email+"\n"))
+	})
+	for _, uri := range []string{"/fixture/report", "/fixture/export"} {
+		rec := httptest.NewRecorder()
+		router.ServeHTTP(rec, httptest.NewRequest("GET", uri, nil))
+		if rec.Code != 200 || strings.Contains(rec.Body.String(), email) || strings.Contains(rec.Header().Get("X-Account"), email) || strings.Contains(rec.Header().Get("Content-Disposition"), email) {
+			t.Fatalf("privacy leak at %s: %d", uri, rec.Code)
+		}
+		if !strings.Contains(rec.Body.String(), "exampl**@example.com") {
+			t.Fatal(rec.Body.String())
+		}
+	}
+	for _, uri := range []string{"/keeper/api/v1/usage/events/1/request-log", "/keeper/api/v1/usage/events/1/request-log/download-file?token=old", "/keeper/api/v1/usage/events/1/request-log/download-token"} {
+		method := http.MethodGet
+		if strings.HasSuffix(uri, "download-token") {
+			method = http.MethodPost
+		}
+		rec := httptest.NewRecorder()
+		router.ServeHTTP(rec, httptest.NewRequest(method, uri, nil))
+		if rec.Code != 403 {
+			t.Fatalf("raw log bypass %s: %d", uri, rec.Code)
+		}
+	}
+	source.mu.Lock()
+	source.entries = nil
+	source.mu.Unlock()
+	rec := httptest.NewRecorder()
+	router.ServeHTTP(rec, httptest.NewRequest("GET", "/fixture/report", nil))
+	if strings.Contains(rec.Body.String(), email) {
+		t.Fatal("deletion exposed archived history")
+	}
+	source.mu.Lock()
+	source.fail = true
+	source.mu.Unlock()
+	rec = httptest.NewRecorder()
+	router.ServeHTTP(rec, httptest.NewRequest("GET", "/fixture/report", nil))
+	if rec.Code != 503 || strings.Contains(rec.Body.String(), email) {
+		t.Fatal("policy outage failed open")
+	}
+}
+
+func TestEmailPrivacyRechecksAfterHandlerAndRestoresActions(t *testing.T) {
+	source := &privacySourceStub{entries: []emailprivacy.Entry{}}
+	boundary := NewEmailPrivacyBoundary(source, filepath.Join(t.TempDir(), "privacy.json"))
+	r := gin.New()
+	r.Use(boundary.Middleware())
+	email := "example.secret@example.com"
+	r.GET("/slow", func(c *gin.Context) {
+		source.mu.Lock()
+		source.entries = []emailprivacy.Entry{{Name: email + ".json", Email: email, Hidden: true}}
+		source.mu.Unlock()
+		c.JSON(200, gin.H{"email": email})
+	})
+	rec := httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("GET", "/slow", nil))
+	if rec.Code != 200 || strings.Contains(rec.Body.String(), email) {
+		t.Fatal("in-flight report bypassed new policy")
+	}
+	policy, err := boundary.policy(context.Background())
+	if err != nil {
+		t.Fatal(err)
+	}
+	var alias string
+	for name := range policy.Names {
+		alias = name
+	}
+	r.PATCH("/credentials/status", func(c *gin.Context) {
+		var body map[string][]string
+		if err := c.ShouldBindJSON(&body); err != nil {
+			t.Fatal(err)
+		}
+		if body["names"][0] != email+".json" {
+			t.Fatal("server did not restore private filename")
+		}
+		c.JSON(200, body)
+	})
+	payload, _ := json.Marshal(map[string][]string{"names": {alias}})
+	rec = httptest.NewRecorder()
+	r.ServeHTTP(rec, httptest.NewRequest("PATCH", "/credentials/status", strings.NewReader(string(payload))))
+	if rec.Code != 200 || strings.Contains(rec.Body.String(), email) {
+		t.Fatal("action response leaked filename")
+	}
+}
