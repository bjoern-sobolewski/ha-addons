+package test
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func serveVisibleEmailPolicy(w http.ResponseWriter, r *http.Request) bool {
+	if r.URL.Path != "/v8/management/keeper-email-privacy" {
+		return false
+	}
+	w.Header().Set("Content-Type", "application/json")
+	_, _ = w.Write([]byte(`{"version":1,"entries":[]}`))
+	return true
+}
+
+func visibleEmailPolicyServer(t *testing.T) string {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !serveVisibleEmailPolicy(w, r) {
+			w.WriteHeader(http.StatusNotFound)
+		}
+	}))
+	t.Cleanup(server.Close)
+	return server.URL
+}
