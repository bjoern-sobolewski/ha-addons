+++ b/internal/cpa/email_privacy.go
@@ -0,0 +1,22 @@
+package cpa
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/emailprivacy"
+	"errors"
+)
+
+func (c *Client) KeeperEmailPrivacy(ctx context.Context) ([]emailprivacy.Entry, error) {
+	var result struct {
+		Version int                  `json:"version"`
+		Entries []emailprivacy.Entry `json:"entries"`
+	}
+	_, _, err := c.doManagementJSONRequest(ctx, "/v8/management/keeper-email-privacy", &result, "email privacy")
+	if err != nil {
+		return nil, err
+	}
+	if result.Version != 1 || result.Entries == nil {
+		return nil, errors.New("email privacy policy unavailable")
+	}
+	return result.Entries, nil
+}
