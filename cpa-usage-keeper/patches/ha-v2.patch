+// Different captured payload tiers must remain independent even if the response
+// reports the same tier and a recalculation gives both requests the same price.
+func TestUsageCostRecalculationPreservesCapturedOutgoingTierBuckets(t *testing.T) {
+	writer, reader := openRecalculationPools(t)
+	when := time.Date(2026, 10, 21, 10, 15, 0, 0, time.Local)
+	events := []entities.UsageEvent{
+		{EventKey: "normal", APIGroupKey: "key", Model: "priced", Timestamp: when, UpstreamServiceTier: "default", ResponseServiceTier: "default", InputTokens: 1_000_000, CostUSD: recalcCost(1), CostAvailable: recalcAvailable(true)},
+		{EventKey: "fast", APIGroupKey: "key", Model: "priced", Timestamp: when, UpstreamServiceTier: "priority", ResponseServiceTier: "default", InputTokens: 1_000_000, CostUSD: recalcCost(3), CostAvailable: recalcAvailable(true)},
+	}
+	if err := writer.Create(&events).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := repository.AggregateUsageOverviewStats(context.Background(), writer, when.Add(time.Hour)); err != nil {
+		t.Fatal(err)
+	}
+	scope := repository.UsageCostRecalculationScope{Start: when.Truncate(time.Hour), End: when.Add(time.Hour), MaxEventID: events[1].ID}
+	page, _, _, err := repository.LoadUsageCostRecalculationPage(context.Background(), reader, scope, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := repository.ApplyUsageCostRecalculationBatch(context.Background(), writer, scope, page, recalcResolver(t)); err != nil {
+		t.Fatal(err)
+	}
+	if err := repository.FinalizeUsageCostRecalculationStats(context.Background(), reader, writer, scope); err != nil {
+		t.Fatal(err)
+	}
+	for _, table := range []string{"usage_overview_hourly_stats", "usage_overview_daily_stats"} {
+		var rows []struct {
+			UpstreamServiceTier string
+			RequestCount        int64
+			CostUSD             float64
+		}
+		if err := reader.Table(table).Order("upstream_service_tier").Find(&rows).Error; err != nil {
+			t.Fatal(err)
+		}
+		if len(rows) != 2 || rows[0].UpstreamServiceTier != "default" || rows[1].UpstreamServiceTier != "priority" || rows[0].RequestCount != 1 || rows[1].RequestCount != 1 {
+			t.Fatalf("captured tier buckets changed in %s: %+v", table, rows)
+		}
+		for _, row := range rows {
+			var event entities.UsageEvent
+			if err := reader.Where("upstream_service_tier = ?", row.UpstreamServiceTier).First(&event).Error; err != nil {
+				t.Fatal(err)
+			}
+			if event.CostUSD == nil || math.Abs(row.CostUSD-*event.CostUSD) > 1e-12 {
+				t.Fatalf("bucket fee differs from its event: %+v event=%+v", row, event)
+			}
+		}
+	}
+}
