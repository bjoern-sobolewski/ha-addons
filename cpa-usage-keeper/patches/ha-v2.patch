index 00000000..510ccadc
--- /dev/null
+++ b/web/src/components/usage/credentials/PerformancePanel.tsx
@@ -0,0 +1,140 @@
+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Chart } from 'react-chartjs-2'
+import type { ChartData, ChartOptions } from 'chart.js'
+import '@/lib/chartjs'
+import { ApiError, fetchAccountPerformance } from '@/lib/api'
+import type { PerformanceReport, PerformanceStats } from '@/lib/types'
+import { Button } from '@/components/ui/Button'
+import { useThemeStore } from '@/stores'
+import { buildUsageChartTooltipStyle, getUsageChartTheme } from '@/utils/usage/chartConfig'
+import { AnalyticsModelPicker } from './AnalyticsModelPicker'
+import { analyticsModeSelected, analyticsModelColor, rankAnalyticsModels, selectedAnalyticsModels, type AnalyticsModel, type ModelSelection } from './analyticsModels'
+import styles from './WeeklyQuotaValuePanel.module.scss'
+
+export function PerformancePanel({ authIndex, readOnlyAccountId, onAuthRequired }: { authIndex: string; readOnlyAccountId?: string; onAuthRequired?: () => void }) {
+  const { t, i18n } = useTranslation()
+  const isDark = useThemeStore(state => state.resolvedTheme) === 'dark'
+  const [days, setDays] = useState('7')
+  const [metric, setMetric] = useState('tps')
+  const [mode, setMode] = useState('captured')
+  const [context, setContext] = useState('')
+  const [output, setOutput] = useState('')
+  const [effort, setEffort] = useState('')
+  const accountKey = JSON.stringify([authIndex, readOnlyAccountId])
+  const catalogKey = JSON.stringify([accountKey, days])
+  const [selectionState, setSelectionState] = useState<{ account: string; value: ModelSelection }>()
+  const selection = selectionState?.account === accountKey ? selectionState.value : 'top'
+  const [catalog, setCatalog] = useState<{ key: string; models: AnalyticsModel[]; efforts: string[] }>()
+  const discovering = catalog?.key !== catalogKey
+  const models = discovering ? [] : catalog!.models
+  const selectedModels = selectedAnalyticsModels(selection, models)
+  const requestModels = discovering || selection === 'all' ? [] : selectedModels
+  const noSelection = !discovering && models.length > 0 && !selectedModels.length
+  const [basis, setBasis] = useState<'raw' | 'matched'>('raw')
+  const [tail, setTail] = useState(false)
+  const [revision, setRevision] = useState(0)
+  const [result, setResult] = useState<{ key: string; report?: PerformanceReport; error?: boolean }>()
+  const requestKey = JSON.stringify([accountKey, days, metric, mode, context, output, effort, requestModels, discovering, revision])
+  const loading = !noSelection && result?.key !== requestKey
+  const report = loading || noSelection ? undefined : result?.report
+  useEffect(() => {
+    if (noSelection) return
+    const controller = new AbortController()
+    // Discover request totals without workload filters before asking the server to
+    // match the selected models. Merely hiding lines would leave the wrong mix.
+    const query = discovering
+      ? { readOnlyAccountId, days, metric: 'latency', mode: '', context: '', output: '', effort: '', models: [] }
+      : { readOnlyAccountId, days, metric, mode: mode === 'captured' ? '' : mode, context, output, effort, models: requestModels }
+    fetchAccountPerformance(authIndex, query, controller.signal)
+      .then(report => {
+        if (controller.signal.aborted) return
+        if (discovering) setCatalog({ key: catalogKey, models: rankAnalyticsModels(report.groups, report.models), efforts: report.efforts })
+        setResult({ key: requestKey, report })
+      })
+      .catch((error: unknown) => {
+        if (controller.signal.aborted) return
+        if (error instanceof ApiError && error.status === 401) onAuthRequired?.()
+        setResult({ key: requestKey, error: true })
+      })
+    return () => controller.abort()
+    // requestKey contains every query dimension, including the resolved model list.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [requestKey, noSelection, onAuthRequired])
+  const speed = metric === 'tps' || metric === 'phase'
+  const unit = speed ? 'tokens/s' : 's'
+  const format = (value: number | null | undefined) => value == null ? '—' : `${new Intl.NumberFormat(i18n.language, { maximumFractionDigits: 2 }).format(value)} ${unit}`
+  const modeName = (value: string) => value === 'fast' ? t('weekly_quota.fast', 'Fast requested') : value === 'normal' ? t('weekly_quota.normal', 'Normal') : t('weekly_quota.unknown', 'Mode not captured')
+  const groups = (report?.groups ?? []).filter(group => selectedModels.includes(group.model) && analyticsModeSelected(group.mode, mode))
+    .sort((a, b) => selectedModels.indexOf(a.model) - selectedModels.indexOf(b.model) || a.mode.localeCompare(b.mode))
+  const statValue = (stats: PerformanceStats) => tail ? speed ? stats.p10 : stats.p90 : stats.median
+  const chartGroups = groups.filter(group => group.days.some(point => statValue(point[basis]) != null))
+  const dates = groups[0]?.days.map(point => point.day) ?? []
+  const data: ChartData<'line', Array<number | null>, string> = {
+    labels: dates.map(day => new Date(`${day}T00:00:00Z`).toLocaleDateString(i18n.language, { month: 'short', day: 'numeric', timeZone: 'UTC' })),
+    datasets: chartGroups.map(group => {
+      const color = analyticsModelColor(group.model, models)
+      return { label: `${group.model} · ${modeName(group.mode)}`, data: group.days.map(point => statValue(point[basis])), borderColor: color, backgroundColor: color, borderDash: group.mode === 'fast' ? [7, 3] : group.mode === 'unknown' ? [2, 4] : [], borderWidth: 2, pointRadius: 3, spanGaps: false, tension: 0 }
+    }),
+  }
+  const theme = getUsageChartTheme(isDark)
+  const chartOptions: ChartOptions<'line'> = {
+    responsive: true, maintainAspectRatio: false, animation: false,
+    interaction: { mode: 'nearest', intersect: false },
+    plugins: { legend: { position: 'bottom', labels: { color: theme.textSecondary, boxWidth: 20, boxHeight: 2 } }, tooltip: { ...buildUsageChartTooltipStyle(theme), callbacks: {
+      label: item => `${item.dataset.label}: ${format(item.parsed.y)}`,
+      afterLabel: item => `${chartGroups[item.datasetIndex]?.days[item.dataIndex]?.[basis].samples ?? 0} ${t('performance.samples', 'timed requests')}`,
+    } } },
+    scales: { x: { ticks: { color: theme.textSecondary, maxTicksLimit: 8 }, grid: { display: false } }, y: { beginAtZero: true, title: { display: true, text: unit, color: theme.textSecondary }, ticks: { color: theme.textSecondary }, grid: { color: theme.grid } } },
+  }
+  const select = (label: string, value: string, change: (value: string) => void, values: Array<[string, string]>) => <label>{label}<select aria-label={label} value={value} onChange={event => change(event.target.value)}>{values.map(([key, name]) => <option key={key} value={key}>{name}</option>)}</select></label>
+  const all = t('performance.all', 'All')
+  return <div className={`${styles.panel} ${styles.trends}`} data-account-performance="true">
+    <div className={styles.toolbar}><h3>{t('analytics.response_speed', 'Response speed')}</h3><Button variant="secondary" size="sm" disabled={loading} onClick={() => setRevision(value => value + 1)}>{t('common.refresh', 'Refresh')}</Button></div>
+    <p className={styles.note}>{t('analytics.performance_intro', 'Compare how quickly models finish your recorded requests. Start with your two most-used models, then narrow the workload for a fairer comparison.')}</p>
+    <div className={styles.filters}>
+    {!discovering && <AnalyticsModelPicker models={models} selection={selection} onChange={value => setSelectionState({ account: accountKey, value })} />}
+      {select(t('performance.period', 'Period'), days, setDays, [['7', '7 days'], ['14', '14 days'], ['30', '30 days'], ['90', '90 days']])}
+      {select(t('analytics.speed_measure', 'Response speed over time'), metric, setMetric, [['tps', t('analytics.total_tps', 'Total request time — tokens/s')], ['phase', t('analytics.phase_tps', 'Streaming phase — tokens/s (approx.)')], ['ttft', t('performance.ttft', 'First token (recorded)')], ['latency', t('performance.completion', 'Time to completion')]])}
+      {select(t('weekly_trends.mode', 'Mode'), mode, setMode, [['captured', t('analytics.captured', 'Normal + Fast')], ['', t('analytics.all_modes', 'All, including uncaptured')], ['normal', modeName('normal')], ['fast', modeName('fast')], ['unknown', modeName('unknown')]])}
+    </div>
+    <details className={styles.method}><summary>{t('analytics.workload_filters', 'Refine workload')}</summary><div className={styles.filters}>
+      {select(t('performance.context', 'Input size'), context, setContext, [['', all], ['small', '< 8k tokens'], ['medium', '8k–32k tokens'], ['large', '32k–128k tokens'], ['huge', '128k+ tokens']])}
+      {select(t('performance.output', 'Total output size'), output, setOutput, [['', all], ['short', '< 256 tokens'], ['medium', '256–1,024 tokens'], ['long', '1,024–4,096 tokens'], ['huge', '4,096+ tokens']])}
+      {select(t('performance.effort', 'Reasoning effort'), effort, setEffort, [['', all], ...(discovering ? [] : catalog!.efforts).map(value => [value, value] as [string, string])])}
+    </div></details>
+    {noSelection && <p role="status" className={styles.empty}>{t('analytics.choose', 'Select a model to show its data, or restore Top 2.')}</p>}
+    {loading && <p role="status" className={styles.empty}>{t('common.loading', 'Loading…')}</p>}
+    {!loading && result?.error && !noSelection && <p role="alert" className={styles.empty}>{t('performance.error', 'Unable to load performance. Use Refresh to retry.')}</p>}
+    {report && <>
+      <section className={styles.card} aria-label={t('analytics.response_speed_chart', 'Response speed over time')}>
+        <div className={styles.sectionHeading}><h4>{t('analytics.response_speed_chart', 'Response speed over time')}</h4><span className={styles.meta}>{speed ? t('analytics.higher', 'Higher is faster') : t('analytics.lower', 'Lower is faster')} · UTC</span></div>
+        <div className={styles.filters}>
+          {select(t('performance.basis', 'Comparison'), basis, value => setBasis(value as 'raw' | 'matched'), [['raw', t('performance.raw', 'Actual workload')], ['matched', t('performance.matched', 'Same workload mix')]])}
+          {select(t('performance.percentile', 'Percentile'), tail ? 'tail' : 'median', value => setTail(value === 'tail'), [['median', t('performance.typical', 'Typical — median')], ['tail', speed ? 'Slow tail — p10' : 'Slow tail — p90']])}
+        </div>
+        <div className={styles.modeKey}><span><i />Normal</span><span><i className={styles.fast} />Fast requested</span>{(mode === '' || mode === 'unknown') && <span><i className={styles.unknown} />Mode not captured</span>}</div>
+        {data.datasets.length ? <div className={styles.chart}><Chart type="line" data={data} options={chartOptions} role="img" aria-label={t('analytics.response_speed_chart', 'Response speed over time')} /></div> : <p role="status" className={styles.empty}>{t('performance.no_chart', 'Not enough supported daily samples for this comparison. Try Actual workload or a longer period.')}</p>}
+        <p className={styles.note}>{t('analytics.performance_chart_note', 'Colors identify models; line styles identify modes. Missing daily samples stay gaps. Select fewer models if the comparison has insufficient overlap.')}</p>
+      </section>
+      <div className={styles.sectionHeading}><h4>{t('analytics.comparison_table', 'Model comparison')}</h4><span className={styles.meta}>{t('analytics.median_tail', 'Median / slow tail')} ({speed ? 'p10' : 'p90'})</span></div>
+      <div className={styles.scroll}><table><thead><tr><th>{t('performance.group', 'Model / mode')}</th><th>{t('performance.raw', 'Actual workload')}</th><th>{t('performance.matched', 'Same workload mix')}</th><th>{t('performance.coverage', 'Matched coverage')}</th></tr></thead><tbody>{groups.map(group => <tr key={JSON.stringify([group.model, group.mode])}>
+        <td><strong><span className={styles.swatch} style={{ backgroundColor: analyticsModelColor(group.model, models) }} /> {group.model}</strong><small>{modeName(group.mode)}</small><small>{group.requests} {t('weekly_quota.requests', 'requests')} · {group.failed} {t('performance.failed', 'failed')}</small></td>
+        <td><strong>{format(group.raw.median)}</strong><small>{speed ? 'p10' : 'p90'}: {format(speed ? group.raw.p10 : group.raw.p90)}</small><small>{group.raw.samples} {t('performance.samples', 'timed requests')}</small></td>
+        <td><strong>{group.matched.median == null ? t('performance.insufficient', 'Insufficient overlap') : format(group.matched.median)}</strong>{group.matched.median != null && <small>{speed ? 'p10' : 'p90'}: {format(speed ? group.matched.p10 : group.matched.p90)}</small>}</td>
+        <td><strong>{new Intl.NumberFormat(i18n.language, { style: 'percent', maximumFractionDigits: 1 }).format(group.coverage)}</strong><small>{group.matched.samples} / {group.raw.samples}</small></td>
+      </tr>)}</tbody></table></div>
+      {!groups.length && <p role="status" className={styles.empty}>{t('performance.empty', 'No recorded requests match these filters.')}</p>}
+      <p className={styles.meta}>{report.comparison_groups} {t('performance.compared_groups', 'model/mode groups compared')} · {report.common_cells} {t('performance.common_cells', 'common workload buckets')}</p>
+      <p className={styles.note}>{t('analytics.timing_limit', 'Proxy timings include reasoning and exclude client network delays and external tool execution. First token is not necessarily first visible text.')}</p>
+      <details className={styles.method}><summary>{t('analytics.performance_method', 'How matching and timing work')}</summary>
+        <p className={styles.note}>{t('performance.match_note', 'Matching uses common input/output size buckets, cache share (<50%, 50–90%, 90%+), exact recorded reasoning effort, streaming status and executor/transport. Each eligible model/mode contributes equally to one fixed reference workload mix for this report. Weighted request distributions produce the matched percentiles; unshared workloads are excluded. Unknown recorded fields match only unknown fields, so task difficulty and unrecorded differences can still affect comparisons.')}</p>
+        <p className={styles.note}>{t('performance.floors', 'Matched comparisons need at least 2 groups, 20 valid timings per group and 5 per common bucket. Groups below the floor or with uncaptured mode retain raw results only. These floors do not establish statistical confidence.')}</p>
+        <p className={styles.note}>{speed ? t('performance.speed_direction', 'Higher is faster. Slow tail uses p10: 10% of timed requests are this slow or slower.') : t('performance.time_direction', 'Lower is faster. Slow tail uses p90: 10% of timed requests take this long or longer.')}</p>
+        <p className={styles.note}>{t('performance.daily_note', 'Daily UTC buckets; today and the first day may be partial. Raw points need 3 valid timings. Matched points require 20 timings and 3 in every reference bucket; missing buckets stay gaps and never change the reference mix. The fixed mix describes the selected reporting period, not a forecast.')}</p>
+        <p className={styles.note}>{t('performance.timing_note', 'First token is the existing recorded timing and may be reasoning, tool arguments or a fallback event; first visible text is not separately recorded. Output tokens include reasoning. End-to-end TPS includes startup and reasoning time. Phase TPS approximates output divided by (completion time − first-token time), only for streaming requests with at least 32 output tokens and 250 ms after first token; it is not measured visible-text decode speed. Failed requests are counted separately and excluded from timing comparisons.')}</p>
+        <p className={styles.meta}>{new Date(report.range_start).toLocaleString(i18n.language)} – {new Date(report.generated_at).toLocaleString(i18n.language)}</p>
+      </details>
+    </>}
+  </div>
+}
