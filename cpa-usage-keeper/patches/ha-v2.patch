+}
+
+func (r *maintainedRunner) Run(ctx context.Context) error {
+	r.started <- ctx
+	<-ctx.Done()
+	close(r.done)
+	return nil
+}
+
+type maintainedQuotaContext struct{ context.Context }
+
+func (q *maintainedQuotaContext) SetRefreshContext(ctx context.Context)  { q.Context = ctx }
+func (q *maintainedQuotaContext) StopRefreshTasks()                      {}
+func (q *maintainedQuotaContext) WaitRefreshTasks()                      {}
+func (q *maintainedQuotaContext) StartAutoRefresh(context.Context) error { return nil }
+func TestMaintainedReadyRunnersFollowLifecycle(t *testing.T) {
+	makeRunner := func() *maintainedRunner { return &maintainedRunner{make(chan context.Context, 1), make(chan struct{})} }
+	rank, local, traffic := makeRunner(), makeRunner(), makeRunner()
+	quota := &maintainedQuotaContext{}
+	a := &App{QuotaService: quota}
+	a.installReadyApp(&App{Ranking: rank, LocalRanking: local, QuotaTrafficSync: traffic, QuotaService: quota})
+	ctx := a.startBackgroundContext(context.Background())
+	a.startRankingBackgroundTasks(ctx)
+	a.startQuotaBackgroundTasks(ctx)
+	for _, r := range []*maintainedRunner{rank, local, traffic} {
+		select {
+		case got := <-r.started:
+			if got != ctx {
+				t.Fatal("incorrect runner context")
+			}
+		case <-time.After(time.Second):
+			t.Fatal("runner did not start")
+		}
+	}
+	if quota.Context != ctx {
+		t.Fatal("traffic started without quota runtime context")
+	}
+	a.stopBackgroundTasks()
+	for _, r := range []*maintainedRunner{rank, local, traffic} {
+		select {
+		case <-r.done:
+		default:
+			t.Fatal("shutdown did not wait for runner")
+		}
+	}
+}
