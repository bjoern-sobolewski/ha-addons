+.panel { padding: 20px 22px; }
+.panel, .trends { display: flex; flex-direction: column; gap: 18px; min-width: 0; color: var(--text-primary); h3, h4, p { margin: 0; } }
+
+.toolbar, .sectionHeading { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
+.toolbar h3 { font-size: 19px; font-weight: 750; }
+.sectionHeading { font-size: 13px; font-weight: 650; small { color: var(--text-secondary); margin-left: 6px; font-weight: 400; } }
+.note { font-size: 12px; line-height: 1.6; color: var(--text-secondary); }
+.meta { font-size: 11px; color: var(--text-secondary); }
+.card { border: 1px solid var(--border-color); border-radius: 12px; background: var(--bg-primary); padding: 18px; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
+.views, .pickerActions { display: flex; gap: 4px; flex-wrap: wrap; button { font: inherit; font-size: 12px; border: 1px solid transparent; color: var(--text-secondary); background: transparent; border-radius: 7px; padding: 7px 10px; cursor: pointer; &[aria-pressed='true'] { background: var(--bg-secondary); color: var(--text-primary); border-color: var(--border-color); } &:focus-visible { outline: 2px solid var(--text-primary); outline-offset: 2px; } } }
+.views { padding-bottom: 8px; border-bottom: 1px solid var(--border-color); button { font-size: 13px; padding: 8px 14px; } }
+.filters { display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: flex-end; }
+.filters label, .metric { display: flex; flex-direction: column; gap: 6px; font-size: 12px; color: var(--text-secondary); }
+.panel select { max-width: 100%; padding: 8px 10px; min-height: 36px; border: 1px solid var(--border-color); border-radius: 7px; background: var(--bg-secondary); color: var(--text-primary); font: inherit; font-size: 13px; }
+.scroll { max-width: 100%; overflow-x: auto; border: 1px solid var(--border-color); border-radius: 10px;
+  table { width: 100%; border-collapse: collapse; text-align: left; font-size: 13px; }
+  th, td { padding: 12px 14px; vertical-align: top; border-bottom: 1px solid var(--border-color); min-width: 112px; }
+  th { font-size: 11px; font-weight: 650; color: var(--text-secondary); background: var(--bg-secondary); }
+  small { display: block; margin-top: 4px; font-size: 11px; line-height: 1.5; color: var(--text-secondary); }
+  strong { font-variant-numeric: tabular-nums; font-weight: 650; }
+  tr:last-child td { border-bottom: 0; }
+  tr[data-current='true'] { background: color-mix(in srgb, var(--success-color, #10b981) 5%, var(--bg-primary)); }
+}
+.cyclesTable { th:first-child, td:first-child { min-width: 150px; } th:last-child, td:last-child { min-width: 140px; } }
+.cycleRate { font-size: 15px; }
+.badge { display: inline-block; font-size: 10px; line-height: 1.6; padding: 2px 7px; margin-top: 5px; border-radius: 5px; color: var(--text-secondary); background: var(--bg-secondary); border: 1px solid var(--border-color); }
+.quotaBar { height: 4px; margin-top: 7px; max-width: 90px; border-radius: 4px; background: var(--bg-secondary); overflow: hidden; span { display: block; height: 100%; background: var(--success-color, #10b981); } }
+.method { border-top: 1px solid var(--border-color); padding-top: 12px; summary { font-size: 12px; color: var(--text-secondary); cursor: pointer; } p { margin-top: 10px; } }
+.coverage { font-size: 11px; summary { cursor: pointer; color: var(--text-secondary); } }
+.chart { height: 290px; min-width: 0; width: 100%; position: relative; }
+.modeKey { display: flex; flex-wrap: wrap; gap: 14px; font-size: 11px; color: var(--text-secondary); span { display: inline-flex; gap: 6px; align-items: center; } i { width: 22px; border-top: 2px solid currentColor; } .fast { border-top-style: dashed; } .unknown { border-top-style: dotted; } }
+.modelPicker { display: flex; flex-direction: column; gap: 10px; }
+.modelChips { display: flex; gap: 7px; flex-wrap: wrap; }
+.modelChip { display: inline-flex; gap: 6px; align-items: center; cursor: pointer; padding: 6px 9px; border: 1px solid var(--border-color); border-radius: 7px; font-size: 11px; color: var(--text-secondary); &[data-selected='true'] { background: var(--bg-secondary); color: var(--text-primary); } input { width: 13px; height: 13px; margin: 0; accent-color: var(--text-primary); } small { color: var(--text-secondary); font-size: 10px; } }
+.swatch { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
+.moreModels { summary { cursor: pointer; color: var(--text-secondary); font-size: 12px; } .modelChips { margin-top: 10px; } }
+.empty { padding: 18px; border: 1px dashed var(--border-color); border-radius: 8px; color: var(--text-secondary); font-size: 13px; line-height: 1.6; }
