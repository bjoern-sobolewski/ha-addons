+		request := quota.CodexQuotaHistoryRequest{AuthIndex: authIndex, WeeklyOnly: c.Query("weekly_only") == "true", RemainingDays: days}
 		if rawRole, ok := c.GetQuery("window_role"); ok {
 			role := strings.TrimSpace(rawRole)
 			request.WindowRole = &role
@@ -361,3 +366,17 @@ func writeQuotaResetError(c *gin.Context, statusCode int, err error) {
 	}
 	c.JSON(statusCode, payload)
 }
+
+// remainingHistoryDays is shared by admin and scoped read-only account reports.
+func remainingHistoryDays(c *gin.Context) (int, bool) {
+	raw, present := c.GetQuery("remaining_days")
+	if !present {
+		return 0, true
+	}
+	days, err := strconv.Atoi(raw)
+	if err != nil || (days != 1 && days != 7 && days != 30) {
+		c.JSON(http.StatusBadRequest, gin.H{"error": "remaining_days must be 1, 7 or 30"})
+		return 0, false
+	}
+	return days, true
+}
diff --git a/internal/api/read_only.go b/internal/api/read_only.go
