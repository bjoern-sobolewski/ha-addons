+// @vitest-environment happy-dom
+import { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, expect, test, vi } from 'vitest';
+import { QuotaFreshness } from '../QuotaFreshness';
+import { quotaAgeLabel } from '@/lib/quotaAgeClock';
+
+afterEach(()=>{vi.useRealTimers();vi.restoreAllMocks();});
+test('age counts up locally across multiple quota windows and releases its shared timer on unmount',async()=>{
+ globalThis.IS_REACT_ACT_ENVIRONMENT=true;
+ vi.useFakeTimers();vi.setSystemTime(new Date('2026-10-05T10:00:00Z'));
+ const hidden=vi.spyOn(document,'hidden','get').mockReturnValue(false);
+ const container=document.createElement('div');document.body.appendChild(container);const root=createRoot(container);
+ await act(async()=>root.render(<><QuotaFreshness account="fixture" capturedAt="2026-10-05T09:59:50Z" source="websocket_event"/><QuotaFreshness account="fixture2" capturedAt="2026-10-05T09:59:00Z"/></>));
+ expect(container.textContent).toContain('10s ago');expect(container.textContent).toContain('1m 0s ago');expect(vi.getTimerCount()).toBe(1);
+ await act(async()=>vi.advanceTimersByTime(3000));expect(container.textContent).toContain('13s ago');expect(container.textContent).toContain('1m 3s ago');
+ hidden.mockReturnValue(true);await act(async()=>vi.advanceTimersByTime(5000));expect(container.textContent).toContain('13s ago');
+ hidden.mockReturnValue(false);await act(async()=>document.dispatchEvent(new Event('visibilitychange')));expect(container.textContent).toContain('18s ago');
+ await act(async()=>root.unmount());container.remove();expect(vi.getTimerCount()).toBe(0);
+});
+test('age handles unknown and future timestamps without creating a fresh capture',()=>{
+ const now=Date.parse('2026-10-05T10:00:00Z');
+ expect(quotaAgeLabel(undefined,now)).toBe('Unknown age');expect(quotaAgeLabel('invalid',now)).toBe('Unknown age');
+ expect(quotaAgeLabel('2026-10-05T10:01:00Z',now)).toBe('0s ago');
+});
