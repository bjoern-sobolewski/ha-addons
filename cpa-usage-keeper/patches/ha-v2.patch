+// A maintained v1 database can have two physical rollup rows with identical
+// upstream dimensions except the captured outgoing tier. Both M2 fact checks
+// and M6 cost checks must use that extra dimension rather than merging them.
+func TestLegacyPricingUpgradePreservesOutgoingTierGroupsAcrossHotAndArchive(t *testing.T) {
+	fixture := openPublishedPricingEventFixture(t)
+	for _, table := range []string{"usage_events", "usage_events_archive", "usage_overview_hourly_stats", "usage_overview_daily_stats"} {
+		if err := fixture.writer.Exec("ALTER TABLE " + table + " ADD COLUMN upstream_service_tier TEXT NOT NULL DEFAULT ''").Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	statements := []string{
+		"UPDATE usage_events SET upstream_service_tier = 'default' WHERE id = 1",
+		"DELETE FROM usage_events WHERE id = 3",
+		`INSERT INTO usage_events (id,event_key,api_group_key,model,auth_index,timestamp,input_tokens,output_tokens,cache_read_tokens,cache_creation_tokens,total_tokens,failed,upstream_service_tier) SELECT 3,'hot-priority',api_group_key,model,auth_index,timestamp,input_tokens,output_tokens,cache_read_tokens,cache_creation_tokens,total_tokens,failed,'priority' FROM usage_events WHERE id = 1`,
+		"UPDATE usage_events_archive SET upstream_service_tier = 'priority', auth_index = 'hot-a', timestamp = '2026-09-01T10:02:00Z' WHERE id = 2",
+		"UPDATE usage_aggregation_checkpoints SET last_aggregated_usage_event_id = 3 WHERE name = 'overview'",
+		"INSERT INTO model_price_rules (model_price_setting_id,key,value,multiplier) VALUES (1,'upstream_service_tier','priority',2)",
+	}
+	for _, table := range []string{"usage_overview_hourly_stats", "usage_overview_daily_stats"} {
+		statements = append(statements,
+			"UPDATE "+table+" SET upstream_service_tier = 'default' WHERE id = 1",
+			"INSERT INTO "+table+" (id,bucket_start,api_group_key,model,auth_index,model_alias,service_tier,response_service_tier,reasoning_effort,endpoint,executor_type,request_count,success_count,failure_count,input_tokens,output_tokens,reasoning_tokens,cached_tokens,cache_read_tokens,cache_creation_tokens,total_tokens,upstream_service_tier) SELECT 2,bucket_start,api_group_key,model,auth_index,model_alias,service_tier,response_service_tier,reasoning_effort,endpoint,executor_type,2,2,0,150,30,0,0,10,5,180,'priority' FROM "+table+" WHERE id = 1")
+	}
+	for _, statement := range statements {
+		if err := fixture.writer.Exec(statement).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	alignPublishedPricingOverviewBuckets(t, fixture)
+	ctx := context.Background()
+	baseline, err := repository.MigrateLegacyPricingEvents(ctx, fixture.writer, fixture.reader, fixture.backupDir, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := repository.CompleteLegacyPricingData(ctx, fixture.writer, fixture.reader, baseline); err != nil {
+		t.Fatal(err)
+	}
+	var normal, priority, archived struct {
+		CostUSD       float64
+		CostAvailable bool
+	}
+	if err := fixture.reader.Table("usage_events").Select("cost_usd,cost_available").Where("id=1").Take(&normal).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := fixture.reader.Table("usage_events").Select("cost_usd,cost_available").Where("id=3").Take(&priority).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := fixture.reader.Table("usage_events_archive").Select("cost_usd,cost_available").Where("id=2").Take(&archived).Error; err != nil {
+		t.Fatal(err)
+	}
+	if !normal.CostAvailable || !priority.CostAvailable || !archived.CostAvailable || math.Abs(priority.CostUSD-2*normal.CostUSD) > 1e-12 {
+		t.Fatalf("outgoing rule backfill lost: normal=%+v priority=%+v archive=%+v", normal, priority, archived)
+	}
+	for _, table := range []string{"usage_overview_hourly_stats", "usage_overview_daily_stats"} {
+		var rows []struct {
+			UpstreamServiceTier string
+			RequestCount        int64
+			CostUSD             float64
+		}
+		if err := fixture.reader.Table(table).Order("upstream_service_tier").Find(&rows).Error; err != nil {
+			t.Fatal(err)
+		}
+		if len(rows) != 2 || rows[0].UpstreamServiceTier != "default" || rows[0].RequestCount != 1 || math.Abs(rows[0].CostUSD-normal.CostUSD) > 1e-12 || rows[1].UpstreamServiceTier != "priority" || rows[1].RequestCount != 2 || math.Abs(rows[1].CostUSD-priority.CostUSD-archived.CostUSD) > 1e-12 {
+			t.Fatalf("%s outgoing buckets lost: %+v", table, rows)
+		}
+	}
+	// Equal total dollars cannot conceal a transfer between distinct tier buckets.
+	if err := fixture.writer.Exec("UPDATE usage_overview_daily_stats SET cost_usd = cost_usd + CASE WHEN upstream_service_tier = 'default' THEN 0.01 ELSE -0.01 END").Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := repository.VerifyLegacyPricingData(ctx, fixture.reader, baseline); err == nil {
+		t.Fatal("cross-tier fee corruption passed verification")
+	}
+}
