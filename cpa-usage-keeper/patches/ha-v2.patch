@@ -0,0 +1,14 @@
+// Date preferences follow the browser, independently of the dashboard language.
+export function weeklyDateLocale(): string[] | undefined {
+  if (typeof navigator === 'undefined') return undefined
+  return navigator.languages?.length ? [...navigator.languages] : navigator.language ? [navigator.language] : undefined
+}
+
+export function formatWeeklyDateTime(value: string | null | undefined): string {
+  if (!value) return '—'
+  const date = new Date(value)
+  if (!Number.isFinite(date.getTime())) return value
+  return new Intl.DateTimeFormat(weeklyDateLocale(), {
+    year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit',
+  }).format(date)
+}
