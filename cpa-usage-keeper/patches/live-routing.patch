+package cpa
+
+import (
+	"context"
+	"encoding/json"
+)
+
+func (c *Client) RoutingActivity(ctx context.Context) (json.RawMessage, int, error) {
+	var out json.RawMessage
+	status, _, err := c.doManagementJSONRequest(ctx, "/v8/management/routing/activity", &out, "live routing")
+	return out, status, err
+}
