diff --git a/web/src/pages/test/LiveRoutingPage.test.tsx b/web/src/pages/test/LiveRoutingPage.test.tsx
new file mode 100644
index 00000000..2834d543
--- /dev/null
+++ b/web/src/pages/test/LiveRoutingPage.test.tsx
@@ -0,0 +1,34 @@
+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot } from 'react-dom/client'
+import { expect, it, vi } from 'vitest'
+import { apiFetch } from '@/lib/api'
+import { LiveRoutingPage, type RoutingSnapshot } from '../LiveRoutingPage'
+globalThis.IS_REACT_ACT_ENVIRONMENT = true
+const live = vi.hoisted(() => ({ refresh: undefined as undefined | ((signal: AbortSignal) => Promise<unknown>), stop: vi.fn() }))
+vi.mock('@/lib/live', () => ({ startLiveRefresh: (refresh: (signal: AbortSignal) => Promise<unknown>) => { live.refresh = refresh; void refresh(new AbortController().signal); return live.stop }, subscribeLiveStatus: () => () => {}, getLiveStatus: () => 'live' }))
+vi.mock('@/lib/api', () => ({ apiFetch: vi.fn(), apiPath: (value: string) => value }))
+it('distinguishes live work from cached affinity and preserves the last snapshot on failure', async () => {
+ const date = new Date().toISOString()
+ const payload: RoutingSnapshot = { activity: { at: date, since: date, dropped: 0, events: [], rows: [{ id: 'socket-one', kind: 'websocket', session: 'session-one', client: 'client-one', model: 'example-model', account: 'account-one', pool: 'codex', transport: 'websocket', state: 'waiting_tools', reason: 'pinned', priority: 2, active: 0, tools: 1, draining: true, uncertain: false, attempts: 1, started_at: date, updated_at: date, candidates: [{ account: 'account-one', pool: 'codex', priority: 2, websocket: true, status: 'selected' }] }] }, bindings: [{ session: 'cached-only', account: 'account-one', pool: 'codex', source: 'prefix', expires_at: date }], rebalances: [], accounts: { 'account-one': 'Example account' }, clients: { 'client-one': 'Example client' } }
+ vi.mocked(apiFetch).mockResolvedValue({ ok: true, json: async () => payload } as Response)
+ const container = document.createElement('div'); document.body.append(container); const root = createRoot(container)
+ try {
+  await act(async () => root.render(<LiveRoutingPage />))
+  expect(container.textContent).toContain('Waiting for tool output')
+  expect(container.textContent).toContain('Example client')
+  expect(container.textContent).not.toContain('Session cached-o')
+  const button = [...container.querySelectorAll('button')].find(b => b.textContent === 'Session session-')!
+  await act(async () => button.click())
+  expect(container.textContent).toContain('Connection pinned')
+  expect(container.textContent).toContain('waiting for tool output')
+  expect(container.textContent).toContain('Accounts at selection')
+  vi.mocked(apiFetch).mockRejectedValue(new Error('Connection lost'))
+  await act(async () => live.refresh!(new AbortController().signal))
+  expect(container.querySelector('[role="alert"]')?.textContent).toContain('Last successful snapshot')
+  expect(container.textContent).toContain('Example account')
+  await act(async () => [...container.querySelectorAll('button')].find(b => b.textContent === 'Pause')!.click())
+  expect(live.stop).toHaveBeenCalled()
+  expect(container.textContent).toContain('Paused')
+ } finally { await act(async () => root.unmount()); container.remove() }
+})
