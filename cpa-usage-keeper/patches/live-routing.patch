+    <div className={styles.filters}><input aria-label="Search live traffic" placeholder="Search session, model, account or client…" value={query} onChange={event => setQuery(event.target.value)} /><select aria-label="Provider pool" value={pool} onChange={event => setPool(event.target.value)}><option value="">All pools</option>{pools.map(value => <option key={value}>{value}</option>)}</select><select aria-label="Traffic state" value={state} onChange={event => setState(event.target.value)}><option value="">All states</option>{['running', 'waiting_tools', 'idle', 'draining', 'selecting', 'protocol_wait'].map(value => <option key={value} value={value}>{value === 'draining' ? 'Draining' : routingLabel(value)}</option>)}</select></div>
