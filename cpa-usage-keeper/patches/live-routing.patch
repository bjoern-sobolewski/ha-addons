--- /dev/null
+++ b/internal/api/routing_activity.go
@@ -0,0 +1,32 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"time"
+)
+
+type routingActivityReader interface {
+	RoutingActivity(context.Context) (json.RawMessage, int, error)
+}
+
+func registerRoutingActivityRoutes(router gin.IRoutes, provider QuotaPolicyProvider) {
+	router.GET("/routing/activity", func(c *gin.Context) {
+		p, ok := provider.(routingActivityReader)
+		if !ok {
+			c.JSON(503, gin.H{"error": "Live routing unavailable"})
+			return
+		}
+		ctx, cancel := context.WithTimeout(c.Request.Context(), 5*time.Second)
+		defer cancel()
+		body, status, err := p.RoutingActivity(ctx)
+		if err != nil || status != http.StatusOK || !json.Valid(body) {
+			c.JSON(502, gin.H{"error": "Live routing unavailable"})
+			return
+		}
+		c.Header("Cache-Control", "no-store")
+		c.Data(200, "application/json", body)
+	})
+}
