+  </div>
+  {allocations.length > 0 && <div className={styles.allocations} aria-label="Account distribution">{allocations.map(item => <button type="button" key={item.pool + item.account} onClick={() => { setQuery(account(item.account)); setPool(item.pool) }}><span>{item.pool}</span><strong>{account(item.account)}</strong><div><b>{item.active}</b> running <em>·</em> {item.count} connections{item.draining > 0 && ' · ' + item.draining + ' draining'}</div><div className={styles.bar}><i style={{ width: Math.max(3, item.active / Math.max(1, active) * 100) + '%' }} /></div></button>)}</div>}
+  <div className={styles.workspace}>
