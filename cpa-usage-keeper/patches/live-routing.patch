+import { useEffect, useMemo, useState, useSyncExternalStore } from 'react'
+import { apiFetch, apiPath } from '@/lib/api'
+import { getLiveStatus, startLiveRefresh, subscribeLiveStatus } from '@/lib/live'
+import styles from './LiveRoutingPage.module.scss'
+
+interface Candidate { account: string; pool: string; priority: number; websocket: boolean; status: string }
+export interface RoutingRow { id: string; kind: string; session?: string; client?: string; model?: string; account?: string; pool?: string; transport: string; state: string; reason?: string; priority: number; active: number; tools: number; draining: boolean; uncertain: boolean; attempts: number; started_at: string; updated_at: string; candidates: Candidate[]; work?: Array<{ id: string; kind: string; state: string; started_at: string }> }
+interface RoutingEvent { id: number; at: string; row: string; account?: string; pool?: string; reason: string }
+interface Binding { session: string; account: string; pool: string; source: string; expires_at: string }
+interface Rebalance { id: number; pool: string; reason: string; reconnect_websockets: boolean; sessions_rebalanced: number; waiting: number; waiting_for_responses: number; waiting_for_tools: number; waiting_for_protocol: number; requested_at: string }
+export interface RoutingSnapshot { activity: { at: string; since: string; rows: RoutingRow[]; events: RoutingEvent[]; dropped: number }; bindings: Binding[]; rebalances: Rebalance[]; accounts: Record<string, string>; clients: Record<string, string> }
+const EMPTY_ROWS: RoutingRow[] = []
+const labels: Record<string, string> = {
+ websocket_preference: 'WebSocket preference, then priority', outside_pin: 'Outside connection pin', http_deprioritized: 'WebSocket preferred', lower_priority: 'Lower priority', scheduler: 'Scheduler selection', pinned: 'Connection pinned', sticky: 'Sticky session', prefix_affinity: 'Matching conversation prefix',
+ compaction_affinity: 'Compaction continuity', parent_affinity: 'Parent session affinity', new_binding: 'New session binding',
+ affinity_failover: 'Temporary affinity failover', affinity_reselected: 'Previous account unavailable',
+ home_scheduler: 'Home scheduler', plugin_scheduler: 'Plugin scheduler', eligible: 'Eligible', selected: 'Selected',
+ disabled: 'Manually disabled', quota_minimum: 'Below quota minimum', model_unsupported: 'Model unavailable',
+ request_policy: 'Request policy excluded', zero_weight: 'Weight is zero', cooldown: 'Account/model blocked', already_tried: 'Already attempted',
+ rebalance_requested: 'Safe rebalance requested', queued: 'Queued', generating: 'Generating', running: 'Running', idle: 'Idle', selecting: 'Selecting account', waiting_tools: 'Waiting for tool output', protocol_wait: 'Protocol state unresolved',
+ reconnecting: 'Reconnecting', completed: 'Request finished', disconnected: 'Connection closed', failed: 'Request failed',
+ priority_saved: 'Priority saved', quota_policy_excluded: 'Quota minimum reached', quota_policy_recovered: 'Account eligibility recovered',
+}
+export function routingLabel(value = ''): string { return value.startsWith('retry_') ? 'Retry · ' + routingLabel(value.slice(6)) : labels[value] ?? value.replaceAll('_', ' ') }
+const short = (value?: string) => value ? value.slice(0, 8) : '—'
+const age = (date: string, now: number) => { const seconds = Math.max(0, Math.floor((now - Date.parse(date)) / 1000)); return seconds < 60 ? seconds + 's' : seconds < 3600 ? Math.floor(seconds / 60) + 'm ' + seconds % 60 + 's' : Math.floor(seconds / 3600) + 'h ' + Math.floor(seconds % 3600 / 60) + 'm' }
+const time = (date: string) => new Date(date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' })
+
+export function LiveRoutingPage() {
+ const [data, setData] = useState<RoutingSnapshot>()
+ const [error, setError] = useState('')
+ const [paused, setPaused] = useState(false)
+ const [revision, setRevision] = useState(0)
+ const [now, setNow] = useState(Date.now())
+ const [selected, setSelected] = useState('')
+ const [query, setQuery] = useState('')
+ const [pool, setPool] = useState('')
+ const [state, setState] = useState('')
+ const [showBindings, setShowBindings] = useState(false)
+ const live = useSyncExternalStore(subscribeLiveStatus, getLiveStatus)
+ useEffect(() => { const tick = setInterval(() => { if (!document.hidden) setNow(Date.now()) }, 1000); return () => clearInterval(tick) }, [])
+ useEffect(() => { const refresh = () => { setPaused(false); setRevision(v => v + 1) }; window.addEventListener('keeper:routing-refresh', refresh); return () => window.removeEventListener('keeper:routing-refresh', refresh) }, [])
+ useEffect(() => {
+  if (paused) return
+  return startLiveRefresh(async signal => {
+   try {
+    const response = await apiFetch(apiPath('/routing/activity'), { signal })
+    if (!response.ok) throw new Error('Live routing is unavailable. Retrying with live updates.')
+    const next = await response.json() as RoutingSnapshot
+    if (!next.activity || !Array.isArray(next.activity.rows)) throw new Error('Live routing returned an unsupported snapshot.')
+    if (!signal.aborted) { setData(next); setError('') }
+   } catch (failure) { if (!signal.aborted) setError(failure instanceof Error ? failure.message : 'Live routing unavailable') }
+  }, ['routing', 'rebalance', 'accounts', 'clock'])
+ }, [paused, revision])
+ const rows = data?.activity.rows ?? EMPTY_ROWS
+ const account = (id?: string) => id ? data?.accounts?.[id] || 'Account ' + short(id) : 'Awaiting selection'
+ const client = (id?: string) => id ? data?.clients?.[id] || 'Client ' + short(id) : 'Unidentified client'
+ const pools = [...new Set([...rows.map(r => r.pool ?? ''), ...(data?.bindings ?? []).map(b => b.pool)].filter(Boolean))].sort()
+ const filtered = rows.filter(r => (!pool || r.pool === pool) && (!state || (state === 'draining' ? r.draining : r.state === state)) && [r.id, r.session, r.model, r.pool, account(r.account), client(r.client)].join(' ').toLowerCase().includes(query.toLowerCase()))
