+    </div> : <div className={styles.empty}><span>⌖</span><h3>{selected ? 'Connection finished' : 'Follow a request'}</h3><p>{selected ? 'Its recent routing events remain below.' : 'Select a session to see its account, routing reason and eligibility snapshot.'}</p></div>}
+   </aside>
+  </div>
+  <div className={styles.lower}>
+   <section className={styles.panel} aria-label="Rebalance activity"><div className={styles.panelHead}><div><h2>Rebalance activity</h2><p>Latest changes and safe drain progress.</p></div></div><div className={styles.jobs}>{balances.length ? balances.map(job => <div key={job.id} className={styles.job}><div><span className={styles.badge} data-state={job.waiting ? 'waiting_tools' : 'idle'}>{job.waiting ? 'Draining' : 'Applied'}</span><time>{time(job.requested_at)}</time></div><strong>{routingLabel(job.reason)} · {job.pool}</strong><p>Affinity cleared{job.reconnect_websockets ? ' · ' + job.sessions_rebalanced + ' rebalanced · ' + job.waiting + ' waiting' : ' · existing sockets retained'}</p>{job.waiting > 0 && <small>{job.waiting_for_responses} response · {job.waiting_for_tools} tool · {job.waiting_for_protocol} protocol waits</small>}</div>) : <div className={styles.quiet}>No recent rebalances. Active drains remain visible until they finish.</div>}</div></section>
+   <section className={styles.panel} aria-label="Routing timeline"><div className={styles.panelHead}><div><h2>Routing timeline</h2><p>{selected ? 'Selected connection' : 'Recent decisions'} · last 10 minutes</p></div></div><ol className={styles.timeline}>{recent.length ? recent.map(event => <li key={event.id}><time>{time(event.at)}</time><div><strong>{routingLabel(event.reason)}</strong><small>{account(event.account)} · {event.pool || 'unassigned'} · <button type="button" onClick={() => setSelected(event.row)}>{short(event.row)}</button></small></div></li>) : <li className={styles.quiet}>No recent routing events.</li>}</ol></section>
+  </div>
+  <section className={styles.panel}><button type="button" className={styles.bindingToggle} aria-expanded={showBindings} onClick={() => setShowBindings(v => !v)}><strong>Cached session affinity</strong><span>{data?.bindings.length ?? 0} bindings · {showBindings ? 'Hide' : 'Show'}</span></button>{showBindings && <><p className={styles.footnote}>A cached binding can outlive its connection. It does not mean a request is running.</p><div className={styles.tableWrap}><table><thead><tr><th>Session</th><th>Account / pool</th><th>Affinity</th><th>Expires</th></tr></thead><tbody>{(data?.bindings ?? []).filter(b => !pool || b.pool === pool).slice(0, 200).map(binding => <tr key={binding.session}><td>{short(binding.session)}</td><td>{account(binding.account)}<small>{binding.pool}</small></td><td>{binding.source === 'prefix' ? 'Conversation prefix' : 'Explicit session'}</td><td>{time(binding.expires_at)}</td></tr>)}</tbody></table></div></>}</section>
+  <p className={styles.footnote}>Local runtime activity since {data ? time(data.activity.since) : '…'} · resets on CPA restart · session and client IDs are opaque references.</p>
+ </section>
+}
