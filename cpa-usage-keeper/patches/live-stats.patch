diff --git a/web/test-helpers/liveStream.ts b/web/test-helpers/liveStream.ts
new file mode 100644
index 00000000..3c549aec
--- /dev/null
+++ b/web/test-helpers/liveStream.ts
@@ -0,0 +1,16 @@
+import { vi } from 'vitest';
+import { apiFetch } from '../src/lib/api';
+export function mockLiveStream() {
+ const streams:ReadableStreamDefaultController<Uint8Array>[]=[];
+ vi.mocked(apiFetch).mockImplementation(async (_url,init)=>{
+  let controller!:ReadableStreamDefaultController<Uint8Array>;
+  const body=new ReadableStream<Uint8Array>({start(value){controller=value;streams.push(value);}});
+  init?.signal?.addEventListener('abort',()=>{try{controller.close();}catch{/* already closed */}});
+  return new Response(body,{headers:{'Content-Type':'text/event-stream'}});
+ });
+ return (topics:string[],fragment=false)=>{
+  const data=new TextEncoder().encode('event: change\r\ndata: '+JSON.stringify({topics})+'\r\n\r\n');
+  const stream=streams.at(-1)!;
+  if(fragment){stream.enqueue(data.slice(0,12));stream.enqueue(data.slice(12));}else stream.enqueue(data);
+ };
+}
