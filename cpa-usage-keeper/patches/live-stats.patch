+import { useEffect, useRef } from 'react';
+import { startLiveRefresh, type LiveTopic } from '@/lib/live';
+export function useLiveRefresh(refresh: () => Promise<unknown>, topics: readonly LiveTopic[], enabled = true) {
+ const current = useRef(refresh);
+ useEffect(() => { current.current = refresh; }, [refresh]);
+ const key = topics.join(',');
+ useEffect(() => { if (!enabled) return; return startLiveRefresh(async () => current.current(), key.split(',') as LiveTopic[], false); }, [enabled, key]);
+}
