diff --git a/internal/live/hub.go b/internal/live/hub.go
new file mode 100644
index 00000000..0eb31591
--- /dev/null
+++ b/internal/live/hub.go
@@ -0,0 +1,72 @@
+// Package live carries bounded, non-blocking invalidations, never account data or credentials.
+package live
+
+import "sync"
+
+type Hub struct {
+	mu          sync.Mutex
+	subscribers map[*Subscription]struct{}
+}
+type Subscription struct {
+	hub    *Hub
+	Group  string
+	Viewer bool
+	Wake   chan struct{}
+	topics map[string]bool
+}
+
+func New() *Hub { return &Hub{subscribers: make(map[*Subscription]struct{})} }
+func (h *Hub) Subscribe(group string, viewer bool) *Subscription {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if len(h.subscribers) >= 256 {
+		return nil
+	}
+	s := &Subscription{hub: h, Group: group, Viewer: viewer, Wake: make(chan struct{}, 1), topics: map[string]bool{}}
+	h.subscribers[s] = struct{}{}
+	return s
+}
+func (s *Subscription) Close() {
+	s.hub.mu.Lock()
+	defer s.hub.mu.Unlock()
+	delete(s.hub.subscribers, s)
+}
+func (s *Subscription) Drain() []string {
+	s.hub.mu.Lock()
+	defer s.hub.mu.Unlock()
+	out := make([]string, 0, len(s.topics))
+	for topic := range s.topics {
+		out = append(out, topic)
+	}
+	s.topics = map[string]bool{}
+	return out
+}
+func (h *Hub) Publish(topic string, groups ...string) {
+	if h == nil {
+		return
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	for s := range h.subscribers {
+		if s.Viewer && topic != "usage" && topic != "quota" {
+			continue
+		}
+		if s.Viewer && topic == "usage" && len(groups) > 0 {
+			match := false
+			for _, group := range groups {
+				if group == s.Group {
+					match = true
+					break
+				}
+			}
+			if !match {
+				continue
+			}
+		}
+		s.topics[topic] = true
+		select {
+		case s.Wake <- struct{}{}:
+		default:
+		}
+	}
+}
diff --git a/internal/live/hub_test.go b/internal/live/hub_test.go
