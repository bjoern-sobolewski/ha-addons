index 00000000..e8330cc8
--- /dev/null
+++ b/internal/cpa/live.go
@@ -0,0 +1,53 @@
+package cpa
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// WatchLive reads only CPA's local state stream. It never contacts a provider.
+func (c *Client) WatchLive(ctx context.Context, changed func([]string)) error {
+	streamCtx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	request, err := http.NewRequestWithContext(streamCtx, http.MethodGet, c.baseURL+"/v8/management/live", nil)
+	if err != nil {
+		return err
+	}
+	request.Header.Set("Authorization", "Bearer "+c.managementKey)
+	request.Header.Set("Accept", "text/event-stream")
+	client := &http.Client{Transport: c.httpClient.Transport}
+	idle := time.AfterFunc(45*time.Second, cancel)
+	defer idle.Stop()
+	response, err := client.Do(request)
+	if err != nil {
+		return fmt.Errorf("CPA live connection unavailable")
+	}
+	defer response.Body.Close()
+	if response.StatusCode != 200 || !strings.Contains(response.Header.Get("Content-Type"), "text/event-stream") {
+		return fmt.Errorf("CPA live status %d", response.StatusCode)
+	}
+	scanner := bufio.NewScanner(response.Body)
+	scanner.Buffer(make([]byte, 4096), 65536)
+	for scanner.Scan() {
+		idle.Reset(45 * time.Second)
+		line := scanner.Text()
+		if !strings.HasPrefix(line, "data:") {
+			continue
+		}
+		var event struct {
+			Topics []string `json:"topics"`
+		}
+		if json.Unmarshal([]byte(strings.TrimSpace(line[5:])), &event) == nil {
+			changed(event.Topics)
+		}
+	}
+	if err := scanner.Err(); err != nil {
+		return err
+	}
+	return fmt.Errorf("CPA live connection ended")
+}
