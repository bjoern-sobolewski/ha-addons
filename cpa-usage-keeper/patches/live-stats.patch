new file mode 100644
index 00000000..70483f7f
--- /dev/null
+++ b/web/src/lib/live.ts
@@ -0,0 +1,86 @@
+import { apiFetch, apiPath } from './api';
+
+export type LiveTopic = 'sync' | 'usage' | 'quota' | 'accounts' | 'clock';
+export type LiveStatus = 'connecting' | 'live' | 'reconnecting' | 'paused';
+type Listener = (topics: LiveTopic[]) => void;
+const listeners = new Set<Listener>();
+const statusListeners = new Set<() => void>();
+let status: LiveStatus = 'connecting';
+let controller: AbortController | undefined;
+let retry: ReturnType<typeof setTimeout> | undefined;
+let generation = 0;
+let attempts = 0;
+const setStatus = (value: LiveStatus) => { if (status !== value) { status = value; statusListeners.forEach(listener => listener()); } };
+export const getLiveStatus = () => status;
+export const subscribeLiveStatus = (listener: () => void) => { statusListeners.add(listener); return () => { statusListeners.delete(listener); }; };
+
+// Fetch retains the existing cookie and CPAMC embed-header authentication. Tokens never enter URLs.
+async function connect() {
+  if (!listeners.size || document.hidden || controller) return;
+  const current = new AbortController(); controller = current;
+  const revision = generation;
+  setStatus(attempts ? 'reconnecting' : 'connecting');
+  let watchdog: ReturnType<typeof setTimeout> | undefined;
+  const touch = () => { clearTimeout(watchdog); watchdog = setTimeout(() => current.abort(), 45_000); };
+  try {
+    touch();
+    const response = await apiFetch(apiPath('/live'), { signal: current.signal, headers: { Accept: 'text/event-stream' } });
+    if (response.status === 401 || response.status === 403) { window.dispatchEvent(new Event('keeper:live-auth-required')); return; }
+    if (!response.ok || !response.body || !response.headers.get('content-type')?.includes('text/event-stream')) throw new Error('Live connection unavailable');
+    const reader = response.body.getReader(); const decoder = new TextDecoder(); let buffer = '';
+    while (true) {
+      const { value, done } = await reader.read(); if (done) break;
+      if (current.signal.aborted || revision !== generation) return;
+      touch(); buffer += decoder.decode(value, { stream: true }).replace(/\r/g, '');
+      if (buffer.length > 65536) throw new Error('Invalid live frame');
+      let boundary: number;
+      while ((boundary = buffer.indexOf('\n\n')) >= 0) {
+        const frame = buffer.slice(0, boundary); buffer = buffer.slice(boundary + 2);
+        const data = frame.split('\n').filter(line => line.startsWith('data:')).map(line => line.slice(5).trimStart()).join('\n');
+        if (!data) continue;
+        const payload = JSON.parse(data) as { topics?: unknown };
+        if (!Array.isArray(payload.topics)) continue;
+        const topics = payload.topics.filter((topic): topic is LiveTopic => ['sync', 'usage', 'quota', 'accounts', 'clock'].includes(String(topic)));
+        attempts = 0; setStatus('live'); listeners.forEach(listener => listener(topics));
+      }
+    }
+  } catch { /* Retain the last good data while the stream reconnects. */ }
+  finally {
+    current.abort();
+    clearTimeout(watchdog);
+    if (controller === current) controller = undefined;
+    if (revision === generation && listeners.size && !document.hidden) {
+      setStatus('reconnecting');
+      const delay = Math.min(30_000, 1000 * 2 ** Math.min(attempts++, 5));
+      retry = setTimeout(() => { retry = undefined; void connect(); }, delay);
+    }
+  }
+}
+function stop() { generation++; clearTimeout(retry); retry = undefined; controller?.abort(); controller = undefined; }
+function visibility() { stop(); if (document.hidden) setStatus('paused'); else { attempts = 0; void connect(); } }
+export function subscribeLive(listener: Listener) {
+  listeners.add(listener);
+  if (listeners.size === 1) { document.addEventListener('visibilitychange', visibility); window.addEventListener('online', visibility); if (document.hidden) setStatus('paused'); else void connect(); }
+  return () => { listeners.delete(listener); if (!listeners.size) { stop(); document.removeEventListener('visibilitychange', visibility); window.removeEventListener('online', visibility); } };
+}
+
+// Each consumer has one in-flight read and one trailing refresh. Bursts never cancel a useful read.
+export function startLiveRefresh(refresh: (signal: AbortSignal) => Promise<unknown>, topics: readonly LiveTopic[], initial = true) {
+  let stopped = false, dirty = false;
+  let request: AbortController | undefined;
+  let lastRequest: AbortController | undefined;
+  let timer: ReturnType<typeof setTimeout> | undefined;
+  const run = async () => {
+    timer = undefined;
+    if (stopped || document.hidden || request || !dirty) return;
+    dirty = false; const current = new AbortController(); request = current; lastRequest = current;
+    try { await refresh(current.signal); } catch { /* The caller owns error presentation. */ }
+    finally { if (request === current) request = undefined; if (dirty && !stopped) schedule(); }
+  };
+  const schedule = () => { if (!timer && !request && !stopped) timer = setTimeout(() => { void run(); }, 200); };
+  const unsubscribe = subscribeLive(changed => { if (changed.includes('sync') || topics.some(topic => changed.includes(topic))) { dirty = true; schedule(); } });
+  const hide = () => { if (document.hidden) { lastRequest?.abort(); dirty = true; } };
+  document.addEventListener('visibilitychange', hide);
+  if (initial) { dirty = true; void run(); }
+  return () => { stopped = true; clearTimeout(timer); lastRequest?.abort(); unsubscribe(); document.removeEventListener('visibilitychange', hide); };
+}
