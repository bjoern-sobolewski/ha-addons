@@ -0,0 +1,108 @@
+package api
+
+import (
+	"cpa-usage-keeper/internal/auth"
+	"cpa-usage-keeper/internal/live"
+	"encoding/json"
+	"fmt"
+	"github.com/gin-gonic/gin"
+	"net/http"
+	"time"
+)
+
+// Changes contain only topic names. All values still pass through the existing scoped read APIs.
+func (h *authHandler) registerLiveRoutes(router gin.IRoutes, hub *live.Hub) {
+	router.GET("/live", h.roleMiddleware(auth.RoleAdmin, auth.RoleReadOnly, auth.RoleAPIKeyViewer), func(c *gin.Context) {
+		if hub == nil {
+			c.Status(http.StatusServiceUnavailable)
+			return
+		}
+		group := ""
+		viewer := false
+		if value, ok := c.Get(authSessionContextKey); ok {
+			session := value.(auth.Session)
+			viewer = session.Role == auth.RoleAPIKeyViewer
+			if viewer {
+				resolved := c.MustGet(authResolvedContextKey).(resolvedSessionToken)
+				key, valid := h.activeViewerAPIKey(c, resolved, session)
+				if !valid {
+					c.Status(http.StatusUnauthorized)
+					return
+				}
+				group = key.APIKey
+			}
+		}
+		subscription := hub.Subscribe(group, viewer)
+		if subscription == nil {
+			c.Status(http.StatusServiceUnavailable)
+			return
+		}
+		defer subscription.Close()
+		c.Header("Content-Type", "text/event-stream")
+		c.Header("Cache-Control", "no-store")
+		c.Header("X-Accel-Buffering", "no")
+		sequence := 0
+		send := func(topics []string) bool {
+			if !h.liveSessionValid(c, group) {
+				return false
+			}
+			_ = http.NewResponseController(c.Writer).SetWriteDeadline(time.Now().Add(10 * time.Second))
+			sequence++
+			payload, _ := json.Marshal(gin.H{"topics": topics})
+			_, err := fmt.Fprintf(c.Writer, "id: %d\nevent: change\ndata: %s\n\n", sequence, payload)
+			c.Writer.Flush()
+			return err == nil
+		}
+		if !send([]string{"sync"}) {
+			return
+		}
+		heartbeat := time.NewTicker(15 * time.Second)
+		defer heartbeat.Stop()
+		for {
+			select {
+			case <-c.Request.Context().Done():
+				return
+			case <-subscription.Wake:
+				timer := time.NewTimer(150 * time.Millisecond)
+				select {
+				case <-c.Request.Context().Done():
+					timer.Stop()
+					return
+				case <-timer.C:
+				}
+				topics := subscription.Drain()
+				if len(topics) == 0 {
+					continue
+				}
+				if !send(topics) {
+					return
+				}
+			case <-heartbeat.C:
+				if !send([]string{"clock"}) {
+					return
+				}
+			}
+		}
+	})
+}
+func (h *authHandler) liveSessionValid(c *gin.Context, group string) bool {
+	if h == nil || !h.config.Enabled {
+		return true
+	}
+	resolved := c.MustGet(authResolvedContextKey).(resolvedSessionToken)
+	session, ok := h.sessions.Get(resolved.Token)
+	if !ok || !sessionMatchesResolvedSource(session, resolved) {
+		return false
+	}
+	if session.Role == auth.RoleReadOnly && !h.readOnlyEnabled() {
+		return false
+	}
+	if session.Role == auth.RoleAPIKeyViewer {
+		if h.cpaAPIKeyProvider == nil {
+			return false
+		}
+		key, err := h.cpaAPIKeyProvider.FindActiveCPAAPIKeyByID(c.Request.Context(), session.CPAAPIKeyID)
+		return err == nil && key.APIKey == group
+	}
+	return session.Role == auth.RoleAdmin || session.Role == auth.RoleReadOnly
+}
