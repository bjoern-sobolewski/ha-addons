+package quota
+
+import (
+	"testing"
+	"time"
+)
+
+func TestResetCreditCacheKeepsNewestAndPreservesHeaderMerge(t *testing.T) {
+	at := time.Now()
+	old := 2
+	s := &Service{refreshTasks: map[string]*RefreshTaskRecord{"a": {RefreshedAt: at, Quota: &CheckResponse{RateLimitResetCreditsAvailableCount: &old}}}}
+	s.cacheResetCredits("a", 0, at.Add(time.Second))
+	s.cacheResetCredits("a", 7, at)
+	s.cacheResetCredits("a", -1, at.Add(time.Hour))
+	if s.resetCreditsCache["a"].Count != 0 || *s.refreshTasks["a"].Quota.RateLimitResetCreditsAvailableCount != 0 || old != 2 {
+		t.Fatal("lost zero, accepted late data or mutated old snapshot")
+	}
+	merged := mergeUsageHeaderQuotaResponse(*s.refreshTasks["a"].Quota, CheckResponse{})
+	if merged.RateLimitResetCreditsAvailableCount == nil || *merged.RateLimitResetCreditsAvailableCount != 0 {
+		t.Fatal("headers erased known credits")
+	}
+}
