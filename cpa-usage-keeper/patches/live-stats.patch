+package cpa
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestWatchLiveAuthenticationAndCancellation(t *testing.T) {
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v8/management/live" || r.URL.RawQuery != "" || r.Header.Get("Authorization") != "Bearer fixture" {
+			t.Error("wrong stream request")
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprint(w, `data: {"topics":[`)
+		w.(http.Flusher).Flush()
+		fmt.Fprint(w, `"quota"]}`+"\n\n")
+		w.(http.Flusher).Flush()
+		<-r.Context().Done()
+	}))
+	defer server.Close()
+	client := &Client{baseURL: server.URL, managementKey: "fixture", httpClient: server.Client()}
+	seen := false
+	_ = client.WatchLive(ctx, func(topics []string) {
+		if len(topics) == 1 && topics[0] == "quota" {
+			seen = true
+			cancel()
+		}
+	})
+	if !seen {
+		t.Fatal("stream did not deliver fragmented change")
+	}
+}
