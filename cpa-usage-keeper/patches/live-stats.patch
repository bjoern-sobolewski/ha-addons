+++ b/internal/live/hub_test.go
@@ -0,0 +1,53 @@
+package live
+
+import "testing"
+
+func TestAudienceAndCoalescing(t *testing.T) {
+	h := New()
+	admin := h.Subscribe("", false)
+	a := h.Subscribe("a", true)
+	b := h.Subscribe("b", true)
+	defer admin.Close()
+	defer a.Close()
+	defer b.Close()
+	for i := 0; i < 10000; i++ {
+		h.Publish("usage", "a")
+		h.Publish("accounts")
+		h.Publish("quota")
+	}
+	if len(admin.Drain()) != 3 {
+		t.Fatal("lost topics for slow subscriber")
+	}
+	if len(a.Drain()) != 2 {
+		t.Fatal("viewer missed scoped usage/quota")
+	}
+	topics := b.Drain()
+	if len(topics) != 1 || topics[0] != "quota" {
+		t.Fatalf("cross-group notification: %v", topics)
+	}
+	a.Close()
+	h.Publish("usage", "a")
+	if len(a.Drain()) != 0 {
+		t.Fatal("closed subscriber retained")
+	}
+}
+func TestSubscriberLimit(t *testing.T) {
+	h := New()
+	var first *Subscription
+	for i := 0; i < 256; i++ {
+		s := h.Subscribe("", false)
+		if s == nil {
+			t.Fatal(i)
+		}
+		if i == 0 {
+			first = s
+		}
+	}
+	if h.Subscribe("", false) != nil {
+		t.Fatal("unbounded subscriptions")
+	}
+	first.Close()
+	if h.Subscribe("", false) == nil {
+		t.Fatal("slot not released")
+	}
+}
