+	"strings"
+	"testing"
+	"time"
+)
+
+func TestLiveRequiresAuthScopesTopicsAndStopsRevokedSessions(t *testing.T) {
+	sessions := auth.NewSessionManager(time.Hour)
+	hub := live.New()
+	config := AuthConfig{Enabled: true, LoginPassword: "fixture", SessionTTL: time.Hour}
+	keys := &authLoginKeyStub{row: entities.CPAAPIKey{ID: 42, APIKey: "a"}}
+	router := NewRouter(nil, nil, nil, nil, config, NewAuthHandler(config, sessions), "", OptionalProviders{Live: hub, CPAAPIKeys: keys})
+	denied := serveAPIGet(router, "/api/v1/live")
+	if denied.Code != 401 {
+		t.Fatal(denied.Code)
+	}
+	server := httptest.NewServer(router)
+	defer server.Close()
+	token, _, err := sessions.CreateAPIKeyViewer(42)
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	req, _ := http.NewRequestWithContext(ctx, "GET", server.URL+"/api/v1/live", nil)
+	req.AddCookie(&http.Cookie{Name: standardSessionCookieName, Value: token})
+	resp, err := server.Client().Do(req)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != 200 || resp.Header.Get("X-Accel-Buffering") != "no" {
+		t.Fatal("stream headers")
+	}
+	scanner := bufio.NewScanner(resp.Body)
+	next := func() string {
+		for scanner.Scan() {
+			if strings.HasPrefix(scanner.Text(), "data:") {
+				return scanner.Text()
+			}
+		}
+		return ""
+	}
+	if !strings.Contains(next(), "sync") {
+		t.Fatal("missing resync")
+	}
+	hub.Publish("usage", "b")
+	hub.Publish("accounts")
+	hub.Publish("quota")
+	frame := next()
+	if !strings.Contains(frame, "quota") || strings.Contains(frame, "usage") || strings.Contains(frame, "accounts") || strings.Contains(frame, token) {
+		t.Fatal("unscoped frame", frame)
+	}
+	hub.Publish("usage", "a")
+	if !strings.Contains(next(), "usage") {
+		t.Fatal("missing committed usage")
+	}
+	sessions.Delete(token)
+	hub.Publish("quota")
+	if next() != "" {
+		t.Fatal("revoked session received data")
+	}
+}
+
+func TestLiveCacheReadsDoNotPublishButMutationsDo(t *testing.T) {
+	for _, base := range []string{"", "/keeper"} {
+		hub := live.New()
+		sub := hub.Subscribe("", false)
+		router := NewRouter(nil, nil, nil, nil, AuthConfig{}, nil, base, OptionalProviders{Live: hub, Quota: &quotaProviderStub{}})
+		for _, route := range []struct {
+			path string
+			want bool
+		}{{"/quota/cache", false}, {"/quota/inspection", true}} {
+			response := httptest.NewRecorder()
+			req := httptest.NewRequest("POST", base+"/api/v1"+route.path, strings.NewReader(`{"auth_indexes":["fixture"]}`))
+			req.Header.Set("Content-Type", "application/json")
+			req.Header.Set("X-CPA-Usage-Keeper-Request", "fetch")
+			router.ServeHTTP(response, req)
+			if response.Code != 200 {
+				t.Fatalf("%s: %d %s", route.path, response.Code, response.Body.String())
+			}
+			if got := len(sub.Drain()) > 0; got != route.want {
+				t.Fatalf("%s invalidated=%v, want %v", route.path, got, route.want)
+			}
+		}
+		sub.Close()
+	}
+}
