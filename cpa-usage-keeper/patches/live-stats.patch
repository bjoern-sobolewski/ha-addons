new file mode 100644
index 00000000..fdd8d78a
--- /dev/null
+++ b/internal/quota/traffic_reset_credits.go
@@ -0,0 +1,53 @@
+package quota
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/cpa"
+	"cpa-usage-keeper/internal/entities"
+	"time"
+)
+
+type resetCreditObservation struct {
+	Count int
+	At    time.Time
+}
+
+func (s *Service) cacheResetCredits(index string, count int, at time.Time) {
+	if count < 0 || count > 10000 {
+		return
+	}
+	s.refreshMu.Lock()
+	if s.resetCreditsCache == nil {
+		s.resetCreditsCache = map[string]resetCreditObservation{}
+	}
+	old, exists := s.resetCreditsCache[index]
+	if (exists && !at.After(old.At)) || (!exists && len(s.resetCreditsCache) >= 4096) {
+		s.refreshMu.Unlock()
+		return
+	}
+	s.resetCreditsCache[index] = resetCreditObservation{count, at}
+	if task := s.refreshTasks[index]; task != nil && task.Quota != nil && (task.Quota.RateLimitResetCreditsAvailableCount == nil || !at.Before(task.RefreshedAt)) {
+		response := *task.Quota
+		value := count
+		response.RateLimitResetCreditsAvailableCount = &value
+		task.Quota = &response
+	}
+	s.refreshMu.Unlock()
+	s.Live.Publish("quota")
+}
+func (s *Service) applyTrafficResetCredits(ctx context.Context, item cpa.QuotaObservation) {
+	if item.ResetCreditsAvailableCount == nil {
+		return
+	}
+	s.refreshMu.Lock()
+	old, exists := s.resetCreditsCache[item.AuthIndex]
+	s.refreshMu.Unlock()
+	if exists && !item.ObservedAt.After(old.At) {
+		return
+	}
+	var identity entities.UsageIdentity
+	if s.db.WithContext(ctx).Where("identity = ? AND is_deleted = ?", item.AuthIndex, false).First(&identity).Error != nil || !usageHeaderIdentityIsCodex(identity) || (identity.Disabled != nil && *identity.Disabled) {
+		return
+	}
+	s.cacheResetCredits(item.AuthIndex, *item.ResetCreditsAvailableCount, item.ObservedAt)
+}
