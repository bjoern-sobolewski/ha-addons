@@ -0,0 +1,43 @@
+package test
+
+import (
+	"testing"
+	"time"
+
+	"cpa-usage-keeper/internal/timeutil"
+)
+
+func TestUsagePeriodPresetsUseCalendarDaysAcrossDST(t *testing.T) {
+	location := useTimezone(t, "Europe/Berlin")
+	anchor := time.Date(2026, 10, 27, 12, 0, 0, 0, location)
+	for _, sample := range []struct {
+		value string
+		days  int
+	}{{"1w", 7}, {"52w", 364}, {"1mo", 30}, {"12mo", 360}} {
+		result, err := timeutil.ParseUsageQueryRangeWithOptions(sample.value, "", "", "", anchor, timeutil.UsageQueryRangeOptions{MaxCustomDayRangeDays: 365})
+		if err != nil {
+			t.Fatalf("%s: %v", sample.value, err)
+		}
+		start := time.Date(2026, 10, 27, 0, 0, 0, 0, location).AddDate(0, 0, 1-sample.days)
+		end := time.Date(2026, 10, 28, 0, 0, 0, 0, location)
+		if result.Range != "custom" || result.Unit != timeutil.UsageQueryUnitDay || result.Count != sample.days || !result.EndExclusive || !result.StartTime.Equal(start) || !result.EndTime.Equal(end) {
+			t.Fatalf("%s: got %+v, want %s..%s", sample.value, result, start, end)
+		}
+	}
+}
+
+func TestUsagePeriodPresetsRespectRouteLimits(t *testing.T) {
+	location := useTimezone(t, "Europe/Berlin")
+	anchor := time.Date(2026, 11, 12, 12, 0, 0, 0, location)
+	options := timeutil.UsageQueryRangeOptions{MaxCustomDayRangeDays: 90}
+	for _, value := range []string{"12w", "3mo"} {
+		if _, err := timeutil.ParseUsageQueryRangeWithOptions(value, "", "", "", anchor, options); err != nil {
+			t.Fatalf("%s: %v", value, err)
+		}
+	}
+	for _, value := range []string{"13w", "4mo", "0w", "53w", "0mo", "13mo", "01w", "1m", "-1mo"} {
+		if _, err := timeutil.ParseUsageQueryRangeWithOptions(value, "", "", "", anchor, options); err == nil {
+			t.Fatalf("accepted %s", value)
+		}
+	}
+}
