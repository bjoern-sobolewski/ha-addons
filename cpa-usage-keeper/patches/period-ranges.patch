+// Period presets include today and use the same bounded daily aggregates as custom ranges.
+func parseUsagePeriodDays(value string) (int, bool) {
+	suffix, daysPerPeriod, maximum := "w", 7, 52
+	if strings.HasSuffix(value, "mo") {
+		suffix, daysPerPeriod, maximum = "mo", 30, 12
+	}
+	if !strings.HasSuffix(value, suffix) {
+		return 0, false
+	}
+	numberText := strings.TrimSuffix(value, suffix)
+	amount, err := strconv.Atoi(numberText)
+	if err != nil || strconv.Itoa(amount) != numberText || amount < 1 || amount > maximum {
+		return 0, false
+	}
+	return amount * daysPerPeriod, true
+}
+
+func usageDayRangeLimit(options UsageQueryRangeOptions) int {
+	if options.MaxCustomDayRangeDays > 0 {
+		return options.MaxCustomDayRangeDays
+	}
+	return defaultCustomDayRangeMaxDays
+}
