@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest';
+import { buildUsageRangeQuery, clampUsageRangeToDayLimit, parseSelectableUsageRange } from '../rangeQuery';
+import { parseStoredUsageRangeState, serializeUsageRangeState } from '../customRange';
+import { isDailyAverageRange } from '../overview';
+
+describe('week and month range presets', () => {
+  it.each([['2w', 'week', 2], ['12mo', 'month', 12]] as const)('keeps %s selectable, queryable and persistent', (range, mode, value) => {
+    expect(parseSelectableUsageRange(range)).toEqual({ mode, value });
+    expect(buildUsageRangeQuery({ range })).toEqual({ valid: true, range });
+    expect(parseStoredUsageRangeState(serializeUsageRangeState({ range }), { nowMs: Date.now() })).toEqual({ range });
+    expect(isDailyAverageRange({ range })).toBe(true);
+  });
+
+  it('clamps event views without changing the stored overview choice', () => {
+    expect(clampUsageRangeToDayLimit('52w', 90)).toBe('12w');
+    expect(clampUsageRangeToDayLimit('12mo', 90)).toBe('3mo');
+    expect(clampUsageRangeToDayLimit('12mo', 365)).toBe('12mo');
+    expect(clampUsageRangeToDayLimit('custom', 90)).toBe('custom');
+  });
+});
