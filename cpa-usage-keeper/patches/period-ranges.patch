+package test
+
+import (
+	"context"
+	"net/http"
+	"testing"
+
+	. "cpa-usage-keeper/internal/api"
+	servicedto "cpa-usage-keeper/internal/service/dto"
+)
+
+type usagePeriodReportsStub struct{ usageEventsStub }
+
+func (s *usagePeriodReportsStub) GetAnalysis(_ context.Context, filter servicedto.UsageFilter) (*servicedto.AnalysisSnapshot, error) {
+	s.lastFilter = filter
+	return nil, nil
+}
+
+func (s *usagePeriodReportsStub) GetUsageActivity(_ context.Context, filter servicedto.UsageFilter) (*servicedto.UsageActivitySnapshot, error) {
+	s.lastFilter = filter
+	return nil, nil
+}
+
+func TestUsagePeriodPresetsReachScopedDailyReports(t *testing.T) {
+	for _, route := range []string{"/api/v1/usage/overview", "/api/v1/usage/analysis", "/api/v1/usage/activity"} {
+		t.Run(route, func(t *testing.T) {
+			provider := &usagePeriodReportsStub{}
+			router := NewRouter(nil, nil, provider, nil, AuthConfig{}, nil, "")
+			response := serveAPIGet(router, route+"?range=12mo&api_key_id=42")
+			if response.Code != http.StatusOK {
+				t.Fatalf("status=%d body=%s", response.Code, response.Body.String())
+			}
+			filter := provider.lastFilter
+			if filter.APIKeyID != "42" || filter.Range != "custom" || filter.CustomUnit != "day" || filter.RangeCount != 360 || !filter.EndExclusive {
+				t.Fatalf("unexpected daily filter: %+v", filter)
+			}
+		})
+	}
+	provider := &usageEventsStub{}
+	router, cookie := newUsageViewerRouter(t, provider)
+	response := serveAPIGet(router, "/api/v1/key-overview?range=52w&api_key_id=999", cookie)
+	if response.Code != http.StatusOK || provider.lastFilter.APIKeyID != "42" || provider.lastFilter.RangeCount != 364 {
+		t.Fatalf("viewer scope/range status=%d filter=%+v", response.Code, provider.lastFilter)
+	}
+}
+
+func TestUsagePeriodPresetsKeepEventsWithinHotStorage(t *testing.T) {
+	for _, sample := range []struct {
+		value  string
+		status int
+	}{{"12w", 200}, {"3mo", 200}, {"13w", 400}, {"4mo", 400}} {
+		provider := &usageEventsStub{}
+		router := NewRouter(nil, nil, provider, nil, AuthConfig{}, nil, "")
+		response := serveAPIGet(router, "/api/v1/usage/events?range="+sample.value)
+		if response.Code != sample.status {
+			t.Fatalf("%s: status=%d body=%s", sample.value, response.Code, response.Body.String())
+		}
+	}
+}
