diff --git a/internal/repository/provider_stats.go b/internal/repository/provider_stats.go
new file mode 100644
index 00000000..a9634870
--- /dev/null
+++ b/internal/repository/provider_stats.go
@@ -0,0 +1,143 @@
+package repository
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/timeutil"
+	"fmt"
+	"gorm.io/gorm"
+	"gorm.io/plugin/dbresolver"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Provider reports contain aggregate facts only, never credential metadata.
+type ProviderUsageTotals struct {
+	Requests         int64   `json:"requests"`
+	Failed           int64   `json:"failed"`
+	InputTokens      int64   `json:"input_tokens"`
+	OutputTokens     int64   `json:"output_tokens"`
+	CacheReadTokens  int64   `json:"cache_read_tokens"`
+	TotalTokens      int64   `json:"total_tokens"`
+	TotalCostUSD     float64 `json:"total_cost_usd"`
+	UnpricedRequests int64   `json:"unpriced_requests"`
+}
+type ProviderUsageGroup struct {
+	Model string `json:"model"`
+	Mode  string `json:"mode"`
+	ProviderUsageTotals
+}
+type ProviderUsageDay struct {
+	Day string `json:"day"`
+	ProviderUsageTotals
+}
+type ProviderStats struct {
+	Provider    string               `json:"provider"`
+	GeneratedAt time.Time            `json:"generated_at"`
+	RangeStart  time.Time            `json:"range_start"`
+	Accounts    int                  `json:"accounts"`
+	Totals      ProviderUsageTotals  `json:"totals"`
+	Groups      []ProviderUsageGroup `json:"groups"`
+	Days        []ProviderUsageDay   `json:"days"`
+}
+
+func ListStatsProviders(ctx context.Context, db *gorm.DB) ([]string, error) {
+	source := "SELECT provider FROM usage_events WHERE auth_type = 'oauth'"
+	if db.Migrator().HasTable(&entities.UsageEventArchive{}) {
+		source += " UNION SELECT provider FROM usage_events_archive WHERE auth_type = 'oauth'"
+	}
+	source += " UNION SELECT type AS provider FROM usage_identities WHERE auth_type = 1"
+	values := []string{}
+	err := db.WithContext(ctx).Clauses(dbresolver.Read).Raw("SELECT DISTINCT provider FROM (" + source + ") WHERE provider IS NOT NULL AND TRIM(provider) <> '' ORDER BY provider").Scan(&values).Error
+	return values, err
+}
+
+func BuildProviderStats(ctx context.Context, db *gorm.DB, provider string, days int, now time.Time) (ProviderStats, error) {
+	report := ProviderStats{Provider: provider, Groups: []ProviderUsageGroup{}, Days: []ProviderUsageDay{}}
+	if err := ValidatePerformanceQuery(PerformanceQuery{Provider: provider, Days: days, Metric: "latency"}); err != nil {
+		return report, err
+	}
+	if now.IsZero() {
+		now = time.Now()
+	}
+	report.GeneratedAt = now.UTC()
+	report.RangeStart = report.GeneratedAt.Add(-time.Duration(days) * 24 * time.Hour)
+	projection := "auth_index, model, COALESCE(NULLIF(effective_service_tier, ''), upstream_service_tier, '') AS upstream_service_tier, timestamp, failed, input_tokens, output_tokens, cache_read_tokens, total_tokens, cost_usd, cost_available"
+	filter := "auth_type = ? AND provider = ? AND timestamp >= ? AND timestamp < ?"
+	args := []any{"oauth", provider, timeutil.FormatStorageTime(report.RangeStart), timeutil.FormatStorageTime(report.GeneratedAt)}
+	source := "SELECT " + projection + " FROM usage_events WHERE " + filter
+	if db.Migrator().HasTable(&entities.UsageEventArchive{}) {
+		source += " UNION ALL SELECT " + projection + " FROM usage_events_archive WHERE " + filter
+		args = append(append([]any{}, args...), args...)
+	}
+	rows, err := db.WithContext(ctx).Clauses(dbresolver.Read).Raw(source, args...).Rows()
+	if err != nil {
+		return report, fmt.Errorf("read provider stats: %w", err)
+	}
+	defer rows.Close()
+	accounts := map[string]bool{}
+	groups := map[[2]string]*ProviderUsageGroup{}
+	daily := map[string]*ProviderUsageDay{}
+	for rows.Next() {
+		var e entities.UsageEvent
+		if err := db.ScanRows(rows, &e); err != nil {
+			return report, err
+		}
+		if strings.TrimSpace(e.AuthIndex) != "" {
+			accounts[e.AuthIndex] = true
+		}
+		key := [2]string{e.Model, quotaRequestedMode(e.UpstreamServiceTier)}
+		if groups[key] == nil {
+			groups[key] = &ProviderUsageGroup{Model: key[0], Mode: key[1]}
+		}
+		day := timeutil.NormalizeStorageTime(e.Timestamp).UTC().Format("2006-01-02")
+		if daily[day] == nil {
+			daily[day] = &ProviderUsageDay{Day: day}
+		}
+		addProviderUsage(&report.Totals, e)
+		addProviderUsage(&groups[key].ProviderUsageTotals, e)
+		addProviderUsage(&daily[day].ProviderUsageTotals, e)
+	}
+	if err := rows.Err(); err != nil {
+		return report, err
+	}
+	report.Accounts = len(accounts)
+	for _, group := range groups {
+		report.Groups = append(report.Groups, *group)
+	}
+	sort.Slice(report.Groups, func(i, j int) bool {
+		a, b := report.Groups[i], report.Groups[j]
+		if a.Requests != b.Requests {
+			return a.Requests > b.Requests
+		}
+		if a.Model != b.Model {
+			return a.Model < b.Model
+		}
+		return a.Mode < b.Mode
+	})
+	for date := report.RangeStart.Truncate(24 * time.Hour); !date.After(report.GeneratedAt.Truncate(24 * time.Hour)); date = date.AddDate(0, 0, 1) {
+		day := date.Format("2006-01-02")
+		if value := daily[day]; value != nil {
+			report.Days = append(report.Days, *value)
+		} else {
+			report.Days = append(report.Days, ProviderUsageDay{Day: day})
+		}
+	}
+	return report, nil
+}
+func addProviderUsage(total *ProviderUsageTotals, e entities.UsageEvent) {
+	total.Requests++
+	if e.Failed {
+		total.Failed++
+	}
+	total.InputTokens += e.InputTokens
+	total.OutputTokens += e.OutputTokens
+	total.CacheReadTokens += e.CacheReadTokens
+	total.TotalTokens += e.TotalTokens
+	if e.CostAvailable != nil && *e.CostAvailable && e.CostUSD != nil {
+		total.TotalCostUSD += *e.CostUSD
+	} else {
+		total.UnpricedRequests++
+	}
+}
