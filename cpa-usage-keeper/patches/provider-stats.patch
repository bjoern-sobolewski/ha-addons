+package test
+
+import (
+	"context"
+	. "cpa-usage-keeper/internal/api"
+	"cpa-usage-keeper/internal/auth"
+	"cpa-usage-keeper/internal/quota"
+	"cpa-usage-keeper/internal/repository"
+	"net/http"
+	"testing"
+	"time"
+)
+
+type providerStatsStub struct {
+	quotaProviderStub
+	request repository.PerformanceQuery
+	err     error
+}
+
+func (p *providerStatsStub) ListStatsProviders(context.Context) ([]string, error) {
+	return []string{"codex", "claude"}, p.err
+}
+func (p *providerStatsStub) GetProviderStats(_ context.Context, q repository.PerformanceQuery) (repository.ProviderStats, error) {
+	p.request = q
+	return repository.ProviderStats{Provider: q.Provider}, p.err
+}
+func (p *providerStatsStub) GetProviderPerformance(_ context.Context, q repository.PerformanceQuery) (repository.PerformanceReport, error) {
+	p.request = q
+	return repository.PerformanceReport{Metric: q.Metric}, p.err
+}
+func TestProviderStatsRoutesValidateFiltersAndStayAdminOnly(t *testing.T) {
+	sessions := auth.NewSessionManager(time.Hour)
+	cfg := AuthConfig{Enabled: true, LoginPassword: "admin", ReadOnlyPassword: "synthetic-read-only-password"}
+	provider := &providerStatsStub{}
+	router := NewRouter(nil, nil, nil, nil, cfg, NewAuthHandler(cfg, sessions), "", OptionalProviders{Quota: provider})
+	token, _, _ := sessions.Create()
+	admin := &http.Cookie{Name: standardSessionCookieName, Value: token}
+	viewerToken, _, _ := sessions.CreateAPIKeyViewer(1)
+	viewer := &http.Cookie{Name: standardSessionCookieName, Value: viewerToken}
+	readToken, _, _ := sessions.CreateReadOnlyWithSourceAndMetadata(auth.SessionSourceStandard, auth.SessionClientMetadata{})
+	readOnly := &http.Cookie{Name: standardSessionCookieName, Value: readToken}
+	for _, path := range []string{"/api/v1/quota/providers", "/api/v1/quota/providers/codex/stats?days=7", "/api/v1/quota/providers/codex/performance?days=14&metric=tps&model=a&mode=fast"} {
+		if response := serveAPIGet(router, path, admin); response.Code != 200 {
+			t.Fatalf("%s: %d %s", path, response.Code, response.Body.String())
+		}
+		if serveAPIGet(router, path).Code != 401 || serveAPIGet(router, path, viewer).Code != 403 || serveAPIGet(router, path, readOnly).Code != 403 {
+			t.Fatal("provider aggregate escaped admin boundary")
+		}
+	}
+	if provider.request.Provider != "codex" || provider.request.AuthIndex != "" || provider.request.Days != 14 || provider.request.Metric != "tps" || provider.request.Mode != "fast" {
+		t.Fatal(provider.request)
+	}
+	for _, query := range []string{"days=1", "days=bad", "mode=bad", "metric=bad"} {
+		if serveAPIGet(router, "/api/v1/quota/providers/codex/stats?"+query, admin).Code != 400 {
+			t.Fatal(query)
+		}
+	}
+	for _, item := range []struct {
+		err    error
+		status int
+	}{{quota.ErrNotFound, 404}, {quota.ErrValidation, 400}} {
+		provider.err = item.err
+		if serveAPIGet(router, "/api/v1/quota/providers/missing/stats?days=7", admin).Code != item.status {
+			t.Fatal("wrong error mapping")
+		}
+	}
+}
