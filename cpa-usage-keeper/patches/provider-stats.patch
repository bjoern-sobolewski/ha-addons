+it('routes provider reports separately from account and read-only reports', async () => {
+ vi.stubGlobal('window', { __APP_BASE_PATH__: '/keeper/' })
+ const fetchMock=vi.spyOn(globalThis,'fetch').mockImplementation(async () => Response.json({providers:['codex']}))
+ const signal=new AbortController().signal
+ const options={days:'14',metric:'tps',models:['a','b'],mode:'fast',context:'large',output:'long',effort:'low'}
+ expect(await fetchStatsProviders(signal)).toEqual(['codex'])
+ await fetchProviderStats('codex','30',signal)
+ await fetchAccountPerformance('',{...options,provider:'codex'},signal)
+ await fetchAccountPerformance('private-account',options,signal)
+ await fetchAccountPerformance('private-account',{...options,readOnlyAccountId:'3'},signal)
+ await fetchCodexQuotaHistory('private-account',{readOnlyAccountId:'3',weeklyOnly:true},signal)
+ const urls=fetchMock.mock.calls.map(([url])=>new URL(String(url),'http://localhost'))
+ expect(urls.map(url=>url.pathname)).toEqual(['/keeper/api/v1/quota/providers','/keeper/api/v1/quota/providers/codex/stats','/keeper/api/v1/quota/providers/codex/performance','/keeper/api/v1/quota/performance/private-account','/keeper/api/v1/read-only/accounts/3/performance','/keeper/api/v1/read-only/accounts/3/weekly-quota'])
