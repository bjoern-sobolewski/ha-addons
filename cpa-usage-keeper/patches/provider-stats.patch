+ days:[{day:'2026-11-06',requests:100,failed:5,input_tokens:10000,output_tokens:1000,cache_read_tokens:9000,total_tokens:11000,total_cost_usd:12,unpriced_requests:3}]
+})
+let element: HTMLDivElement; let root: Root
+beforeEach(async () => { globalThis.IS_REACT_ACT_ENVIRONMENT = true; await i18n.changeLanguage('en'); mocks.providers.mockReset().mockResolvedValue(['codex','claude']); mocks.stats.mockReset().mockImplementation(async (provider: string) => fixture(provider)); mocks.chart.mockClear(); element=document.createElement('div'); document.body.append(element); root=createRoot(element) })
