+package quota
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/repository"
+	"fmt"
+)
+
+func (s *Service) ListStatsProviders(ctx context.Context) ([]string, error) {
+	if s == nil || s.db == nil {
+		return nil, fmt.Errorf("provider statistics unavailable")
+	}
+	return repository.ListStatsProviders(ctx, s.db)
+}
+func (s *Service) GetProviderStats(ctx context.Context, q repository.PerformanceQuery) (repository.ProviderStats, error) {
+	if err := s.validateStatsProvider(ctx, q); err != nil {
+		return repository.ProviderStats{}, err
+	}
+	return repository.BuildProviderStats(ctx, s.db, q.Provider, q.Days, q.Now)
+}
+func (s *Service) GetProviderPerformance(ctx context.Context, q repository.PerformanceQuery) (repository.PerformanceReport, error) {
+	if err := s.validateStatsProvider(ctx, q); err != nil {
+		return repository.PerformanceReport{}, err
+	}
+	return repository.BuildAccountPerformance(ctx, s.db, q)
+}
+func (s *Service) validateStatsProvider(ctx context.Context, q repository.PerformanceQuery) error {
+	if q.Provider == "" || q.AuthIndex != "" {
+		return ErrValidation
+	}
+	if err := repository.ValidatePerformanceQuery(q); err != nil {
+		return fmt.Errorf("%w: %v", ErrValidation, err)
+	}
+	providers, err := s.ListStatsProviders(ctx)
+	if err != nil {
+		return err
+	}
+	for _, provider := range providers {
+		if provider == q.Provider {
+			return nil
+		}
+	}
+	return ErrNotFound
+}
