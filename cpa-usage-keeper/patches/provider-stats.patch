+)
+
+func TestProviderStatsPoolRequestsPricesAndArchivedAccounts(t *testing.T) {
+	db := openTestDatabase(t)
+	at := performanceNow.Add(-time.Hour)
+	seedPerformance(t, db, "model", 1000, 1000, 1, at)
+	seedPerformance(t, db, "model", 1000, 9000, 9, at.Add(-time.Minute))
+	if err := db.Model(&entities.UsageEvent{}).Where("latency_ms = ?", 9000).Update("auth_index", "second-private-account").Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Model(&entities.UsageEvent{}).Where("latency_ms = ?", 9000).Updates(map[string]any{"cost_usd": 2.0, "cost_available": true, "cache_read_tokens": 500, "total_tokens": 1100}).Error; err != nil {
+		t.Fatal(err)
+	}
+	seedPerformance(t, db, "foreign", 1000, 2000, 3, at)
+	db.Model(&entities.UsageEvent{}).Where("model = ?", "foreign").Update("provider", "claude")
+	seedPerformance(t, db, "api", 1000, 2000, 3, at)
+	db.Model(&entities.UsageEvent{}).Where("model = ?", "api").Update("auth_type", "api_key")
+	seedPerformance(t, db, "future", 1000, 2000, 1, performanceNow)
+	seedPerformance(t, db, "old", 1000, 2000, 1, performanceNow.Add(-8*24*time.Hour))
+	q := repository.PerformanceQuery{Provider: "codex", Days: 7, Metric: "latency", Now: performanceNow}
+	report := getPerformance(t, db, q)
+	if len(report.Groups) != 1 || report.Groups[0].Requests != 10 || *report.Groups[0].Raw.Median != 9 {
+		t.Fatalf("did not pool request distributions: %+v", report)
+	}
+	totals, err := repository.BuildProviderStats(context.Background(), db, "codex", 7, performanceNow)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if totals.Accounts != 2 || totals.Totals.Requests != 10 || totals.Totals.TotalCostUSD != 18 || totals.Totals.UnpricedRequests != 1 || totals.Totals.CacheReadTokens != 4500 {
+		t.Fatalf("bad totals: %+v", totals)
+	}
+	if len(totals.Groups) != 1 || totals.Groups[0].Requests != 10 {
+		t.Fatal(totals.Groups)
+	}
+	payload, _ := json.Marshal(totals)
+	if strings.Contains(string(payload), "private-account") || strings.Contains(string(payload), "auth_index") {
+		t.Fatal("aggregate leaked account identity")
+	}
+	db.Exec("INSERT INTO usage_events_archive (" + entities.UsageEventStorageColumns + ") SELECT " + entities.UsageEventStorageColumns + " FROM usage_events")
+	db.Exec("DELETE FROM usage_events")
+	archived, err := repository.BuildProviderStats(context.Background(), db, "codex", 7, performanceNow)
+	if err != nil || !reflect.DeepEqual(totals, archived) {
+		t.Fatalf("archive changed totals: %v %+v", err, archived)
+	}
+	if !reflect.DeepEqual(report, getPerformance(t, db, q)) {
+		t.Fatal("archive changed pooled speed")
+	}
+	providers, err := repository.ListStatsProviders(context.Background(), db)
+	if err != nil || !reflect.DeepEqual(providers, []string{"claude", "codex"}) {
+		t.Fatalf("provider catalog: %v %v", providers, err)
+	}
+}
+func TestProviderStatsEmptyAndScopeValidation(t *testing.T) {
+	db := openTestDatabase(t)
+	report, err := repository.BuildProviderStats(context.Background(), db, "codex", 7, performanceNow)
+	if err != nil || report.Totals.Requests != 0 || report.Accounts != 0 || len(report.Days) != 8 {
+		t.Fatalf("empty: %+v %v", report, err)
+	}
+	for _, q := range []repository.PerformanceQuery{{Days: 7, Metric: "tps"}, {Provider: "codex", AuthIndex: "account", Days: 7, Metric: "tps"}, {Provider: "codex", Days: 1, Metric: "tps"}} {
+		if repository.ValidatePerformanceQuery(q) == nil {
+			t.Fatal("invalid scope accepted", q)
+		}
+	}
+}
