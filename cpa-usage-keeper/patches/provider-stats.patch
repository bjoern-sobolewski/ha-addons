@@ -0,0 +1,66 @@
+package api
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/quota"
+	"cpa-usage-keeper/internal/repository"
+	"errors"
+	"github.com/gin-gonic/gin"
+)
+
+type providerStatsReader interface {
+	ListStatsProviders(context.Context) ([]string, error)
+	GetProviderStats(context.Context, repository.PerformanceQuery) (repository.ProviderStats, error)
+	GetProviderPerformance(context.Context, repository.PerformanceQuery) (repository.PerformanceReport, error)
+}
+
+// Registered only behind the LAN administrator authentication boundary.
+func registerProviderStatsRoutes(router gin.IRoutes, provider QuotaProvider) {
+	router.GET("/quota/providers", func(c *gin.Context) {
+		setNoStoreHeaders(c)
+		reader, ok := provider.(providerStatsReader)
+		if !ok {
+			c.JSON(503, gin.H{"error": "Provider statistics unavailable"})
+			return
+		}
+		providers, err := reader.ListStatsProviders(c.Request.Context())
+		if err != nil {
+			writeInternalError(c, "Provider statistics unavailable", err)
+			return
+		}
+		c.JSON(200, gin.H{"providers": providers})
+	})
+	serve := func(c *gin.Context, performance bool) {
+		setNoStoreHeaders(c)
+		reader, ok := provider.(providerStatsReader)
+		if !ok {
+			c.JSON(503, gin.H{"error": "Provider statistics unavailable"})
+			return
+		}
+		request, err := performanceRequest(c, "", c.Param("provider"))
+		if err != nil {
+			c.JSON(400, gin.H{"error": "Invalid provider filter"})
+			return
+		}
+		var result any
+		if performance {
+			result, err = reader.GetProviderPerformance(c.Request.Context(), request)
+		} else {
+			result, err = reader.GetProviderStats(c.Request.Context(), request)
+		}
+		if err != nil {
+			switch {
+			case errors.Is(err, quota.ErrNotFound):
+				c.JSON(404, gin.H{"error": "Provider not found"})
+			case errors.Is(err, quota.ErrValidation):
+				c.JSON(400, gin.H{"error": "Invalid provider filter"})
+			default:
+				writeInternalError(c, "Provider statistics unavailable", err)
+			}
+			return
+		}
+		c.JSON(200, result)
+	}
+	router.GET("/quota/providers/:provider/stats", func(c *gin.Context) { serve(c, false) })
+	router.GET("/quota/providers/:provider/performance", func(c *gin.Context) { serve(c, true) })
+}
