index 00000000..e7c87370
--- /dev/null
+++ b/web/src/components/usage/credentials/ProviderStatsDrawer.tsx
@@ -0,0 +1,116 @@
+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Modal } from '@/components/ui/Modal'
+import { Button } from '@/components/ui/Button'
+import { ProviderBrandIcon } from '@/components/ProviderBrandIcon'
+import { Chart } from '@/components/usage/charts/UsageChart'
+import type { ChartData, ChartOptions } from 'chart.js'
+import '@/lib/chartjs'
+import { ApiError, fetchProviderStats, fetchStatsProviders } from '@/lib/api'
+import type { ProviderStats } from '@/lib/types'
+import { startLiveRefresh } from '@/lib/live'
+import { useThemeStore } from '@/stores'
+import { buildUsageChartTooltipStyle, getUsageChartTheme } from '@/utils/usage/chartConfig'
+import { PerformancePanel } from './PerformancePanel'
+import { formatCredentialNumber } from './CredentialSectionShell'
+import detail from './CredentialDetailDrawer.module.scss'
+import styles from './WeeklyQuotaValuePanel.module.scss'
+import providerStyles from './ProviderStatsDrawer.module.scss'
+
+export function ProviderStatsDrawer({ open, initialProvider, onClose }: { open: boolean; initialProvider?: string; onClose: () => void }) {
+ const { t } = useTranslation()
+ const [providers, setProviders] = useState<string[]>([])
+ const [provider, setProvider] = useState(initialProvider ?? '')
+ const [revision, setRevision] = useState(0)
+ const [catalogError, setCatalogError] = useState(false)
+ const [tab, setTab] = useState('overview')
+ useEffect(() => {
+  if (!open) return
+  const controller = new AbortController()
+  fetchStatsProviders(controller.signal).then(values => {
+   if (controller.signal.aborted) return
+   setCatalogError(false)
+   setProviders(values)
+   setProvider(previous => values.includes(previous) ? previous : values.includes(initialProvider ?? '') ? initialProvider! : values[0] ?? '')
+  }).catch(() => { if (!controller.signal.aborted) setCatalogError(true) })
+  return () => controller.abort()
+ }, [open, initialProvider, revision])
+ return <Modal open={open} title={<div className={detail.drawerTitle}>
+  <ProviderBrandIcon providerType={provider} size={36} />
+  <div className={detail.drawerTitleText}><strong>{t('provider_stats.title', 'Provider statistics')}</strong><span>{t('provider_stats.subtitle', 'All accounts combined')}</span></div>
+ </div>} variant="drawer" width={980} className={detail.drawer} onClose={onClose}>
+  {open && <>
+   <div className={styles.panel}>
+    <div className={styles.filters}><label>{t('provider_stats.provider', 'Provider')}<select aria-label={t('provider_stats.provider', 'Provider')} value={provider} onChange={event => setProvider(event.target.value)}>{providers.map(value => <option key={value} value={value}>{value}</option>)}</select></label></div>
+    <p className={styles.note}>{t('provider_stats.scope', 'Combined recorded requests across all client keys and accounts for this provider, including disabled and historical accounts. The account-list filters do not limit this view.')}</p>
+    {catalogError && <div role="alert">{t('provider_stats.catalog_error', 'Unable to load providers.')} <Button size="sm" onClick={() => setRevision(value => value + 1)}>{t('common.retry', 'Retry')}</Button></div>}
+    {!catalogError && !providers.length && <p role="status">{t('provider_stats.empty', 'No provider data available yet.')}</p>}
+    <div className={styles.views} aria-label={t('provider_stats.views', 'Provider statistic views')}>
+     <button type="button" aria-pressed={tab === 'overview'} onClick={() => setTab('overview')}>{t('provider_stats.overview', 'Overview & API value')}</button>
+     <button type="button" aria-pressed={tab === 'speed'} onClick={() => setTab('speed')}>{t('analytics.response_speed', 'Response speed')}</button>
+    </div>
+   </div>
+   {provider && (tab === 'speed' ? <PerformancePanel key={provider} authIndex="" provider={provider} /> : <ProviderUsagePanel key={provider} provider={provider} />)}
+  </>}
+ </Modal>
+}
+
+export function ProviderUsagePanel({ provider }: { provider: string }) {
+ const { t, i18n } = useTranslation()
+ const isDark = useThemeStore(state => state.resolvedTheme) === 'dark'
+ const [days, setDays] = useState('7')
+ const [metric, setMetric] = useState('value')
+ const [revision, setRevision] = useState(0)
+ const [result, setResult] = useState<{ key: string; report?: ProviderStats; error?: string }>()
+ const key = JSON.stringify([provider, days, revision])
+ const loading = result?.key !== key
+ const report = loading ? undefined : result?.report
+ useEffect(() => startLiveRefresh(async signal => {
+  try {
+   const report = await fetchProviderStats(provider, days, signal)
+   if (!signal.aborted) setResult({ key, report })
+  } catch (error) {
+   if (!signal.aborted) setResult(previous => previous?.key === key && previous.report ? previous : { key, error: error instanceof ApiError ? error.message : t('provider_stats.load_error', 'Unable to load provider statistics.') })
+  }
+ }, ['usage', 'accounts']), [provider, days, key, t])
+ const money = (value: number, unpriced: number, requests: number) => unpriced > 0 && unpriced === requests ? '—' : (unpriced > 0 ? '≥ ' : '') + new Intl.NumberFormat(i18n.language, { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(value)
+ const percent = (value: number, total: number) => total ? new Intl.NumberFormat(i18n.language, { style: 'percent', maximumFractionDigits: 2 }).format(value / total) : '—'
+ const theme = getUsageChartTheme(isDark)
+ const label = metric === 'value' ? t('provider_stats.api_value', 'API-equivalent value') : metric === 'requests' ? t('usage_stats.total_requests', 'Requests') : t('usage_stats.total_tokens', 'Tokens')
+ const data: ChartData<'line', Array<number | null>, string> = {
+  labels: report?.days.map(point => new Date(point.day + 'T00:00:00Z').toLocaleDateString(i18n.language, { month: 'short', day: 'numeric', timeZone: 'UTC' })) ?? [],
+  datasets: [{ label, data: report?.days.map(point => metric === 'value' ? point.unpriced_requests ? null : point.total_cost_usd : metric === 'requests' ? point.requests : point.total_tokens) ?? [], borderColor: '#d49b00', backgroundColor: '#d49b00', borderWidth: 2, pointRadius: 3, tension: 0, spanGaps: false }],
+ }
+ const options: ChartOptions<'line'> = { responsive: true, maintainAspectRatio: false, animation: false,
+  plugins: { legend: { display: false }, tooltip: buildUsageChartTooltipStyle(theme) },
+  scales: { x: { ticks: { color: theme.textSecondary, maxTicksLimit: 8 }, grid: { display: false } }, y: { beginAtZero: true, ticks: { color: theme.textSecondary }, grid: { color: theme.grid } } },
+ }
+ const modeName = (mode: string) => mode === 'fast' ? t('weekly_quota.fast', 'Fast requested') : mode === 'normal' ? t('weekly_quota.normal', 'Normal') : t('weekly_quota.unknown', 'Mode not captured')
+ return <div className={styles.panel} data-provider-usage>
+  <div className={styles.toolbar}><label>{t('performance.period', 'Period')}{' '}<select aria-label={t('performance.period', 'Period')} value={days} onChange={event => setDays(event.target.value)}>{['7', '14', '30', '90'].map(value => <option key={value} value={value}>{t('provider_stats.days', '{{count}} days', { count: Number(value) })}</option>)}</select></label><Button size="sm" disabled={loading} onClick={() => setRevision(value => value + 1)}>{t('common.refresh', 'Refresh')}</Button></div>
+  {loading && <p role="status">{t('common.loading', 'Loading…')}</p>}
+  {!loading && result?.error && <p role="alert">{result.error}</p>}
+  {report && <>
+   <p className={styles.note}>{new Date(report.range_start).toLocaleString(i18n.language)} – {new Date(report.generated_at).toLocaleString(i18n.language)} · {t('provider_stats.account_count', '{{count}} accounts with requests', { count: report.accounts })}</p>
+   <div className={providerStyles.summary}>
+    {[
+     [t('usage_stats.total_requests', 'Requests'), formatCredentialNumber(report.totals.requests)],
+     [t('usage_stats.success_rate', 'Success rate'), percent(report.totals.requests - report.totals.failed, report.totals.requests)],
+     [t('usage_stats.total_tokens', 'Tokens'), formatCredentialNumber(report.totals.total_tokens)],
+     [t('usage_stats.cache_rate', 'Cache rate'), percent(report.totals.cache_read_tokens, report.totals.input_tokens)],
+     [t('provider_stats.api_value', 'API-equivalent value'), money(report.totals.total_cost_usd, report.totals.unpriced_requests, report.totals.requests)],
+    ].map(([title, value]) => <div key={title} className={detail.summaryMetric}><span>{title}</span><strong>{value}</strong></div>)}
+   </div>
+   <p className={styles.note}>{t('provider_stats.value_note', 'API-equivalent value sums stored request costs; it is not a subscription charge. Account quota percentages and reset times stay separate because account plans and allowances can differ.')}</p>
+   {report.totals.unpriced_requests > 0 && <p className={styles.note} role="note">{t('provider_stats.unpriced', '{{count}} requests have no stored price. ≥ shows the priced portion only; incomplete daily values appear as gaps.', { count: report.totals.unpriced_requests })}</p>}
+   {report.totals.requests === 0 ? <p role="status" className={styles.empty}>{t('provider_stats.no_requests', 'No recorded requests in this period.')}</p> : <>
+    <section className={styles.card}>
+     <div className={styles.sectionHeading}><h4>{t('provider_stats.daily', 'Combined daily activity')}</h4><span className={styles.meta}>UTC</span></div>
+     <label>{t('provider_stats.measure', 'Measure')}{' '}<select aria-label={t('provider_stats.measure', 'Measure')} value={metric} onChange={event => setMetric(event.target.value)}><option value="value">{t('provider_stats.api_value', 'API-equivalent value')}</option><option value="requests">{t('usage_stats.total_requests', 'Requests')}</option><option value="tokens">{t('usage_stats.total_tokens', 'Tokens')}</option></select></label>
+     <div className={styles.chart}><Chart type="line" data={data} options={options} role="img" aria-label={t('provider_stats.daily', 'Combined daily activity')} /></div>
+    </section>
+    <div className={styles.scroll}><table><thead><tr><th>{t('provider_stats.model', 'Model / mode')}</th><th>{t('usage_stats.total_requests', 'Requests')}</th><th>{t('usage_stats.success_rate', 'Success rate')}</th><th>{t('usage_stats.total_tokens', 'Tokens')}</th><th>{t('provider_stats.api_value', 'API-equivalent value')}</th></tr></thead><tbody>{report.groups.map(group => <tr key={JSON.stringify([group.model, group.mode])}><td>{group.model || '—'}<small>{modeName(group.mode)}</small></td><td>{formatCredentialNumber(group.requests)}</td><td>{percent(group.requests - group.failed, group.requests)}</td><td>{formatCredentialNumber(group.total_tokens)}</td><td>{money(group.total_cost_usd, group.unpriced_requests, group.requests)}</td></tr>)}</tbody></table></div>
+   </>}
+  </>}
+ </div>
+}
