+package api
+
+import (
+	"context"
+	"errors"
+	"net/http"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/quota"
+	"github.com/gin-gonic/gin"
+)
+
+type quotaAutoResetProvider interface {
+	ListAutoResets(context.Context) ([]entities.QuotaAutoReset, error)
+	SetAutoReset(context.Context, string, int64, bool) (entities.QuotaAutoReset, error)
+}
+
+func registerQuotaAutoResetRoutes(router gin.IRoutes, provider quotaAutoResetProvider) {
+	router.GET("/quota/auto-resets", func(c *gin.Context) {
+		states, err := provider.ListAutoResets(c.Request.Context())
+		if err != nil {
+			writeInternalError(c, "quota auto-reset status unavailable", err)
+			return
+		}
+		c.JSON(http.StatusOK, gin.H{"items": states})
+	})
+	router.PUT("/quota/auto-resets/:auth_index", func(c *gin.Context) {
+		var request struct {
+			Armed    *bool  `json:"armed" binding:"required"`
+			Revision *int64 `json:"revision" binding:"required"`
+		}
+		c.Request.Body = http.MaxBytesReader(c.Writer, c.Request.Body, 1024)
+		if err := c.ShouldBindJSON(&request); err != nil {
+			c.JSON(http.StatusBadRequest, gin.H{"error": "armed and revision are required"})
+			return
+		}
+		state, err := provider.SetAutoReset(c.Request.Context(), c.Param("auth_index"), *request.Revision, *request.Armed)
+		switch {
+		case errors.Is(err, quota.ErrValidation), errors.Is(err, quota.ErrUnsupportedType):
+			c.JSON(http.StatusBadRequest, gin.H{"error": "auto-reset requires an enabled Codex credential"})
+		case errors.Is(err, quota.ErrNotFound):
+			c.JSON(http.StatusNotFound, gin.H{"error": "credential not found"})
+		case errors.Is(err, quota.ErrAutoResetConflict):
+			c.JSON(http.StatusConflict, gin.H{"error": "auto-reset state changed"})
+		case err != nil:
+			writeInternalError(c, "quota auto-reset could not be saved", err)
+		default:
+			c.JSON(http.StatusOK, state)
+		}
+	})
+}
