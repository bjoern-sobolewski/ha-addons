+package quota
+
+import (
+	"context"
+	"errors"
+	"slices"
+	"testing"
+	"time"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/timeutil"
+	"gorm.io/gorm"
+)
+
+type autoResetProviderFixture struct {
+	used               float64
+	creditCount        int
+	resetIDs           []string
+	outcome            string
+	duringCreditLookup func()
+}
+
+func (f *autoResetProviderFixture) Check(context.Context, ProviderInput) (ProviderOutput, error) {
+	weekly := &CodexUsageWindow{
+		UsedPercent: f.used, HasUsedPercent: true,
+		LimitWindowSeconds: quotaWindowSevenDaySeconds, HasLimitWindowSeconds: true,
+		ResetAt: time.Now().Add(time.Hour).Unix(), HasResetAt: true,
+	}
+	return ProviderOutput{Provider: "codex", Result: CodexResult{
+		Usage: &CodexUsagePayload{RateLimit: &CodexRateLimitInfo{SecondaryWindow: weekly}},
+	}}, nil
+}
+
+func (f *autoResetProviderFixture) ListResetCredits(context.Context, ProviderInput) (ProviderResetCreditsOutput, error) {
+	if f.duringCreditLookup != nil {
+		f.duringCreditLookup()
+	}
+	return ProviderResetCreditsOutput{AvailableCount: &f.creditCount}, nil
+}
+
+func (f *autoResetProviderFixture) Reset(_ context.Context, input ProviderInput) (ProviderResetOutput, error) {
+	f.resetIDs = append(f.resetIDs, input.ResetRequestID)
+	return ProviderResetOutput{Code: f.outcome}, nil
+}
+
+func autoResetFixture(t *testing.T, provider *autoResetProviderFixture) (*Service, *gorm.DB, string) {
+	t.Helper()
+	service, db, _ := apiQuotaTestService(t)
+	service.registry = NewProviderRegistry(map[string]ProviderHandler{"codex": provider})
+	identity := entities.UsageIdentity{AuthType: entities.UsageIdentityAuthTypeCredential, Identity: "codex-fixture", Type: "codex", Provider: "codex"}
+	if err := db.Create(&identity).Error; err != nil {
+		t.Fatal(err)
+	}
+	return service, db, identity.Identity
+}
+
+func requireAutoResetStatus(t *testing.T, service *Service, status string) entities.QuotaAutoReset {
+	t.Helper()
+	items, err := service.ListAutoResets(context.Background())
+	if err != nil || len(items) != 1 || items[0].Status != status {
+		t.Fatalf("expected one %s activation, got %+v (%v)", status, items, err)
+	}
+	return items[0]
+}
+
+func setAutoResetQuotaCache(service *Service, authIndex string, used float64, captured, reset time.Time, duration int64, scope string) {
+	service.refreshMu.Lock()
+	defer service.refreshMu.Unlock()
+	service.refreshTasks[authIndex] = &RefreshTaskRecord{
+		AuthIndex: authIndex, Type: "codex", Status: RefreshTaskStatusCompleted,
+		Quota: &CheckResponse{Quota: []QuotaRow{{
+			Scope: scope, UsedPercent: &used, Window: &QuotaWindow{Seconds: &duration},
+			CapturedAt: captured, ResetAt: timeutil.FormatStorageTime(reset),
+		}}},
+	}
+}
+
+func TestAutoResetWaitsForWeeklyExhaustionAndRedeemsOnce(t *testing.T) {
+	ctx := context.Background()
+	provider := &autoResetProviderFixture{used: 99.9, creditCount: 2, outcome: "reset"}
+	service, _, authIndex := autoResetFixture(t, provider)
+	armed, err := service.SetAutoReset(ctx, authIndex, 0, true)
+	if err != nil || armed.Status != autoResetArmed || !claudeUUIDPattern.MatchString(armed.RequestID) {
+		t.Fatalf("arming failed: %+v (%v)", armed, err)
+	}
+	service.checkActiveAutoResets(ctx)
+	requireAutoResetStatus(t, service, autoResetArmed)
+	provider.used = 100
+	now := time.Now()
+	for _, fixture := range []struct {
+		scope    string
+		duration int64
+		observed time.Time
+		reset    time.Time
+	}{
+		{"window", quotaWindowFiveHourSeconds, now, now.Add(time.Hour)},
+		{"additional", quotaWindowSevenDaySeconds, now, now.Add(time.Hour)},
+		{"window", quotaWindowSevenDaySeconds, now.Add(-16 * time.Minute), now.Add(time.Hour)},
+		{"window", quotaWindowSevenDaySeconds, now, now.Add(-time.Second)},
+	} {
+		setAutoResetQuotaCache(service, authIndex, 100, fixture.observed, fixture.reset, fixture.duration, fixture.scope)
+		service.checkActiveAutoResets(ctx)
+		requireAutoResetStatus(t, service, autoResetArmed)
+	}
+	setAutoResetQuotaCache(service, authIndex, 100, now, now.Add(time.Hour), quotaWindowSevenDaySeconds, "window")
+	service.checkActiveAutoResets(ctx)
+	requireAutoResetStatus(t, service, autoResetSucceeded)
+	service.checkActiveAutoResets(ctx)
+	if !slices.Equal(provider.resetIDs, []string{armed.RequestID}) {
+		t.Fatalf("expected one redemption with the activation ID, got %v", provider.resetIDs)
+	}
+	if _, err := service.SetAutoReset(ctx, authIndex, 0, true); !errors.Is(err, ErrAutoResetConflict) {
+		t.Fatalf("stale arming request accepted: %v", err)
+	}
+}
+
+func TestAutoResetConsumesActivationWithoutCredit(t *testing.T) {
+	ctx := context.Background()
+	provider := &autoResetProviderFixture{used: 100}
+	service, _, authIndex := autoResetFixture(t, provider)
+	if _, err := service.SetAutoReset(ctx, authIndex, 0, true); err != nil {
+		t.Fatal(err)
+	}
+	service.checkActiveAutoResets(ctx)
+	none := requireAutoResetStatus(t, service, autoResetNoCredit)
+	provider.creditCount = 1
+	service.checkActiveAutoResets(ctx)
+	if len(provider.resetIDs) != 0 {
+		t.Fatalf("a later credit reactivated auto-reset: %v", provider.resetIDs)
+	}
+	armed, err := service.SetAutoReset(ctx, authIndex, none.Revision, true)
+	if err != nil || armed.RequestID == none.RequestID {
+		t.Fatalf("re-arm did not establish a new activation: %+v (%v)", armed, err)
+	}
+}
+
+func TestAutoResetCancelsDuringCheckAndSerializesWithManualReset(t *testing.T) {
+	ctx := context.Background()
+	provider := &autoResetProviderFixture{used: 100, creditCount: 1}
+	service, _, authIndex := autoResetFixture(t, provider)
+	armed, err := service.SetAutoReset(ctx, authIndex, 0, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	provider.duringCreditLookup = func() {
+		_, err := service.Reset(ctx, ResetRequest{AuthIndex: authIndex, RequestID: newAutoResetRequestID()})
+		if !errors.Is(err, ErrResetInProgress) {
+			t.Fatalf("manual reset was not serialized: %v", err)
+		}
+		if _, err := service.SetAutoReset(ctx, authIndex, armed.Revision, false); err != nil {
+			t.Fatalf("could not cancel during eligibility checks: %v", err)
+		}
+	}
+	service.checkActiveAutoResets(ctx)
+	requireAutoResetStatus(t, service, autoResetCancelled)
+	if len(provider.resetIDs) != 0 {
+		t.Fatal("cancelled activation redeemed a credit")
+	}
+}
+
+func TestAutoResetRecoveryDisarmsWithoutRedeeming(t *testing.T) {
+	ctx := context.Background()
+	provider := &autoResetProviderFixture{used: 100, creditCount: 1}
+	service, db, authIndex := autoResetFixture(t, provider)
+	armed, err := service.SetAutoReset(ctx, authIndex, 0, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := service.changeAutoResetStatus(ctx, armed, autoResetRunning); err != nil {
+		t.Fatal(err)
+	}
+	restarted := NewServiceWithRegistry(db, service.registry)
+	t.Cleanup(restarted.StopRefreshTasks)
+	restarted.checkActiveAutoResets(ctx)
+	interrupted := requireAutoResetStatus(t, restarted, autoResetUnconfirmed)
+	if interrupted.RequestID != armed.RequestID || len(provider.resetIDs) != 0 {
+		t.Fatal("recovery did not preserve the attempt without redeeming again")
+	}
+}
+
+func TestAutoResetProtectsReplacedCredentials(t *testing.T) {
+	ctx := context.Background()
+	provider := &autoResetProviderFixture{used: 100, creditCount: 1}
+	service, db, authIndex := autoResetFixture(t, provider)
+	if _, err := service.SetAutoReset(ctx, authIndex, 0, true); err != nil {
+		t.Fatal(err)
+	}
+	provider.duringCreditLookup = func() {
+		if err := db.Model(&entities.UsageIdentity{}).Where("identity = ?", authIndex).Update("account_id", "replaced").Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	service.checkActiveAutoResets(ctx)
+	requireAutoResetStatus(t, service, autoResetAccountChanged)
+	if len(provider.resetIDs) != 0 {
+		t.Fatal("credit redeemed for a replacement account")
+	}
+}
