+package entities
+
+// QuotaAutoReset stores one activation and its latest outcome per CPA credential.
+type QuotaAutoReset struct {
+	AuthIndex             string `gorm:"primaryKey;size:191" json:"auth_index"`
+	IdentityID            int64  `json:"-"`
+	AccountID             string `gorm:"size:191" json:"-"`
+	RequestID             string `gorm:"size:36" json:"-"`
+	Revision              int64  `gorm:"not null" json:"revision"`
+	Status                string `gorm:"not null;size:32;index" json:"status"`
+	LastCheckedAtUnixNano int64  `json:"-"`
+}
