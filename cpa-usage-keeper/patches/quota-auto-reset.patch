diff --git a/internal/quota/auto_reset.go b/internal/quota/auto_reset.go
new file mode 100644
index 00000000..c014d025
--- /dev/null
+++ b/internal/quota/auto_reset.go
@@ -0,0 +1,344 @@
+package quota
+
+import (
+	"context"
+	"crypto/rand"
+	"errors"
+	"fmt"
+	"math"
+	"strings"
+	"time"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/repository"
+	"cpa-usage-keeper/internal/timeutil"
+
+	"github.com/sirupsen/logrus"
+	"gorm.io/gorm"
+	"gorm.io/gorm/clause"
+	"gorm.io/plugin/dbresolver"
+)
+
+const (
+	autoResetArmed          = "armed"
+	autoResetRunning        = "running"
+	autoResetCancelled      = "cancelled"
+	autoResetNoCredit       = "no_credit"
+	autoResetSucceeded      = "reset"
+	autoResetRecoveryFailed = "recovery_failed"
+	autoResetUnconfirmed    = "unconfirmed"
+	autoResetFailed         = "failed"
+	autoResetAccountChanged = "account_changed"
+
+	autoResetCheckInterval = 3 * time.Second
+	autoResetMaxQuotaAge   = 15 * time.Minute
+	autoResetTimeout       = 45 * time.Second
+)
+
+var ErrAutoResetConflict = errors.New("auto-reset state changed")
+
+func (s *Service) ListAutoResets(ctx context.Context) ([]entities.QuotaAutoReset, error) {
+	states := make([]entities.QuotaAutoReset, 0)
+	err := s.autoResetDB(ctx).Find(&states).Error
+	return states, err
+}
+
+func (s *Service) SetAutoReset(ctx context.Context, authIndex string, revision int64, armed bool) (entities.QuotaAutoReset, error) {
+	var state entities.QuotaAutoReset
+	authIndex = strings.TrimSpace(authIndex)
+	if authIndex == "" || len(authIndex) > 191 || revision < 0 {
+		return state, ErrValidation
+	}
+
+	if err := s.autoResetDB(ctx).Where("auth_index = ?", authIndex).Limit(1).Find(&state).Error; err != nil {
+		return state, err
+	}
+	if state.Revision != revision || state.Status == autoResetRunning {
+		return state, ErrAutoResetConflict
+	}
+	if armed == (state.Status == autoResetArmed) {
+		return state, ErrAutoResetConflict
+	}
+	if !armed {
+		return s.changeAutoResetStatus(ctx, state, autoResetCancelled)
+	}
+
+	identity, _, err := s.autoResetCredential(ctx, authIndex)
+	if err != nil {
+		return state, err
+	}
+	next := entities.QuotaAutoReset{
+		AuthIndex: authIndex, IdentityID: identity.ID, AccountID: optionalAccountID(identity.AccountID),
+		RequestID: newAutoResetRequestID(), Revision: revision + 1, Status: autoResetArmed,
+	}
+	db := s.autoResetDB(ctx)
+	var write *gorm.DB
+	if revision == 0 {
+		write = db.Clauses(clause.OnConflict{DoNothing: true}).Create(&next)
+	} else {
+		write = autoResetVersion(db, state).Select("identity_id", "account_id", "request_id", "revision", "status", "last_checked_at_unix_nano").Updates(&next)
+	}
+	if write.Error != nil {
+		return state, write.Error
+	}
+	if write.RowsAffected != 1 {
+		return state, ErrAutoResetConflict
+	}
+	s.Live.Publish("auto_reset")
+	return next, nil
+}
+
+func (s *Service) autoResetDB(ctx context.Context) *gorm.DB {
+	return s.db.WithContext(ctx).Clauses(dbresolver.Write).Model(&entities.QuotaAutoReset{})
+}
+
+func autoResetVersion(db *gorm.DB, state entities.QuotaAutoReset) *gorm.DB {
+	return db.Where("auth_index = ? AND revision = ?", state.AuthIndex, state.Revision)
+}
+
+func (s *Service) changeAutoResetStatus(ctx context.Context, state entities.QuotaAutoReset, status string) (entities.QuotaAutoReset, error) {
+	write := autoResetVersion(s.autoResetDB(ctx), state).Updates(map[string]any{
+		"status": status, "revision": state.Revision + 1,
+	})
+	if write.Error != nil {
+		return state, write.Error
+	}
+	if write.RowsAffected != 1 {
+		return state, ErrAutoResetConflict
+	}
+	state.Status = status
+	state.Revision++
+	s.Live.Publish("auto_reset")
+	return state, nil
+}
+
+func (s *Service) autoResetCredential(ctx context.Context, authIndex string) (entities.UsageIdentity, ProviderHandler, error) {
+	identity, err := repository.GetActiveCredentialUsageIdentityByAuthIndex(ctx, s.db.Clauses(dbresolver.Write), authIndex)
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return identity, nil, ErrNotFound
+	}
+	if err != nil {
+		return identity, nil, err
+	}
+	provider, handler, ok := s.resolveQuotaHandlerForIdentity(identity)
+	if !ok || provider != "codex" || (identity.Disabled != nil && *identity.Disabled) {
+		return identity, nil, ErrUnsupportedType
+	}
+	return identity, handler, nil
+}
+
+func newAutoResetRequestID() string {
+	var bytes [16]byte
+	rand.Read(bytes[:])
+	bytes[6] = bytes[6]&0x0f | 0x40
+	bytes[8] = bytes[8]&0x3f | 0x80
+	return fmt.Sprintf("%x-%x-%x-%x-%x", bytes[:4], bytes[4:6], bytes[6:8], bytes[8:10], bytes[10:])
+}
+
+func (s *Service) RunAutoReset(ctx context.Context) {
+	ticker := time.NewTicker(autoResetCheckInterval)
+	defer ticker.Stop()
+	for ctx.Err() == nil {
+		s.checkActiveAutoResets(ctx)
+		select {
+		case <-ctx.Done():
+			return
+		case <-ticker.C:
+		}
+	}
+}
+
+func (s *Service) checkActiveAutoResets(ctx context.Context) {
+	var states []entities.QuotaAutoReset
+	if err := s.autoResetDB(ctx).Where("status IN ?", []string{autoResetArmed, autoResetRunning}).Find(&states).Error; err != nil {
+		if ctx.Err() == nil {
+			logrus.WithError(err).Warn("could not read active quota auto-resets")
+		}
+		return
+	}
+	for _, state := range states {
+		if ctx.Err() != nil {
+			return
+		}
+		err := s.processAutoReset(ctx, state)
+		if err != nil && !errors.Is(err, ErrAutoResetConflict) && ctx.Err() == nil {
+			logrus.WithError(err).Warn("could not process a quota auto-reset")
+		}
+	}
+}
+
+func (s *Service) processAutoReset(ctx context.Context, state entities.QuotaAutoReset) error {
+	if state.Status == autoResetRunning {
+		// The worker handles one attempt at a time. A running row here was interrupted,
+		// and CPA may already have accepted its saved request ID.
+		_, err := s.changeAutoResetStatus(ctx, state, autoResetUnconfirmed)
+		return err
+	}
+	attemptCtx, cancel := context.WithTimeout(ctx, autoResetTimeout)
+	defer cancel()
+	return s.checkAutoReset(attemptCtx, state, time.Now())
+}
+
+func (s *Service) hasFreshExhaustedWeeklyQuota(state entities.QuotaAutoReset, now time.Time) bool {
+	s.refreshMu.Lock()
+	defer s.refreshMu.Unlock()
+	task := s.refreshTasks[state.AuthIndex]
+	if task == nil || task.Status != RefreshTaskStatusCompleted || task.Type != "codex" || task.Quota == nil {
+		return false
+	}
+
+	for _, row := range task.Quota.Quota {
+		if row.Scope != "window" || row.Window == nil || row.Window.Seconds == nil || *row.Window.Seconds != quotaWindowSevenDaySeconds ||
+			row.UsedPercent == nil || *row.UsedPercent < 100 || math.IsNaN(*row.UsedPercent) || math.IsInf(*row.UsedPercent, 0) ||
+			row.CapturedAt.IsZero() || row.CapturedAt.UnixNano() <= state.LastCheckedAtUnixNano || row.CapturedAt.After(now) || now.Sub(row.CapturedAt) > autoResetMaxQuotaAge {
+			continue
+		}
+		resetAt, err := timeutil.ParseStorageTime(row.ResetAt)
+		if row.ResetAt == "" && row.ResetAfterSeconds != nil && *row.ResetAfterSeconds > 0 && *row.ResetAfterSeconds <= quotaWindowSevenDaySeconds {
+			resetAt, err = row.CapturedAt.Add(time.Duration(*row.ResetAfterSeconds)*time.Second), nil
+		}
+		if err == nil && resetAt.After(now) {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *Service) checkAutoReset(ctx context.Context, state entities.QuotaAutoReset, now time.Time) error {
+	identity, handler, err := s.autoResetCredential(ctx, state.AuthIndex)
+	if err != nil || !matchesAutoResetCredential(state, identity) {
+		return s.handleAutoResetCredentialChange(ctx, state, err)
+	}
+	if state.LastCheckedAtUnixNano != 0 && !s.hasFreshExhaustedWeeklyQuota(state, now) {
+		return nil
+	}
+	// Check and redeem under the same account lock used by Keeper's manual action.
+	if !s.beginReset(state.AuthIndex) {
+		return nil
+	}
+	defer s.finishReset(state.AuthIndex)
+
+	write := autoResetVersion(s.autoResetDB(ctx), state).Update("last_checked_at_unix_nano", now.UnixNano())
+	if write.Error != nil {
+		return write.Error
+	}
+	if write.RowsAffected != 1 {
+		return ErrAutoResetConflict
+	}
+
+	input := ProviderInput{Identity: identity, ResetRequestID: state.RequestID}
+	output, err := handler.Check(ctx, input)
+	if err != nil {
+		return nil
+	}
+	resetAt := exhaustedCodexWeeklyResetAt(state.AuthIndex, output, time.Now())
+	if resetAt.IsZero() {
+		return nil
+	}
+
+	lister, canList := handler.(ProviderResetCreditLister)
+	resetter, canReset := handler.(ProviderResetter)
+	if !canList || !canReset {
+		_, err = s.changeAutoResetStatus(ctx, state, autoResetFailed)
+		return err
+	}
+	credits, err := lister.ListResetCredits(ctx, input)
+	if err != nil {
+		_, err = s.changeAutoResetStatus(ctx, state, autoResetFailed)
+		return err
+	}
+	if !availableAutoResetCredit(credits, time.Now()) {
+		_, err = s.changeAutoResetStatus(ctx, state, autoResetNoCredit)
+		return err
+	}
+	current, _, err := s.autoResetCredential(ctx, state.AuthIndex)
+	if err != nil || !matchesAutoResetCredential(state, current) {
+		return s.handleAutoResetCredentialChange(ctx, state, err)
+	}
+	if !resetAt.After(time.Now()) {
+		return nil
+	}
+	input.Identity = current
+	// Settings can be cancelled during the checks. A compare-and-set claims the
+	// original activation before the only call that can spend a credit.
+	running, err := s.changeAutoResetStatus(ctx, state, autoResetRunning)
+	if err != nil {
+		return err
+	}
+	result, resetErr := resetter.Reset(ctx, input)
+	status := autoResetOutcome(result, resetErr)
+	// A deadline while calling CPA must still produce a durable terminal outcome.
+	saveCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 5*time.Second)
+	defer cancel()
+	if _, err := s.changeAutoResetStatus(saveCtx, running, status); err != nil {
+		return err
+	}
+	if status == autoResetSucceeded || status == autoResetRecoveryFailed {
+		_, err = s.Refresh(ctx, RefreshRequest{AuthIndexes: []string{state.AuthIndex}, Source: RefreshSourceManual})
+	}
+	return err
+}
+
+func matchesAutoResetCredential(state entities.QuotaAutoReset, identity entities.UsageIdentity) bool {
+	return identity.ID == state.IdentityID && optionalAccountID(identity.AccountID) == state.AccountID
+}
+
+func (s *Service) handleAutoResetCredentialChange(ctx context.Context, state entities.QuotaAutoReset, lookupErr error) error {
+	if lookupErr != nil && !errors.Is(lookupErr, ErrNotFound) && !errors.Is(lookupErr, ErrUnsupportedType) {
+		return lookupErr
+	}
+	_, err := s.changeAutoResetStatus(ctx, state, autoResetAccountChanged)
+	return err
+}
+
+func exhaustedCodexWeeklyResetAt(authIndex string, output ProviderOutput, now time.Time) time.Time {
+	usage := codexUsagePayloadFromProviderOutput(output)
+	if usage == nil || usage.RateLimit == nil {
+		return time.Time{}
+	}
+	windows := []struct {
+		role   string
+		window *CodexUsageWindow
+	}{
+		{"primary", usage.RateLimit.PrimaryWindow},
+		{"secondary", usage.RateLimit.SecondaryWindow},
+	}
+	for _, candidate := range windows {
+		observation, valid := buildCodexMainQuotaObservation(authIndex, candidate.role, candidate.window, now)
+		// Use the raw value. History and the dashboard can round near-zero quotas.
+		if valid && observation.WindowSeconds == quotaWindowSevenDaySeconds && candidate.window.UsedPercent >= 100 && observation.ResetAt.After(now) {
+			return observation.ResetAt
+		}
+	}
+	return time.Time{}
+}
+
+func availableAutoResetCredit(options ProviderResetCreditsOutput, now time.Time) bool {
+	if options.AvailableCount != nil {
+		return *options.AvailableCount > 0
+	}
+	for _, credit := range options.Credits {
+		expiry, err := time.Parse(time.RFC3339Nano, credit.ExpiresAt)
+		if err == nil && expiry.After(now) {
+			return true
+		}
+	}
+	return false
+}
+
+func autoResetOutcome(result ProviderResetOutput, err error) string {
+	if err != nil {
+		return autoResetUnconfirmed
+	}
+	switch result.Code {
+	case "reset", "already_redeemed", "already_used":
+		if result.RecoveryFailed {
+			return autoResetRecoveryFailed
+		}
+		return autoResetSucceeded
+	case "unknown", "":
+		return autoResetUnconfirmed
+	default:
+		return autoResetFailed
+	}
+}
