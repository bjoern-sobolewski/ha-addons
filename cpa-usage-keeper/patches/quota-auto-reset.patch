diff --git a/web/src/components/usage/credentials/QuotaAutoResetControl.tsx b/web/src/components/usage/credentials/QuotaAutoResetControl.tsx
new file mode 100644
index 00000000..64c3b6b2
--- /dev/null
+++ b/web/src/components/usage/credentials/QuotaAutoResetControl.tsx
@@ -0,0 +1,140 @@
+import { useCallback, useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Button } from '@/components/ui/Button'
+import { Modal } from '@/components/ui/Modal'
+import { accountActionError } from '@/lib/accountErrors'
+import { apiFetch, apiPath, parseApiError } from '@/lib/api'
+import { startLiveRefresh } from '@/lib/live'
+import styles from './CredentialSections.module.scss'
+
+type AutoResetStatus =
+  | 'armed'
+  | 'running'
+  | 'cancelled'
+  | 'no_credit'
+  | 'reset'
+  | 'recovery_failed'
+  | 'unconfirmed'
+  | 'failed'
+  | 'account_changed'
+
+interface AutoResetState {
+  auth_index: string
+  revision: number
+  status: AutoResetStatus
+}
+
+export function useQuotaAutoResets(enabled: boolean) {
+  const [states, setStates] = useState<Record<string, AutoResetState> | null>(null)
+  const [loadError, setLoadError] = useState(false)
+
+  const merge = useCallback((items: AutoResetState[]) => {
+    setStates(previous => {
+      const next = { ...previous }
+      for (const item of items) {
+        if ((next[item.auth_index]?.revision ?? 0) < item.revision) next[item.auth_index] = item
+      }
+      return next
+    })
+  }, [])
+
+  useEffect(() => {
+    if (!enabled) return
+    return startLiveRefresh(async signal => {
+      try {
+        const response = await apiFetch(apiPath('/quota/auto-resets'), { signal })
+        if (!response.ok) throw new Error('Quota auto-reset status unavailable')
+        const result = await response.json() as { items: AutoResetState[] }
+        if (signal.aborted) return
+        merge(result.items)
+        setLoadError(false)
+      } catch {
+        if (!signal.aborted) setLoadError(true)
+      }
+    }, ['auto_reset', 'clock'])
+  }, [enabled, merge])
+
+  const setArmed = async (authIndex: string, revision: number, armed: boolean) => {
+    const response = await apiFetch(apiPath(`/quota/auto-resets/${encodeURIComponent(authIndex)}`), {
+      method: 'PUT',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ armed, revision }),
+    })
+    if (!response.ok) await parseApiError(response, 'Could not save auto-reset')
+    merge([await response.json() as AutoResetState])
+  }
+
+  return { states, loadError, setArmed }
+}
+
+interface AutoResetControlProps {
+  authIndex: string
+  displayName: string
+  disabled?: boolean
+  autoResets: ReturnType<typeof useQuotaAutoResets>
+}
+
+export function QuotaAutoResetControl({ authIndex, displayName, disabled, autoResets }: AutoResetControlProps) {
+  const { t } = useTranslation()
+  const [confirmRevision, setConfirmRevision] = useState<number | null>(null)
+  const [saving, setSaving] = useState(false)
+  const [error, setError] = useState('')
+  const state = autoResets.states?.[authIndex]
+  const revision = state?.revision ?? 0
+  const armed = state?.status === 'armed'
+  const running = state?.status === 'running'
+
+  const save = async (nextArmed: boolean, expectedRevision: number) => {
+    setSaving(true)
+    setError('')
+    try {
+      await autoResets.setArmed(authIndex, expectedRevision, nextArmed)
+      setConfirmRevision(null)
+    } catch (caught) {
+      setError(accountActionError(caught, t('usage_stats.credentials_auto_reset_save_failed')))
+    } finally {
+      setSaving(false)
+    }
+  }
+
+  return (
+    <div className={styles.credentialAutoReset}>
+      <Button
+        type="button"
+        size="sm"
+        variant="ghost"
+        disabled={saving || running || !autoResets.states || (!armed && disabled)}
+        onClick={() => {
+          if (armed) void save(false, revision)
+          else { setError(''); setConfirmRevision(revision) }
+        }}
+      >
+        {t(armed ? 'usage_stats.credentials_auto_reset_cancel' : 'usage_stats.credentials_auto_reset_button')}
+      </Button>
+      {state && <span role="status">{t(`usage_stats.credentials_auto_reset_${state.status}`)}</span>}
+      {!autoResets.states && autoResets.loadError && <span role="status">{t('usage_stats.credentials_auto_reset_load_failed')}</span>}
+      {error && confirmRevision === null && <span role="alert">{error}</span>}
+      <Modal
+        open={confirmRevision !== null}
+        title={t('usage_stats.credentials_auto_reset_button')}
+        onClose={() => setConfirmRevision(null)}
+        closeDisabled={saving}
+        footer={
+          <>
+            <Button variant="secondary" disabled={saving} onClick={() => setConfirmRevision(null)}>{t('common.cancel')}</Button>
+            <Button
+              loading={saving}
+              disabled={disabled || confirmRevision !== revision}
+              onClick={() => { if (confirmRevision !== null) void save(true, confirmRevision) }}
+            >
+              {t('usage_stats.credentials_auto_reset_arm')}
+            </Button>
+          </>
+        }
+      >
+        <p>{t('usage_stats.credentials_auto_reset_confirm', { name: displayName })}</p>
+        {error && <p role="alert">{error}</p>}
+      </Modal>
+    </div>
+  )
+}
