diff --git a/web/src/components/usage/credentials/QuotaPolicyPanel.tsx b/web/src/components/usage/credentials/QuotaPolicyPanel.tsx
new file mode 100644
index 00000000..a90d583e
--- /dev/null
+++ b/web/src/components/usage/credentials/QuotaPolicyPanel.tsx
@@ -0,0 +1,136 @@
+import { useState, useSyncExternalStore } from 'react'
+import { apiFetch, apiPath } from '@/lib/api'
+import { startLiveRefresh } from '@/lib/live'
+import styles from './QuotaPolicyPanel.module.scss'
+
+export interface PolicyWindow {
+  id: string
+  label: string
+  minimum_remaining_percent: number | null
+  remaining_percent: number | null
+  observed_at: string
+  reset_at: string
+  source: string
+  excluded: boolean
+  reason: string
+}
+export interface AccountPolicy {
+  auth_index: string
+  provider: string
+  manually_disabled: boolean
+  thresholds: Record<string, number>
+  windows: PolicyWindow[]
+  excluded: boolean
+  reason: string
+}
+interface Snapshot { items: AccountPolicy[]; error: boolean }
+const emptySnapshot: Snapshot = { items: [], error: false }
+let snapshot: Snapshot = emptySnapshot
+const listeners = new Set<() => void>()
+let stop: (() => void) | undefined
+const emit = () => listeners.forEach(listener => listener())
+async function refresh(signal?: AbortSignal) {
+  try {
+    const response = await apiFetch(apiPath('/quota/policies'), { signal })
+    if (!response.ok) throw new Error('Quota policy unavailable')
+    const result = await response.json() as { items: AccountPolicy[] }
+    if (signal?.aborted) return
+    snapshot = { items: result.items, error: false }
+  } catch {
+    if (signal?.aborted) return
+    snapshot = { ...snapshot, error: true }
+  }
+  emit()
+}
+function subscribe(listener: () => void) {
+  listeners.add(listener)
+  // One coalesced cached-state read for all mounted cards, using the existing SSE.
+  if (listeners.size === 1) stop = startLiveRefresh(refresh, ['quota', 'accounts', 'clock'])
+  return () => {
+    listeners.delete(listener)
+    if (!listeners.size) { stop?.(); stop = undefined; snapshot = { items: [], error: false } }
+  }
+}
+
+export const policyReason = (reason: string) => ({
+  minimum_reached: 'Minimum reached',
+  quota_unknown: 'Quota unknown — awaiting observation',
+  quota_stale: 'Quota older than 15 minutes — awaiting observation',
+  awaiting_reset_observation: 'Reset passed — awaiting fresh observation',
+}[reason] ?? reason)
+
+export function parseMinimum(value: string): number | null | undefined {
+  if (!value.trim()) return null
+  if (!/^\d+(?:\.\d+)?$/.test(value.trim())) return undefined
+  const number = Number(value)
+  return Number.isFinite(number) && number >= 0 && number <= 100 ? number : undefined
+}
+
+// Mounted only in the admin role: reporting viewers never call this endpoint.
+export function QuotaPolicyPanel(props: { authIndex: string; provider: string }) {
+  if (!['codex', 'claude'].includes(props.provider)) return null
+  return <SupportedQuotaPolicyPanel {...props} />
+}
+
+function SupportedQuotaPolicyPanel({ authIndex, provider }: { authIndex: string; provider: string }) {
+  const data = useSyncExternalStore(subscribe, () => snapshot, () => emptySnapshot)
+  const account = data.items.find(item => item.auth_index === authIndex && item.provider === provider)
+  const [editing, setEditing] = useState(false)
+  const [draft, setDraft] = useState<Record<string, string>>({})
+  const [expected, setExpected] = useState<Record<string, number>>({})
+  const [windows, setWindows] = useState<PolicyWindow[]>([])
+  const [pending, setPending] = useState(false)
+  const [error, setError] = useState('')
+  if (!account) return data.error ? <div role="status">Quota policy unavailable</div> : null
+  const configured = Object.keys(account.thresholds).length > 0
+  const begin = () => {
+    setExpected({ ...account.thresholds })
+    setWindows(account.windows)
+    setDraft(Object.fromEntries(account.windows.map(window => [window.id, window.minimum_remaining_percent == null ? '' : String(window.minimum_remaining_percent)])))
+    setError(''); setEditing(true)
+  }
+  const save = async () => {
+    const thresholds: Record<string, number> = {}
+    for (const [id, value] of Object.entries(draft)) {
+      const minimum = parseMinimum(value)
+      if (minimum === undefined) { setError('Enter a percentage from 0 to 100, or leave it blank.'); return }
+      if (minimum !== null) thresholds[id] = minimum
+    }
+    setPending(true); setError('')
+    try {
+      const response = await apiFetch(apiPath('/quota/policies'), {
+        method: 'PUT', headers: { 'Content-Type': 'application/json' },
+        body: JSON.stringify({ auth_index: authIndex, provider, thresholds, expected_thresholds: expected }),
+      })
+      if (!response.ok) throw new Error(response.status === 409 ? 'Policy changed elsewhere. Cancel and reopen to load it.' : 'Could not save quota policy. Reload and retry.')
+      await refresh(); setEditing(false)
+    } catch (caught) { setError(caught instanceof Error ? caught.message : 'Could not save quota policy.') }
+    finally { setPending(false) }
+  }
+  return <section className={styles.panel} data-quota-policy={authIndex} aria-label="Quota routing policy">
+    <div className={styles.heading}>
+      <strong>Quota routing</strong>
+      <span className={account.excluded ? styles.excluded : undefined} role="status">
+        {account.manually_disabled ? 'Manually disabled' : account.excluded ? 'Excluded by quota policy' : configured ? 'Policy permits routing' : 'No minimum configured'}
+      </span>
+      {!editing && <button type="button" onClick={begin}>Edit minimums</button>}
+    </div>
+    {data.error && <p role="alert">Live policy state unavailable. Displayed state may be outdated.</p>}
+    {!editing && configured && <ul>{account.windows.filter(window => window.minimum_remaining_percent !== null).map(window => <li key={window.id}>
+      {window.label}: minimum {window.minimum_remaining_percent}% · {window.remaining_percent === null ? 'Unknown' : `${window.remaining_percent.toFixed(1)}% remaining`}
+      {window.excluded && <strong> · {policyReason(window.reason)}</strong>}
+    </li>)}</ul>}
+    {editing && <form onSubmit={event => { event.preventDefault(); void save() }}>
+      <p>Exclude this whole account from new requests when any configured window is at or below its minimum. Model-specific and reserve limits also apply to the whole account.</p>
+      <p>Blank leaves a window unrestricted. 0% stops at exhaustion. Unknown quota, data older than 15 minutes, and passed resets exclude configured windows until a fresh observation arrives. No provider query is added. Existing scheduled or manual quota refresh can restore availability.</p>
+      <p>Manual enable/disable and priority stay separate. Running requests finish. Bound WebSocket turns are rejected while excluded; reconnect with full context to use another eligible account.</p>
+      {!windows.length && <p>No percentage windows observed for this account yet.</p>}
+      {windows.map(window => <label className={styles.window} key={window.id}>
+        <span>{window.label}<small>{window.remaining_percent === null ? 'Unknown quota' : `${window.remaining_percent.toFixed(1)}% remaining`}{window.reason ? ` · ${policyReason(window.reason)}` : ''}</small></span>
+        <input aria-label={`Minimum remaining percentage: ${window.label}`} inputMode="decimal" type="number" min="0" max="100" step="any" placeholder="Off" value={draft[window.id] ?? ''} disabled={pending} onChange={event => setDraft({ ...draft, [window.id]: event.target.value })} />
+      </label>)}
+      {error && <p role="alert">{error}</p>}
+      <div className={styles.actions}><button type="submit" disabled={pending}>{pending ? 'Saving…' : 'Save minimums'}</button><button type="button" disabled={pending} onClick={() => setEditing(false)}>Cancel</button></div>
+    </form>}
+  </section>
+}
