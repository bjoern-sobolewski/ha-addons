@@ -0,0 +1,42 @@
+package api
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/live"
+	"encoding/json"
+	"errors"
+	"github.com/gin-gonic/gin"
+	"net/http/httptest"
+	"strings"
+	"testing"
+)
+
+type policyProviderStub struct {
+	status int
+	err    error
+	body   json.RawMessage
+	method string
+}
+
+func (p *policyProviderStub) QuotaPolicies(_ context.Context, method string, body json.RawMessage) (json.RawMessage, int, error) {
+	p.body = body
+	p.method = method
+	return json.RawMessage(`{"items":[]}`), p.status, p.err
+}
+func TestQuotaPolicyBridgeLimitsInputAndSanitizesErrors(t *testing.T) {
+	for _, tc := range []struct {
+		body           string
+		upstream, want int
+		err            error
+	}{{`{"thresholds":{}}`, 200, 200, nil}, {`bad`, 200, 400, nil}, {strings.Repeat("x", 33000), 200, 400, nil}, {`{}`, 409, 409, errors.New("private upstream credential")}, {`{}`, 500, 502, errors.New("private upstream credential")}} {
+		p := &policyProviderStub{status: tc.upstream, err: tc.err}
+		router := gin.New()
+		registerQuotaPolicyRoutes(router, p, live.New())
+		r := httptest.NewRequest("PUT", "/quota/policies", strings.NewReader(tc.body))
+		w := httptest.NewRecorder()
+		router.ServeHTTP(w, r)
+		if w.Code != tc.want || strings.Contains(w.Body.String(), "credential") {
+			t.Fatalf("status %d body %s", w.Code, w.Body.String())
+		}
+	}
+}
