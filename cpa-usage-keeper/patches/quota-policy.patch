+package api
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/live"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"io"
+	"net/http"
+)
+
+type QuotaPolicyProvider interface {
+	QuotaPolicies(context.Context, string, json.RawMessage) (json.RawMessage, int, error)
+}
+
+func registerQuotaPolicyRoutes(router gin.IRoutes, provider QuotaPolicyProvider, hub *live.Hub) {
+	for _, method := range []string{http.MethodGet, http.MethodPut} {
+		router.Handle(method, "/quota/policies", func(c *gin.Context) {
+			if provider == nil {
+				c.JSON(http.StatusServiceUnavailable, gin.H{"error": "quota policy service unavailable"})
+				return
+			}
+			var body json.RawMessage
+			if c.Request.Method == http.MethodPut {
+				raw, err := io.ReadAll(http.MaxBytesReader(c.Writer, c.Request.Body, 32768))
+				if err != nil || !json.Valid(raw) {
+					c.JSON(400, gin.H{"error": "invalid quota policy"})
+					return
+				}
+				body = raw
+			}
+			result, status, err := provider.QuotaPolicies(c.Request.Context(), c.Request.Method, body)
+			if err != nil || status != http.StatusOK || !json.Valid(result) {
+				switch status {
+				case 400, 404, 409, 412:
+					c.JSON(status, gin.H{"error": "quota policy rejected; reload the account and retry"})
+				default:
+					c.JSON(502, gin.H{"error": "CPA quota policy service unavailable"})
+				}
+				return
+			}
+			if c.Request.Method == http.MethodPut {
+				hub.Publish("quota")
+			}
+			c.Header("Cache-Control", "no-store")
+			c.Data(http.StatusOK, "application/json", result)
+		})
+	}
+}
diff --git a/internal/api/quota_policy_test.go b/internal/api/quota_policy_test.go
