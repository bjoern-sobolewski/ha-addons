@@ -0,0 +1,44 @@
+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot } from 'react-dom/client'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { QuotaPolicyPanel, parseMinimum, policyReason } from '../QuotaPolicyPanel'
+import { apiFetch } from '@/lib/api'
+
+globalThis.IS_REACT_ACT_ENVIRONMENT = true
+const live = vi.hoisted(() => ({ refresh: undefined as undefined | (() => Promise<unknown>), stop: vi.fn() }))
+vi.mock('@/lib/live', () => ({ startLiveRefresh: (refresh: () => Promise<unknown>) => { live.refresh = refresh; void refresh(); return live.stop } }))
+vi.mock('@/lib/api', () => ({ apiFetch: vi.fn(), apiPath: (value: string) => value }))
+const account = { auth_index: 'a', provider: 'codex', manually_disabled: false, excluded: true, reason: 'minimum_reached', thresholds: { weekly: 10 }, windows: [
+  { id: 'weekly', label: 'Weekly', minimum_remaining_percent: 10, remaining_percent: 10, excluded: true, reason: 'minimum_reached' },
+  { id: '5h', label: '5-hour', minimum_remaining_percent: null, remaining_percent: 90, excluded: false, reason: '' },
+] }
+afterEach(() => vi.clearAllMocks())
+describe('Quota policy controls', () => {
+  it('keeps blank, zero and fractional percentages distinct and rejects malformed values', () => {
+    expect(parseMinimum('')).toBeNull()
+    expect(parseMinimum('0')).toBe(0)
+    expect(parseMinimum('12.5')).toBe(12.5)
+    for (const input of ['101', '-1', 'NaN', 'Infinity', '1e2']) expect(parseMinimum(input)).toBeUndefined()
+    expect(policyReason('awaiting_reset_observation')).toContain('fresh observation')
+  })
+  it('shares the cached read, preserves drafts on live recovery, and saves only explicit windows with conflict protection', async () => {
+    vi.mocked(apiFetch).mockResolvedValue({ ok: true, json: async () => ({ items: [account] }) } as Response)
+    const container = document.createElement('div'); document.body.append(container); const root = createRoot(container)
+    try {
+      await act(async () => root.render(<><QuotaPolicyPanel authIndex="a" provider="codex" /><QuotaPolicyPanel authIndex="a" provider="codex" /></>))
+      expect(apiFetch).toHaveBeenCalledTimes(1)
+      expect(container.textContent).toContain('Excluded by quota policy')
+      await act(async () => container.querySelector<HTMLButtonElement>('button')!.click())
+      expect(container.querySelectorAll('input')).toHaveLength(2)
+      expect(container.querySelectorAll<HTMLInputElement>('input')[1].value).toBe('')
+      vi.mocked(apiFetch).mockResolvedValue({ ok: true, json: async () => ({ items: [{ ...account, excluded: false, thresholds: {}, windows: account.windows.map(window => ({ ...window, minimum_remaining_percent: null })) }] }) } as Response)
+      await act(async () => { await live.refresh!() })
+      expect(container.querySelector<HTMLInputElement>('input')!.value).toBe('10')
+      await act(async () => container.querySelector('form')!.dispatchEvent(new Event('submit', { bubbles: true, cancelable: true })))
+      const put = vi.mocked(apiFetch).mock.calls.find(([, options]) => options?.method === 'PUT')!
+      expect(JSON.parse(put[1]!.body as string)).toEqual({ auth_index: 'a', provider: 'codex', thresholds: { weekly: 10 }, expected_thresholds: { weekly: 10 } })
+    } finally { await act(async () => root.unmount()); container.remove() }
+    expect(live.stop).toHaveBeenCalledTimes(1)
+  })
