@@ -0,0 +1,20 @@
+package cpa
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+)
+
+// Forward only the dedicated local-cache policy contract, never a provider API.
+func (c *Client) QuotaPolicies(ctx context.Context, method string, body json.RawMessage) (json.RawMessage, int, error) {
+	var result json.RawMessage
+	var status int
+	var err error
+	if method == http.MethodGet {
+		status, _, err = c.doManagementJSONRequest(ctx, "/v8/management/quota/policies", &result, "quota policy")
+	} else {
+		status, _, err = c.doManagementJSONRequestWithBody(ctx, method, "/v8/management/quota/policies", body, &result, "quota policy")
+	}
+	return result, status, err
+}
