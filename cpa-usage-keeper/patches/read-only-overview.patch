+// @vitest-environment happy-dom
+import React,{act} from 'react';
+import {createRoot} from 'react-dom/client';
+import {expect,it,vi} from 'vitest';
+import i18n from '@/i18n';
+const api = vi.hoisted(() => ({fetchReadOnlyOverview:vi.fn(),fetchReadOnlyQuota:vi.fn()}));
+vi.mock('@/lib/api',async (original) => ({...await original<typeof import('@/lib/api')>(),...api}));
+import {ReadOnlyPage} from '../ReadOnlyPage';
+import {getRoleTargetPath} from '@/App';
+
+it('renders all-key totals and shared quota with only read controls',async () => {
+  globalThis.IS_REACT_ACT_ENVIRONMENT=true;await i18n.changeLanguage('en');
+  api.fetchReadOnlyOverview.mockResolvedValue({overview:{usage:{total_requests:7,total_tokens:700,failure_count:1},summary:{cost_available:true,total_cost:0},series:{buckets:[],requests:[]}},keys:[{label:'Client key 1',requests:2,failures:0,total_tokens:200,cost:null},{label:'Client key 2',requests:5,failures:1,total_tokens:500,cost:0}]});
+  api.fetchReadOnlyQuota.mockResolvedValue({accounts:[{label:'Codex account 1',status:'available',rows:[{label:'Weekly',remaining_percent:96}]}]});
+  const element=document.createElement('div');document.body.append(element);const root=createRoot(element);
+  try {
+    await act(async () => root.render(<ReadOnlyPage onAuthRequired={() => undefined}/>));
+    for(const value of ['Client key 1','Client key 2','96%','Read-only overview','Estimated API cost']) expect(element.textContent).toContain(value);
+    expect(element.textContent).not.toMatch(/Reset quota|Settings|Edit credential|Delete/);
+    expect(api.fetchReadOnlyOverview).toHaveBeenCalledWith('7d',expect.any(AbortSignal));
+    expect(getRoleTargetPath('read_only','/auth-files')).toBe('/read-only');
+    expect(getRoleTargetPath('api_key_viewer','/read-only')).toBe('/key-overview');
+  } finally {await act(async () => root.unmount());element.remove();}
+});
