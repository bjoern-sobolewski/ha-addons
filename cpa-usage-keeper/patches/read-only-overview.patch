diff --git a/internal/quota/traffic_sync.go b/internal/quota/traffic_sync.go
new file mode 100644
index 0000000..41d97a6
--- /dev/null
+++ b/internal/quota/traffic_sync.go
@@ -0,0 +1,27 @@
+package quota
+import (
+ "context"
+ "time"
+ "cpa-usage-keeper/internal/cpa"
+)
+type trafficQuotaReader interface {FetchQuotaObservations(context.Context)([]cpa.QuotaObservation,error)}
+// Only CPA's local cache is read. No upstream query is made by this loop.
+func(s *Service) startTrafficQuotaSync(reader trafficQuotaReader) {
+ s.startRefreshGoroutine(func(){
+  timer:=time.NewTicker(5*time.Second);defer timer.Stop()
+  for {
+   ctx,cancel:=context.WithTimeout(s.refreshContext,4*time.Second)
+   items,err:=reader.FetchQuotaObservations(ctx)
+   if err==nil {for _,item:=range items {
+    snapshot,ok:=BuildUsageHeaderSnapshot(UsageHeaderSnapshotInput{AuthType:"oauth",AuthIndex:item.AuthIndex,Provider:item.Provider,ObservedAt:item.ObservedAt,Headers:item.Headers,Source:RefreshSource(item.Source)})
+    if ok {s.applyUsageHeaderSnapshotPointers(ctx,[]*UsageHeaderSnapshot{snapshot})}
+   }}
+   cancel()
+   select {case <-s.refreshContext.Done():return;case <-timer.C:}
+  }
+ })
+}
+func stampQuotaRows(rows []QuotaRow, at time.Time, source RefreshSource) {
+ if source==""||source==RefreshSourceUsageHeader{source="api_response_headers"}
+ for i:=range rows {rows[i].CapturedAt=at;rows[i].Source=source}
+}
