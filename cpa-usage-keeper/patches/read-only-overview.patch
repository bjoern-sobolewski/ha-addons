+     const [data,filters]=await Promise.all([fetchUsageEvents(query,controller.signal,eventOptions),fetchReadOnlyReport<typeof options>('events/filters',params,controller.signal)]);
+     if(controller.signal.aborted)return;setEvents(data);setOptions(filters);setNextCursor(data.has_more?data.next_cursor:undefined);
