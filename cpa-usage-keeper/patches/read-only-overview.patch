index 0000000..7174311
--- /dev/null
+++ b/web/src/pages/ReadOnlyPage.tsx
@@ -0,0 +1,70 @@
+import {useCallback, useEffect, useState} from 'react';
+import {useTranslation} from 'react-i18next';
+import {DashboardHeader} from '@/components/dashboard/DashboardHeader';
+import {Button} from '@/components/ui/Button';
+import {Card} from '@/components/ui/Card';
+import {ApiError, fetchReadOnlyOverview, fetchReadOnlyQuota, logout, type ReadOnlyOverview, type ViewerQuotaAccount} from '@/lib/api';
+import {QuotaAccounts} from './KeyQuotaPage';
+import styles from './ReadOnlyPage.module.scss';
+
+export function ReadOnlyPage({onAuthRequired}: {onAuthRequired: () => void}) {
+  const {t} = useTranslation();
+  const [range,setRange] = useState('7d');
+  const [data,setData] = useState<ReadOnlyOverview>();
+  const [accounts,setAccounts] = useState<ViewerQuotaAccount[]>([]);
+  const [loading,setLoading] = useState(true);
+  const [usageError,setUsageError] = useState(false);
+  const [quotaError,setQuotaError] = useState(false);
+  const refresh = useCallback(async (signal?: AbortSignal) => {
+    setLoading(true);
+    const [usage,quota] = await Promise.allSettled([fetchReadOnlyOverview(range,signal),fetchReadOnlyQuota(signal)]);
+    if (signal?.aborted) return;
+    for (const result of [usage,quota]) {
+      if (result.status === 'rejected' && result.reason instanceof ApiError && result.reason.status === 401) {onAuthRequired(); return;}
+    }
+    if (usage.status === 'fulfilled') {setData(usage.value);setUsageError(false);} else {setData(undefined);setUsageError(true);}
+    if (quota.status === 'fulfilled') {setAccounts(quota.value.accounts);setQuotaError(false);} else {setAccounts([]);setQuotaError(true);}
+    setLoading(false);
+  },[range,onAuthRequired]);
+  useEffect(() => {
+    const controller = new AbortController();
+    void refresh(controller.signal);
+    const timer = window.setInterval(() => void refresh(controller.signal),60000);
+    return () => {controller.abort();window.clearInterval(timer);};
+  },[refresh]);
+  const amount = (value: number) => value.toLocaleString();
+  const cost = (value: number | null | undefined) => value == null ? '—' : value.toLocaleString(undefined,{style:'currency',currency:'USD'});
+  const stats = data?.overview;
+  const buckets = stats?.series?.buckets ?? [];
+  const requests = stats?.series?.requests ?? [];
+  const maximum = Math.max(1,...requests);
+  return <div className={styles.page} data-keeper-page="read-only">
+    <DashboardHeader identity={t('read_only.title')} onLogout={() => void logout().finally(onAuthRequired)} />
+    <main className={styles.content}>
+      <div className={styles.toolbar}>
+        <div><h1>{t('read_only.title')}</h1><p>{t('read_only.scope')}</p></div>
+        <label>{t('read_only.range')} <select aria-label={t('read_only.range')} value={range} onChange={(event) => {setData(undefined);setRange(event.target.value);}}>
+          <option value="24h">{t('read_only.hours')}</option><option value="7d">{t('read_only.week')}</option><option value="30d">{t('read_only.month')}</option>
+        </select></label>
+        <Button loading={loading} disabled={loading} onClick={() => void refresh()}>{t('usage_stats.refresh')}</Button>
+      </div>
+      {usageError && <p role="alert">{t('read_only.error')}</p>}
+      {stats && <>
+        <div className={styles.stats}>
+          {[['requests',amount(stats.usage.total_requests)],['tokens',amount(stats.usage.total_tokens)],['failures',amount(stats.usage.failure_count)],['cost',cost(stats.summary?.cost_available ? stats.summary.total_cost : null)]].map(([label,value]) => <Card key={label}><p>{t(`read_only.${label}`)}</p><strong>{value}</strong></Card>)}
+        </div>
+        <Card><h2>{t('read_only.trend')}</h2><div className={styles.trend} role="img" aria-label={t('read_only.trend')}>
+          {buckets.map((bucket,index) => <div key={bucket} title={`${new Date(bucket).toLocaleString()}: ${amount(requests[index] ?? 0)}`} style={{height:`${Math.max(1,(requests[index] ?? 0)/maximum*100)}%`}} />)}
+        </div><p className={styles.period}>{buckets.length > 0 && `${new Date(buckets[0]).toLocaleString()} — ${new Date(buckets[buckets.length-1]).toLocaleString()}`}</p></Card>
+        <Card><h2>{t('read_only.keys')}</h2><div className={styles.table}><table>
+          <thead><tr>{['keys','requests','failures','tokens','cost'].map((label) => <th key={label}>{t(`read_only.${label}`)}</th>)}</tr></thead>
+          <tbody>{data?.keys.map((key) => <tr key={key.label}><th scope="row">{key.label}</th><td>{amount(key.requests)}</td><td>{amount(key.failures)}</td><td>{amount(key.total_tokens)}</td><td>{cost(key.cost)}</td></tr>)}</tbody>
+        </table></div>{data?.keys.length === 0 && <p>{t('read_only.empty')}</p>}</Card>
+      </>}
+      <h2>{t('key_quota.tab')}</h2><p>{t('key_quota.shared')}</p>
+      {quotaError && <p role="alert">{t('key_quota.error')}</p>}
+      {!loading && !quotaError && accounts.length === 0 && <p>{t('key_quota.empty')}</p>}
+      <QuotaAccounts accounts={accounts}/>
+    </main>
+  </div>;
+}
