+
+type trafficQuotaReader interface {
+	FetchQuotaObservations(context.Context) ([]cpa.QuotaObservation, error)
+}
+
+// Only CPA's local cache is read. No upstream query is made by this loop.
+func (s *Service) StartTrafficQuotaSync(reader trafficQuotaReader) {
+	s.startRefreshGoroutine(func() {
+		timer := time.NewTicker(5 * time.Second)
+		defer timer.Stop()
+		for {
+			ctx, cancel := context.WithTimeout(s.refreshContext, 4*time.Second)
+			items, err := reader.FetchQuotaObservations(ctx)
+			if err == nil {
+				for _, item := range items {
+					snapshot, ok := BuildUsageHeaderSnapshot(UsageHeaderSnapshotInput{AuthType: "oauth", AuthIndex: item.AuthIndex, Provider: item.Provider, ObservedAt: item.ObservedAt, Headers: item.Headers, Source: RefreshSource(item.Source)})
+					if ok {
+						var identity entities.UsageIdentity
+						if err := s.db.WithContext(ctx).Where("identity = ? AND is_deleted = ? AND (disabled IS NULL OR disabled = ?)", item.AuthIndex, false, false).First(&identity).Error; err == nil {
+							s.applyUsageHeaderSnapshotWithIdentity(ctx, snapshot, identity, nil)
+						}
+					}
+				}
+			}
+			cancel()
+			select {
+			case <-s.refreshContext.Done():
+				return
+			case <-timer.C:
+			}
+		}
+	})
+}
+func stampQuotaRows(rows []QuotaRow, at time.Time, source RefreshSource) {
+	if source == "" || source == RefreshSourceUsageHeader {
+		source = "api_response_headers"
+	}
+	for i := range rows {
+		rows[i].CapturedAt = at
+		rows[i].Source = source
+		if rows[i].ResetAt == "" && rows[i].ResetAfterSeconds != nil {
+			rows[i].ResetAt = at.Add(time.Duration(*rows[i].ResetAfterSeconds) * time.Second).Format(time.RFC3339)
+		}
+	}
+}
