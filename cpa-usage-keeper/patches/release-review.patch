+package test
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	. "cpa-usage-keeper/internal/quota"
+	"net/http"
+	"testing"
+	"time"
+)
+
+func TestAPIProviderTrafficCacheIsSeparateAndRevalidatesAccount(t *testing.T) {
+	db := openQuotaTestDatabase(t)
+	identity := entities.UsageIdentity{Identity: "synthetic-api", Name: "synthetic", Type: "codex", AuthType: entities.UsageIdentityAuthTypeAIProvider}
+	if err := db.Create(&identity).Error; err != nil {
+		t.Fatal(err)
+	}
+	service := NewServiceWithRegistry(db, NewProviderRegistry(nil), emptyPricingCatalogForTest())
+	defer service.StopRefreshTasks()
+	at := time.Date(2026, 10, 1, 12, 0, 0, 0, time.UTC)
+	build := func(when time.Time) *UsageHeaderSnapshot {
+		h := http.Header{}
+		h.Set("X-Codex-Primary-Used-Percent", "12")
+		h.Set("X-Codex-Primary-Window-Minutes", "300")
+		h.Set("X-Codex-Primary-Reset-After-Seconds", "120")
+		snapshot, ok := BuildUsageHeaderSnapshot(UsageHeaderSnapshotInput{AuthType: "oauth", AuthIndex: identity.Identity, Provider: "codex", ObservedAt: when, Headers: h, Source: "websocket_event"})
+		if !ok {
+			t.Fatal("no snapshot")
+		}
+		return snapshot
+	}
+	if !applyTrafficAPIProviderQuota(service, context.Background(), build(at), identity) {
+		t.Fatal("API cache lost")
+	}
+	result, err := service.GetCachedQuota(context.Background(), CacheRequest{AuthIndexes: []string{identity.Identity}})
+	if err != nil || len(result.Items) != 1 || result.Items[0].Quota.Quota[0].Source != "websocket_event" {
+		t.Fatal("cache provenance lost", err)
+	}
+	if applyTrafficAPIProviderQuota(service, context.Background(), build(at.Add(-time.Second)), identity) {
+		t.Fatal("older observation replaced cache")
+	}
+	if err := db.Model(&identity).Update("disabled", true).Error; err != nil {
+		t.Fatal(err)
+	}
+	// Use the earlier eligible entity to simulate metadata changing during work.
+	identity.Disabled = nil
+	if applyTrafficAPIProviderQuota(service, context.Background(), build(at.Add(time.Second)), identity) {
+		t.Fatal("disabled provider accepted")
+	}
+	if err := db.Model(&identity).Updates(map[string]any{"disabled": false, "type": "claude"}).Error; err != nil {
+		t.Fatal(err)
+	}
+	identity.Type = "codex"
+	if applyTrafficAPIProviderQuota(service, context.Background(), build(at.Add(time.Second)), identity) {
+		t.Fatal("changed provider accepted")
+	}
+}
