+			return seen, err
+		}
+		for _, row := range rows {
+			apiIdentities[row.Identity] = row
+		}
+	}
+	snapshots, next := selectTrafficQuotaSnapshots(validItems, candidates, identities, seen)
+	for i, snapshot := range candidates {
