new file mode 100644
index 0000000..e4ef297
--- /dev/null
+++ b/internal/repository/test/quota_remaining_history_test.go
@@ -0,0 +1,81 @@
+package test
+
+import (
+	"context"
+	"reflect"
+	"testing"
+	"time"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/repository"
+	dto "cpa-usage-keeper/internal/repository/dto"
+)
+
+func TestRemainingHistoryAttributesRealChangesAcrossResetAndArchive(t *testing.T) {
+	db := openTestDatabase(t)
+	now := time.Date(2026, 10, 19, 12, 0, 0, 0, time.UTC)
+	reset := now.Add(-time.Hour)
+	seedCodexQuotaEfficiencyCycle(t, db, "remaining-account", reset.Add(-7*24*time.Hour), reset, []codexQuotaEfficiencySegmentSeed{
+		{remaining: 20, first: now.Add(-3 * time.Hour), last: now.Add(-3 * time.Hour)},
+		{remaining: 18, first: now.Add(-2 * time.Hour), last: now.Add(-90 * time.Minute)},
+	})
+	seedCodexQuotaEfficiencyCycle(t, db, "remaining-account", reset, reset.Add(7*24*time.Hour), []codexQuotaEfficiencySegmentSeed{
+		{remaining: 100, first: now.Add(-50 * time.Minute), last: now.Add(-40 * time.Minute)},
+		{remaining: 99, first: now.Add(-30 * time.Minute), last: now.Add(-20 * time.Minute)},
+	})
+	unpriced := usageEventForQuotaEfficiency("unpriced", "oauth", "remaining-account", now.Add(-35*time.Minute), 1_000_000)
+	unpriced.Model = "unknown-price"
+	seedCodexQuotaEfficiencyUsage(t, db,
+		usageEventForQuotaEfficiency("baseline-excluded", "oauth", "remaining-account", now.Add(-3*time.Hour), 9_000_000),
+		usageEventForQuotaEfficiency("drop-right-boundary", "oauth", "remaining-account", now.Add(-2*time.Hour), 1_000_000),
+		usageEventForQuotaEfficiency("old-cycle-tail", "oauth", "remaining-account", now.Add(-70*time.Minute), 2_000_000),
+		usageEventForQuotaEfficiency("reset-boundary", "oauth", "remaining-account", reset, 3_000_000),
+		usageEventForQuotaEfficiency("new-cycle-head", "oauth", "remaining-account", now.Add(-50*time.Minute), 4_000_000),
+		usageEventForQuotaEfficiency("new-drop", "oauth", "remaining-account", now.Add(-30*time.Minute), 5_000_000),
+		usageEventForQuotaEfficiency("after-last-point", "oauth", "remaining-account", now.Add(-10*time.Minute), 9_000_000),
+		usageEventForQuotaEfficiency("other-account", "oauth", "other", now.Add(-40*time.Minute), 9_000_000),
+		usageEventForQuotaEfficiency("other-auth", "api_key", "remaining-account", now.Add(-40*time.Minute), 9_000_000), unpriced,
+	)
+	query := dto.CodexQuotaEfficiencyQuery{AuthIndex: "remaining-account", Now: now, RangeStart: now.Add(-7 * 24 * time.Hour), WeeklyOnly: true, RemainingHistory: true}
+	resolver := codexQuotaEfficiencyPricingResolver(t)
+	before, err := repository.BuildCodexQuotaEfficiencyHistory(context.Background(), db, query, resolver)
+	if err != nil {
+		t.Fatal(err)
+	}
+	points := before.RemainingHistory
+	if len(points) != 4 {
+		t.Fatalf("expected four actual observations, got %+v", points)
+	}
+	for i, want := range []int{20, 18, 100, 99} {
+		if points[i].RemainingPercent != want {
+			t.Fatalf("point %d: %+v", i, points[i])
+		}
+	}
+	if points[0].IntervalStartedAt != nil || points[0].Usage.Requests != 0 {
+		t.Fatal("baseline must not invent an interval")
+	}
+	for i, want := range []float64{0, 1, 9, 5} {
+		if points[i].Usage.TotalCostUSD != want {
+			t.Fatalf("interval %d cost=%v, want %v", i, points[i].Usage.TotalCostUSD, want)
+		}
+	}
+	if points[2].Usage.Requests != 3 || !points[2].Usage.CostAvailable {
+		t.Fatal("reset lost or duplicated boundary requests")
+	}
+	if points[3].Usage.Requests != 2 || points[3].Usage.CostAvailable {
+		t.Fatal("unpriced usage must remain explicitly incomplete")
+	}
+	if err := db.Exec("INSERT INTO usage_events_archive (" + entities.UsageEventStorageColumns + ") SELECT " + entities.UsageEventStorageColumns + " FROM usage_events").Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Exec("DELETE FROM usage_events").Error; err != nil {
+		t.Fatal(err)
+	}
+	after, err := repository.BuildCodexQuotaEfficiencyHistory(context.Background(), db, query, resolver)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		t.Fatal("remaining history changed after archival")
+	}
+}
