@@ -0,0 +1,55 @@
+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import type { ComponentProps } from 'react'
+import i18n from '@/i18n'
+import type { CodexQuotaHistoryResponse, QuotaRemainingPoint } from '@/lib/types'
+const api = vi.hoisted(() => ({ fetchCodexQuotaHistory: vi.fn() }))
+vi.mock('@/lib/api', async original => ({ ...await original<typeof import('@/lib/api')>(), ...api }))
+const charts = vi.hoisted(() => ({ props: {} as Record<string, unknown> }))
+vi.mock('react-chartjs-2', () => ({ Chart: (props: Record<string, unknown>) => { charts.props = props; return <div role="img" /> } }))
+import { QuotaRemainingHistory, quotaIntervalValue, visibleRemainingPoints } from '../credentials/QuotaRemainingHistory'
+const usage = { requests: 3, successful_requests: 3, failed_requests: 0, input_tokens: 10, output_tokens: 1, reasoning_tokens: 0, cache_read_tokens: 0, cache_creation_tokens: 0, total_tokens: 11, total_cost_usd: 4.5, cost_available: true }
+const point = (time: string, remaining: number, start: string | null): QuotaRemainingPoint => ({observed_at: time, remaining_percent: remaining, interval_started_at: start, usage})
+const report: CodexQuotaHistoryResponse = { generated_at:'2026-10-19T12:00:00Z', range_start:'2026-10-12T12:00:00Z', windows:[], selected_window:null, cycles:[], remaining_history:[
+  point('2026-10-10T12:00:00Z',30,null), point('2026-10-11T12:00:00Z',20,'2026-10-10T12:00:00Z'), point('2026-10-15T12:00:00Z',100,'2026-10-11T12:00:00Z'), point('2026-10-19T10:00:00Z',98,'2026-10-15T12:00:00Z'),
+] }
+let element: HTMLDivElement; let root: Root
+beforeEach(async () => { globalThis.IS_REACT_ACT_ENVIRONMENT=true; await i18n.changeLanguage('en'); vi.clearAllMocks(); api.fetchCodexQuotaHistory.mockResolvedValue(report); element=document.createElement('div');document.body.append(element);root=createRoot(element) })
+afterEach(async () => { await act(async()=>root.unmount());element.remove() })
+const button = (text: string) => [...element.querySelectorAll('button')].find(node => node.textContent === text)!
+
+it('keeps one real baseline before the range, real change timestamps and reset jumps', () => {
+  expect(visibleRemainingPoints(report).map(p=>p.remaining_percent)).toEqual([20,100,98])
+  expect(quotaIntervalValue({...report.remaining_history![0],interval_started_at:null})).toBe('—')
+  expect(quotaIntervalValue({...report.remaining_history![1],usage:{...usage,cost_available:false}})).toMatch(/^≥ /)
+  expect(quotaIntervalValue({...report.remaining_history![1],usage:{...usage,cost_available:false,total_cost_usd:0}})).toBe('—')
+})
+
+it('defaults to 7 days and retains both tooltip values when the value legend is deselected', async () => {
+  await act(async()=>root.render(<QuotaRemainingHistory authIndex="account" readOnlyAccountId="3" />))
+  expect(api.fetchCodexQuotaHistory).toHaveBeenLastCalledWith('account',{weeklyOnly:true,remainingDays:7,readOnlyAccountId:'3'},expect.any(AbortSignal))
+  expect(button('7d').getAttribute('aria-pressed')).toBe('true')
+  await act(async()=>button('Interval API value').click())
+  expect(button('Interval API value').getAttribute('aria-pressed')).toBe('false')
+  const props = charts.props as unknown as {data:{datasets:{hidden?:boolean}[]};options:{plugins:{tooltip:{callbacks:{label:(item:{dataIndex:number})=>string[]}}}}}
+  expect(props.data.datasets[1].hidden).toBe(true)
+  const lines = props.options.plugins.tooltip.callbacks.label({dataIndex:2})
+  expect(lines[0]).toBe('Remaining quota: 98%');expect(lines[1]).toContain('4.50')
+  const signal=api.fetchCodexQuotaHistory.mock.calls[0][2] as AbortSignal
+  await act(async()=>button('1d').click());expect(signal.aborted).toBe(true)
+  expect(api.fetchCodexQuotaHistory.mock.calls.at(-1)![1].remainingDays).toBe(1)
+  await act(async()=>button('30d').click());expect(api.fetchCodexQuotaHistory.mock.calls.at(-1)![1].remainingDays).toBe(30)
+})
+
+it('discards obsolete account responses and retries errors', async () => {
+  let finish!: (value: CodexQuotaHistoryResponse)=>void
+  api.fetchCodexQuotaHistory.mockImplementationOnce(()=>new Promise(resolve=>{finish=resolve})).mockRejectedValueOnce(new Error('offline'))
+  const props: ComponentProps<typeof QuotaRemainingHistory>={authIndex:'old'}
+  await act(async()=>root.render(<QuotaRemainingHistory {...props}/>))
+  await act(async()=>root.render(<QuotaRemainingHistory authIndex="new"/>))
+  await act(async()=>finish(report))
+  expect(element.textContent).toContain('Could not load');expect(element.querySelector('[role="img"]')).toBeNull()
+  await act(async()=>button('Retry').click());expect(element.querySelector('[role="img"]')).not.toBeNull()
+})
