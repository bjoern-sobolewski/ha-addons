@@ -0,0 +1,123 @@
+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Chart } from 'react-chartjs-2'
+import type { ChartData, ChartOptions } from 'chart.js'
+import '@/lib/chartjs'
+import { ApiError, fetchCodexQuotaHistory } from '@/lib/api'
+import type { CodexQuotaHistoryResponse, QuotaRemainingPoint } from '@/lib/types'
+import { useThemeStore } from '@/stores'
+import { buildUsageChartTooltipStyle, getUsageChartTheme } from '@/utils/usage/chartConfig'
+import { formatWeeklyDateTime, weeklyDateLocale } from './weeklyDateTime'
+import styles from './QuotaRemainingHistory.module.scss'
+
+type Period = 1 | 7 | 30
+type XY = { x: number; y: number | null }
+const remainingColor = '#3b82f6'
+const valueColor = '#d97706'
+
+// Keep the last real observation before the range as context. Never create hourly/daily points.
+export function visibleRemainingPoints(report: CodexQuotaHistoryResponse): QuotaRemainingPoint[] {
+  const start = Date.parse(report.range_start)
+  const end = Date.parse(report.generated_at)
+  const points = (report.remaining_history ?? []).filter(point => {
+    const time = Date.parse(point.observed_at)
+    return Number.isFinite(time) && time <= end
+  }).sort((a, b) => Date.parse(a.observed_at) - Date.parse(b.observed_at))
+  const before = points.filter(point => Date.parse(point.observed_at) < start).at(-1)
+  return [...(before ? [before] : []), ...points.filter(point => Date.parse(point.observed_at) >= start)]
+}
+
+export function quotaIntervalValue(point: QuotaRemainingPoint): string {
+  if (!point.interval_started_at) return '—'
+  if (!point.usage.cost_available && point.usage.total_cost_usd === 0) return '—'
+  const money = new Intl.NumberFormat(weeklyDateLocale(), { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 4 }).format(point.usage.total_cost_usd)
+  return `${point.usage.cost_available ? '' : '≥ '}${money}`
+}
+
+export function QuotaRemainingHistory({ authIndex, readOnlyAccountId, onAuthRequired }: {
+  authIndex: string
+  readOnlyAccountId?: string
+  onAuthRequired?: () => void
+}) {
+  const { t } = useTranslation()
+  const dark = useThemeStore(state => state.resolvedTheme) === 'dark'
+  const theme = getUsageChartTheme(dark)
+  const [days, setDays] = useState<Period>(7)
+  const [retry, setRetry] = useState(0)
+  const [showValue, setShowValue] = useState(true)
+  const requestKey = JSON.stringify([authIndex, readOnlyAccountId, days, retry])
+  const [result, setResult] = useState<{ key: string; report?: CodexQuotaHistoryResponse; error?: string } | null>(null)
+  const report = result?.key === requestKey ? result.report ?? null : null
+  const error = result?.key === requestKey ? result.error ?? '' : ''
+  const loading = result?.key !== requestKey
+  useEffect(() => {
+    const controller = new AbortController()
+    const load = async () => {
+      try {
+        const report = await fetchCodexQuotaHistory(authIndex, { weeklyOnly: true, remainingDays: days, readOnlyAccountId }, controller.signal)
+        if (!controller.signal.aborted) setResult({ key: requestKey, report })
+      } catch (failure) {
+        if (controller.signal.aborted) return
+        if (failure instanceof ApiError && failure.status === 401) { onAuthRequired?.(); return }
+        setResult({ key: requestKey, error: t('quota_timeline.load_failed', 'Could not load rate-limit history.') })
+      }
+    }
+    void load()
+    return () => controller.abort()
+  }, [authIndex, readOnlyAccountId, days, requestKey, onAuthRequired, t])
+
+  const points = report ? visibleRemainingPoints(report) : []
+  const remainingLabel = t('quota_timeline.remaining', 'Remaining quota')
+  const valueLabel = t('quota_timeline.value', 'Interval API value')
+  const title = t('quota_timeline.title', 'Rate-limit remaining history')
+  const data: ChartData<'line', XY[]> = { datasets: [
+    { label: remainingLabel, yAxisID: 'remaining', data: points.map(point => ({ x: Date.parse(point.observed_at), y: point.remaining_percent })), borderColor: remainingColor, backgroundColor: remainingColor, stepped: 'before', borderWidth: 2, pointRadius: 2, pointHoverRadius: 5 },
+    { label: valueLabel, yAxisID: 'value', hidden: !showValue, data: points.map(point => ({ x: Date.parse(point.observed_at), y: point.interval_started_at && (point.usage.cost_available || point.usage.total_cost_usd > 0) ? point.usage.total_cost_usd : null })), borderColor: valueColor, backgroundColor: valueColor, borderWidth: 1.5, borderDash: [4, 3], pointRadius: 2, pointHoverRadius: 5, spanGaps: false },
+  ] }
+  const options: ChartOptions<'line'> = {
+    responsive: true, maintainAspectRatio: false, animation: false,
+    interaction: { mode: 'index', intersect: false },
+    plugins: {
+      legend: { display: false },
+      // Use the remaining series as the tooltip anchor. Its callbacks deliberately read
+      // both values from the report, independently of dataset visibility.
+      tooltip: { ...buildUsageChartTooltipStyle(theme), filter: item => item.datasetIndex === 0, callbacks: {
+        title: items => items.length ? formatWeeklyDateTime(points[items[0].dataIndex].observed_at) : '',
+        label: item => {
+          const point = points[item.dataIndex]
+          return [`${remainingLabel}: ${point.remaining_percent}%`, `${valueLabel}: ${quotaIntervalValue(point)}`]
+        },
+        afterBody: items => {
+          if (!items.length) return []
+          const point = points[items[0].dataIndex]
+          if (!point.interval_started_at) return [t('quota_timeline.baseline', 'First observation · no preceding interval')]
+          return [
+            `${formatWeeklyDateTime(point.interval_started_at)} → ${formatWeeklyDateTime(point.observed_at)}`,
+            t('quota_timeline.requests', '{{count}} requests', { count: point.usage.requests }),
+            ...(!point.usage.cost_available ? [t('quota_timeline.partial', 'Pricing incomplete · known value only')] : []),
+          ]
+        },
+      } },
+    },
+    scales: {
+      x: { type: 'linear', min: report ? Date.parse(report.range_start) : undefined, max: report ? Date.parse(report.generated_at) : undefined,
+        ticks: { color: theme.textSecondary, maxTicksLimit: 6, callback: value => new Intl.DateTimeFormat(weeklyDateLocale(), days === 1 ? { hour: '2-digit', minute: '2-digit' } : { month: 'short', day: 'numeric' }).format(new Date(Number(value))) }, grid: { display: false } },
+      remaining: { position: 'left', min: 0, max: 100, title: { display: true, text: remainingLabel, color: theme.textSecondary }, ticks: { color: theme.textSecondary, callback: value => `${value}%` }, grid: { color: theme.grid } },
+      value: { position: 'right', beginAtZero: true, display: showValue, title: { display: true, text: 'USD', color: theme.textSecondary }, ticks: { color: theme.textSecondary }, grid: { drawOnChartArea: false } },
+    },
+  }
+  return <section className={styles.panel} aria-label={title}>
+    <div className={styles.header}><h3>{title}</h3><div className={styles.periods} role="group" aria-label={t('quota_timeline.period', 'History period')}>
+      {([1, 7, 30] as const).map(period => <button key={period} type="button" aria-pressed={days === period} onClick={() => setDays(period)}>{period}d</button>)}
+    </div></div>
+    {loading ? <p role="status">{t('common.loading', 'Loading…')}</p> : error ? <p role="status">{error} <button type="button" onClick={() => setRetry(value => value + 1)}>{t('common.retry', 'Retry')}</button></p> : points.length ? <>
+      <div className={styles.chart}><Chart type="line" data={data} options={options} role="img" aria-label={title} /></div>
+      <div className={styles.legend} aria-label={t('quota_timeline.legend', 'Chart legend')}>
+        <span><i style={{ background: remainingColor }} />{remainingLabel}</span>
+        <button type="button" aria-pressed={showValue} onClick={() => setShowValue(value => !value)}><i style={{ background: valueColor }} /><span className={!showValue ? styles.hidden : undefined}>{valueLabel}</span></button>
+      </div>
+      <p className={styles.note}>{t('quota_timeline.note', 'Weekly window · one point per detected change. API value covers recorded requests since the previous point, including resets. Hover always shows both values.')}</p>
+      <p className={styles.note}>{t('quota_timeline.last_observed', 'Last detected change: {{time}} · {{remaining}}% remaining', { time: formatWeeklyDateTime(points.at(-1)!.observed_at), remaining: points.at(-1)!.remaining_percent })}</p>
+    </> : <p role="status">{t('quota_timeline.empty', 'No weekly rate-limit history recorded for this period.')}</p>}
+  </section>
+}
