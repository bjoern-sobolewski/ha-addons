new file mode 100644
index 00000000..218d4deb
--- /dev/null
+++ b/web/src/components/usage/test/PromptPreviews.test.tsx
@@ -0,0 +1,52 @@
+// @vitest-environment happy-dom
+import { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { afterEach, expect, it, vi } from 'vitest';
+import { apiFetch } from '@/lib/api';
+import { RequestEventsTestCard } from './requestEventsFixtures';
+import type { UsageEvent } from '@/lib/types';
+
+vi.mock('@/lib/api', () => ({ apiFetch: vi.fn(), apiPath: (path: string) => path }));
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+const event = { id: '7', timestamp: '2026-11-08T10:00:00Z', model: 'example', tokens: {} } as UsageEvent;
+const container = document.createElement('div');
+document.body.append(container);
+let root = createRoot(container);
+afterEach(async () => {
+  await act(async () => root.unmount());
+  root = createRoot(container);
+  vi.clearAllMocks();
+});
+
+it('loads previews only on expansion and renders escaped text below all columns', async () => {
+  vi.mocked(apiFetch).mockResolvedValue({ ok: true, json: async () => ({ initial: '<script>private initial</script>', current: 'private current', character_limit: 240 }) } as Response);
+  await act(async () => root.render(<RequestEventsTestCard events={[event]} showPromptPreviews initialVisibleColumnIds={['timestamp', 'model']} />));
+  expect(apiFetch).not.toHaveBeenCalled();
+  const toggle = container.querySelector<HTMLButtonElement>('button[aria-controls="request-prompts-7"]')!;
+  expect(toggle.getAttribute('aria-expanded')).toBe('false');
+  await act(async () => toggle.click());
+  expect(apiFetch).toHaveBeenCalledWith('/usage/events/7/prompts', expect.objectContaining({ signal: expect.any(AbortSignal) }));
+  const details = container.querySelector('#request-prompts-7')!;
+  expect(details.querySelector('td')?.colSpan).toBe(3);
+  expect(details.textContent).toContain('private initial');
+  expect(details.textContent).toContain('private current');
+  expect(details.querySelector('script')).toBeNull();
+  expect(toggle.getAttribute('aria-expanded')).toBe('true');
+  await act(async () => toggle.click());
+  expect(container.querySelector('#request-prompts-7')).toBeNull();
+});
+
+it('omits all preview controls and requests for shared viewer tables', async () => {
+  await act(async () => root.render(<RequestEventsTestCard events={[event]} />));
+  expect(container.querySelector('button[aria-controls="request-prompts-7"]')).toBeNull();
+  expect(container.textContent).not.toContain('First observed prompt');
+  expect(apiFetch).not.toHaveBeenCalled();
+});
+
+it('shows a denied request without rendering prompt content', async () => {
+  vi.mocked(apiFetch).mockResolvedValue({ ok: false, status: 403 } as Response);
+  await act(async () => root.render(<RequestEventsTestCard events={[event]} showPromptPreviews />));
+  await act(async () => container.querySelector<HTMLButtonElement>('button[aria-controls="request-prompts-7"]')!.click());
+  expect(container.querySelector('[role="alert"]')?.textContent).toContain('Administrator login required');
+  expect(container.textContent).not.toContain('private initial');
+});
