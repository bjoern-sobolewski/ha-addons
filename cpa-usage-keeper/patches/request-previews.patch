+package api
+
+import (
+	"context"
+	"errors"
+	"strconv"
+
+	"cpa-usage-keeper/internal/service"
+	"github.com/gin-gonic/gin"
+	"gorm.io/gorm"
+)
+
+type promptPreviewReader interface {
+	GetUsageEventPromptPreview(context.Context, int64) (service.PromptPreview, error)
+}
+
+// Register only on adminProtected. Previews never enter shared event DTOs,
+// exports, read-only reports or API-key reports.
+func registerPromptPreviewRoute(router gin.IRoutes, provider service.UsageProvider) {
+	router.GET("/usage/events/:id/prompts", func(c *gin.Context) {
+		setNoStoreHeaders(c)
+		eventID, err := strconv.ParseInt(c.Param("id"), 10, 64)
+		if err != nil || eventID <= 0 {
+			c.JSON(400, gin.H{"error": "Invalid event"})
+			return
+		}
+		reader, ok := provider.(promptPreviewReader)
+		if !ok {
+			c.JSON(503, gin.H{"error": "Prompt previews unavailable"})
+			return
+		}
+		preview, err := reader.GetUsageEventPromptPreview(c.Request.Context(), eventID)
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			c.JSON(404, gin.H{"error": "Event not found"})
+			return
+		}
+		if err != nil {
+			c.JSON(503, gin.H{"error": "Prompt previews unavailable"})
+			return
+		}
+		c.JSON(200, preview)
+	})
+}
