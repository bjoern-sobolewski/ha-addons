--- /dev/null
+++ b/internal/service/prompt_preview.go
@@ -0,0 +1,53 @@
+package service
+
+import (
+	"context"
+	"strings"
+	"unicode"
+
+	"cpa-usage-keeper/internal/entities"
+)
+
+const PromptPreviewCharacterLimit = 240
+
+type PromptPreview struct {
+	Initial        string `json:"initial,omitempty"`
+	Current        string `json:"current,omitempty"`
+	CharacterLimit int    `json:"character_limit"`
+}
+
+// Bound ingress independently of CPA, including messages from older/custom peers.
+func normalizePromptPreview(value string) string {
+	var result strings.Builder
+	count := 0
+	space := false
+	for _, character := range value {
+		if unicode.IsSpace(character) {
+			space = result.Len() > 0
+			continue
+		}
+		if unicode.IsControl(character) || unicode.Is(unicode.Cf, character) {
+			continue
+		}
+		if count >= PromptPreviewCharacterLimit {
+			break
+		}
+		if space {
+			result.WriteByte(' ')
+			count++
+			space = false
+			if count >= PromptPreviewCharacterLimit {
+				break
+			}
+		}
+		result.WriteRune(character)
+		count++
+	}
+	return result.String()
+}
+
+func (s *usageService) GetUsageEventPromptPreview(ctx context.Context, eventID int64) (PromptPreview, error) {
+	var event entities.UsageEvent
+	err := s.db.WithContext(usageServiceContext(ctx)).Select("initial_prompt_preview", "current_prompt_preview").First(&event, eventID).Error
+	return PromptPreview{Initial: event.InitialPromptPreview, Current: event.CurrentPromptPreview, CharacterLimit: PromptPreviewCharacterLimit}, err
+}
