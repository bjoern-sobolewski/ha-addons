+package migration
+
+import (
+	"cpa-usage-keeper/internal/entities"
+	"fmt"
+	"gorm.io/gorm"
+)
+
+func addPromptPreviewsMigration(tx *gorm.DB) error {
+	if !tx.Migrator().HasTable(&entities.UsageEvent{}) {
+		return nil
+	}
+	for _, field := range []string{"InitialPromptPreview", "CurrentPromptPreview"} {
+		if !tx.Migrator().HasColumn(&entities.UsageEvent{}, field) {
+			if err := tx.Migrator().AddColumn(&entities.UsageEvent{}, field); err != nil {
+				return fmt.Errorf("add prompt preview %s: %w", field, err)
+			}
+		}
+	}
+	return nil
+}
