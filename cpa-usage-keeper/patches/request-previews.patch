@@ -0,0 +1,67 @@
+package test
+
+import (
+	"context"
+	"net/http"
+	"strings"
+	"testing"
+	"time"
+
+	. "cpa-usage-keeper/internal/api"
+	"cpa-usage-keeper/internal/auth"
+	"cpa-usage-keeper/internal/service"
+)
+
+type promptPreviewUsageStub struct {
+	reportingUsageStub
+	calls int
+}
+
+func (s *promptPreviewUsageStub) GetUsageEventPromptPreview(context.Context, int64) (service.PromptPreview, error) {
+	s.calls++
+	return service.PromptPreview{Initial: "private initial marker", Current: "private current marker", CharacterLimit: 240}, nil
+}
+
+func TestPromptPreviewsAreAdminOnly(t *testing.T) {
+	sessions := auth.NewSessionManager(time.Hour)
+	config := AuthConfig{Enabled: true, LoginPassword: "admin-password-long", ReadOnlyPassword: "read-password-long"}
+	usage := &promptPreviewUsageStub{}
+	router := NewRouter(nil, nil, usage, nil, config, NewAuthHandler(config, sessions), "", OptionalProviders{CPAAPIKeys: &reportingKeysStub{}})
+	login := serveCredentialMutation(router, "POST", "/api/v1/auth/login", `{"password":"admin-password-long"}`)
+	if login.Code != 204 {
+		t.Fatal(login.Code)
+	}
+	adminCookie := login.Result().Cookies()[0]
+	path := "/api/v1/usage/events/7/prompts"
+	response := serveAPIGet(router, path, adminCookie)
+	if response.Code != 200 || !strings.Contains(response.Body.String(), "private initial marker") || !strings.Contains(response.Header().Get("Cache-Control"), "no-store") {
+		t.Fatal(response.Code, response.Body.String())
+	}
+	readLogin := serveCredentialMutation(router, "POST", "/api/v1/auth/read-only-login", `{"password":"read-password-long"}`)
+	if readLogin.Code != 204 {
+		t.Fatal(readLogin.Code)
+	}
+	viewer, _, _ := sessions.CreateAPIKeyViewer(1)
+	if serveAPIGet(router, path).Code != 401 {
+		t.Fatal("anonymous preview route exposed")
+	}
+	for _, cookie := range []*http.Cookie{readLogin.Result().Cookies()[0], {Name: adminCookie.Name, Value: viewer}} {
+		response := serveAPIGet(router, path, cookie)
+		if response.Code != 401 && response.Code != 403 {
+			t.Fatalf("non-admin allowed: %d", response.Code)
+		}
+		if strings.Contains(response.Body.String(), "private") {
+			t.Fatal("preview leaked on denied request")
+		}
+	}
+	if usage.calls != 1 {
+		t.Fatal("unauthorized request reached preview reader")
+	}
+	if serveAPIGet(router, "/api/v1/read-only/events/7/prompts", readLogin.Result().Cookies()[0]).Code != 404 {
+		t.Fatal("read-only preview route exposed")
+	}
+	response = serveAPIGet(router, "/api/v1/read-only/events?range=today", readLogin.Result().Cookies()[0])
+	if response.Code != 200 || strings.Contains(response.Body.String(), "prompt") {
+		t.Fatal("preview fields entered viewer DTO")
+	}
+}
