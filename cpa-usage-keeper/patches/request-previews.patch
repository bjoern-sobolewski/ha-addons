@@ -0,0 +1,54 @@
+package test
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf8"
+
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/pricing"
+	"cpa-usage-keeper/internal/repository"
+	"cpa-usage-keeper/internal/service"
+)
+
+func TestPromptPreviewPersistsWithEventAndStaysOutOfSharedEntityJSON(t *testing.T) {
+	db := openUsageServiceTestDatabase(t)
+	payload, _ := json.Marshal(map[string]any{
+		"execution_id": "preview-execution", "request_id": "preview-request", "model": "model-a", "timestamp": time.Now(),
+		"prompt_preview": map[string]string{"initial": "First observed prompt", "current": strings.Repeat("🙂", 300)},
+	})
+	event, _, err := service.DecodeRedisUsageMessage(string(payload), time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if utf8.RuneCountInString(event.CurrentPromptPreview) != service.PromptPreviewCharacterLimit {
+		t.Fatal("ingress preview not bounded")
+	}
+	if _, _, err := repository.InsertUsageEvents(db, []entities.UsageEvent{event}); err != nil {
+		t.Fatal(err)
+	}
+	var saved entities.UsageEvent
+	if err := db.Where("request_id = ?", "preview-request").First(&saved).Error; err != nil {
+		t.Fatal(err)
+	}
+	reader := service.NewUsageService(db, pricing.NewCatalog(pricing.EmptySnapshot())).(interface {
+		GetUsageEventPromptPreview(context.Context, int64) (service.PromptPreview, error)
+	})
+	preview, err := reader.GetUsageEventPromptPreview(context.Background(), saved.ID)
+	if err != nil || preview.Initial != "First observed prompt" || preview.Current != event.CurrentPromptPreview {
+		t.Fatal(preview, err)
+	}
+	encoded, _ := json.Marshal(saved)
+	if strings.Contains(string(encoded), "First observed prompt") || strings.Contains(string(encoded), "🙂") {
+		t.Fatal("entity JSON disclosed prompt previews")
+	}
+	if err := db.Delete(&saved).Error; err != nil {
+		t.Fatal(err)
+	}
+	if _, err := reader.GetUsageEventPromptPreview(context.Background(), saved.ID); err == nil {
+		t.Fatal("deleted event retained readable preview")
+	}
+}
