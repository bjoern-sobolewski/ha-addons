@@ -0,0 +1,39 @@
+import { useEffect, useState } from 'react'
+import { apiFetch, apiPath } from '@/lib/api'
+import styles from './PromptPreviewPanel.module.scss'
+
+export interface PromptPreview { initial?: string; current?: string; character_limit?: number }
+
+export function PromptPreviewContent({ preview }: { preview: PromptPreview }) {
+  return <div className={styles.content}>
+    <dl>
+      <div><dt>First observed prompt</dt><dd>{preview.initial || 'Not captured'}</dd></div>
+      <div><dt>Current user prompt</dt><dd>{preview.current || 'Not captured'}</dd></div>
+    </dl>
+    <p>Text previews · up to {preview.character_limit ?? 240} characters each. The start of an older chat may not have been observed.</p>
+  </div>
+}
+
+export function RequestEventPromptPreview({ eventId }: { eventId: string }) {
+  const [preview, setPreview] = useState<PromptPreview>()
+  const [error, setError] = useState('')
+  const [revision, setRevision] = useState(0)
+  useEffect(() => {
+    const controller = new AbortController()
+    async function load() {
+      try {
+        const response = await apiFetch(apiPath(`/usage/events/${encodeURIComponent(eventId)}/prompts`), { signal: controller.signal })
+        if (!response.ok) throw new Error(response.status === 403 ? 'Administrator login required.' : 'Prompt previews could not be loaded.')
+        const next = await response.json() as PromptPreview
+        if (!controller.signal.aborted) { setPreview(next); setError('') }
+      } catch (failure) {
+        if (!controller.signal.aborted) setError(failure instanceof Error ? failure.message : 'Prompt previews could not be loaded.')
+      }
+    }
+    void load()
+    return () => controller.abort()
+  }, [eventId, revision])
+  if (error) return <div className={styles.content} role="alert">{error} <button type="button" onClick={() => setRevision(value => value + 1)}>Retry</button></div>
+  if (!preview) return <div className={styles.content} role="status">Loading prompt previews…</div>
+  return <PromptPreviewContent preview={preview} />
+}
