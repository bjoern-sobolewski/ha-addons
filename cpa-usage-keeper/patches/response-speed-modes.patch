new file mode 100644
index 00000000..76d3b1a5
--- /dev/null
+++ b/web/src/components/usage/credentials/AnalyticsPicker.tsx
@@ -0,0 +1,38 @@
+import { useEffect, useRef, type ReactNode } from 'react'
+import styles from './WeeklyQuotaValuePanel.module.scss'
+
+interface AnalyticsPickerProps {
+  label: string
+  summary: string
+  actions: ReactNode
+  children: ReactNode
+  footer?: ReactNode
+  menuClassName?: string
+}
+
+export function AnalyticsPicker({ label, summary, actions, children, footer, menuClassName }: AnalyticsPickerProps) {
+  const details = useRef<HTMLDetailsElement>(null)
+  const trigger = useRef<HTMLElement>(null)
+  useEffect(() => {
+    const close = (event: PointerEvent) => {
+      if (details.current && !details.current.contains(event.target as Node)) details.current.open = false
+    }
+    document.addEventListener('pointerdown', close)
+    return () => document.removeEventListener('pointerdown', close)
+  }, [])
+
+  return <details ref={details} className={styles.modelDropdown} onKeyDown={event => {
+    if (event.key === 'Escape' && details.current?.open) {
+      details.current.open = false
+      trigger.current?.focus()
+      event.stopPropagation()
+    }
+  }}>
+    <summary ref={trigger} aria-label={label}>{label} · {summary}</summary>
+    <div className={menuClassName ? `${styles.modelMenu} ${menuClassName}` : styles.modelMenu}>
+      <div className={styles.pickerActions}>{actions}</div>
+      <div className={styles.modelOptions} role="group" aria-label={label}>{children}</div>
+      {footer}
+    </div>
+  </details>
+}
