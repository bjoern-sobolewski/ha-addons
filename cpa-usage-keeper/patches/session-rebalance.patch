index 00000000..8f9fe3bf
--- /dev/null
+++ b/internal/api/test/session_rebalance_priority_test.go
@@ -0,0 +1,57 @@
+package test
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"strings"
+	"testing"
+)
+
+type rebalancePriorityProvider struct {
+	*priorityProviderStub
+	calls int
+	fail  bool
+}
+
+func (p *rebalancePriorityProvider) RebalanceSessions(_ context.Context, index string, priority int, reconnect bool) (json.RawMessage, error) {
+	if p.authIndex != index || p.priority != priority || p.err != nil {
+		panic("rebalance ran before successful priority save")
+	}
+	p.calls++
+	if p.fail {
+		return nil, errors.New("secret-upstream-error")
+	}
+	return json.RawMessage(`{"id":1,"pool":"codex","sessions_rebalanced":5,"waiting":2}`), nil
+}
+func TestSessionRebalanceOnlyAfterPrioritySave(t *testing.T) {
+	for _, path := range []string{"/api/v1/credentials/auth-1/priority", "/api/v1/ai-providers/auth-1/priority"} {
+		for _, tc := range []struct {
+			name, body              string
+			saveFail, rebalanceFail bool
+			status, calls           int
+		}{
+			{"plain", `{"priority":3}`, false, false, 200, 0},
+			{"explicit", `{"priority":3,"rebalance_sessions":true}`, false, false, 200, 1},
+			{"failed save", `{"priority":3,"rebalance_sessions":true}`, true, false, 500, 0},
+			{"saved but rebalance failed", `{"priority":3,"rebalance_sessions":true}`, false, true, 200, 1},
+		} {
+			t.Run(path+tc.name, func(t *testing.T) {
+				p := &rebalancePriorityProvider{priorityProviderStub: &priorityProviderStub{}, fail: tc.rebalanceFail}
+				if tc.saveFail {
+					p.err = errors.New("secret-upstream-error")
+				}
+				r := priorityRouteRequest(t, p, path, tc.body)
+				if r.Code != tc.status || p.calls != tc.calls {
+					t.Fatalf("status %d calls %d", r.Code, p.calls)
+				}
+				if strings.Contains(r.Body.String(), "secret-upstream-error") {
+					t.Fatal("upstream detail leaked")
+				}
+				if tc.rebalanceFail && !strings.Contains(r.Body.String(), "Priority saved") {
+					t.Fatal("partial success misreported")
+				}
+			})
+		}
+	}
+}
