diff --git a/web/src/components/usage/credentials/SessionRebalanceProgress.tsx b/web/src/components/usage/credentials/SessionRebalanceProgress.tsx
new file mode 100644
index 00000000..6626bbe3
--- /dev/null
+++ b/web/src/components/usage/credentials/SessionRebalanceProgress.tsx
@@ -0,0 +1,40 @@
+import { useEffect, useState } from 'react'
+import { apiFetch, apiPath } from '@/lib/api'
+import { startLiveRefresh } from '@/lib/live'
+
+interface Progress {
+  reconnect_websockets: boolean
+  id: number
+  pool: string
+  reason: string
+  sessions_rebalanced: number
+  waiting: number
+  requested_at: string
+}
+
+// Admin page only. Uses the existing SSE connection and local CPA state.
+export function SessionRebalanceProgress() {
+  const [items, setItems] = useState<Progress[]>([])
+  const [failed, setFailed] = useState(false)
+  useEffect(() => startLiveRefresh(async signal => {
+    try {
+      const response = await apiFetch(apiPath('/sessions/rebalances'), { signal })
+      if (!response.ok) throw new Error('Progress unavailable')
+      const data = await response.json() as { items: Progress[] }
+      if (signal.aborted) return
+      const latest = new Map<string, Progress>()
+      for (const item of data.items) {
+        if (item.waiting > 0 || Date.now() - Date.parse(item.requested_at) < 600_000) latest.set(`${item.pool}:${item.waiting > 0 ? 'waiting' : 'latest'}`, item)
+      }
+      setItems([...latest.values()]); setFailed(false)
+    } catch { if (!signal.aborted) setFailed(true) }
+  }, ['rebalance', 'clock']), [])
+  return <div aria-label="Session rebalance progress" aria-live="polite">
+    {failed && <p role="status">Session rebalance progress unavailable. Waiting sessions continue safely.</p>}
+    {items.map(item => <p key={item.id} role="status">
+      {item.reason === 'priority_saved' ? 'Priority saved' : item.reason === 'quota_policy_recovered' ? 'Account eligibility recovered' : 'Quota policy excluded an account'}
+      {' · '}{item.pool}{' · Affinity rebalanced'}
+      {item.reconnect_websockets && <>{' · '}{item.sessions_rebalanced} sessions rebalanced{' · '}{item.waiting} waiting</>}
+    </p>)}
+  </div>
+}
