diff --git a/internal/api/session_rebalance.go b/internal/api/session_rebalance.go
new file mode 100644
index 00000000..968c20ca
--- /dev/null
+++ b/internal/api/session_rebalance.go
@@ -0,0 +1,29 @@
+package api
+
+import (
+	"context"
+	"encoding/json"
+	"github.com/gin-gonic/gin"
+	"net/http"
+)
+
+type sessionRebalanceReader interface {
+	SessionRebalances(context.Context, string, json.RawMessage) (json.RawMessage, int, error)
+}
+
+func registerSessionRebalanceRoutes(router gin.IRoutes, provider QuotaPolicyProvider) {
+	router.GET("/sessions/rebalances", func(c *gin.Context) {
+		p, ok := provider.(sessionRebalanceReader)
+		if !ok {
+			c.JSON(503, gin.H{"error": "session rebalance service unavailable"})
+			return
+		}
+		result, status, err := p.SessionRebalances(c.Request.Context(), http.MethodGet, nil)
+		if err != nil || status != 200 || !json.Valid(result) {
+			c.JSON(502, gin.H{"error": "session rebalance progress unavailable"})
+			return
+		}
+		c.Header("Cache-Control", "no-store")
+		c.Data(200, "application/json", result)
+	})
+}
diff --git a/internal/api/test/session_rebalance_priority_test.go b/internal/api/test/session_rebalance_priority_test.go
