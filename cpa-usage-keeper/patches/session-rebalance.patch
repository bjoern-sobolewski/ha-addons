+package cpa
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+)
+
+func (c *Client) SessionRebalances(ctx context.Context, method string, body json.RawMessage) (json.RawMessage, int, error) {
+	var result json.RawMessage
+	var status int
+	var err error
+	if method == http.MethodGet {
+		status, _, err = c.doManagementJSONRequest(ctx, "/v8/management/sessions/rebalances", &result, "session rebalance")
+	} else {
+		status, _, err = c.doManagementJSONRequestWithBody(ctx, method, "/v8/management/sessions/rebalances", body, &result, "session rebalance")
+	}
+	return result, status, err
+}
