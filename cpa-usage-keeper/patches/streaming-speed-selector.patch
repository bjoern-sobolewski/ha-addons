+func TestWeeklyTimelinePhaseSumsTokensAndDurationsAndKeepsMissingGaps(t *testing.T) {
+	day := time.Date(2026, 10, 14, 0, 0, 0, 0, time.UTC)
+	fragment := func(tokens, duration int64) dto.CodexQuotaEfficiencyCycle {
+		return dto.CodexQuotaEfficiencyCycle{WindowSeconds: 604800, DailyUsage: []dto.QuotaDailyUsage{{Day: day, Usage: dto.CodexQuotaEfficiencyUsage{ModelModes: []dto.QuotaModelModeUsage{{Model: "a", Mode: "fast", PhaseRequests: 3, PhaseOutputTokens: tokens, PhaseDurationMS: duration}}}}}}
+	}
+	history := dto.CodexQuotaEfficiencyHistory{GeneratedAt: day.Add(24 * time.Hour), Cycles: []dto.CodexQuotaEfficiencyCycle{fragment(100, 1000), fragment(300, 9000)}}
+	rows := buildWeeklyTimeline(history)
+	if len(rows) != 2 || rows[0].PhaseRequests != 6 || rows[0].PhaseTPS == nil || *rows[0].PhaseTPS != 40 {
+		t.Fatalf("phase rate not weighted by duration: %+v", rows)
+	}
+	if rows[0].SpeedTPS != nil || rows[1].PhaseTPS != nil || rows[1].PhaseRequests != 0 {
+		t.Fatalf("missing data replaced by a rate: %+v", rows)
+	}
+}
