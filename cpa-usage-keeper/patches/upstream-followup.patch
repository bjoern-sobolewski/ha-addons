- const [accounts,setAccounts]=useState<ViewerQuotaAccount[]>([]);
- useEffect(()=>startQuotaPolling(async(signal)=>{const data=await fetchAdminProviderQuota(signal);if(!signal.aborted)setAccounts(data.accounts.filter(a=>a.kind==='api'&&a.rows.length>0))}),[]);
