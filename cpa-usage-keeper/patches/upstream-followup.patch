+      new Promise((resolve) => {
+        finish = resolve;
+      }),
+  );
+  await mount(<ApiProviderQuota />);
+  const signal = api.fetchAdminProviderQuota.mock.calls[0][0] as AbortSignal;
+  await act(async () => {
+    root!.unmount();
+  });
+  root = undefined;
+  expect(signal.aborted).toBe(true);
+  await act(async () => {
+    finish({
+      accounts: [
+        { kind: "api", label: "Late account", rows: [{ label: "Weekly" }] },
+      ],
+    });
