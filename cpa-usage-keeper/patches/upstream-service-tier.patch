diff --git a/internal/repository/test/usage_upstream_service_tier_test.go b/internal/repository/test/usage_upstream_service_tier_test.go
new file mode 100644
index 0000000..38123a4
--- /dev/null
+++ b/internal/repository/test/usage_upstream_service_tier_test.go
@@ -0,0 +1,83 @@
+package test
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/helper"
+	"cpa-usage-keeper/internal/pricing"
+	"cpa-usage-keeper/internal/repository"
+	repodto "cpa-usage-keeper/internal/repository/dto"
+	"testing"
+	"time"
+)
+
+func TestOutgoingTierPricesRawCacheAndRollupsWithoutHistoricalInference(t *testing.T) {
+	db := openTestDatabase(t)
+	now := time.Date(2026, 10, 5, 12, 0, 0, 0, time.Local)
+	alias := "model-fast"
+	events := []entities.UsageEvent{}
+	// All client/response values and aliases are identical. Only captured outgoing
+	// priority incurs the multiplier; a historical alias is not proof of Fast.
+	for i, tier := range []string{"priority", "default", ""} {
+		events = append(events, entities.UsageEvent{EventKey: tier + "-capture", APIGroupKey: "group-a", Model: "model-a", ModelAlias: &alias,
+			ServiceTier: "auto", UpstreamServiceTier: tier, ResponseServiceTier: "default",
+			Timestamp: now.Add(time.Duration(-30+i) * time.Minute), InputTokens: 1_000_000, TotalTokens: 1_000_000})
+	}
+	if _, _, err := repository.InsertUsageEvents(db, events); err != nil {
+		t.Fatal(err)
+	}
+	resolver := repositoryPricingResolver(t, []pricing.RuleConfig{{Key: "upstream_service_tier", Value: "priority", Multiplier: 2}})
+	page, err := repository.ListUsageEventsWithFilter(db, repodto.UsageQueryFilter{Page: 1, PageSize: 10}, resolver)
+	if err != nil {
+		t.Fatal(err)
+	}
+	total := 0.0
+	for _, row := range page.Events {
+		total += row.CostUSD
+	}
+	if total != 4 {
+		t.Fatalf("raw cost=%v, want 4", total)
+	}
+	cache, err := repository.NewUsageRecentEventCache(db, repository.UsageRecentEventCacheOptions{Now: func() time.Time { return now }})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer cache.Close()
+	cached, ok := cache.Events(now.Add(-time.Hour), now, false, "group-a")
+	if !ok || len(cached) != 3 {
+		t.Fatalf("cached rows=%+v", cached)
+	}
+	total = 0
+	for _, row := range cached {
+		total += resolver.Calculate(pricing.CostSubject{Dimensions: pricing.UsageDimensions{Model: row.Model, UpstreamServiceTier: row.UpstreamServiceTier}, Tokens: helper.UsageTokenCostInput{InputTokens: row.InputTokens}}).Cost.TotalCostUSD
+	}
+	if total != 4 {
+		t.Fatalf("cache cost=%v, want 4", total)
+	}
+	if err := repository.AggregateUsageOverviewStats(context.Background(), db, now); err != nil {
+		t.Fatal(err)
+	}
+	for _, unit := range []string{"hour", "day"} {
+		start := now.Add(-time.Hour)
+		if unit == "day" {
+			start = time.Date(2026, 10, 5, 0, 0, 0, 0, time.Local)
+		}
+		end := now.Add(time.Hour)
+		overview, err := repository.BuildUsageOverviewWithFilter(db, repodto.UsageQueryFilter{Range: "custom", CustomUnit: unit, StartTime: &start, EndTime: &end, EndExclusive: true}, resolver)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if overview.Summary.TotalCost != 4 {
+			t.Fatalf("%s cost=%v, want 4", unit, overview.Summary.TotalCost)
+		}
+	}
+	for _, table := range []string{"usage_overview_hourly_stats", "usage_overview_daily_stats"} {
+		var count int64
+		if err := db.Table(table).Count(&count).Error; err != nil {
+			t.Fatal(err)
+		}
+		if count != 3 {
+			t.Fatalf("%s combined distinct outgoing tiers: %d rows", table, count)
+		}
+	}
+}
