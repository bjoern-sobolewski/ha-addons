@@ -0,0 +1,42 @@
+package test
+
+import (
+	"cpa-usage-keeper/internal/entities"
+	"testing"
+)
+
+func TestOutgoingTierMigrationPreservesUncapturedHistory(t *testing.T) {
+	db := openUnmigratedTestDatabase(t)
+	if err := db.AutoMigrate(&entities.UsageEvent{}, &entities.UsageEventArchive{}, &entities.UsageOverviewHourlyStat{}, &entities.UsageOverviewDailyStat{}); err != nil {
+		t.Fatal(err)
+	}
+	tables := []string{"usage_events", "usage_events_archive", "usage_overview_hourly_stats", "usage_overview_daily_stats"}
+	for _, table := range tables {
+		if table == "usage_overview_hourly_stats" || table == "usage_overview_daily_stats" {
+			if err := db.Exec("DROP INDEX uniq_" + table + "_dimensions").Error; err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err := db.Exec("ALTER TABLE " + table + " DROP COLUMN upstream_service_tier").Error; err != nil {
+			t.Fatal(err)
+		}
+		columns, values := "id, api_group_key, model, model_alias, service_tier, response_service_tier", "1, 'group', 'model', 'model-fast', 'auto', 'default'"
+		if table == "usage_overview_hourly_stats" || table == "usage_overview_daily_stats" {
+			columns += ", bucket_start, created_at, updated_at"
+			values += ", '2026-10-05T00:00:00Z', '2026-10-05T00:00:00Z', '2026-10-05T00:00:00Z'"
+		}
+		if err := db.Exec("INSERT INTO " + table + " (" + columns + ") VALUES (" + values + ")").Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	runOnlyMigration(t, db, "20261005_usage_upstream_service_tier")
+	for _, table := range tables {
+		var tier string
+		if err := db.Table(table).Select("upstream_service_tier").Where("id = 1").Scan(&tier).Error; err != nil {
+			t.Fatal(err)
+		}
+		if tier != "" {
+			t.Fatalf("%s fabricated historical tier: %q", table, tier)
+		}
+	}
+}
