diff --git a/internal/repository/migration/20261005_usage_upstream_service_tier.go b/internal/repository/migration/20261005_usage_upstream_service_tier.go
new file mode 100644
index 0000000..0a1970e
--- /dev/null
+++ b/internal/repository/migration/20261005_usage_upstream_service_tier.go
@@ -0,0 +1,41 @@
+package migration
+
+import (
+	"fmt"
+
+	"cpa-usage-keeper/internal/entities"
+	"gorm.io/gorm"
+)
+
+// Historical rows stay empty: an alias cannot prove the payload sent upstream.
+func addUsageUpstreamServiceTierMigration(tx *gorm.DB) error {
+	for _, model := range []any{
+		&entities.UsageEvent{}, &entities.UsageEventArchive{},
+		&entities.UsageOverviewHourlyStat{}, &entities.UsageOverviewDailyStat{},
+	} {
+		if !tx.Migrator().HasColumn(model, "upstream_service_tier") {
+			if err := tx.Migrator().AddColumn(model, "UpstreamServiceTier"); err != nil {
+				return fmt.Errorf("add outgoing service tier: %w", err)
+			}
+		}
+	}
+	// Keep captured request tiers separate in rollups, including when the response
+	// reports the same value for Standard and Fast requests.
+	for _, item := range []struct {
+		model any
+		index string
+	}{
+		{&entities.UsageOverviewHourlyStat{}, "uniq_usage_overview_hourly_stats_dimensions"},
+		{&entities.UsageOverviewDailyStat{}, "uniq_usage_overview_daily_stats_dimensions"},
+	} {
+		if tx.Migrator().HasIndex(item.model, item.index) {
+			if err := tx.Migrator().DropIndex(item.model, item.index); err != nil {
+				return fmt.Errorf("replace outgoing tier rollup index: %w", err)
+			}
+		}
+		if err := tx.Migrator().CreateIndex(item.model, item.index); err != nil {
+			return fmt.Errorf("create outgoing tier rollup index: %w", err)
+		}
+	}
+	return nil
+}
