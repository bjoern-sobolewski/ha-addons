diff --git a/internal/api/test/usage_events_live_privacy_test.go b/internal/api/test/usage_events_live_privacy_test.go
new file mode 100644
index 00000000..7bff82d8
--- /dev/null
+++ b/internal/api/test/usage_events_live_privacy_test.go
@@ -0,0 +1,120 @@
+package test
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"cpa-usage-keeper/internal/api"
+	"cpa-usage-keeper/internal/emailprivacy"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/service"
+)
+
+type livePrivacyPolicySource struct {
+	mu          sync.Mutex
+	entries     []emailprivacy.Entry
+	unavailable bool
+}
+
+func (s *livePrivacyPolicySource) KeeperEmailPrivacy(context.Context) ([]emailprivacy.Entry, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.unavailable {
+		return nil, errors.New("unavailable")
+	}
+	return append([]emailprivacy.Entry{}, s.entries...), nil
+}
+
+func TestUsageEventsLivePrivacyMasksEveryBatchAndFailsClosed(t *testing.T) {
+	const email = "example.secret@example.test"
+	db := openAPITestDatabase(t)
+	notifier := service.NewUsageEventsNotifier()
+	source := &livePrivacyPolicySource{entries: []emailprivacy.Entry{{Name: "codex-" + email + ".json", Email: email, Hidden: true}}}
+	insert := func() {
+		events := liveTestInsert(t, db, []entities.UsageEvent{{Timestamp: time.Now(), Model: "match", AuthType: "oauth", AuthIndex: "privacy-account", Source: email}})
+		notifier.NotifyUsageEventsCommitted(events)
+	}
+	insert()
+	provider := service.NewUsageService(db, emptyPricingCatalogForTest())
+	boundary := api.NewEmailPrivacyBoundary(source, filepath.Join(t.TempDir(), "privacy.json"))
+	server := httptest.NewServer(api.NewRouter(nil, nil, provider, nil, api.AuthConfig{}, nil, "", api.OptionalProviders{UsageEventsLive: notifier, EmailPrivacy: boundary}))
+	defer server.Close()
+	client := &http.Client{Timeout: 10 * time.Second}
+	target := server.URL + "/api/v1/usage/events/live?range=24h"
+	response, reader := liveTestConnect(t, client, target, nil)
+	defer response.Body.Close()
+	assertMasked := func(kind string) {
+		t.Helper()
+		payload, err := json.Marshal(liveTestReadKind(t, reader, kind).data)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(payload), email) || !strings.Contains(string(payload), "exampl**@example.test") {
+			t.Fatalf("unsafe stream frame: %s", payload)
+		}
+	}
+	assertMasked("snapshot")
+	// Deleting the current credential does not expose its historical identity.
+	source.mu.Lock()
+	source.entries = nil
+	source.mu.Unlock()
+	insert()
+	assertMasked("append")
+	// A policy change on an already open stream is enforced before its next write.
+	source.mu.Lock()
+	source.entries = []emailprivacy.Entry{{Name: "codex-" + email + ".json", Email: email, Hidden: false}}
+	source.mu.Unlock()
+	insert()
+	cleared, _ := json.Marshal(liveTestReadKind(t, reader, "append").data)
+	if !strings.Contains(string(cleared), email) {
+		t.Fatalf("explicit visibility change not applied: %s", cleared)
+	}
+	source.mu.Lock()
+	source.entries[0].Hidden = true
+	source.mu.Unlock()
+	insert()
+	assertMasked("append")
+	// Unverified policy ends the established stream instead of delivering a batch.
+	source.mu.Lock()
+	source.unavailable = true
+	source.mu.Unlock()
+	insert()
+	remaining, err := io.ReadAll(response.Body)
+	if err != nil {
+		t.Fatalf("policy outage did not close cleanly: %v", err)
+	}
+	// A checkpoint may already have passed policy verification and reached the
+	// socket before the flag changed. Permit queued range metadata only; no
+	// event batch or hidden identity may follow the last verified append.
+	buffered := bufio.NewReader(strings.NewReader(string(remaining)))
+	for {
+		if _, err := buffered.Peek(1); errors.Is(err, io.EOF) {
+			break
+		} else if err != nil {
+			t.Fatal(err)
+		}
+		frame := readLiveTestFrame(t, buffered)
+		_, hasEvents := frame.data["events"]
+		if (frame.kind != "checkpoint" && frame.kind != "heartbeat") || hasEvents || strings.Contains(string(remaining), email) {
+			t.Fatalf("policy outage emitted an event batch or hidden identity: %s", remaining)
+		}
+	}
+	failed, err := client.Get(target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer failed.Body.Close()
+	if failed.StatusCode != http.StatusServiceUnavailable {
+		t.Fatalf("initial policy outage status: %d", failed.StatusCode)
+	}
+}
