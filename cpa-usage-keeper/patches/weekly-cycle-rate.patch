diff --git a/web/src/components/usage/credentials/weeklyCycleValue.ts b/web/src/components/usage/credentials/weeklyCycleValue.ts
new file mode 100644
index 0000000..418b610
--- /dev/null
+++ b/web/src/components/usage/credentials/weeklyCycleValue.ts
@@ -0,0 +1,11 @@
+import type { CodexQuotaHistoryCycle } from '@/lib/types'
+
+// Keep numerator and denominator on the same observed quota-drop intervals.
+// This descriptive cycle average can contain mixed models and modes.
+export function weeklyCycleValue(cycle: CodexQuotaHistoryCycle) {
+  const intervals = cycle.transitions.filter(interval => interval.percentage_points > 0)
+  const points = intervals.reduce((sum, interval) => sum + interval.percentage_points, 0)
+  const cost = intervals.reduce((sum, interval) => sum + interval.usage.total_cost_usd, 0)
+  const priced = intervals.every(interval => interval.usage.cost_available && Number.isFinite(interval.usage.total_cost_usd))
+  return { points, intervals: intervals.length, cost, costPerPoint: points > 0 && priced ? cost / points : null }
+}
