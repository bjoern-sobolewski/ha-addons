+import { useEffect, useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { ApiError, fetchCodexQuotaHistory } from '@/lib/api'
+import type { CodexQuotaHistoryResponse } from '@/lib/types'
+import { Button } from '@/components/ui/Button'
+import { CodexQuotaHistoryPanel } from './CodexQuotaHistoryPanel'
+import { weeklyCycleRows } from './weeklyCycleRows'
+import styles from './WeeklyQuotaValuePanel.module.scss'
+
+export function WeeklyQuotaValuePanel({ authIndex, readOnlyAccountId, onAuthRequired }: {
+  authIndex: string; readOnlyAccountId?: string; onAuthRequired?: () => void
+}) {
+  const { t, i18n } = useTranslation()
+  const [role, setRole] = useState<'primary' | 'secondary' | undefined>()
+  const [showDetails, setShowDetails] = useState(false)
+  const [expandedCyclesFor, setExpandedCyclesFor] = useState<string>()
+  const [revision, setRevision] = useState(0)
+  const requestKey = JSON.stringify([authIndex, readOnlyAccountId, role, revision])
+  const [result, setResult] = useState<{ key: string; history: CodexQuotaHistoryResponse | null; error: boolean }>()
+  const loading = result?.key !== requestKey
+  const history = loading ? null : result?.history
+  const error = !loading && result?.error
+  useEffect(() => {
+    const controller = new AbortController()
+    fetchCodexQuotaHistory(authIndex, { weeklyOnly: true, readOnlyAccountId, windowRole: role }, controller.signal)
+      .then(history => { if (!controller.signal.aborted) setResult({ key: requestKey, history, error: false }) })
+      .catch((cause: unknown) => {
+        if (controller.signal.aborted) return
+        if (cause instanceof ApiError && cause.status === 401) onAuthRequired?.()
+        setResult({ key: requestKey, history: null, error: true })
+      })
+    return () => controller.abort()
+  }, [authIndex, readOnlyAccountId, role, requestKey, onAuthRequired])
+  const money = (value: number | null | undefined) => value == null ? '—' : new Intl.NumberFormat(i18n.language, { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }).format(value)
+  const date = (value: string | null | undefined) => value ? new Date(value).toLocaleString(i18n.language) : '—'
+  const report = history?.weekly_value
+  const cycleRows = history ? weeklyCycleRows(history) : []
+  const cycleViewKey = JSON.stringify([authIndex, readOnlyAccountId, role])
+  const showAllCycles = expandedCyclesFor === cycleViewKey
+  const visibleCycles = showAllCycles ? cycleRows : cycleRows.slice(0, 5)
+  const modeName = (mode: string) => mode === 'fast' ? t('weekly_quota.fast', 'Fast requested') : mode === 'normal' ? t('weekly_quota.normal', 'Normal') : t('weekly_quota.unknown', 'Mode not captured')
+  return <div className={styles.panel} data-weekly-quota-value="true">
+    <div className={styles.toolbar}>
+      <h3>{t('weekly_quota.title', 'Weekly quota value')}</h3>
+      <Button size="sm" disabled={loading} onClick={() => setRevision(value => value + 1)}>{t('common.refresh', 'Refresh')}</Button>
+    </div>
+    <p className={styles.note}>{t('weekly_quota.scope', 'Shared account usage across all client keys. API-equivalent value uses current configured prices, including pricing rules; it is not a subscription charge. Fast means the outgoing request asked for Fast; Normal includes outgoing Auto/default. Usage outside this proxy is not included and can distort estimates.')}</p>
+    {history && <p className={styles.note}>{t('weekly_quota.range', 'Reporting period')}: {date(history.range_start)} – {date(history.generated_at)}</p>}
+    {loading && <p role="status">{t('common.loading', 'Loading…')}</p>}
+    {error && <p role="alert">{t('weekly_quota.error', 'Unable to load weekly history. Use Refresh to retry.')}</p>}
+    {history && history.windows.length > 1 && <label>{t('weekly_quota.window', 'Weekly window')}{' '}
+      <select value={role ?? history.selected_window?.window_role} onChange={event => setRole(event.target.value as 'primary' | 'secondary')}>
+        {history.windows.map(window => <option key={window.window_role} value={window.window_role}>{window.window_role}</option>)}
+      </select>
+    </label>}
+    {history && !history.cycles.length && <p>{t('weekly_quota.empty', 'No weekly quota observations yet. History will appear after weekly quota is captured.')}</p>}
+    {!!history?.cycles.length && <>
+      <h4>{t('weekly_quota.resets', 'Weekly cycles and resets')}</h4>
+      <p className={styles.note}>{t('weekly_quota.remaining_note', 'Remaining is the last observed value, not an exact measurement at reset. A passed reset time remains unconfirmed until a later cycle is observed. Dollar totals cover recorded requests, including archived requests.')}</p>
+      <div className={styles.scroll}><table>
+        <thead><tr>
+          <th>{t('weekly_quota.reset', 'Reset / rollover')}</th>
+          <th>{t('weekly_quota.remaining', 'Last remaining')}</th>
+          <th>{t('weekly_quota.delivered', 'API value delivered')}</th>
+          <th>{t('weekly_quota.coverage', 'Observation coverage')}</th>
+        </tr></thead>
+        <tbody>{visibleCycles.map(({ cycle, reset, combinedUpdates }) => {
+          const current = cycle.status === 'current'
+          const shortened = cycle.effective_ended_at !== cycle.reset_at
+          return <tr key={cycle.id}>
+            <td><strong>{date(shortened && !current ? cycle.effective_ended_at : cycle.reset_at)}</strong><small>{current ? t('weekly_quota.scheduled', 'Scheduled') : reset?.rollover_observed_at ? t('weekly_quota.observed', 'Rollover observed') : shortened ? t('weekly_quota.changed', 'Window changed') : t('weekly_quota.unconfirmed', 'Awaiting rollover observation')}</small>
+              {reset?.rollover_observed_at && <small>{date(reset.rollover_observed_at)}</small>}</td>
+            <td><strong>{cycle.last_remaining_percent == null ? '—' : `${cycle.last_remaining_percent}%`}</strong><small>{date(cycle.last_observed_at)}</small>
+              {reset && <small>{t('weekly_quota.age', '{{minutes}} min before {{boundary}}', { minutes: Math.round(reset.last_observation_age_seconds / 60), boundary: current ? t('weekly_quota.report_time', 'report time') : t('weekly_quota.cycle_end', 'cycle end') })}</small>}</td>
+            <td><strong>{cycle.usage.cost_available ? money(cycle.usage.total_cost_usd) : t('weekly_quota.unpriced', 'Pricing incomplete')}</strong><small>{cycle.usage.requests} {t('weekly_quota.requests', 'requests')}</small></td>
+            <td><small>{t('weekly_quota.first', 'First observed')}: {date(cycle.first_observed_at)}</small>
+              {combinedUpdates > 0 && <small>{t('weekly_quota.combined', '{{count}} reset-time updates combined while quota stayed at 100%', { count: combinedUpdates })}</small>}
+              {reset?.partial_observation && <small>{t('weekly_quota.partial', 'Observation began after the cycle started')}</small>}</td>
+          </tr>
+        })}</tbody>
+      </table></div>
+      {cycleRows.length > 5 && <Button size="sm" onClick={() => setExpandedCyclesFor(showAllCycles ? undefined : cycleViewKey)}>{showAllCycles ? t('weekly_quota.show_recent', 'Show recent cycles') : t('weekly_quota.show_older', 'Show older cycles ({{count}})', { count: cycleRows.length - 5 })}</Button>}
+      <h4>{t('weekly_quota.models', 'Value by model and requested mode')}</h4>
+      <p className={styles.note}>{t('weekly_quota.sample_note', 'Estimates need at least {{points}} percentage points, {{intervals}} qualifying intervals and {{requests}} requests. Only intervals of at most {{minutes}} minutes with one model/mode, complete pricing and no failed requests qualify. These are eligibility floors, not a confidence guarantee.', { points: report?.min_points, intervals: report?.min_intervals, requests: report?.min_requests, minutes: (report?.max_interval_seconds ?? 0) / 60 })}</p>
+      {report && <p className={styles.note}>{t('weekly_quota.sample_coverage', '{{eligible}} of {{observed}} observed percentage points qualify; {{excluded}} intervals excluded.', { eligible: report.eligible_points, observed: report.observed_points, excluded: report.excluded_intervals })}</p>}
+      <div className={styles.scroll}><table>
+        <thead><tr><th>{t('weekly_quota.model', 'Model / mode')}</th><th>{t('weekly_quota.delivered', 'API value delivered')}</th><th>{t('weekly_quota.samples', 'Qualifying samples')}</th><th>{t('weekly_quota.per_point', 'API $ / percentage point')}</th><th>{t('weekly_quota.full', 'Estimated full allowance')}</th></tr></thead>
+        <tbody>{report?.modes.map(group => <tr key={`${group.model}:${group.mode}`}>
+          <td><strong>{group.model || '—'}</strong><small>{modeName(group.mode)}</small></td>
+          <td>{group.cost_available ? money(group.total_cost_usd) : t('weekly_quota.unpriced', 'Pricing incomplete')}<small>{group.total_requests} {t('weekly_quota.requests', 'requests')}</small></td>
+          <td>{group.percentage_points} {t('weekly_quota.points', 'percentage points')}<small>{group.sample_intervals} {t('weekly_quota.intervals', 'intervals')} · {group.sample_requests} {t('weekly_quota.requests', 'requests')}</small></td>
+          <td>{group.ready ? money(group.cost_per_point) : t('weekly_quota.insufficient', 'Insufficient data')}{group.ready && <small>{t('weekly_quota.observed_range', 'Observed range')}: {money(group.min_cost_per_point)} – {money(group.max_cost_per_point)}</small>}</td>
+          <td>{group.ready ? money(group.full_allowance_usd) : '—'}</td>
+        </tr>)}</tbody>
+      </table></div>
+      <p className={styles.note}>{t('weekly_quota.assumption', 'Full allowance estimates assume similar workload, caching, reasoning and quota rules. They use total qualifying API value divided by total qualifying percentage points, multiplied by 100. Uncaptured modes and mixed intervals remain in delivered totals but do not receive a quota estimate.')}</p>
+      {!readOnlyAccountId && <>
+        <Button size="sm" onClick={() => setShowDetails(value => !value)}>{t('weekly_quota.details', 'Detailed weekly observations and charts')}</Button>
+        {showDetails && <CodexQuotaHistoryPanel authIndex={authIndex} weeklyOnly onAuthRequired={onAuthRequired} />}
+      </>}
+    </>}
+  </div>
+}
