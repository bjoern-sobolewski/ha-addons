diff --git a/internal/quota/weekly_value.go b/internal/quota/weekly_value.go
new file mode 100644
index 0000000..64a5769
--- /dev/null
+++ b/internal/quota/weekly_value.go
@@ -0,0 +1,152 @@
+package quota
+
+import (
+	"sort"
+	"time"
+
+	repositorydto "cpa-usage-keeper/internal/repository/dto"
+)
+
+// These are eligibility floors, not a statistical confidence guarantee.
+const weeklyMinPoints = 5
+const weeklyMinIntervals = 3
+const weeklyMinRequests = 20
+const weeklyMaxInterval = time.Hour
+
+type WeeklyQuotaValue struct {
+	MinPoints          int                `json:"min_points"`
+	MinIntervals       int                `json:"min_intervals"`
+	MinRequests        int                `json:"min_requests"`
+	MaxIntervalSeconds int64              `json:"max_interval_seconds"`
+	ExcludedIntervals  int                `json:"excluded_intervals"`
+	EligiblePoints     int                `json:"eligible_points"`
+	ObservedPoints     int                `json:"observed_points"`
+	Modes              []WeeklyModelValue `json:"modes"`
+	Resets             []WeeklyReset      `json:"resets"`
+}
+
+type WeeklyReset struct {
+	CycleID int64 `json:"cycle_id"`
+	// A later observation confirms a rollover, not the exact instant it occurred.
+	RolloverObservedAt        *time.Time `json:"rollover_observed_at"`
+	LastObservationAgeSeconds int64      `json:"last_observation_age_seconds"`
+	PartialObservation        bool       `json:"partial_observation"`
+}
+
+type WeeklyModelValue struct {
+	Model            string   `json:"model"`
+	Mode             string   `json:"mode"`
+	TotalRequests    int64    `json:"total_requests"`
+	TotalCostUSD     float64  `json:"total_cost_usd"`
+	CostAvailable    bool     `json:"cost_available"`
+	SampleRequests   int64    `json:"sample_requests"`
+	SampleIntervals  int      `json:"sample_intervals"`
+	PercentagePoints int      `json:"percentage_points"`
+	SampleCostUSD    float64  `json:"sample_cost_usd"`
+	Ready            bool     `json:"ready"`
+	CostPerPoint     *float64 `json:"cost_per_point"`
+	FullAllowanceUSD *float64 `json:"full_allowance_usd"`
+	MinCostPerPoint  *float64 `json:"min_cost_per_point"`
+	MaxCostPerPoint  *float64 `json:"max_cost_per_point"`
+}
+
+func buildWeeklyQuotaValue(history repositorydto.CodexQuotaEfficiencyHistory) *WeeklyQuotaValue {
+	result := &WeeklyQuotaValue{MinPoints: weeklyMinPoints, MinIntervals: weeklyMinIntervals,
+		MinRequests: weeklyMinRequests, MaxIntervalSeconds: int64(weeklyMaxInterval / time.Second),
+		Modes: []WeeklyModelValue{}, Resets: []WeeklyReset{}}
+	groups := make(map[[2]string]*WeeklyModelValue)
+	get := func(model, mode string) *WeeklyModelValue {
+		key := [2]string{model, mode}
+		if groups[key] == nil {
+			groups[key] = &WeeklyModelValue{Model: model, Mode: mode, CostAvailable: true}
+		}
+		return groups[key]
+	}
+	for _, cycle := range history.Cycles {
+		if cycle.WindowSeconds != 7*24*60*60 {
+			continue
+		}
+		end := cycle.EffectiveEndedAt
+		if cycle.Status == "current" {
+			end = history.GeneratedAt
+		}
+		age := int64(end.Sub(cycle.LastObservedAt) / time.Second)
+		if age < 0 {
+			age = 0
+		}
+		reset := WeeklyReset{CycleID: cycle.ID, LastObservationAgeSeconds: age,
+			PartialObservation: cycle.FirstObservedAt.Sub(cycle.EffectiveStartedAt) > 15*time.Minute}
+		// Do not call a shortened/reconfigured window or a passed countdown a reset.
+		if cycle.EffectiveEndedAt.Equal(cycle.ResetAt) && cycle.Status != "current" {
+			for _, next := range history.Cycles {
+				if next.ID == cycle.ID || next.WindowStartedAt.Before(cycle.ResetAt) || next.FirstObservedAt.Before(cycle.ResetAt) {
+					continue
+				}
+				if reset.RolloverObservedAt == nil || next.FirstObservedAt.Before(*reset.RolloverObservedAt) {
+					observed := next.FirstObservedAt
+					reset.RolloverObservedAt = &observed
+				}
+			}
+		}
+		result.Resets = append(result.Resets, reset)
+		for _, usage := range cycle.Usage.ModelModes {
+			group := get(usage.Model, usage.Mode)
+			group.TotalRequests += usage.Requests
+			group.TotalCostUSD += usage.TotalCostUSD
+			group.CostAvailable = group.CostAvailable && usage.CostAvailable
+		}
+		for _, interval := range cycle.Transitions {
+			result.ObservedPoints += interval.PercentagePoints
+			usage := interval.Usage
+			// Mixed/unknown modes, missing prices, failures and long observation gaps
+			// cannot establish a usable model-specific quota conversion sample.
+			valid := interval.PercentagePoints > 0 && interval.IntervalEndedAt.After(interval.IntervalStartedAt) &&
+				interval.IntervalEndedAt.Sub(interval.IntervalStartedAt) <= weeklyMaxInterval &&
+				len(usage.ModelModes) == 1 && usage.CostAvailable && usage.Requests > 0 && usage.FailedRequests == 0
+			if valid {
+				valid = usage.ModelModes[0].Model != "" && usage.ModelModes[0].Mode != "unknown"
+			}
+			if !valid {
+				result.ExcludedIntervals++
+				continue
+			}
+			sample := usage.ModelModes[0]
+			group := get(sample.Model, sample.Mode)
+			group.SampleRequests += usage.Requests
+			group.SampleIntervals++
+			group.PercentagePoints += interval.PercentagePoints
+			group.SampleCostUSD += usage.TotalCostUSD
+			result.EligiblePoints += interval.PercentagePoints
+			rate := usage.TotalCostUSD / float64(interval.PercentagePoints)
+			if group.MinCostPerPoint == nil || rate < *group.MinCostPerPoint {
+				v := rate
+				group.MinCostPerPoint = &v
+			}
+			if group.MaxCostPerPoint == nil || rate > *group.MaxCostPerPoint {
+				v := rate
+				group.MaxCostPerPoint = &v
+			}
+		}
+	}
+	for _, group := range groups {
+		group.Ready = group.PercentagePoints >= weeklyMinPoints && group.SampleIntervals >= weeklyMinIntervals && group.SampleRequests >= weeklyMinRequests
+		if group.Ready {
+			rate := group.SampleCostUSD / float64(group.PercentagePoints)
+			full := rate * 100
+			group.CostPerPoint = &rate
+			group.FullAllowanceUSD = &full
+		} else {
+			group.MinCostPerPoint = nil
+			group.MaxCostPerPoint = nil
+		}
+		result.Modes = append(result.Modes, *group)
+	}
+	sort.Slice(result.Modes, func(i, j int) bool {
+		a, b := result.Modes[i], result.Modes[j]
+		if a.Model != b.Model {
+			return a.Model < b.Model
+		}
+		return a.Mode < b.Mode
+	})
+	return result
+}
diff --git a/internal/quota/weekly_value_test.go b/internal/quota/weekly_value_test.go
new file mode 100644
index 0000000..9037532
--- /dev/null
+++ b/internal/quota/weekly_value_test.go
@@ -0,0 +1,78 @@
+package quota
+
+import (
+	dto "cpa-usage-keeper/internal/repository/dto"
+	"math"
+	"testing"
+	"time"
+)
+
+func weeklySample(now time.Time, points int, cost float64, mode string) dto.CodexQuotaEfficiencyTransition {
+	return dto.CodexQuotaEfficiencyTransition{PercentagePoints: points, IntervalStartedAt: now.Add(-time.Minute), IntervalEndedAt: now,
+		Usage: dto.CodexQuotaEfficiencyUsage{Requests: 10, CostAvailable: true, TotalCostUSD: cost,
+			ModelModes: []dto.QuotaModelModeUsage{{Model: "model-a", Mode: mode, Requests: 10, CostAvailable: true, TotalCostUSD: cost}}}}
+}
+
+func TestWeeklyValueWeightedSamplesAndExclusions(t *testing.T) {
+	now := time.Date(2026, 10, 7, 12, 0, 0, 0, time.UTC)
+	good := []dto.CodexQuotaEfficiencyTransition{weeklySample(now, 1, 1, "fast"), weeklySample(now, 2, 4, "fast"), weeklySample(now, 3, 9, "fast")}
+	mixed := weeklySample(now, 1, 10, "fast")
+	mixed.Usage.ModelModes = append(mixed.Usage.ModelModes, dto.QuotaModelModeUsage{Model: "model-b", Mode: "normal"})
+	missing := weeklySample(now, 1, 10, "fast")
+	missing.Usage.CostAvailable = false
+	failed := weeklySample(now, 1, 10, "fast")
+	failed.Usage.FailedRequests = 1
+	gap := weeklySample(now, 1, 10, "fast")
+	gap.IntervalStartedAt = now.Add(-2 * time.Hour)
+	unknown := weeklySample(now, 1, 10, "unknown")
+	zero := weeklySample(now, 0, 10, "fast")
+	sparse := weeklySample(now, 1, 2, "normal")
+	cycle := dto.CodexQuotaEfficiencyCycle{WindowSeconds: 604800, Transitions: append(good, mixed, missing, failed, gap, unknown, zero, sparse)}
+	report := buildWeeklyQuotaValue(dto.CodexQuotaEfficiencyHistory{GeneratedAt: now, Cycles: []dto.CodexQuotaEfficiencyCycle{cycle}})
+	if report.ExcludedIntervals != 6 || report.EligiblePoints != 7 || report.ObservedPoints != 12 {
+		t.Fatalf("bad coverage: %+v", report)
+	}
+	if len(report.Modes) != 2 {
+		t.Fatalf("bad groups: %+v", report.Modes)
+	}
+	fast, normal := report.Modes[0], report.Modes[1]
+	if !fast.Ready || math.Abs(*fast.CostPerPoint-14.0/6) > 1e-9 || math.Abs(*fast.FullAllowanceUSD-1400.0/6) > 1e-9 || *fast.MinCostPerPoint != 1 || *fast.MaxCostPerPoint != 3 {
+		t.Fatalf("unweighted or invalid result: %+v", fast)
+	}
+	if normal.Ready || normal.CostPerPoint != nil || normal.FullAllowanceUSD != nil {
+		t.Fatalf("sparse data produced estimate: %+v", normal)
+	}
+}
+
+func TestWeeklyValueResetEvidenceAndWindowChanges(t *testing.T) {
+	reset := time.Date(2026, 10, 7, 12, 0, 0, 0, time.UTC)
+	old := dto.CodexQuotaEfficiencyCycle{ID: 1, WindowSeconds: 604800, Status: "completed", ResetAt: reset, EffectiveEndedAt: reset, EffectiveStartedAt: reset.Add(-7 * 24 * time.Hour), FirstObservedAt: reset.Add(-6 * 24 * time.Hour), LastObservedAt: reset.Add(-10 * time.Minute)}
+	next := dto.CodexQuotaEfficiencyCycle{ID: 2, WindowSeconds: 604800, Status: "current", WindowStartedAt: reset, FirstObservedAt: reset.Add(5 * time.Minute)}
+	report := buildWeeklyQuotaValue(dto.CodexQuotaEfficiencyHistory{GeneratedAt: reset.Add(time.Hour), Cycles: []dto.CodexQuotaEfficiencyCycle{old}})
+	if report.Resets[0].RolloverObservedAt != nil || report.Resets[0].LastObservationAgeSeconds != 600 || !report.Resets[0].PartialObservation {
+		t.Fatal("passed countdown claimed as reset")
+	}
+	report = buildWeeklyQuotaValue(dto.CodexQuotaEfficiencyHistory{GeneratedAt: reset.Add(time.Hour), Cycles: []dto.CodexQuotaEfficiencyCycle{old, next}})
+	if report.Resets[0].RolloverObservedAt == nil || !report.Resets[0].RolloverObservedAt.Equal(next.FirstObservedAt) {
+		t.Fatal("missing rollover evidence")
+	}
+	old.EffectiveEndedAt = reset.Add(-time.Hour)
+	report = buildWeeklyQuotaValue(dto.CodexQuotaEfficiencyHistory{Cycles: []dto.CodexQuotaEfficiencyCycle{old, next}})
+	if report.Resets[0].RolloverObservedAt != nil {
+		t.Fatal("reconfigured window reported as a reset")
+	}
+}
+
+func TestWeeklyValueEligibilityFloors(t *testing.T) {
+ for _, tc := range []struct{name string; points, intervals int; requests int64; ready bool}{
+  {"eligible",5,3,20,true},{"rounding",4,3,20,false},{"few intervals",5,2,20,false},{"few requests",5,3,19,false},
+ } {
+  t.Run(tc.name,func(t *testing.T){
+   now:=time.Now();var samples []dto.CodexQuotaEfficiencyTransition
+   for i:=0;i<tc.intervals;i++ { sample:=weeklySample(now,1,1,"normal");sample.Usage.Requests=1; samples=append(samples,sample) }
+   samples[0].PercentagePoints=tc.points-tc.intervals+1;samples[0].Usage.Requests=tc.requests-int64(tc.intervals)+1
+   report:=buildWeeklyQuotaValue(dto.CodexQuotaEfficiencyHistory{Cycles:[]dto.CodexQuotaEfficiencyCycle{{WindowSeconds:604800,Transitions:samples}}})
+   if report.Modes[0].Ready!=tc.ready {t.Fatalf("bad floor: %+v",report.Modes[0])}
+  })
+ }
+}
