@@ -0,0 +1,61 @@
+package test
+
+import (
+	"context"
+	"cpa-usage-keeper/internal/entities"
+	"cpa-usage-keeper/internal/pricing"
+	"cpa-usage-keeper/internal/repository"
+	dto "cpa-usage-keeper/internal/repository/dto"
+	"reflect"
+	"testing"
+	"time"
+)
+
+func TestWeeklyQuotaValueArchiveModeAndWindowIsolation(t *testing.T) {
+	db := openTestDatabase(t)
+	now := time.Date(2026, 10, 7, 12, 0, 0, 0, time.UTC)
+	seedCodexQuotaEfficiencyRoleCycle(t, db, "weekly-account", entities.CodexQuotaWindowRolePrimary, now.Add(-2*time.Hour), now.Add(3*time.Hour), []codexQuotaEfficiencySegmentSeed{{remaining: 99, first: now.Add(-time.Hour), last: now.Add(-time.Hour)}})
+	seedCodexQuotaEfficiencyRoleCycle(t, db, "weekly-account", entities.CodexQuotaWindowRoleSecondary, now.Add(-6*24*time.Hour), now.Add(24*time.Hour), []codexQuotaEfficiencySegmentSeed{
+		{remaining: 80, first: now.Add(-30 * time.Minute), last: now.Add(-30 * time.Minute)},
+		{remaining: 78, first: now.Add(-10 * time.Minute), last: now.Add(-10 * time.Minute)},
+	})
+	fast := usageEventForQuotaEfficiency("fast", "oauth", "weekly-account", now.Add(-20*time.Minute), 1_000_000)
+	fast.UpstreamServiceTier = "priority"
+	normal := usageEventForQuotaEfficiency("normal", "oauth", "weekly-account", now.Add(-15*time.Minute), 1_000_000)
+	normal.UpstreamServiceTier = "default"
+	unknown := usageEventForQuotaEfficiency("unknown", "oauth", "weekly-account", now.Add(-5*time.Minute), 1_000_000)
+	alias := "model-fast"
+	unknown.ModelAlias = &alias
+	other := usageEventForQuotaEfficiency("other", "oauth", "other-account", now.Add(-15*time.Minute), 9_000_000)
+	seedCodexQuotaEfficiencyUsage(t, db, fast, normal, unknown, other)
+	query := dto.CodexQuotaEfficiencyQuery{AuthIndex: "weekly-account", Now: now, RangeStart: now.Add(-90 * 24 * time.Hour), WeeklyOnly: true}
+	resolver := codexQuotaEfficiencyPricingResolverWithRules(t, []pricing.RuleConfig{{Key: "upstream_service_tier", Value: "priority", Multiplier: 2}})
+	before, err := repository.BuildCodexQuotaEfficiencyHistory(context.Background(), db, query, resolver)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(before.Cycles) != 1 || before.SelectedWindow.WindowRole != "secondary" || before.Cycles[0].Usage.TotalCostUSD != 4 {
+		t.Fatalf("wrong weekly results: %+v", before)
+	}
+	modes := before.Cycles[0].Usage.ModelModes
+	if len(modes) != 3 || modes[0].Mode != "fast" || modes[0].TotalCostUSD != 2 || modes[1].Mode != "normal" || modes[2].Mode != "unknown" {
+		t.Fatalf("mode guessed or price lost: %+v", modes)
+	}
+	if len(before.Cycles[0].Transitions[0].Usage.ModelModes) != 2 {
+		t.Fatal("mixed interval lost a model/mode")
+	}
+	// The production archive operation uses exactly these storage columns and an atomic move.
+	if err := db.Exec("INSERT INTO usage_events_archive (" + entities.UsageEventStorageColumns + ") SELECT " + entities.UsageEventStorageColumns + " FROM usage_events").Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Exec("DELETE FROM usage_events").Error; err != nil {
+		t.Fatal(err)
+	}
+	after, err := repository.BuildCodexQuotaEfficiencyHistory(context.Background(), db, query, resolver)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !reflect.DeepEqual(before, after) {
+		t.Fatalf("history changed after archival: before=%+v after=%+v", before.Cycles, after.Cycles)
+	}
+}
