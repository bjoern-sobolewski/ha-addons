index 0000000..d5f208e
--- /dev/null
+++ b/web/src/components/usage/credentials/weeklyCycleRows.ts
@@ -0,0 +1,58 @@
+import type { CodexQuotaHistoryCycle, CodexQuotaHistoryResponse, CodexQuotaHistoryUsage } from '@/lib/types'
+
+export interface WeeklyCycleRow {
+  cycle: CodexQuotaHistoryCycle
+  reset?: NonNullable<CodexQuotaHistoryResponse['weekly_value']>['resets'][number]
+  combinedUpdates: number
+}
+
+function addUsage(a: CodexQuotaHistoryUsage, b: CodexQuotaHistoryUsage): CodexQuotaHistoryUsage {
+  return {
+    requests: a.requests + b.requests,
+    successful_requests: a.successful_requests + b.successful_requests,
+    failed_requests: a.failed_requests + b.failed_requests,
+    input_tokens: a.input_tokens + b.input_tokens,
+    output_tokens: a.output_tokens + b.output_tokens,
+    reasoning_tokens: a.reasoning_tokens + b.reasoning_tokens,
+    cache_read_tokens: a.cache_read_tokens + b.cache_read_tokens,
+    cache_creation_tokens: a.cache_creation_tokens + b.cache_creation_tokens,
+    total_tokens: a.total_tokens + b.total_tokens,
+    total_cost_usd: a.total_cost_usd + b.total_cost_usd,
+    cost_available: a.cost_available && b.cost_available,
+  }
+}
+
+// An unused allowance can keep reporting "now + seven days" until use fixes
+// its reset time. Those contiguous 100% records describe one allowance.
+// Group only the presentation; retain the source records and sample intervals.
+export function weeklyCycleRows(history: CodexQuotaHistoryResponse): WeeklyCycleRow[] {
+  const ordered = [...history.cycles].sort((a, b) => Date.parse(a.effective_started_at) - Date.parse(b.effective_started_at) || a.id - b.id)
+  const rows: WeeklyCycleRow[] = []
+  for (const source of ordered) {
+    const cycle = { ...source, usage: { ...source.usage } }
+    const reset = history.weekly_value?.resets.find(item => item.cycle_id === cycle.id)
+    const previous = rows.at(-1)
+    const before = previous?.cycle
+    const combine = before && before.status !== 'current' &&
+      before.window_seconds === cycle.window_seconds && before.window_seconds === 604800 &&
+      Date.parse(before.effective_ended_at) === Date.parse(cycle.effective_started_at) &&
+      Date.parse(before.effective_ended_at) < Date.parse(before.reset_at) &&
+      before.first_remaining_percent === 100 && before.last_remaining_percent === 100 &&
+      !before.transitions.length && cycle.first_remaining_percent === 100 &&
+      Date.parse(cycle.reset_at) >= Date.parse(before.reset_at)
+    if (combine && previous) {
+      cycle.effective_started_at = before.effective_started_at
+      cycle.first_observed_at = before.first_observed_at
+      cycle.observation_count += before.observation_count
+      cycle.usage = addUsage(before.usage, cycle.usage)
+      rows[rows.length - 1] = {
+        cycle,
+        reset: reset ? { ...reset, partial_observation: previous.reset?.partial_observation ?? reset.partial_observation } : undefined,
+        combinedUpdates: previous.combinedUpdates + 1,
+      }
+    } else {
+      rows.push({ cycle, reset, combinedUpdates: 0 })
+    }
+  }
+  return rows.reverse()
+}
diff --git a/web/src/components/usage/test/WeeklyQuotaValuePanel.test.tsx b/web/src/components/usage/test/WeeklyQuotaValuePanel.test.tsx
