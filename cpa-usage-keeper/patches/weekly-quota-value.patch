@@ -0,0 +1,137 @@
+// @vitest-environment happy-dom
+import React, { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { beforeEach, afterEach, expect, it, vi } from 'vitest'
+import i18n from '@/i18n'
+import type { CodexQuotaHistoryResponse } from '@/lib/types'
+const api = vi.hoisted(() => ({ fetchCodexQuotaHistory: vi.fn() }))
+vi.mock('@/lib/api', async original => ({ ...await original<typeof import('@/lib/api')>(), ...api }))
+import { WeeklyQuotaValuePanel } from '../credentials/WeeklyQuotaValuePanel'
+import { weeklyCycleRows } from '../credentials/weeklyCycleRows'
+
+let element: HTMLDivElement
+let root: Root
+const date = '2026-10-07T12:00:00Z'
+function fixture(): CodexQuotaHistoryResponse {
+  return { generated_at: date, range_start: '2026-07-09T12:00:00Z', windows: [], selected_window: null,
+    cycles: [{ id: 1, status: 'completed', window_seconds: 604800, window_started_at: '2026-09-30T12:00:00Z', reset_at: date,
+      effective_started_at: '2026-09-30T12:00:00Z', effective_ended_at: date, first_observed_at: '2026-10-01T12:00:00Z', last_observed_at: '2026-10-07T11:50:00Z',
+      first_remaining_percent: 99, last_remaining_percent: 17, observation_count: 80, transitions: [],
+      usage: { requests: 42, successful_requests: 42, failed_requests: 0, input_tokens: 100, output_tokens: 10, reasoning_tokens: 0, cache_read_tokens: 0, cache_creation_tokens: 0, total_tokens: 110, total_cost_usd: 12, cost_available: true } }],
+    weekly_value: { min_points: 5, min_intervals: 3, min_requests: 20, max_interval_seconds: 3600, excluded_intervals: 2, eligible_points: 8, observed_points: 10,
+      resets: [{ cycle_id: 1, rollover_observed_at: null, last_observation_age_seconds: 600, partial_observation: true }],
+      modes: [{ model: 'model-a', mode: 'fast', total_requests: 42, total_cost_usd: 12, cost_available: true, sample_requests: 40, sample_intervals: 4, percentage_points: 8, sample_cost_usd: 12, ready: true, cost_per_point: 1.5, full_allowance_usd: 150, min_cost_per_point: 1, max_cost_per_point: 2 }] } }
+}
+beforeEach(async () => {
+  globalThis.IS_REACT_ACT_ENVIRONMENT = true
+  await i18n.changeLanguage('en')
+  vi.clearAllMocks()
+  element = document.createElement('div'); document.body.append(element); root = createRoot(element)
+})
+afterEach(async () => { await act(async () => root.unmount()); element.remove() })
+
+it('shows observed remaining, unconfirmed rollover and weighted estimates in the read-only report', async () => {
+  api.fetchCodexQuotaHistory.mockResolvedValue(fixture())
+  await act(async () => root.render(<WeeklyQuotaValuePanel authIndex="account:opaque" readOnlyAccountId="3" />))
+  expect(api.fetchCodexQuotaHistory).toHaveBeenCalledWith('account:opaque', { weeklyOnly: true, readOnlyAccountId: '3', windowRole: undefined }, expect.any(AbortSignal))
+  expect(element.textContent).toContain('17%')
+  expect(element.textContent).toContain('Awaiting rollover observation')
+  expect(element.textContent).toContain('10 min before cycle end')
+  expect(element.textContent).toContain('$150.00')
+  expect(element.textContent).toContain('Fast requested')
+  expect(element.textContent).toContain('8 of 10 observed percentage points')
+  expect(element.textContent).not.toMatch(/Delete|Reset quota/)
+})
+
+it('does not display missing prices or sparse estimates as zero or a full allowance', async () => {
+  const response = fixture()
+  response.cycles[0].usage.cost_available = false
+  response.weekly_value!.modes[0] = { ...response.weekly_value!.modes[0], ready: false, cost_per_point: null, full_allowance_usd: null, min_cost_per_point: null, max_cost_per_point: null }
+  api.fetchCodexQuotaHistory.mockResolvedValue(response)
+  await act(async () => root.render(<WeeklyQuotaValuePanel authIndex="account" />))
+  expect(element.textContent).toContain('Pricing incomplete')
+  expect(element.textContent).toContain('Insufficient data')
+  expect(element.textContent).not.toContain('$150.00')
+})
+
+it('handles empty weekly data, retry and abort on unmount', async () => {
+  api.fetchCodexQuotaHistory.mockRejectedValueOnce(new Error('offline')).mockResolvedValueOnce({ ...fixture(), cycles: [] })
+  await act(async () => root.render(<WeeklyQuotaValuePanel authIndex="account" />))
+  expect(element.querySelector('[role="alert"]')).not.toBeNull()
+  await act(async () => element.querySelector<HTMLButtonElement>('button')!.click())
+  expect(element.textContent).toContain('No weekly quota observations yet')
+  const signal: AbortSignal = api.fetchCodexQuotaHistory.mock.calls[1][2]
+  await act(async () => root.unmount())
+  expect(signal.aborted).toBe(true)
+  root = createRoot(element)
+})
+
+function movingResetFixture(): CodexQuotaHistoryResponse {
+  const response = fixture()
+  const previous = response.cycles[0]
+  const start = Date.parse(date)
+  const stamp = (minutes: number) => new Date(start + minutes * 60000).toISOString()
+  response.cycles = Array.from({ length: 28 }, (_, index) => ({
+    ...previous, id: index + 2, status: index === 27 ? 'current' : 'completed',
+    window_started_at: stamp(index * 10), reset_at: stamp(index * 10 + 10080),
+    effective_started_at: stamp(index * 10), effective_ended_at: stamp((index + 1) * 10),
+    first_observed_at: stamp(index * 10), last_observed_at: stamp(index * 10 + 5),
+    first_remaining_percent: 100, last_remaining_percent: index === 27 ? 90 : 100,
+    usage: { ...previous.usage, requests: 1, total_cost_usd: 0.25 },
+  }))
+  response.cycles.unshift(previous)
+  response.weekly_value!.resets = response.cycles.map(cycle => ({ cycle_id: cycle.id, rollover_observed_at: null, last_observation_age_seconds: 300, partial_observation: false }))
+  return response
+}
+
+it('combines repeated unused reset-time updates while preserving usage, observations and source records', async () => {
+  const response = movingResetFixture()
+  const before = JSON.stringify(response)
+  const rows = weeklyCycleRows(response)
+  expect(rows).toHaveLength(2)
+  expect(rows[0].combinedUpdates).toBe(27)
+  expect(rows[0].cycle.usage.requests).toBe(28)
+  expect(rows[0].cycle.usage.total_cost_usd).toBe(7)
+  expect(rows[0].cycle.last_remaining_percent).toBe(90)
+  expect(Date.parse(rows[0].cycle.first_observed_at)).toBe(Date.parse(date))
+  expect(rows[1].cycle.last_remaining_percent).toBe(17)
+  expect(JSON.stringify(response)).toBe(before)
+  api.fetchCodexQuotaHistory.mockResolvedValue(response)
+  await act(async () => root.render(<WeeklyQuotaValuePanel authIndex="account" readOnlyAccountId="3" />))
+  expect(element.querySelector('table tbody')!.children).toHaveLength(2)
+  expect(element.textContent).toContain('27 reset-time updates combined')
+  expect(element.textContent).toContain('$7.00')
+})
+
+it('retains real rollovers, consumption changes, gaps and missing percentages as separate rows', () => {
+  for (const change of ['rollover', 'consumption', 'gap', 'unknown', 'backward-reset'] as const) {
+    const response = movingResetFixture()
+    response.cycles = response.cycles.slice(1, 3)
+    const [a, b] = response.cycles
+    if (change === 'rollover') a.reset_at = a.effective_ended_at
+    if (change === 'consumption') a.last_remaining_percent = 99
+    if (change === 'gap') b.effective_started_at = b.last_observed_at
+    if (change === 'unknown') b.first_remaining_percent = null
+    if (change === 'backward-reset') b.reset_at = a.effective_ended_at
+    expect(weeklyCycleRows(response), change).toHaveLength(2)
+  }
+})
+
+it('keeps incomplete pricing visible after combining updates', () => {
+  const response = movingResetFixture()
+  response.cycles[2].usage.cost_available = false
+  expect(weeklyCycleRows(response)[0].cycle.usage.cost_available).toBe(false)
+})
+
+it('shows five recent cycles and lets the user expand and collapse older history', async () => {
+  const response = fixture()
+  response.cycles = Array.from({ length: 9 }, (_, index) => ({ ...response.cycles[0], id: index + 1 }))
+  api.fetchCodexQuotaHistory.mockResolvedValue(response)
+  await act(async () => root.render(<WeeklyQuotaValuePanel authIndex="account" readOnlyAccountId="3" />))
+  expect(element.querySelector('table tbody')!.children).toHaveLength(5)
+  const older = Array.from(element.querySelectorAll('button')).find(button => button.textContent === 'Show older cycles (4)')!
+  await act(async () => older.click())
+  expect(element.querySelector('table tbody')!.children).toHaveLength(9)
+  await act(async () => older.click())
+  expect(element.querySelector('table tbody')!.children).toHaveLength(5)
+})
