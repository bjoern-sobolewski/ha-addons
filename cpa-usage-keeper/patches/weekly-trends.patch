+	valid.TTFTMS = &ttft
+	boundary := valid
+	boundary.EventKey = "boundary"
+	boundary.Timestamp = midnight
+	boundary.UpstreamServiceTier = "priority"
+	boundary.TTFTMS = nil
+	failed := boundary
+	failed.EventKey = "failed"
+	failed.Failed = true
+	invalid := boundary
+	invalid.EventKey = "invalid"
+	invalid.LatencyMS = 0
+	nonGeneration := boundary
+	nonGeneration.EventKey = "non-generation"
+	generate := false
+	nonGeneration.Generate = &generate
+	invalidTTFT := boundary
+	invalidTTFT.EventKey = "invalid-ttft"
+	negative := int64(-1)
+	invalidTTFT.TTFTMS = &negative
+	seedCodexQuotaEfficiencyUsage(t, db, valid, boundary, failed, invalid, nonGeneration, invalidTTFT)
+	result, err := repository.BuildCodexQuotaEfficiencyHistory(context.Background(), db, dto.CodexQuotaEfficiencyQuery{AuthIndex: "speed-account", Now: now, RangeStart: midnight.Add(-7 * 24 * time.Hour), WeeklyOnly: true}, codexQuotaEfficiencyPricingResolver(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	days := result.Cycles[0].DailyUsage
+	if len(days) != 2 || !days[0].Day.Equal(midnight.Add(-24*time.Hour)) || !days[1].Day.Equal(midnight) {
+		t.Fatalf("wrong UTC buckets: %+v", days)
+	}
+	normal, fast := days[0].Usage.ModelModes[0], days[1].Usage.ModelModes[0]
+	if normal.Mode != "normal" || normal.SpeedRequests != 1 || normal.TTFTRequests != 1 || normal.TotalTTFTMS != 500 {
+		t.Fatalf("normal timing lost: %+v", normal)
+	}
+	if fast.Mode != "fast" || fast.Requests != 5 || fast.SpeedRequests != 2 || fast.SpeedDurationMS != 4000 || fast.SpeedOutputTokens != 200 || fast.TTFTRequests != 0 {
+		t.Fatalf("invalid timings counted: %+v", fast)
+	}
+}
