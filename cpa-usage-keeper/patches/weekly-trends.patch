diff --git a/internal/quota/weekly_trends.go b/internal/quota/weekly_trends.go
new file mode 100644
index 0000000..8a55ca5
--- /dev/null
+++ b/internal/quota/weekly_trends.go
@@ -0,0 +1,130 @@
+package quota
+
+import (
+	dto "cpa-usage-keeper/internal/repository/dto"
+	"sort"
+	"time"
+)
+
+type WeeklyTrendPoint struct {
+	Day              time.Time `json:"day"`
+	Model            string    `json:"model"`
+	Mode             string    `json:"mode"`
+	Requests         int64     `json:"requests"`
+	TotalCostUSD     float64   `json:"total_cost_usd"`
+	CostAvailable    bool      `json:"cost_available"`
+	SpeedRequests    int64     `json:"speed_requests"`
+	SpeedTPS         *float64  `json:"speed_tps"`
+	TTFTRequests     int64     `json:"ttft_requests"`
+	MeanTTFTMS       *float64  `json:"mean_ttft_ms"`
+	SampleIntervals  int       `json:"sample_intervals"`
+	SampleRequests   int64     `json:"sample_requests"`
+	PercentagePoints int       `json:"percentage_points"`
+	FullAllowanceUSD *float64  `json:"full_allowance_usd"`
+}
+
+func weeklyIntervalEligible(interval dto.CodexQuotaEfficiencyTransition) bool {
+	usage := interval.Usage
+	return interval.PercentagePoints > 0 && interval.IntervalEndedAt.After(interval.IntervalStartedAt) &&
+		interval.IntervalEndedAt.Sub(interval.IntervalStartedAt) <= weeklyMaxInterval &&
+		len(usage.ModelModes) == 1 && usage.CostAvailable && usage.ModelModes[0].CostAvailable && usage.Requests > 0 && usage.FailedRequests == 0 &&
+		usage.ModelModes[0].Model != "" && (usage.ModelModes[0].Mode == "normal" || usage.ModelModes[0].Mode == "fast")
+}
+
+// Aggregates the same event stream as the cycle table, including archived events.
+// Estimates at each day use only samples already observed in the trailing seven UTC days.
+func buildWeeklyTimeline(history dto.CodexQuotaEfficiencyHistory) []WeeklyTrendPoint {
+	type key struct {
+		day         time.Time
+		model, mode string
+	}
+	daily := make(map[key]dto.QuotaModelModeUsage)
+	samples := make(map[[2]string][]dto.CodexQuotaEfficiencyTransition)
+	groups := make(map[[2]string]bool)
+	var first time.Time
+	addDay := func(day time.Time) {
+		if first.IsZero() || day.Before(first) {
+			first = day
+		}
+	}
+	for _, cycle := range history.Cycles {
+		if cycle.WindowSeconds != 604800 {
+			continue
+		}
+		for _, day := range cycle.DailyUsage {
+			addDay(day.Day)
+			for _, usage := range day.Usage.ModelModes {
+				k := key{day.Day, usage.Model, usage.Mode}
+				total, exists := daily[k]
+				if !exists {
+					total.CostAvailable = true
+				}
+				total.Requests += usage.Requests
+				total.TotalCostUSD += usage.TotalCostUSD
+				total.CostAvailable = total.CostAvailable && usage.CostAvailable
+				total.SpeedRequests += usage.SpeedRequests
+				total.SpeedOutputTokens += usage.SpeedOutputTokens
+				total.SpeedDurationMS += usage.SpeedDurationMS
+				total.TTFTRequests += usage.TTFTRequests
+				total.TotalTTFTMS += usage.TotalTTFTMS
+				daily[k] = total
+				groups[[2]string{usage.Model, usage.Mode}] = true
+			}
+		}
+		for _, interval := range cycle.Transitions {
+			if !weeklyIntervalEligible(interval) || interval.IntervalEndedAt.After(history.GeneratedAt) {
+				continue
+			}
+			usage := interval.Usage.ModelModes[0]
+			k := [2]string{usage.Model, usage.Mode}
+			samples[k] = append(samples[k], interval)
+			groups[k] = true
+			addDay(interval.IntervalEndedAt.UTC().Truncate(24 * time.Hour))
+		}
+	}
+	result := []WeeklyTrendPoint{}
+	if first.IsZero() || history.GeneratedAt.IsZero() {
+		return result
+	}
+	last := history.GeneratedAt.UTC().Truncate(24 * time.Hour)
+	for day := first; !day.After(last); day = day.Add(24 * time.Hour) {
+		for group := range groups {
+			usage, exists := daily[key{day, group[0], group[1]}]
+			point := WeeklyTrendPoint{Day: day, Model: group[0], Mode: group[1], Requests: usage.Requests, TotalCostUSD: usage.TotalCostUSD, CostAvailable: !exists || usage.CostAvailable, SpeedRequests: usage.SpeedRequests, TTFTRequests: usage.TTFTRequests}
+			if usage.SpeedRequests > 0 && usage.SpeedDurationMS > 0 {
+				v := float64(usage.SpeedOutputTokens) * 1000 / float64(usage.SpeedDurationMS)
+				point.SpeedTPS = &v
+			}
+			if usage.TTFTRequests > 0 {
+				v := float64(usage.TotalTTFTMS) / float64(usage.TTFTRequests)
+				point.MeanTTFTMS = &v
+			}
+			var cost float64
+			for _, interval := range samples[group] {
+				if interval.IntervalEndedAt.Before(day.Add(-6*24*time.Hour)) || !interval.IntervalEndedAt.Before(day.Add(24*time.Hour)) {
+					continue
+				}
+				point.SampleIntervals++
+				point.SampleRequests += interval.Usage.Requests
+				point.PercentagePoints += interval.PercentagePoints
+				cost += interval.Usage.TotalCostUSD
+			}
+			if point.PercentagePoints >= weeklyMinPoints && point.SampleIntervals >= weeklyMinIntervals && point.SampleRequests >= weeklyMinRequests {
+				v := cost / float64(point.PercentagePoints) * 100
+				point.FullAllowanceUSD = &v
+			}
+			result = append(result, point)
+		}
+	}
+	sort.Slice(result, func(i, j int) bool {
+		a, b := result[i], result[j]
+		if !a.Day.Equal(b.Day) {
+			return a.Day.Before(b.Day)
+		}
+		if a.Model != b.Model {
+			return a.Model < b.Model
+		}
+		return a.Mode < b.Mode
+	})
+	return result
+}
diff --git a/internal/quota/weekly_trends_test.go b/internal/quota/weekly_trends_test.go
new file mode 100644
index 0000000..f934d27
--- /dev/null
+++ b/internal/quota/weekly_trends_test.go
@@ -0,0 +1,58 @@
+package quota
+
+import (
+	dto "cpa-usage-keeper/internal/repository/dto"
+	"math"
+	"testing"
+	"time"
+)
+
+func TestWeeklyTimelineRollingEstimatesDoNotUseFutureOrExpiredSamples(t *testing.T) {
+	day := time.Date(2026, 10, 1, 0, 0, 0, 0, time.UTC)
+	transitions := []dto.CodexQuotaEfficiencyTransition{}
+	for i, points := range []int{1, 2, 3} {
+		transitions = append(transitions, weeklySample(day.Add(time.Duration(i)*24*time.Hour+time.Hour), points, float64(points)*2, "fast"))
+	}
+	future := weeklySample(day.Add(11*24*time.Hour), 10, 10000, "fast")
+	transitions = append(transitions, future)
+	mixed := weeklySample(day.Add(2*24*time.Hour+2*time.Hour), 10, 9999, "fast")
+	mixed.Usage.ModelModes = append(mixed.Usage.ModelModes, dto.QuotaModelModeUsage{Model: "other", Mode: "normal"})
+	transitions = append(transitions, mixed)
+	history := dto.CodexQuotaEfficiencyHistory{GeneratedAt: day.Add(10 * 24 * time.Hour), Cycles: []dto.CodexQuotaEfficiencyCycle{{WindowSeconds: 604800, Transitions: transitions}}}
+	rows := buildWeeklyTimeline(history)
+	if len(rows) != 11 {
+		t.Fatalf("unexpected days: %d", len(rows))
+	}
+	if rows[0].FullAllowanceUSD != nil || rows[1].FullAllowanceUSD != nil {
+		t.Fatal("future evidence created a past estimate")
+	}
+	if rows[2].FullAllowanceUSD == nil || math.Abs(*rows[2].FullAllowanceUSD-200) > 1e-9 || rows[2].PercentagePoints != 6 {
+		t.Fatalf("wrong weighted estimate: %+v", rows[2])
+	}
+	if rows[7].FullAllowanceUSD != nil || rows[10].FullAllowanceUSD != nil {
+		t.Fatal("stale or future samples were reused")
+	}
+}
+
+func TestWeeklyTimelineCombinesDailyFragmentsAndKeepsModesAndMissingData(t *testing.T) {
+	day := time.Date(2026, 10, 7, 0, 0, 0, 0, time.UTC)
+	usage := func(cost float64, valid bool, mode string, tokens, duration int64) dto.QuotaDailyUsage {
+		return dto.QuotaDailyUsage{Day: day, Usage: dto.CodexQuotaEfficiencyUsage{ModelModes: []dto.QuotaModelModeUsage{{Model: "a", Mode: mode, Requests: 3, TotalCostUSD: cost, CostAvailable: valid, SpeedRequests: 3, SpeedOutputTokens: tokens, SpeedDurationMS: duration, TTFTRequests: 3, TotalTTFTMS: 3000}}}}
+	}
+	history := dto.CodexQuotaEfficiencyHistory{GeneratedAt: day.Add(time.Hour), Cycles: []dto.CodexQuotaEfficiencyCycle{
+		{WindowSeconds: 604800, DailyUsage: []dto.QuotaDailyUsage{usage(2, true, "fast", 100, 1000)}},
+		{WindowSeconds: 604800, DailyUsage: []dto.QuotaDailyUsage{usage(5, true, "fast", 300, 9000), usage(20, false, "unknown", 40, 2000)}},
+		{WindowSeconds: 18000, DailyUsage: []dto.QuotaDailyUsage{usage(999, true, "normal", 5000, 1)}},
+	}}
+	rows := buildWeeklyTimeline(history)
+	if len(rows) != 2 {
+		t.Fatalf("wrong groups: %+v", rows)
+	}
+	fast, unknown := rows[0], rows[1]
+	if fast.Requests != 6 || fast.TotalCostUSD != 7 || fast.SpeedRequests != 6 || fast.SpeedTPS == nil || *fast.SpeedTPS != 40 || *fast.MeanTTFTMS != 1000 {
+		t.Fatalf("lost totals or unweighted speed: %+v", fast)
+	}
+	if unknown.Mode != "unknown" || unknown.CostAvailable || unknown.FullAllowanceUSD != nil {
+		t.Fatalf("missing data invented: %+v", unknown)
+	}
+}
