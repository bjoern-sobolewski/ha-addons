diff --git a/web/src/components/usage/credentials/WeeklyTrendCharts.tsx b/web/src/components/usage/credentials/WeeklyTrendCharts.tsx
new file mode 100644
index 0000000..206a8c4
--- /dev/null
+++ b/web/src/components/usage/credentials/WeeklyTrendCharts.tsx
@@ -0,0 +1,97 @@
+import { useState } from 'react'
+import { useTranslation } from 'react-i18next'
+import { Chart } from 'react-chartjs-2'
+import type { ChartData, ChartOptions } from 'chart.js'
+import '@/lib/chartjs'
+import type { WeeklyTrendPoint } from '@/lib/types'
+import { useThemeStore } from '@/stores'
+import { buildUsageChartTooltipStyle, getUsageChartTheme, USAGE_CHART_COMPOSITION_COLORS } from '@/utils/usage/chartConfig'
+import styles from './WeeklyQuotaValuePanel.module.scss'
+
+export type TrendMetric = 'delivered' | 'allowance' | 'speed' | 'ttft'
+const MIN_SPEED_REQUESTS = 3
+const groupKey = (point: Pick<WeeklyTrendPoint, 'model' | 'mode'>) => JSON.stringify([point.model, point.mode])
+
+export function buildWeeklyTrendChartData(points: WeeklyTrendPoint[], metric: TrendMetric, model: string, mode: string, label: (mode: string) => string, locale: string): ChartData<'line', Array<number | null>, string> {
+  const days = [...new Set(points.map(point => point.day))].sort()
+  const models = [...new Set(points.map(point => point.model))].sort()
+  const selected = points.filter(point => (!model || point.model === model) && (!mode || point.mode === mode))
+  const groups = [...new Map(selected.map(point => [groupKey(point), point])).values()]
+  const lookup = new Map(selected.map(point => [JSON.stringify([point.day, point.model, point.mode]), point]))
+  return { labels: days.map(day => new Date(day).toLocaleDateString(locale, { month: 'short', day: 'numeric', timeZone: 'UTC' })), datasets: groups.map(group => ({
+    label: `${group.model || '—'} · ${label(group.mode)}`,
+    borderColor: USAGE_CHART_COMPOSITION_COLORS[models.indexOf(group.model) % USAGE_CHART_COMPOSITION_COLORS.length].base,
+    backgroundColor: USAGE_CHART_COMPOSITION_COLORS[models.indexOf(group.model) % USAGE_CHART_COMPOSITION_COLORS.length].base,
+    borderDash: group.mode === 'fast' ? [7, 3] : group.mode === 'unknown' ? [2, 4] : [],
+    borderWidth: 2, pointRadius: 3, pointHoverRadius: 5, spanGaps: false, tension: 0,
+    data: days.map(day => {
+      const point = lookup.get(JSON.stringify([day, group.model, group.mode]))
+      if (!point) return null
+      if (metric === 'delivered') return point.cost_available ? point.total_cost_usd : null
+      if (metric === 'allowance') return point.full_allowance_usd
+      if (metric === 'speed') return point.speed_requests >= MIN_SPEED_REQUESTS ? point.speed_tps : null
+      return point.ttft_requests >= MIN_SPEED_REQUESTS && point.mean_ttft_ms != null ? point.mean_ttft_ms / 1000 : null
+    }),
+  })) }
+}
+
+export function WeeklyTrendCharts({ points }: { points: WeeklyTrendPoint[] }) {
+  const { t, i18n } = useTranslation()
+  const isDark = useThemeStore(state => state.resolvedTheme) === 'dark'
+  const [model, setModel] = useState('')
+  const [mode, setMode] = useState('')
+  const [valueMetric, setValueMetric] = useState<TrendMetric>('delivered')
+  const [speedMetric, setSpeedMetric] = useState<TrendMetric>('speed')
+  const modeLabel = (value: string) => value === 'fast' ? t('weekly_quota.fast', 'Fast requested') : value === 'normal' ? t('weekly_quota.normal', 'Normal') : t('weekly_quota.unknown', 'Mode not captured')
+  const models = [...new Set(points.map(point => point.model))].sort()
+  const chartTheme = getUsageChartTheme(isDark)
+  const selected = points.filter(point => (!model || model === point.model) && (!mode || mode === point.mode))
+  const renderChart = (metric: TrendMetric, title: string, unit: string) => {
+    const data = buildWeeklyTrendChartData(points, metric, model, mode, modeLabel, i18n.language)
+    const hasData = data.datasets.some(dataset => dataset.data.some(value => value != null))
+    const options: ChartOptions<'line'> = {
+      responsive: true, maintainAspectRatio: false, animation: false,
+      interaction: { mode: 'index', intersect: false },
+      plugins: {
+        legend: { position: 'bottom', labels: { color: chartTheme.textSecondary, boxWidth: 20, boxHeight: 2 } },
+        tooltip: { ...buildUsageChartTooltipStyle(chartTheme), callbacks: {
+          label: context => `${context.dataset.label}: ${new Intl.NumberFormat(i18n.language, { maximumFractionDigits: 2 }).format(context.parsed.y ?? 0)} ${unit}`,
+          afterLabel: context => {
+            const group = [...new Map(selected.map(point => [groupKey(point), point])).values()][context.datasetIndex]
+            const days = [...new Set(points.map(point => point.day))].sort()
+            const point = selected.find(point => point.day === days[context.dataIndex] && groupKey(point) === groupKey(group))
+            if (!point) return ''
+            return metric === 'allowance'
+              ? t('weekly_trends.quota_samples', '{{points}} points · {{intervals}} intervals · {{requests}} requests in trailing 7 days', { points: point.percentage_points, intervals: point.sample_intervals, requests: point.sample_requests })
+              : t('weekly_trends.requests', '{{count}} requests', { count: metric === 'speed' ? point.speed_requests : metric === 'ttft' ? point.ttft_requests : point.requests })
+          },
+        } },
+      },
+      scales: {
+        x: { ticks: { color: chartTheme.textSecondary, maxTicksLimit: 8 }, grid: { display: false } },
+        y: { beginAtZero: true, title: { display: true, text: unit, color: chartTheme.textSecondary }, ticks: { color: chartTheme.textSecondary }, grid: { color: chartTheme.grid } },
+      },
+    }
+    return hasData ? <div className={styles.chart} data-weekly-trend={metric}><Chart type="line" data={data} options={options} role="img" aria-label={title} /></div>
+      : <p role="status" className={styles.note}>{metric === 'allowance' ? t('weekly_trends.no_estimates', 'Not enough qualifying quota samples for this selection yet.') : metric === 'delivered' ? t('weekly_trends.no_value', 'No fully priced recorded values for this selection yet.') : t('weekly_trends.no_speed', 'Not enough valid timing samples for this selection yet.')}</p>
+  }
+  return <section className={styles.trends} aria-label={t('weekly_trends.title', 'Value and speed over time')}>
+    <h4>{t('weekly_trends.title', 'Value and speed over time')}</h4>
+    <div className={styles.filters}>
+      <label>{t('weekly_trends.model', 'Model')} <select aria-label={t('weekly_trends.model', 'Model')} value={model} onChange={event => setModel(event.target.value)}><option value="">{t('weekly_trends.all_models', 'All models')}</option>{models.map(value => <option key={value} value={value}>{value || '—'}</option>)}</select></label>
+      <label>{t('weekly_trends.mode', 'Mode')} <select aria-label={t('weekly_trends.mode', 'Mode')} value={mode} onChange={event => setMode(event.target.value)}><option value="">{t('weekly_trends.all_modes', 'All modes')}</option>{['normal', 'fast', 'unknown'].map(value => <option key={value} value={value}>{modeLabel(value)}</option>)}</select></label>
+    </div>
+    <p className={styles.note}>{t('weekly_trends.days', 'Daily UTC buckets across the reporting period; today is partial. Each line is one model and requested mode. Solid: Normal · Dashed: Fast requested · Dotted: Mode not captured.')}</p>
+    <label className={styles.metric}>{t('weekly_trends.value', 'Subscription value over time')} <select aria-label={t('weekly_trends.value_metric', 'Value metric')} value={valueMetric} onChange={event => setValueMetric(event.target.value as TrendMetric)}>
+      <option value="delivered">{t('weekly_trends.delivered', 'Daily API value delivered')}</option><option value="allowance">{t('weekly_trends.allowance', 'Estimated full weekly allowance')}</option>
+    </select></label>
+    {renderChart(valueMetric, t('weekly_trends.value', 'Subscription value over time'), 'USD')}
+    {valueMetric === 'allowance' && <p className={styles.note}>{t('weekly_trends.estimate_note', 'Each estimate uses qualifying samples from the trailing seven UTC days, with the same 5-point, 3-interval and 20-request minimums as the table. Missing estimates are gaps; changes can reflect workload and caching.')}</p>}
+    {valueMetric === 'delivered' && selected.some(point => !point.cost_available) && <p className={styles.note}>{t('weekly_trends.missing_prices', 'Days with incomplete pricing are gaps, rather than zero-dollar values.')}</p>}
+    <label className={styles.metric}>{t('weekly_trends.speed', 'Response speed over time')} <select aria-label={t('weekly_trends.speed_metric', 'Speed metric')} value={speedMetric} onChange={event => setSpeedMetric(event.target.value as TrendMetric)}>
+      <option value="speed">{t('weekly_trends.tps', 'Output tokens / second')}</option><option value="ttft">{t('weekly_trends.ttft', 'Time to first token')}</option>
+    </select></label>
+    {renderChart(speedMetric, t('weekly_trends.speed', 'Response speed over time'), speedMetric === 'ttft' ? 's' : 'tokens/s')}
+    <p className={styles.note}>{t('weekly_trends.speed_note', 'Speed is total output tokens divided by total request time for successful generation requests with valid timing. This includes waiting and reasoning time. Time to first token is the mean of captured timings. At least 3 timed requests per day and group are required; missing timings are gaps.')}</p>
+  </section>
+}
diff --git a/web/src/components/usage/test/WeeklyTrendCharts.test.tsx b/web/src/components/usage/test/WeeklyTrendCharts.test.tsx
new file mode 100644
index 0000000..2fe84ea
--- /dev/null
+++ b/web/src/components/usage/test/WeeklyTrendCharts.test.tsx
@@ -0,0 +1,49 @@
+// @vitest-environment happy-dom
+import { act } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+import type { ChartData } from 'chart.js'
+import i18n from '@/i18n'
+import type { WeeklyTrendPoint } from '@/lib/types'
+import { WeeklyTrendCharts, buildWeeklyTrendChartData } from '../credentials/WeeklyTrendCharts'
+
+const charts = vi.hoisted(() => new Map<string, ChartData<'line', Array<number | null>, string>>())
+vi.mock('react-chartjs-2', () => ({ Chart: (props: { data: ChartData<'line', Array<number | null>, string>; 'aria-label': string }) => { charts.set(props['aria-label'],props.data); return <div role="img" aria-label={props['aria-label']} /> } }))
+const point = (day: string, mode = 'normal', model = 'a'): WeeklyTrendPoint => ({day,mode,model,requests:10,total_cost_usd:4,cost_available:true,speed_requests:4,speed_tps:30,ttft_requests:4,mean_ttft_ms:2000,sample_intervals:0,sample_requests:0,percentage_points:0,full_allowance_usd:null})
+const dates = ['2026-10-05T00:00:00Z','2026-10-06T00:00:00Z','2026-10-07T00:00:00Z']
+let element: HTMLDivElement; let root: Root
+beforeEach(async()=>{globalThis.IS_REACT_ACT_ENVIRONMENT=true;await i18n.changeLanguage('en');charts.clear();element=document.createElement('div');document.body.append(element);root=createRoot(element)})
+afterEach(async()=>{await act(async()=>root.unmount());element.remove()})
+
+it('separates model/mode lines, preserves missing prices and timing gaps, and converts TTFT units',()=>{
+ const points=[point(dates[0]),{...point(dates[1]),cost_available:false,speed_requests:2},{...point(dates[2]),speed_tps:null},point(dates[0],'fast'),point(dates[0],'normal','b'),point(dates[0],'unknown')]
+ const data=buildWeeklyTrendChartData(points,'delivered','a','',mode=>mode,'en')
+ expect(data.datasets).toHaveLength(3)
+ expect(data.datasets[0].data).toEqual([4,null,4])
+ expect(data.datasets[1].borderDash).toEqual([7,3]);expect(data.datasets[2].borderDash).toEqual([2,4])
+ expect(buildWeeklyTrendChartData(points,'speed','a','normal',mode=>mode,'en').datasets[0].data).toEqual([30,null,null])
+ expect(buildWeeklyTrendChartData(points,'ttft','a','normal',mode=>mode,'en').datasets[0].data).toEqual([2,2,2])
+ expect(buildWeeklyTrendChartData(points,'allowance','a','normal',mode=>mode,'en').datasets[0].data).toEqual([null,null,null])
+})
+
+it('filters both charts together and switches value and speed metrics without fetching',async()=>{
+ const points=[{...point(dates[0]),full_allowance_usd:200},point(dates[0],'fast'),point(dates[0],'normal','b')]
+ await act(async()=>root.render(<WeeklyTrendCharts points={points}/>))
+ expect(charts.get('Subscription value over time')!.datasets).toHaveLength(3)
+ const change=async(label:string,value:string)=>{const select=element.querySelector<HTMLSelectElement>(`select[aria-label="${label}"]`)!;await act(async()=>{select.value=value;select.dispatchEvent(new Event('change',{bubbles:true}))})}
+ await change('Model','a');await change('Mode','normal')
+ expect(charts.get('Subscription value over time')!.datasets).toHaveLength(1)
+ expect(charts.get('Response speed over time')!.datasets).toHaveLength(1)
+ await change('Value metric','allowance');expect(charts.get('Subscription value over time')!.datasets[0].data).toEqual([200])
+ await change('Speed metric','ttft');expect(charts.get('Response speed over time')!.datasets[0].data).toEqual([2])
+ expect(element.textContent).toContain('trailing seven UTC days')
+})
+
+it('shows insufficient-data states without inventing zero speeds or estimates',async()=>{
+ await act(async()=>root.render(<WeeklyTrendCharts points={[{...point(dates[0]),speed_requests:1,ttft_requests:0}]}/>))
+ expect(element.querySelector('[data-weekly-trend="speed"]')).toBeNull()
+ const select=element.querySelector<HTMLSelectElement>('select[aria-label="Value metric"]')!
+ await act(async()=>{select.value='allowance';select.dispatchEvent(new Event('change',{bubbles:true}))})
+ expect(element.textContent).toContain('Not enough qualifying quota samples')
+ expect(element.textContent).toContain('Not enough valid timing samples')
+})
